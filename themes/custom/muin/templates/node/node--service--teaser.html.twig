{#
  Service teaser card used on the services listing page.
#}
{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  'services-card',
  'group',
  'block',
  'h-full'
] %}

{% set service = muin_service_teaser|default({}) %}
{% set icon = service.icon ?? null %}
{% set tags = service.tags ?? [] %}
{% set description = service.description ?? null %}
{% set description_text = service.description_text ?? null %}
{% set primary = service.primary_cta ?? null %}
{% set secondary = service.secondary_cta ?? null %}

{% set primary_link = primary is iterable and primary.url is defined ? primary : null %}
{% set primary_render = primary is iterable and primary.render is defined ? primary.render : null %}
{% set secondary_link = secondary is iterable and secondary.url is defined ? secondary : null %}
{% set secondary_render = secondary is iterable and secondary.render is defined ? secondary.render : null %}

{% if icon is iterable %}
  {% set icon_attributes = icon['#attributes']|default({}) %}
  {% set icon_classes = icon_attributes.class|default([])|merge(['max-h-12', 'max-w-12', 'object-contain']) %}
  {% set icon_attributes = icon_attributes|merge({'class': icon_classes}) %}
  {% set icon = icon|merge({'#attributes': icon_attributes}) %}
{% endif %}

{% set extra_content = content|without(
  'links',
  'field_service_icon',
  'field_icon',
  'field_icon_media',
  'field_icon_image',
  'field_service_logo',
  'field_media_icon',
  'field_summary',
  'field_description',
  'field_intro',
  'body',
  'field_service_tags',
  'field_tags',
  'field_category',
  'field_primary_cta',
  'field_cta_link',
  'field_contact_cta',
  'field_contact_link',
  'field_primary_call_to_action',
  'field_learn_more_link',
  'field_secondary_cta',
  'field_secondary_call_to_action',
  'field_start_now',
  'field_start_now_link',
  'field_apply_now',
  'field_apply_now_link'
) %}

<article{{ attributes.addClass(classes) }}>
  <div class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:shadow-md focus-within:ring-2 focus-within:ring-primary-600">
    {% if icon %}
      <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-50">
        {{ icon }}
      </div>
    {% endif %}

    {{ title_prefix }}
    <h3 class="mb-3 text-lg font-semibold text-gray-900">
      <a href="{{ url }}" rel="bookmark" class="transition hover:text-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">{{ label }}</a>
    </h3>
    {{ title_suffix }}

    {% if description %}
      <div class="mb-4 text-sm leading-relaxed text-gray-600">{{ description }}</div>
    {% elseif description_text %}
      <p class="mb-4 text-sm leading-relaxed text-gray-600">{{ description_text }}</p>
    {% endif %}

    {% if tags %}
      <div class="mb-4 flex flex-wrap gap-2">
        {% for tag in tags %}
          <span class="rounded border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-medium text-gray-700">{{ tag }}</span>
        {% endfor %}
      </div>
    {% endif %}

    {% if extra_content %}
      <div class="sr-only">{{ extra_content }}</div>
    {% endif %}

    <div class="mt-auto flex flex-wrap gap-2 pt-2">
      {% if primary_link %}
        {% set primary_options = primary_link.options|default({}) %}
        {% set primary_attributes = create_attribute(primary_options.attributes|default({})) %}
        <a
          href="{{ primary_link.url }}"
          {{ primary_attributes.addClass('inline-flex items-center justify-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400') }}
          {% if primary_options.target is defined %}target="{{ primary_options.target }}"{% endif %}
          {% if primary_options.rel is defined %}rel="{{ primary_options.rel }}"{% endif %}
        >
          {{ primary_link.title|default('Learn more'|t) }}
        </a>
      {% elseif primary_render %}
        <div class="inline-flex">{{ primary_render }}</div>
      {% else %}
        <a
          href="{{ url }}"
          rel="bookmark"
          class="inline-flex items-center justify-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400"
        >
          {{ 'Learn more'|t }}
        </a>
      {% endif %}

      {% if secondary_link %}
        {% set secondary_options = secondary_link.options|default({}) %}
        {% set secondary_attributes = create_attribute(secondary_options.attributes|default({})) %}
        <a
          href="{{ secondary_link.url }}"
          {{ secondary_attributes.addClass('inline-flex items-center justify-center rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600') }}
          {% if secondary_options.target is defined %}target="{{ secondary_options.target }}"{% endif %}
          {% if secondary_options.rel is defined %}rel="{{ secondary_options.rel }}"{% endif %}
        >
          {{ secondary_link.title|default('Start now'|t) }}
        </a>
      {% elseif secondary_render %}
        <div class="inline-flex">{{ secondary_render }}</div>
      {% endif %}
    </div>
  </div>

  {% if content.links %}
    <div class="sr-only">{{ content.links }}</div>
  {% endif %}
</article>
