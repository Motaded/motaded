{#
  Template for the "articles" view page display.
  Mirrors the reference layout in reference/html-src/articles-page.html.
#}
{% set view_classes = [
  'articles-page',
  'bg-green-50',
  'pt-10',
  'pb-16'
] %}

{% set articles = muin_articles|default({}) %}
{% set default_title = 'Articles'|t %}
{% set page_title = articles.title ?? '' %}
{% set subtitle = articles.subtitle ?? '' %}
{% set breadcrumb_items = articles.breadcrumb ?? [] %}

{% if page_title == '' and view is defined %}
  {% set page_title = view.getTitle() %}
{% endif %}

{% if page_title is empty %}
  {% set page_title = default_title %}
{% elseif page_title|lower == 'articles' %}
  {% set page_title = default_title %}
{% endif %}

{% set subtitle_output %}
  {% if subtitle %}
    {{ subtitle }}
  {% elseif header %}
    {{ header }}
  {% endif %}
{% endset %}
{% set subtitle_output = subtitle_output|trim %}

{% set home_title = 'Home'|t %}
{% set fallback_home_url = path('<front>') %}

{% if breadcrumb_items is empty %}
  {% set breadcrumb_items = [
    {
      'text': home_title,
      'url': fallback_home_url,
    },
    {
      'text': page_title,
      'url': NULL,
    },
  ] %}
{% endif %}

{% set normalized_breadcrumb = [] %}
{% for item in breadcrumb_items %}
  {% set text = item.text|default('') %}
  {% if text|lower == 'home' %}
    {% set text = home_title %}
  {% elseif text|lower == 'articles' %}
    {% set text = page_title %}
  {% endif %}

  {% set url = item.url|default(null) %}
  {% if url is empty and text == home_title %}
    {% set url = fallback_home_url %}
  {% endif %}

  {% set normalized_breadcrumb = normalized_breadcrumb|merge([
    {
      'text': text,
      'url': url,
    },
  ]) %}
{% endfor %}
{% set breadcrumb_items = normalized_breadcrumb %}

<div{{ attributes.addClass(view_classes) }}>
  {% if breadcrumb_items %}
    <nav class="container-page text-sm text-gray-600 py-8" aria-label="{{ 'Breadcrumb'|t }}">
      <ol class="flex flex-wrap items-center gap-1">
        {% for item in breadcrumb_items %}
          <li class="flex items-center gap-1">
            {% if item.url %}
              <a href="{{ item.url }}" class="hover:underline">{{ item.text }}</a>
            {% else %}
              <span class="text-gray-900">{{ item.text }}</span>
            {% endif %}
            {% if not loop.last %}
              <span aria-hidden="true">/</span>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    </nav>
  {% elseif attachment_before %}
    <div class="container-page">
      <nav class="text-sm text-gray-600 py-8" aria-label="{{ 'Breadcrumb'|t }}">
        {{ attachment_before }}
      </nav>
    </div>
  {% endif %}

  <div class="container-page">
    {% if page_title or subtitle_output or feed_icons or title_prefix or title_suffix %}
      <header class="flex flex-wrap items-center justify-between gap-3">
        <div>
          {{ title_prefix }}
          {% if page_title %}
            <h1 class="articles-page-heading font-bold text-primary-600 leading-tight max-sm:text-2xl">{{ page_title }}</h1>
          {% endif %}
          {{ title_suffix }}
          {% if subtitle_output %}
            <div class="text-md font-medium articles-page-intro">{{ subtitle_output|raw }}</div>
          {% endif %}
        </div>
        {% if feed_icons %}
          <div class="ml-auto">{{ feed_icons }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if exposed %}
      <section class="mt-6 bg-white rounded-xl border border-gray-200 p-4">
        {{ exposed }}
      </section>
    {% endif %}

    {% if rows %}
      <section class="mt-6 w-full">
        {{ rows }}
      </section>
    {% elseif empty %}
      {% set empty_markup = empty|render|trim %}
      {% set default_empty_message %}
        <div class="flex flex-col items-center gap-3">
          <span class="text-lg font-semibold text-gray-900">{{ 'No articles match your filters.'|t }}</span>
          <p class="max-w-xl text-sm text-gray-600">{{ 'Try adjusting the search keywords or clearing some of the filters to find what you are looking for.'|t }}</p>
        </div>
      {% endset %}
      <section class="mt-6 w-full">
        <div class="rounded-xl border border-dashed border-gray-300 bg-white p-10 text-center text-gray-600">
          {% if empty_markup %}
            {{ empty_markup }}
          {% else %}
            {{ default_empty_message }}
          {% endif %}
        </div>
      </section>
    {% endif %}

    {% if pager %}
      <nav class="mt-10 flex items-center justify-center gap-2" aria-label="{{ 'Pagination'|t }}">
        {{ pager }}
      </nav>
    {% endif %}

    {% if attachment_after %}
      <div class="mt-8">{{ attachment_after }}</div>
    {% endif %}

    {% if more %}
      <div class="mt-8 text-center">{{ more }}</div>
    {% endif %}

    {% if footer %}
      <footer class="mt-12 text-sm text-gray-600">{{ footer }}</footer>
    {% endif %}
  </div>
</div>
