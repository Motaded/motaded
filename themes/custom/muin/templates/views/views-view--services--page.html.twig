{#
  Template for the "services" view page display.
  Mirrors the reference layout in reference/html-src/services-page.html.
#}
{% set view_classes = [
  'services-page',
  'bg-gray-50',
  'pt-8',
  'pb-16'
] %}

{% set services = muin_services|default({}) %}
{% set default_title = 'Services'|t %}
{% set page_title = services.title ?? '' %}
{% if page_title == '' and view is defined %}
  {% set page_title = view.getTitle() %}
{% endif %}

{% if page_title is empty %}
  {% set page_title = default_title %}
{% elseif page_title|lower == 'services' %}
  {% set page_title = default_title %}
{% endif %}

{% set subtitle_output %}
  {% if services.subtitle %}
    {{ services.subtitle }}
  {% elseif header %}
    {{ header }}
  {% endif %}
{% endset %}
{% set subtitle_output = subtitle_output|trim %}

{% set breadcrumb_items = services.breadcrumb ?? [] %}
{% set home_title = 'Home'|t %}
{% set fallback_home_url = path('<front>') %}

{% if breadcrumb_items is empty %}
  {% set breadcrumb_items = [
    {
      'text': home_title,
      'url': fallback_home_url,
    },
    {
      'text': page_title,
      'url': NULL,
    },
  ] %}
{% endif %}

{% set normalized_breadcrumb = [] %}
{% for item in breadcrumb_items %}
  {% set text = item.text|default('') %}
  {% if text|lower == 'home' %}
    {% set text = home_title %}
  {% elseif text|lower == 'services' %}
    {% set text = page_title %}
  {% endif %}

  {% set url = item.url|default(null) %}
  {% if url is empty and text == home_title %}
    {% set url = fallback_home_url %}
  {% endif %}

  {% set normalized_breadcrumb = normalized_breadcrumb|merge([
    {
      'text': text,
      'url': url,
    },
  ]) %}
{% endfor %}
{% set breadcrumb_items = normalized_breadcrumb %}

{% set total_results = services.total_results ?? null %}
{% if total_results is null and view.result is defined %}
  {% set total_results = view.result|length %}
{% endif %}

<div{{ attributes.addClass(view_classes) }}>
  {% if breadcrumb_items %}
    <nav class="container-page text-sm text-gray-600" aria-label="{{ 'Breadcrumb'|t }}">
      <ol class="flex flex-wrap items-center gap-1 py-4">
        {% for item in breadcrumb_items %}
          <li class="flex items-center gap-1">
            {% if item.url %}
              <a href="{{ item.url }}" class="hover:underline">{{ item.text }}</a>
            {% else %}
              <span class="text-gray-900">{{ item.text }}</span>
            {% endif %}
            {% if not loop.last %}
              <span aria-hidden="true">/</span>
            {% endif %}
          </li>
        {% endfor %}
      </ol>
    </nav>
  {% endif %}

  <div class="container-page">
    {% if page_title or subtitle_output or feed_icons or title_prefix or title_suffix %}
      <header class="mt-4 flex flex-wrap items-start justify-between gap-6">
        <div class="flex max-w-3xl flex-col gap-3">
          {{ title_prefix }}
          {% if page_title %}
            <h1 class="text-3xl font-bold leading-tight text-primary-600 max-sm:text-2xl">{{ page_title }}</h1>
          {% endif %}
          {{ title_suffix }}
          {% if subtitle_output %}
            <div class="text-md font-medium leading-relaxed text-gray-800">{{ subtitle_output|raw }}</div>
          {% endif %}
        </div>
        {% if feed_icons %}
          <div class="ml-auto">{{ feed_icons }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if attachment_before %}
      <div class="mt-6">{{ attachment_before }}</div>
    {% endif %}

    <div class="mt-8 grid grid-cols-1 items-start gap-6 lg:grid-cols-12">
      <aside class="lg:col-span-4 xl:col-span-3">
        {% if exposed %}
          <div class="services-filters">{{ exposed }}</div>
        {% endif %}
      </aside>

      <section class="lg:col-span-8 xl:col-span-9">
        <div class="flex flex-wrap items-center justify-between gap-3">
          {% if total_results is not null %}
            <p class="text-sm text-gray-600">
              {{ format_plural(total_results, '1 result', '@count results') }}
            </p>
          {% endif %}
        </div>

        {% if rows %}
          <div class="mt-4">{{ rows }}</div>
        {% elseif empty %}
          {% set empty_markup = empty|render|trim %}
          {% set default_empty_message %}
            <div class="flex flex-col items-center gap-3 text-center">
              <span class="text-lg font-semibold text-gray-900">{{ 'No services match your filters.'|t }}</span>
              <p class="max-w-xl text-sm text-gray-600">{{ 'Try adjusting the search keywords or clearing some filters to discover more services.'|t }}</p>
            </div>
          {% endset %}
          <div class="mt-4 rounded-xl border border-dashed border-gray-300 bg-white p-10 text-gray-600">
            {% if empty_markup %}
              {{ empty_markup }}
            {% else %}
              {{ default_empty_message }}
            {% endif %}
          </div>
        {% endif %}

        {% if pager %}
          <nav class="mt-10 flex items-center justify-center gap-2" aria-label="{{ 'Pagination'|t }}">{{ pager }}</nav>
        {% endif %}

        {% if attachment_after %}
          <div class="mt-8">{{ attachment_after }}</div>
        {% endif %}

        {% if more %}
          <div class="mt-8 text-center">{{ more }}</div>
        {% endif %}

        {% if footer %}
          <footer class="mt-12 text-sm text-gray-600">{{ footer }}</footer>
        {% endif %}
      </section>
    </div>
  </div>
</div>
