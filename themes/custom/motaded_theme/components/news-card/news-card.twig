<a href="{{ view_link }}" class="block">
  <div
    class="bg-white rounded-xl p-4 h-full w-full border border-transparent hover:border-primary-600 shadow-sm transition"
  >
    <div class="flex justify-between gap-4 h-full">
      <div class="flex-1">
        <div class="flex flex-col justify-between h-full">
          <p class="text-md font-semibold leading-[1.6]">{{ title }}</p>
          <p class="text-sm text-gray-600 mt-3 leading-[1.6]">{{ date }}</p>
        </div>
      </div>
      <div class="flex-shrink-0 w-[151px] h-[120px]">
        <img
          alt="item.title"
          width="151"
          height="120"
          class="w-full h-full object-cover rounded-lg"
          src="{{ media_url }}"
        />
      </div>
    </div>
  </div>
</a>