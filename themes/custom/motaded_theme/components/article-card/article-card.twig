{% set card_title_text = title|render|striptags|trim %}
{% set card_img_alt = (image_alt ?? '')|trim %}
{% if card_img_alt is empty %}
  {% set card_img_alt = card_title_text %}
{% endif %}
{% if card_img_alt is empty %}
  {% set card_img_alt = 'Article image'|t %}
{% endif %}

{% if view_link %}
<a
  href="{{ view_link }}"
  class="block group"
  aria-label="{% if card_title_text %}{{ 'More about @title'|t({'@title': card_title_text }) }}{% else %}{{ 'Read more'|t }}{% endif %}"
>
{% else %}
<div class="block group">
{% endif %}
  <div
    class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm transition hover:shadow-md h-full flex flex-col"
  >
    <!-- image on top -->
    <div  class="relative w-full h-[180px] md:h-[200px] overflow-hidden">
      <img
        alt="{{ card_img_alt|e }}"
        class="w-full h-full object-cover group-hover:scale-[1.02] transition"
        src="{{ media_url }}"
        loading="lazy"
        decoding="async"
      />
    </div>
    <!-- content -->
    <div class="p-4 flex flex-col flex-1">
      {% if tag %}
        <div class="flex flex-wrap gap-2 mb-3">
          <span class="border px-2 py-0.5 rounded text-xs font-medium bg-gray-50 text-gray-700 border-gray-200">
            {{ tag }}
          </span>
        </div>
      {% endif %}
      <h3 class="font-bold text-lg text-gray-900 group-hover:text-primary-600 transition">{{ title }}</h3>
      <p class="mt-2 text-sm text-gray-600 flex-1 mb-0">{{ excerpt }}</p>
        {% if tag %}
          <div class="mt-auto flex items-center justify-between pt-2">
              <p class="mt-4 mb-0 text-xs text-gray-500">{{ date }}</p>
              <span class="mt-4 inline-block text-sm font-medium text-primary-600 group-hover:underline">{{ "Read More →"|t }}</span>
          </div>
        {% elseif view_link %}
          <span class="mt-4 inline-block text-sm font-medium text-primary-600 group-hover:underline">{{ "Read More →"|t }}</span>
        {% endif %}
    </div>
  </div>
{% if view_link %}
</a>
{% else %}
</div>
{% endif %}