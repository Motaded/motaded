<a
  href="{{ view_link }}"
  class="block group"
  aria-label="Read article"
>
  <div
    class="bg-white rounded-xl border border-transparent hover:border-primary-600 shadow-sm transition h-full flex flex-col overflow-hidden"
  >
    <!-- image on top -->
    <div  class="relative w-full h-[180px] md:h-[200px] overflow-hidden">
      <img
        alt="{{ title }}"
        class="w-full h-full object-cover group-hover:scale-[1.02] transition"
        src="{{ media_url }}"
      />
    </div>
    <!-- content -->
    <div class="p-4 flex flex-col gap-3 flex-1">
      <div class="flex flex-wrap gap-2">
        <span class="border px-2 py-0.5 rounded text-xs font-medium bg-gray-50 text-gray-700 border-gray-200">
          {{ tag }}
        </span>
      </div>
      <p class="text-md font-semibold leading-[1.5] line-clamp-2">{{ title }}</p>
      <p class="text-sm text-gray-600 leading-[1.6] line-clamp-3">{{ excerpt }}</p>
      <div class="mt-auto flex items-center justify-between pt-2">
        <p class="text-xs text-gray-500">{{ date }}</p>
        <span class="text-sm font-medium text-primary-700 group-hover:underline">{{ link_title }}</span
        >
      </div>
    </div>
  </div>
</a>