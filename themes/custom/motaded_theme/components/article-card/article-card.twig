{% set card_title_text = title|render|striptags|trim %}
{% set service_type_text = service_type|default('')|render|striptags|trim %}
{% set card_img_alt = (image_alt ?? '')|trim %}
{% if card_img_alt is empty %}
  {% set card_img_alt = card_title_text %}
{% endif %}
{% if card_img_alt is empty %}
  {% set card_img_alt = 'Article image'|t %}
{% endif %}

{% if view_link %}
<a
  href="{{ view_link }}"
  class="article-card article-card--link group block h-full pt-3{{ service_type_text ? ' article-card--has-service-type' : '' }}"
  aria-label="{% if card_title_text %}{{ 'More about @title'|t({'@title': card_title_text }) }}{% else %}{{ 'Read more'|t }}{% endif %}"
>
{% else %}
<div class="article-card article-card--static group block h-full{{ service_type_text ? ' article-card--has-service-type' : '' }}">
{% endif %}
  <article class="article-card__inner h-full overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition duration-200">
    <div class="article-card__media relative h-[180px] w-full overflow-hidden md:h-[200px]">
      <img
        alt="{{ card_img_alt|e }}"
        class="article-card__image h-full w-full object-cover transition duration-300"
        src="{{ media_url }}"
        {% if media_srcset|default('') %}
        srcset="{{ media_srcset }}"
        sizes="{{ media_sizes|default('(max-width: 767px) 100vw, (min-width: 768px) and (max-width: 1023px) 50vw, 25vw') }}"
        {% endif %}
        width="{{ media_width|default(650) }}"
        height="{{ media_height|default(650) }}"
        loading="lazy"
        decoding="async"
      />
      {% if service_type_text %}
        <span class="article-card__tag article-card__tag--media article-card__tag--service">
          {{ service_type }}
        </span>
      {% endif %}
      <span class="article-card__media-glow" aria-hidden="true"></span>
    </div>

    <div class="article-card__content flex flex-1 flex-col p-4">
      {% if date %}
        <div class="article-card__meta-row mb-2 flex justify-end">
          <span class="article-card__date">
            {{ date }}
          </span>
        </div>
      {% endif %}

      <div class="article-card__title-row mb-3 flex min-w-0 items-center gap-2">
        {% set card_tag = tag|default('')|trim %}
        {% if card_tag and not service_type_text %}
          <span class="article-card__tag shrink-0">
            {{ card_tag }}
          </span>
        {% endif %}
        <h3 class="article-card__title m-0 min-w-0 flex-1 text-lg font-bold leading-snug text-gray-900 transition">
          {{ title }}
        </h3>
      </div>

      {% if excerpt %}
        <p class="article-card__excerpt mb-4 mt-0 flex-1 text-sm leading-6 text-gray-600">
          {{ excerpt }}
        </p>
      {% endif %}

      {% if view_link %}
        <div class="article-card__cta-row mt-4 flex items-center justify-between border-t border-gray-100 pt-3">
          <span class="article-card__cta text-sm font-semibold text-primary-600">
            {{ 'Read more'|t }}
          </span>
          <span class="article-card__cta-icon text-primary-600" aria-hidden="true">
            &#8594;
          </span>
        </div>
      {% endif %}
    </div>
  </article>
{% if view_link %}
</a>
{% else %}
</div>
{% endif %}