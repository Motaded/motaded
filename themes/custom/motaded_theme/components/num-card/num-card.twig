<article class="icon-card flex flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-6">
  <div class="flex items-center gap-3">
    <span
      class="icon-wrapper flex h-10 w-10 items-center justify-center rounded-full bg-emerald-50 text-base font-semibold text-green-700"
      >{{ number }}</span
    >
    {% if title %}
      <h3 class="text-base font-semibold leading-6 text-neutral-900">
        {{ title }}
      </h3>
    {% endif %}
  </div>
  <p class="text-sm leading-5 text-gray-700">{{ desc }}</p>
</article>