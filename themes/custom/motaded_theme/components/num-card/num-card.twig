<article class="num-card">
  <div class="num-card__inner">
    <span class="num-card__badge icon-wrapper" aria-hidden="true">{{ number }}</span>
    <div class="num-card__main">
      {% if title %}
        <h3 class="num-card__title">{{ title }}</h3>
      {% endif %}
      <div class="num-card__desc">{{ desc }}</div>
    </div>
  </div>
</article>
