<article class="flex gap-4 rounded-2xl border border-gray-200 bg-white p-6 {{ icon_position == 'topLeft' ? 'flex-col' : '' }}">
  {% if icon_url %}
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-50">
      <img
        src="{{ icon_url }}"
        alt="{{ title }}"
        class="h-6 w-6"
      />
    </div>
  {% endif %}
  <div class="flex flex-col gap-2">
    {% if title %}
      <h3 class="text-lg font-semibold leading-7 text-neutral-900">
        {{ title }}
      </h3>
    {% endif %}
    <p class="{{ title ? 'text-sm leading-5 text-gray-700' : 'text-base leading-6 text-neutral-900' }}">{{ desc }}</p>
  </div>
</article>