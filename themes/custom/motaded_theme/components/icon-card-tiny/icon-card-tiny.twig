<article class="icon-card flex gap-4 rounded-2xl border border-gray-200 bg-white p-6 {{ icon_position == 'topLeft' ? 'flex-col' : '' }}">
    <div class="icon-wrapper flex h-12 {{ icon_position == 'topLeft' ? 'w-12' : 'w-[12px]' }} items-center justify-center rounded-full bg-emerald-50">
      <img
        src="{{ icon_url ? icon_url : '/themes/custom/motaded_theme/img/icon-target.svg' }}"
        alt="{{ title }}"
        class="{{ icon_position == 'topLeft' ? 'h-6' : '' }} w-6"
      />
    </div>
  <div class="flex flex-col flex-1 gap-2">
    {% if title %}
      <h3 class="text-lg font-semibold leading-7 text-neutral-900">
        {{ title }}
      </h3>
    {% endif %}
    <p class="{{ title ? 'text-sm leading-5 text-gray-700' : 'text-base leading-6 text-neutral-900' }}">{{ desc }}</p>

    {% if tags  %}
      <div class="flex flex-wrap gap-2 mb-4">
      {% for tag in tags %}
        {% if tag %}
          <span
            class="border px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-700 border-gray-200"
          >{{ tag }}</span>
        {% endif %}
      {% endfor %}
      </div>
    {% endif %}
    {% if cta1 or cta2  %}
      <div class="mt-auto flex gap-2">
        {% if cta1 %}
          <a
            href="{{ cta1.url }}"
            class="px-4 py-2 rounded-md border border-gray-300 text-sm text-gray-700 hover:bg-gray-100"
          >
            {{ cta1.title }}
          </a>
        {% endif %}
        {% if cta2 %}
          <a
            href="{{ cta2.url }}"
            class="px-4 py-2 rounded-md bg-primary-600 text-white text-sm hover:bg-primary-700"
          >
            {{ cta2.title }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</article>