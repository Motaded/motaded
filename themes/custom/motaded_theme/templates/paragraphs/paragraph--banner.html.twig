{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
  <div{{attributes.addClass(classes)}}>
    {% block content %}
    {% set banner_type = content.field_banner_type['#items'].0.value ?? '' %}
    {% if banner_type == "banner_style_1" %}
      <section
        class="relative isolate banner-hero-fullbleed">
        <div class="banner-hero-fullbleed__bg absolute inset-0 z-0 bg-gray-200 md:bg-transparent">
          {% if paragraph.field_media.entity %}
            <div class="banner-hero-fullbleed__media">
              {{ drupal_entity('media', paragraph.field_media.entity.id, 'hero_banner') }}
            </div>
          {% endif %}
          <!-- dark-to-transparent gradient for legibility -->
          <div class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-b from-black/50 via-black/40 to-black/20"></div>
        </div>

        <!-- Hero copy -->
        <div class="relative z-10">
          <div class="mx-auto max-w-[72rem] px-4 pt-20 pb-12 sm:pt-24 sm:pb-16 lg:pt-28">
            <div class="mx-auto text-center max-w-[46rem]">

              {% if content.field_title.0 is not empty %}
                <h1 class="text-white/95 font-semibold leading-tight [font-size:clamp(1.75rem,3vw,2.5rem)]">
                  {{ content.field_title.0 }}
                </h1>
              {% endif %}
              {% if content.field_body.0 is not empty %}
                <div class="mt-4 text-white/90 leading-relaxed [font-size:clamp(0.95rem,1.5vw,1.125rem)]">
                  {{ content.field_body.0 }}
                </div>
              {% endif %}


              <!-- CTAs -->
              {% if content.field_links %}
                <div class="mt-6 flex flex-wrap items-center justify-center gap-3">

                  {% for key, item in paragraph.field_links %}
                    {% set link = content.field_links[key]['#url'] %}
                    {% set title = content.field_links[key]['#title'] %}
                    {% if loop.last %}
                      <a href="{{ link }}" class="inline-flex items-center gap-2 rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur hover:bg-white/15 hover:shadow-sm hover:-translate-y-[1px] active:translate-y-0 transition will-change-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80" aria-label="{{ title }}">
                        {{ title }}
                        <img alt="" width="18" height="18" class="-rotate-90 rtl:rotate-90" src="/themes/custom/motaded_theme/img/icon-arrow-down.svg"/>
                      </a>
                    {% else %}
                      <a href="{{ link }}" class="inline-flex items-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-semibold text-primary-600 shadow-sm hover:shadow-md hover:-translate-y-[1px] active:translate-y-0 transition will-change-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/80" aria-label="{{ title }}">
                        {{ title }}
                        <img alt="" width="18" height="18" class="-rotate-90 rtl:rotate-90" src="/themes/custom/motaded_theme/img/icon-arrow-down.svg"/>
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}


              <!-- subtle scroll cue (hidden on users who prefer no motion) -->
              <div class="mt-8 hidden sm:flex items-center justify-center motion-safe:animate-bounce">
                <span class="sr-only">Scroll</span>
                <img alt="" width="22" height="22" src="/themes/custom/motaded_theme/img/icon-scroll.svg" class="opacity-50 invert-[1.2]"/>
              </div>
            </div>
          </div>
        </div>

        <!-- 3 key reasons -->
        <div class="relative z-10">
          <div class="mx-auto max-w-[82.5rem] px-4 translate-y-12 sm:translate-y-16">
            <div
              class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
              <!-- Card -->
              {{ content.field_paragraphs }}
            </div>
          </div>

          <!-- spacer to offset translated cards -->
          <div class="h-24 sm:h-28"></div>
        </div>
      </section>
    {% elseif banner_type == "banner_style_3" %}
      {% include "@motaded_theme/paragraphs/hero--packages.html.twig" %}
    {% else %}

      <header class="max-w-[1320px] mx-auto px-4 mt-6">
        <div
          class="relative overflow-hidden rounded-2xl border border-gray-200 bg-white"
        >
          <div class="grid md:grid-cols-2">
            <div class="p-8 md:p-12">
              {% if content.field_title.0 is not empty %}
              <h1
                class="text-3xl md:text-5xl font-extrabold leading-tight text-[#0F2A1D]"
              >
                  {{ content.field_title.0  }}
              </h1>
              {% endif %}
              {% if content.field_body.0 is not empty %}
              <p class="mt-4 text-lg text-gray-800">
               {{ content.field_body.0 }}
              </p>
              {% endif %}

              {% if content.field_links %}
              <div class="mt-6 flex flex-wrap gap-3">
                {% for key, item in paragraph.field_links %}
                {% set link = content.field_links[key]['#url'] %}
                {% set title = content.field_links[key]['#title'] %}
                {% if loop.last %}
                  <a
                  href="{{link}}"
                  class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-5 py-3 text-sm font-semibold hover:bg-gray-50"
                  >{{ title }}</a
                >
                {% else %}
                <a
                  href="{{link}}"
                  class="inline-flex items-center gap-2 rounded-md bg-primary-600 text-white px-5 py-3 text-sm font-semibold hover:bg-primary-700"
                  >{{title}}</a
                >
                {% endif %}
                {% endfor %}
              </div>
              {% endif %}

              <!-- Value badges -->
              <dl class="mt-8 grid grid-cols-2 gap-4 text-sm">
              {% for key, item in content.field_paragraphs %}
              {% set para = item['#paragraph'] %}
                {% if para is not empty %}
               <div class="rounded-xl border border-green-200 bg-green-50 p-4">
                  <dt class="font-semibold text-green-900">{{ para.field_title.value }}</dt>
                  <dd class="mt-1 text-green-800">
                    {{ para.field_body.value|raw }}
                  </dd>
                </div>
                {% endif %}
              {% endfor %}

              </dl>
            </div>
            <div class="relative">
              <img
                src="{{file_url(content.field_media.0['#media'].field_media_image.entity.uri.value)}}"
                alt="Riyadh skyline at dusk"
                class="h-full w-full object-cover"
                loading="lazy"
              />
              <div
                class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"
              ></div>
            </div>
          </div>
        </div>
      </header>

     {% endif %}
    {% endblock %}

    {# Quick links #}
    {% if content.field_show_quick_links['#items'].0.value == 1%}
      {{ attach_library('motaded_theme/quick-links') }}

      <section class="max-w-[1320px] layout-container mx-auto px-4 mt-6" x-data="quickLinks()" x-init="init()">
        <div class="flex flex-wrap gap-2 border-b border-gray-200 pb-4">
          {# <a href="#why-now" class="chip">Why Now</a> #}
          <template x-for="item in links" :key="item.id">
            <a
              :href="`#${item.id}`"
              @click.prevent="scrollTo(item.id)"
              class="inline-flex items-center rounded-full border border-gray-300 px-3 py-1.5 text-sm bg-white hover:bg-gray-50"
              x-text="item.label"
            ></a>
        </template>
        </div>
      </section>
    {% endif %}
  
  </div>
{% endblock paragraph %}
