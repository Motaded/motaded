{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %}
<section class="hero-two-cols relative isolate bg-gradient-to-br from-[#e4f4ef] via-white to-[#f2f8ff]">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      class="absolute left-1/2 top-16 h-40 w-40 -translate-x-1/2 rounded-full bg-primary-100 blur-3xl opacity-70"
    ></div>
    <div
      class="absolute right-12 bottom-0 h-48 w-48 rounded-full bg-secondary-100 blur-3xl opacity-70"
    ></div>
  </div>
  <div
    class="relative mx-auto flex max-w-[82rem]  flex-col gap-10 px-4 py-16 lg:flex-row lg:items-center lg:py-20"
  >
    <div class="space-y-6 lg:w-1/2">
      {% if content.field_sub_title.0 is not empty %}
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-600">
          {{ content.field_sub_title.0 }}
        </p>
      {% endif %}
      {% if content.field_title.0 is not empty %}
        <h1 class="text-3xl font-extrabold text-gray-900 lg:text-4xl pt-0 leading-[1.2]">
          {{ content.field_title.0 }}
        </h1>
      {% endif %}
      {% if content.field_body.0 is not empty %}
        <div class="text-lg leading-relaxed text-gray-700">
          {{ content.field_body.0['#text']|raw }}
        </div>
      {% endif %}
              <!-- CTAs -->
      {% if content.field_links %}
        <div class="flex flex-wrap gap-3">

          {% for key, item in paragraph.field_links %}
            {% set link = content.field_links[key]['#url'] %}
            {% set title = content.field_links[key]['#title'] %}
            {% if loop.last %}
              <a
                href="{{ link }}"
                class="inline-flex items-center gap-2 rounded-full border border-gray-300 bg-white px-5 py-2.5 text-sm font-semibold text-gray-900 shadow-sm transition hover:border-primary-400"
              >
                {{ title }}
              </a>
            {% else %}
              <a
                href="{{ link }}"
                class="inline-flex items-center gap-2 rounded-full bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-700"
              >
                {{ title }}
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="h-4 w-4"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"
                  />
                </svg>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <dl class="grid grid-cols-2 gap-6 text-sm text-gray-600">
        <div>
          {% if content.field_info[0] is not empty %}
            {{ content.field_info[0]['#text']|raw }}
          {% endif %}
        </div>
        <div>
          {% if content.field_info[1] is not empty %}
            {{ content.field_info[1]['#text']|raw }}
          {% endif %}
        </div>
      </dl>
    </div>
    <div class="relative lg:w-1/2 rounded-3xl border border-white/60 bg-white/80 p-6 shadow-2xl backdrop-blur">
      {{ content.field_cards }}
    </div>
  </div>
</section>
{% endblock paragraph %}
