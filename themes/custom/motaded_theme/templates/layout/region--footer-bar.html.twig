{#
  Footer bar region: Bottom bar (left) + Social links (right).
#}
{%
  set classes = [
    'region',
    'region-' ~ region|clean_class,
    'w-full',
    'flex',
    'flex-wrap',
    'justify-between',
    'items-center',
    'gap-5',
    'mt-16',
    'mb-5',
    'text-white',
  ]
%}
{% if content %}
  <div{{ attributes.addClass(classes) }}>
    {{ content }}
  </div>
{% endif %}
