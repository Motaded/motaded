{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{% if breadcrumb %}
  <nav class="text-sm text-gray-600 max-w-[1320px] px-4 mx-auto pt-8" role="navigation" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    <ol class="flex flex-wrap items-center gap-1">
    {% for item in breadcrumb %}
        {% if item.url and not loop.last %}
          <li class="after:content-['/'] after:mx-1">
            <a href="{{ item.url }}" class="hover:underline">{{ item.text }}</a>
          </li>
        {% else %}
          <li class="text-gray-900 font-medium">
            {{ item.text }}
          </li>
        {% endif %}
    {% endfor %}
    </ol>
  </nav>
{% endif %}
