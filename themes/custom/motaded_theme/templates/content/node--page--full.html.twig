{#
/**
 * @file
 * Theme override to display a node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - node.getCreatedTime() will return the node creation timestamp.
 *   - node.hasField('field_example') returns TRUE if the node bundle includes
 *     field_example. (This does not indicate the presence of a value in this
 *     field.)
 *   - node.isPublished() will return whether the node is published or not.
 *   Calling other methods, such as node.delete(), will result in an exception.
 *   See \Drupal\node\Entity\Node for a full list of public properties and
 *   methods for the node object.
 * - label: (optional) The title of the node.
 * - content: All node items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - author_picture: The node author user entity, rendered using the "compact"
 *   view mode.
 * - date: (optional) Themed creation date field.
 * - author_name: (optional) Themed author name field.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - node: The current template type (also known as a "theming hook").
 *   - node--type-[type]: The current node type. For example, if the node is an
 *     "Article" it would result in "node--type-article". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - node--view-mode-[view_mode]: The View Mode of the node; for example, a
 *     teaser would result in: "node--view-mode-teaser", and
 *     full: "node--view-mode-full".
 *   The following are controlled through the node publishing options.
 *   - node--promoted: Appears on nodes promoted to the front page.
 *   - node--sticky: Appears on nodes ordered above other non-sticky nodes in
 *     teaser listings.
 *   - node--unpublished: Appears on unpublished nodes visible only to site
 *     admins.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - content_attributes: Same as attributes, except applied to the main
 *   content tag that appears in the template.
 * - author_attributes: Same as attributes, except applied to the author of
 *   the node tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - teaser: Flag for the teaser state. Will be true if view_mode is 'teaser'.
 * - page: Flag for the full page state. Will be true if view_mode is 'full'.
 *
 * @see template_preprocess_node()
 *
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'node--service-page',
  ]
%}

{{ attach_library('motaded_theme/node') }}
{% if node.field_display_on_services.value == "1" %}
  <article{{ attributes.addClass(classes) }}>
    {{ title_prefix }}
    {% set tag_styles_hero = [
      {'bg': 'bg-green-50', 'border': 'border-green-200', 'text': 'text-green-800'},
      {'bg': 'bg-blue-50', 'border': 'border-blue-200', 'text': 'text-blue-800'},
    ] %}
    <header class="service-hero service-hero--fullbleed border-t-[6px] border-green-700 lg:border-t-8">
      <div class="mx-auto w-full max-w-[1320px] px-4 py-8 sm:px-6 sm:py-10 lg:px-4">
        <div class="service-hero__inner flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-10">
        <div class="service-hero__primary min-w-0 flex-1 basis-0 flex flex-col gap-4">
          <h1 class="service-hero__title font-bold leading-tight text-green-800 !pt-0 !mb-0">
            {{ label }}
          </h1>

          {% if (content.field_taxonomy['#items'] is defined and content.field_taxonomy['#items'] is not empty) or (content.field_tags['#items'] is defined and content.field_tags['#items'] is not empty) %}
            <div class="flex flex-wrap gap-2 items-center" role="list">
              {% if content.field_taxonomy['#items'] is defined %}
                {% for i in content.field_taxonomy['#items']|keys %}
                  <span class="inline-flex items-center rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-800 [&_a]:text-blue-800 [&_a]:no-underline hover:[&_a]:underline" role="listitem">
                    {{ content.field_taxonomy[i] }}
                  </span>
                {% endfor %}
              {% endif %}
              {% if content.field_tags['#items'] is defined %}
                {% for i in content.field_tags['#items']|keys %}
                  {% set s = tag_styles_hero[loop.index0 % 2] %}
                  <span class="inline-flex items-center rounded-full border px-3 py-1 text-xs font-semibold {{ s.bg }} {{ s.border }} {{ s.text }}" role="listitem">
                    {% set _tag_txt = content.field_tags[i]['#plain_text']|default('') %}
                    {{ _tag_txt is not empty ? _tag_txt : (content.field_tags[i]|render|striptags|trim) }}
                  </span>
                {% endfor %}
              {% endif %}
            </div>
          {% endif %}

          {% if service_hero_intro %}
            <div class="max-w-3xl text-base leading-relaxed text-neutral-900">
              {{ service_hero_intro }}
            </div>
          {% endif %}

          {% if content.field_free_consultation %}
            <div class="field field--name-field-free-consultation [&_a]:inline-flex [&_a]:items-center [&_a]:gap-1.5 [&_a]:text-base [&_a]:font-semibold [&_a]:text-green-700 [&_a]:no-underline hover:[&_a]:underline">
              {{ content.field_free_consultation }}
            </div>
          {% endif %}

          <div class="flex flex-wrap items-center gap-2 pt-1 sm:gap-2.5">
            <a href="{{ service_contact_url }}" class="service-hero__cta service-hero__cta--primary inline-flex max-md:w-full max-md:justify-center cursor-pointer items-center justify-center rounded-lg bg-green-700 px-4 py-2 text-sm font-semibold leading-5 text-white no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700">
              {{ 'Start the service'|t }}
            </a>
            <a href="{{ service_other_services_url }}" class="service-hero__cta service-hero__cta--secondary inline-flex max-md:w-full max-md:justify-center items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold leading-5 text-neutral-900 no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400">
              {{ 'Go to other services'|t }}
            </a>
          </div>

        </div>

        {% if content.addtoany %}
          <aside class="service-hero__share-card shrink-0 rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-md" aria-label="{{ 'Share the page'|t }}">
            <p class="mb-3 text-center text-sm font-semibold text-green-700">
              {{ 'Share the page'|t }}
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2">
              {{ content.addtoany }}
            </div>
          </aside>
        {% endif %}
        </div>
      </div>
    </header>
    {{ title_suffix }}

    {% set _svc_right = service_show_right_column|default(false) %}
    <div class="mx-auto w-full max-w-[1320px] gap-8 px-4 pb-10 pt-10{{ _svc_right ? ' service-page__layout-grid' : ' flex flex-col gap-8' }}">
      {% if _svc_right %}
      <div class="service-page__main-col service-page__main-col--upper min-w-0 flex flex-col">
      {% else %}
      <div class="service-page__main-col min-w-0 flex flex-col">
      {% endif %}

    {% set _nav_body = not node.get('body').isEmpty() %}
    {% set _nav_snapshot = content.field_top_overview_section['#items'] is not empty %}
    {% set _nav_objectives = content.field_objectives['#items'] is not empty %}
    {% set _nav_work_tracks = content.field_work_tracks['#items'] is not empty %}
    {% set _nav_steps = content.field_steps_to_obtain['#items'] is not empty %}
    {% set _nav_areas = content.field_areas_of_work['#items'] is not empty %}
    {% set _nav_extra = content.field_basic_paragraphs['#items'] is defined and content.field_basic_paragraphs['#items'] is not empty %}
    {% set _nav_faqs = content.field_keywords['#items'] is not empty %}
    {% if _nav_body or _nav_snapshot or _nav_objectives or _nav_work_tracks or _nav_steps or _nav_areas or _nav_extra or _nav_faqs %}
      <nav class="service-page__section-tabs" aria-label="{{ 'On this page'|t }}">
        {% if _nav_body %}
          <a href="#service-details" class="service-page__section-tab">{{ 'Details'|t }}</a>
        {% endif %}
        {% if _nav_snapshot %}
          <a href="#service-snapshot" class="service-page__section-tab">{{ 'Snapshot'|t }}</a>
        {% endif %}
        {% if _nav_objectives %}
          <a href="#service-objectives" class="service-page__section-tab">{{ 'Objectives'|t }}</a>
        {% endif %}
        {% if _nav_work_tracks %}
          <a href="#service-work-tracks" class="service-page__section-tab">{{ 'Work Tracks'|t }}</a>
        {% endif %}
        {% if _nav_steps %}
          <a href="#service-steps-to-obtain" class="service-page__section-tab">{{ 'Steps to Obtain'|t }}</a>
        {% endif %}
        {% if _nav_areas %}
          <a href="#service-areas-of-work" class="service-page__section-tab">{{ 'Areas of Work'|t }}</a>
        {% endif %}
        {% if _nav_extra %}
          <a href="#service-extra-data" class="service-page__section-tab">{{ 'Extra data'|t }}</a>
        {% endif %}
        {% if _nav_faqs %}
          <a href="#faqs" class="service-page__section-tab">{{ 'FAQs'|t }}</a>
        {% endif %}
      </nav>
    {% endif %}

    <!-- Full description (body below compact hero) -->
    <section id="service-details" class="scroll-mt-28 flex flex-col items-start gap-4 self-stretch rounded-2xl border border-gray-200 bg-white p-8" aria-labelledby="service-heading-details">
      <div class="service-page__section-head">
        <h2 id="service-heading-details" class="service-page__section-head-badge service-page__section-head-badge--details">
          {{ 'Service details'|t }}
        </h2>
        <span class="service-page__section-head-rule" aria-hidden="true"></span>
      </div>
      {% if service_body_use_readmore|default(false) %}
        <div class="service-page__body-collapsible" data-drupal-selector="service-body-readmore">
          <div id="service-details-body" class="service-page__body service-page__body--truncatable text-base leading-6 text-neutral-900 [&_a]:text-green-700">
            {{ content.body }}
          </div>
          <button
            type="button"
            class="service-page__body-readmore-btn mt-4 inline-flex cursor-pointer items-center justify-center rounded-lg border border-green-700 bg-white px-4 py-2 text-sm font-semibold leading-5 text-green-700 no-underline transition-colors hover:bg-green-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-700"
            aria-expanded="false"
            aria-controls="service-details-body"
            data-label-expand="{{ 'Read more'|t }}"
            data-label-collapse="{{ 'Read less'|t }}"
          >
            {{ 'Read more'|t }}
          </button>
        </div>
      {% else %}
        <div id="service-details-body" class="service-page__body text-base leading-6 text-neutral-900 [&_a]:text-green-700">
          {{ content.body }}
        </div>
      {% endif %}
    </section>

    <!-- Service Snapshot -->
    {% if content.field_top_overview_section['#items'] is not empty %}
      <section id="service-snapshot" class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch" aria-labelledby="service-heading-snapshot">
        <div class="service-page__section-head">
          <h2 id="service-heading-snapshot" class="service-page__section-head-badge service-page__section-head-badge--snapshot">
            {{ content.field_top_overview_section['#title'] }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="service-snapshot-grid colored-icons">
          {% for i in content.field_top_overview_section['#items']|keys %}
            {{ content.field_top_overview_section[i] }}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Objectives -->
    {% if content.field_objectives['#items'] is not empty %}
      <section id="service-objectives" class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch" aria-labelledby="service-heading-objectives">
        <div class="service-page__section-head">
          <h2 id="service-heading-objectives" class="service-page__section-head-badge service-page__section-head-badge--objectives">
            {{ content.field_objectives['#title'] }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="service-objectives-grid colored-icons">
          {% for i in content.field_objectives['#items']|keys %}
            {{ content.field_objectives[i] }}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Work Tracks -->
    {% if content.field_work_tracks['#items'] is not empty %}
      <section id="service-work-tracks" class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch" aria-labelledby="service-heading-work-tracks">
        <div class="service-page__section-head">
          <h2 id="service-heading-work-tracks" class="service-page__section-head-badge service-page__section-head-badge--snapshot">
            {{ content.field_work_tracks['#title'] }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="service-work-tracks-grid colored-icons">
          {% for i in content.field_work_tracks['#items']|keys %}
            {{ content.field_work_tracks[i] }}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Advantages -->
    {% if content.field_advantages['#items'] is not empty %}
      <section class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch" aria-labelledby="service-heading-advantages">
        <div class="service-page__section-head">
          <h2 id="service-heading-advantages" class="service-page__section-head-badge service-page__section-head-badge--objectives">
            {{ content.field_advantages['#title'] }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="service-advantages-grid colored-icons">
          {% for i in content.field_advantages['#items']|keys %}
            {{ content.field_advantages[i] }}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Steps to Obtain -->
    {% if content.field_steps_to_obtain['#items'] is not empty %}
      <section id="service-steps-to-obtain" class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch" aria-labelledby="service-heading-steps">
        <div class="service-page__section-head">
          <h2 id="service-heading-steps" class="service-page__section-head-badge service-page__section-head-badge--objectives">
            {{ content.field_steps_to_obtain['#title'] }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="service-steps-grid grid w-full grid-cols-1 gap-5 colored-icons">
          {% for i in content.field_steps_to_obtain['#items']|keys %}
            {{ content.field_steps_to_obtain[i] }}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- Areas of Work -->
    {% if content.field_areas_of_work['#items'] is not empty %}
      <section id="service-areas-of-work" class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch" aria-labelledby="service-heading-areas">
        <div class="service-page__section-head">
          <h2 id="service-heading-areas" class="service-page__section-head-badge service-page__section-head-badge--snapshot">
            {{ content.field_areas_of_work['#title'] }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="service-areas-grid colored-icons">
          {% for i in content.field_areas_of_work['#items']|keys %}
            {{ content.field_areas_of_work[i] }}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if _svc_right %}
      </div>
      <aside class="service-page__sidebar flex w-full flex-col gap-6 self-stretch rounded-2xl border border-gray-300 bg-white p-6 sm:p-8" role="complementary">
        {% if service_sidebar_second is not empty %}
          <div class="service-page__sidebar-blocks flex flex-col gap-4">
            {{ service_sidebar_second }}
          </div>
        {% endif %}
      </aside>
      <div class="service-page__main-col service-page__main-col--lower min-w-0 flex flex-col">
    {% endif %}

    {% if content.field_basic_paragraphs['#items'] is defined and content.field_basic_paragraphs['#items'] is not empty %}
      <section id="service-extra-data" class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch" aria-labelledby="service-heading-extra-data">
        <div class="service-page__section-head">
          <h2 id="service-heading-extra-data" class="service-page__section-head-badge service-page__section-head-badge--snapshot">
            {{ 'Extra data'|t }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="service-extra-cards-grid w-full min-w-0">
          {% for i in content.field_basic_paragraphs['#items']|keys %}
            {{ content.field_basic_paragraphs[i] }}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <!-- FAQs -->
    {% if content.field_keywords['#items'] is not empty %}
      <section id="faqs" class="scroll-mt-28 mt-10 flex flex-col items-start gap-4 self-stretch faqs" aria-labelledby="service-heading-faqs">
        <div class="service-page__section-head">
          <h2 id="service-heading-faqs" class="service-page__section-head-badge service-page__section-head-badge--objectives">
            {{ content.field_keywords['#title'] }}
          </h2>
          <span class="service-page__section-head-rule" aria-hidden="true"></span>
        </div>
        <div class="flex w-full min-w-0 flex-col gap-4 self-stretch">
          {{ content.field_keywords }}
        </div>
      </section>
    {% endif %}

    {# <div{{ content_attributes.addClass('node__content') }}>
      {{ content|without('body', 'field_top_overview_section', 'field_objectives', 'field_work_tracks', 'field_steps_to_obtain', 'field_areas_of_work', 'field_keywords', 'field_basic_paragraphs', 'field_comments') }}
    </div> #}

      </div>
    </div>

  </article>
{% else %}
  {% include "node--news--full.html.twig" %}
{% endif %}
