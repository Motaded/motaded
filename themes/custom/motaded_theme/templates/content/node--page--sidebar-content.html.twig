{#
/**
 * @file
 * Theme override to display a node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - node.getCreatedTime() will return the node creation timestamp.
 *   - node.hasField('field_example') returns TRUE if the node bundle includes
 *     field_example. (This does not indicate the presence of a value in this
 *     field.)
 *   - node.isPublished() will return whether the node is published or not.
 *   Calling other methods, such as node.delete(), will result in an exception.
 *   See \Drupal\node\Entity\Node for a full list of public properties and
 *   methods for the node object.
 * - label: (optional) The title of the node.
 * - content: All node items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - author_picture: The node author user entity, rendered using the "compact"
 *   view mode.
 * - date: (optional) Themed creation date field.
 * - author_name: (optional) Themed author name field.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - node: The current template type (also known as a "theming hook").
 *   - node--type-[type]: The current node type. For example, if the node is an
 *     "Article" it would result in "node--type-article". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - node--view-mode-[view_mode]: The View Mode of the node; for example, a
 *     teaser would result in: "node--view-mode-teaser", and
 *     full: "node--view-mode-full".
 *   The following are controlled through the node publishing options.
 *   - node--promoted: Appears on nodes promoted to the front page.
 *   - node--sticky: Appears on nodes ordered above other non-sticky nodes in
 *     teaser listings.
 *   - node--unpublished: Appears on unpublished nodes visible only to site
 *     admins.
 * - title_attributes: Same as attributes, except applied to the main title
 *   tag that appears in the template.
 * - content_attributes: Same as attributes, except applied to the main
 *   content tag that appears in the template.
 * - author_attributes: Same as attributes, except applied to the author of
 *   the node tag that appears in the template.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - teaser: Flag for the teaser state. Will be true if view_mode is 'teaser'.
 * - page: Flag for the full page state. Will be true if view_mode is 'full'.
 *
 * @see template_preprocess_node()
 *
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'flex relative flex-col gap-6',
  ]
%}
{{ attach_library('motaded_theme/node') }}
<article{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {{ title_suffix }}

  {% set divider = false %}
  <!-- Service Information -->
  <section class="flex relative flex-col gap-4 items-start self-stretch">
    <!-- Target Audience -->
    {% if content.field_target_audience['#items'] is not empty %}
      {% set divider = true %}
      <div class="flex relative gap-2 items-start self-stretch">
        <img
          src="/themes/custom/motaded_theme/img/target-audience.svg"
          alt="Target Audience"
          width="24"
          height="24"
        />
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_target_audience['#title'] }}
          </h3>
          <p
            class="relative self-stretch text-base leading-6 text-gray-800"
          >
            {{ content.field_target_audience.0 }}
          </p>
        </div>
      </div>
    {% endif %}

    <!-- Service Duration -->
    {% if content.field_service_duration['#items'] is not empty %}
      {% set divider = true %}
      <div class="flex relative gap-2 items-start self-stretch">
        <img
          src="/themes/custom/motaded_theme/img/service-duration.svg"
          alt="Service Duration"
          width="24"
          height="24"
        />
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_service_duration["#title"] }}
          </h3>
          <p
            class="relative self-stretch text-base leading-6 text-gray-800"
          >
            {{ content.field_service_duration.0 }}
          </p>
        </div>
      </div>
    {% endif %}

    <!--  Provided languages -->
    {% if content.field_provided_languages['#items'] is not empty %}
      {% set divider = true %}
      <div class="flex relative gap-2 items-start self-stretch">
        <img
          src="/themes/custom/motaded_theme/img/icon-lang-brand.svg"
          alt="Provided languages"
          width="24"
          height="24"
        />
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_provided_languages['#title'] }}
          </h3>
          <p
            class="relative self-stretch text-base leading-6 text-gray-800"
          >
            {{ content.field_provided_languages.0 }}
          </p>
        </div>
      </div>
    {% endif %}


    <!-- Service Channels -->
    {% if content.field_service_channels['#items'] is not empty %}
      {% set divider = true %}
      <div class="flex relative gap-2 items-start self-stretch">
        <img
          src="/themes/custom/motaded_theme/img/service-channels.svg"
          alt="Service Channels"
          width="24"
          height="24"
        />
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_service_channels['#title'] }}
          </h3>
          <p
            class="relative self-stretch text-base leading-6 text-gray-800"
          >
            {{ content.field_service_channels.0}}
          </p>
        </div>
      </div>
    {% endif %}

    <!-- Service Cost -->
    {% if content.field_service_cost['#items'] is not empty %}
      {% set divider = true %}
      <div class="flex relative gap-2 items-start self-stretch">
        <div
          class="flex relative justify-center items-center p-0.5 w-6 h-6"
        >
          <div class="relative shrink-0 h-[22px] w-[22px]">
            <img
              src="/themes/custom/motaded_theme/img/service-cost.svg"
              alt="Service Cost"
              width="22"
              height="22"
            />
          </div>
        </div>
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_service_cost['#title'] }}
          </h3>
          <p
            class="relative self-stretch text-base leading-6 text-gray-800"
          >
            {{ content.field_service_cost.0 }}
          </p>
        </div>
      </div>
    {% endif %}

    <!-- Payment Channels -->
    {% if content.field_service_cost['#items'] is not empty %}
      {% set divider = true %}
      <div class="flex relative gap-2 items-start self-stretch">
        <img
          src="/themes/custom/motaded_theme/img/icon-checkmark-circle.svg"
          alt="Payment options"
          width="24"
          height="24"
        />
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_payment_options['#title'] }}
          </h3>
          <p
            class="relative self-stretch text-base leading-6 text-gray-800"
          >
            {{ content.field_payment_options.0 }}
          </p>
        </div>
      </div>
    {% endif %}
  </section>

  <!-- Divider -->
  {% if divider %}
    <div class="relative h-px bg-gray-300 w-[336px] max-md:w-full"></div>
  {% endif %}

  <!-- Contact Information -->
  <section class="flex relative flex-col gap-4 items-start self-stretch">
    <!-- FAQ -->
    <div class="flex relative gap-2 items-start self-stretch">
      <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
        <h3
          class="relative self-stretch text-base font-bold leading-6 text-gray-800"
        >
          {{ "Frequently Asked Questions"|t }}
        </h3>
        <a href="#faqs" class="flex relative gap-2 items-center p-0">
          <span class="relative text-base leading-6 text-green-700"
            >{{ "View consultation FAQs"|t }}</span
          >
          <img
            src="/themes/custom/motaded_theme/img/icon-link-square.svg"
            alt="FAQs link"
            width="18"
            height="18"
          />
        </a>
      </div>
    </div>

    <!-- Phone -->
    {% if content.field_phone_number['#items'] is not empty %}
      <div class="flex relative gap-2 items-start self-stretch">
        <img src="/themes/custom/motaded_theme/img/icon-phone.svg" alt="Phone" width="24" height="24" />
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_phone_number["#title"] }}
          </h3>
          <a
            href="tel:{{ content.field_phone_number.0 }}"
            class="flex relative gap-2 items-center p-0"
          >
            <span class="relative text-base leading-6 text-green-700"
              >{{ content.field_phone_number.0 }}</span
            >
            <img
              src="/themes/custom/motaded_theme/img/icon-link-square.svg"
              alt="External Link"
              width="18"
              height="18"
            />
          </a>
        </div>
      </div>
    {% endif %}

    <!-- Email -->
    {% if content.field_email_address['#items'] is not empty %}
      <div class="flex relative gap-2 items-start self-stretch">
        <img src="/themes/custom/motaded_theme/img/icon-email.svg" alt="Email" width="24" height="24" />
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ content.field_email_address["#title"] }}
          </h3>
          <a
            href="mailto:{{ content.field_email_address.0 }}"
            class="flex relative gap-2 items-center p-0"
          >
            <span class="relative text-base leading-6 text-green-700"
              >{{ content.field_email_address.0 }}</span
            >
            <img
              src="/themes/custom/motaded_theme/img/icon-link-square.svg"
              alt="External Link"
              width="18"
              height="18"
            />
          </a>
        </div>
      </div>
    {% endif %}

    <!-- Download Manual Button -->
    {% if content.field_document|render is not empty %}
      {% set field_media = file_url(content.field_document[0]['#entity'].field_media_document.entity.uri.value) %}
  
      <a
        href="{{ field_media }}" 
        target="_blank" 
        class="flex relative gap-1 justify-center items-center px-4 py-0 h-10 max-h-10 bg-gray-100 rounded min-h-10"
      >
        <div class="flex relative justify-center items-center">
          <span
            class="relative text-base font-medium leading-6 text-neutral-900"
            >{{ content.field_document["#title"] }}</span
          >
        </div>
      </a>
    {% endif %}

    {% if content.field_download_user_guides|render is not empty %}
      <div class="flex relative gap-2 items-start self-stretch">
        <div class="flex relative flex-col gap-1 items-start flex-[1_0_0]">
          <h3
            class="relative self-stretch text-base font-bold leading-6 text-gray-800"
          >
            {{ "Download user guide"|t }}
          </h3>
          {% for i in content.field_download_user_guides|keys %}
            {% if i matches '/^\\d+$/' %}
              {% set field_media = file_url(content.field_download_user_guides[i]['#entity'].field_media_document.entity.uri.value) %}
              <a
                href="{{ field_media }}" 
                target="_blank" 
                class="flex relative gap-2 items-center p-0"
              >
                <span class="relative text-base leading-6 text-green-700">{{ content.field_download_user_guides[i]['#title'] }}</span>
                {# <div class="flex relative justify-center items-center">
                  <span class="relative text-base font-medium leading-6 text-neutral-900">{{ content.field_download_user_guides[i]['#title'] }}</span>
                </div> #}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </section>
  
  <!-- Mobile Applications -->
  <section
    class="flex relative flex-col gap-2 items-start h-32 w-[336px] max-md:w-full max-md:h-auto"
  >
    <h3
      class="relative self-stretch text-lg font-bold leading-7 text-gray-800"
    >
      {{ "Mobile Application"|t }}
    </h3>
    <div
      class="flex relative flex-wrap gap-3 content-start items-start self-stretch max-sm:justify-center"
    >
      <!-- App Store Button -->
      <a href="#">
        <img
          src="/themes/custom/motaded_theme/img/app-store.svg"
          alt="App Store"
          width="120"
          height="40"
        />
      </a>

      <!-- Google Play Button -->
      <a href="#">
        <img
          src="/themes/custom/motaded_theme/img/google-play.svg"
          alt="Google Play"
          width="120"
          height="40"
        />
      </a>
    </div>
  </section>

</article>
