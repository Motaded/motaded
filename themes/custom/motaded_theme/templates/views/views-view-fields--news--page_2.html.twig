{% set card_image = card_image|default({}) %}
{% set title_plain = fields.title.content|render|striptags|trim %}
{% include 'motaded_theme:news-card' with {
  'view_link': fields.view_node.content|render|striptags|trim,
  'title': fields.title.content,
  'media_url': card_image.src|default(''),
  'media_srcset': card_image.srcset|default(''),
  'media_width': 151,
  'media_height': 120,
  'media_sizes': '151px',
  'image_alt': card_image.alt|default(title_plain),
  'date': fields.created.content,
} %}
