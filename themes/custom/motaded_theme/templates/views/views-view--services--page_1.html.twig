{#
/**
 * @file
 * Services: exposed (top filters) + .services-directory__main (categories aside + results).
 */
#}
{{ attach_library('motaded_theme/services-directory') }}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'page-gray',
    'services-directory',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if attachment_before %}
    <div class="attachment attachment-before">
      {{ attachment_before }}
    </div>
  {% endif %}

  <div class="w-full py-6">
    {% if exposed %}
      <div class="services-directory__page">
        {{ exposed }}
        <div class="services-directory__main">
          {% if services_categories_sidebar %}
            <aside class="services-filters-sidebar" role="group" aria-label="{{ services_categories_aria_label|default('Categories'|t) }}">
              {{ services_categories_sidebar }}
            </aside>
          {% endif %}
          <div class="services-directory__results-column">
            {% if header %}
              <div class="services-directory__results-meta flex items-center justify-between">
                <p class="text-sm text-gray-600">
                  {{ header }}
                </p>
              </div>
            {% endif %}
            <div class="services-directory__results-body">
              {% if rows %}
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-6">
                  {{ rows }}
                </div>
              {% elseif empty %}
                <div class="view-empty">
                  {{ empty }}
                </div>
              {% endif %}
              {% if pager %}
                <div class="mt-8">
                  {{ pager }}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <div class="services-directory__results-body">
        {% if header %}
          <div class="services-directory__results-meta flex items-center justify-between">
            <p class="text-sm text-gray-600">
              {{ header }}
            </p>
          </div>
        {% endif %}
        {% if rows %}
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-6">
            {{ rows }}
          </div>
        {% elseif empty %}
          <div class="view-empty">
            {{ empty }}
          </div>
        {% endif %}
        {% if pager %}
          <div class="mt-8">
            {{ pager }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {% if attachment_after %}
    <div class="attachment attachment-after">
      {{ attachment_after }}
    </div>
  {% endif %}
  {% if more %}
    {{ more }}
  {% endif %}
  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
  {% if feed_icons %}
    <div class="feed-icons">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
