{#
/**
 * @file
 * Services page: full-width exposed toolbar + categories column + results.
 */
#}
{{ attach_library('motaded_theme/services-page') }}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'page-gray',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if attachment_before %}
    <div class="attachment attachment-before">
      {{ attachment_before }}
    </div>
  {% endif %}

  {% if exposed %}
    <div class="services-page__toolbar" role="search" aria-label="{{ 'Search and filter services'|t }}">
      {{ exposed }}
    </div>
  {% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <aside class="lg:col-span-4 xl:col-span-3" aria-label="{{ 'Service categories'|t }}">
      <div class="lg:hidden mb-4">
        <details class="group rounded-xl border border-gray-200 bg-white">
          <summary class="list-none p-4 flex items-center justify-between cursor-pointer font-semibold">
            {{ 'Categories'|t }}
            <svg class="w-4 h-4 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="px-4 pb-4 border-t border-gray-200 services-page__categories-nav">
            {{ drupal_menu('our-services', 1) }}
          </div>
        </details>
      </div>
      <div class="hidden lg:block sticky top-6 rounded-xl border border-gray-200 bg-white p-4">
        <h2 class="text-base font-semibold text-gray-900 mb-3">{{ 'Categories'|t }}</h2>
        <nav class="services-page__categories-nav">
          {{ drupal_menu('our-services', 1) }}
        </nav>
      </div>
    </aside>

    <section class="lg:col-span-8 xl:col-span-9">
      {% if header %}
        <p class="text-sm text-gray-600 mt-1 mb-4">
          {{ header }}
        </p>
      {% endif %}
      {% if rows %}
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 lg:gap-6">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="view-empty">
          {{ empty }}
        </div>
      {% endif %}
    </section>
  </div>

  {% if pager %}
    {{ pager }}
  {% endif %}
  {% if attachment_after %}
    <div class="attachment attachment-after">
      {{ attachment_after }}
    </div>
  {% endif %}
  {% if more %}
    {{ more }}
  {% endif %}
  {% if footer %}
    <div class="view-footer">
      {{ footer }}
    </div>
  {% endif %}
  {% if feed_icons %}
    <div class="feed-icons">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
