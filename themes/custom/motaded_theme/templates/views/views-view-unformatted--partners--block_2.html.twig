{#
  Partners carousel — Swiper.js
#}

{{ attach_library("motaded_theme/partner-carousel") }}

<div class="partners-swiper swiper" role="region" aria-label="{{ 'Partner logos carousel'|t }}">
  <div class="swiper-wrapper">
    {% for row in rows %}
    <div class="swiper-slide">
      <div class="border rounded-lg p-2 bg-white hover:shadow-sm transition h-full">
        {# img alt is always set in preprocess — link needs no duplicate aria-label #}
        <a href="#" class="block">
          <div class="mx-auto grid place-items-center">
            {% if row.image.src %}
              {% if row.image.srcset %}
                <img class="p-3 max-h-16 object-contain w-full" loading="lazy" decoding="async" alt="{{ row.image.alt }}" src="{{ row.image.src }}" srcset="{{ row.image.srcset }}" sizes="(max-width: 767px) 45vw, 160px" width="{{ row.image.width }}" height="{{ row.image.height }}"/>
              {% else %}
                <img class="p-3 max-h-16 object-contain w-full" loading="lazy" decoding="async" alt="{{ row.image.alt }}" src="{{ row.image.src }}" width="{{ row.image.width }}" height="{{ row.image.height }}"/>
              {% endif %}
            {% endif %}
          </div>
        </a>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="swiper-pagination mt-3"></div>
</div>
