{#
  Partners carousel — Swiper.js
#}

{{ attach_library("motaded_theme/partner-carousel") }}

<div class="partners-swiper swiper" role="region" aria-label="{{ 'Partner logos carousel'|t }}">
  <div class="swiper-wrapper">
    {% for row in rows %}
    <div class="swiper-slide">
      <div class="border rounded-lg p-2 bg-white hover:shadow-sm transition h-full">
        <a href="#" class="block" aria-label="{{ row.image.alt }}">
          <div class="mx-auto grid place-items-center">
            <img
              class="p-3 max-h-16 object-contain w-full"
              alt="{{ row.image.alt }}"
              src="{{ row.image.url }}"
              width="120"
              height="64"
              loading="lazy"
            />
          </div>
        </a>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="swiper-pagination mt-3"></div>
</div>
