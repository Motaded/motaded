{#
/**
 * @file
 * Theme override to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 */
#}

{{attach_library('motaded_theme/partner-carousel')}}
{# Carousel (all screens) #}
<div class="relative overflow-hidden" @mouseenter="pause()" @mouseleave="play()" x-data="partnersCarousel({{ rows | length }})">
  <div x-ref="track" class="flex gap-3 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-2" @scroll.passive="onScroll()" tabindex="0" role="region" aria-roledescription="carousel" :aria-label="ariaLabel">
    {% for row in rows %}
      <div class="min-w-[70%] sm:min-w-[40%] md:min-w-[25%] lg:min-w-[16%] snap-start">
            <div
              class="border rounded-lg p-2 bg-white hover:shadow-sm transition h-full"
            >
              <a href="#" class="block">
                <div class="mx-auto grid place-items-center">
                  <img
                    class="p-3 max-h-16 object-contain"
                    alt="{{row.image.alt}}"
                    src="{{row.image.url}}"
                    width="120"
                    height="64"
                    loading="lazy"
                  />
                </div>
              </a>
            </div>
      </div>
    {% endfor %}

  </div>

  <!-- Dots -->
  <div class="mt-3 flex justify-center gap-1.5">
    <template x-for="(logo, i) in pageCount" :key="i">
      <button type="button" class="h-1.5 rounded-full transition cursor-pointer" :class="currentPage === i ? 'w-6 bg-gray-900' : 'w-3 bg-gray-300'" @click="goTo(i)" :aria-label="`Go to slide ${i+1}`" :aria-current="currentPage === i ? 'page' : false"></button>
    </template>
  </div>
</div>
