{#
/**
 * @file
 * Default theme implementation to webform confirmation.
 *
 * Available variables:
 * - progress: Progress bar.
 * - message: Confirmation message.
 * - back_url: URL to the previous webform submission.
 *
 * @see template_preprocess_webform_confirmation()
 *
 * @ingroup themeable
 */
#}
{{ attach_library('webform/webform.confirmation') }}

{% if progress %}
  {{ progress }}
{% endif %}

<div class="flex items-start gap-4">
  <div class="shrink-0 inline-flex items-center justify-center rounded-full bg-green-100 border border-green-200 size-12">
    <svg
      width="28"
      height="28"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M20 6L9 17l-5-5"
        stroke="#15803d"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span class="sr-only">{{ "Success" }}</span>
  </div>
  <div class="flex-1">
    <h1 class="text-2xl md:text-3xl font-bold text-green-800 leading-tight pt-0">
      {{ "Thanks — Motaded received your message."|t }}
    </h1>
    {% if message %}
      <div class="webform-confirmation__message">{{ message }}</div>
    {% endif %}
  </div>
</div>