{{ attach_library('motaded_theme/alpine') }}

<header
	x-data="{ openMenu: null, mobileOpen: false, mobileSection: null }" class="sticky top-0 z-[201] h-[91px] bg-white border-b border-gray-200" @keydown.escape.window="openMenu=null; mobileOpen=false; mobileSection=null">
	<!-- Desktop -->
	<div class="max-w-[1320px] mx-auto px-4 hidden md:block h-full">
		<div class="flex items-center h-full py-1 gap-4">
			<!-- Left: Logo -->
			<div class="shrink-0 flex items-center">
				<a href="{{ front_page }}" class="block">
					<img alt="Motaded" class="h-9 w-auto max-w-[120px] object-contain object-left" src="{{ logo_path }}" width="500" height="92"/>
				</a>
			</div>

			<!-- Center: Nav -->
			<nav class="hidden lg:flex flex-1 min-w-0 justify-start items-center h-full" @click.outside="openMenu=null">
				{{ page.main_menu }}
			</nav>

			{% set search_url = url('<front>')|render ~ '/search/content' %}
			<!-- Right: CTA / Search / Lang -->
			<div class="shrink-0 flex items-center justify-end gap-2">
				{% if page.header_cta %}
					<div class="flex items-center shrink-0">{{ page.header_cta }}</div>
				{% endif %}
				<div
					class="flex gap-1.5 lg:gap-2 text-xs">
					<!-- Search -->
					<div class="relative flex items-center">
						<a type="button" class="inline-flex items-center justify-center font-medium transition rounded-sm text-black text-xs size-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800" aria-label="Search" href="{{ search_url|replace({'//s': '/s'}) }}">
							<img alt="search" width="24" height="24" src="/themes/custom/motaded_theme/img/icon-search.svg"/>
						</a>
						<p class="text-xs font-medium leading-[1.6] hidden xl:block ml-1 mb-0">
							{{ "Search"|t }}
						</p>
					</div>

					<!-- Language -->
					<span class="flex justify-center px-0 text-xs">
						<div class="flex gap-1.5 items-center">
							{{ page.secondary_menu }}
						</div>
					</span>
				</div>

				<!-- Burger (desktop hidden anyway) -->
				<div class="lg:hidden">
					<button aria-label="Menu" class="w-12 h-12 grid place-items-center">
						<img alt="menu" width="24" height="24" src="/themes/custom/motaded_theme/img/icon-menu.svg"/>
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Mobile (structure preserved, no mega here) -->
	<div class="block md:hidden py-5">
		<div
			class="max-w-[1320px] mx-auto px-4 relative flex items-center justify-between py-2">
			<!-- Left: Search + Lang -->
			<div class="flex items-center gap-2">
				<a type="button" class="inline-flex items-center justify-center transition text-black text-sm size-10 rounded-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800" aria-label="Search" href="{{ search_url|replace({'//s': '/s'}) }}">
					<img alt="search" width="24" height="24" src="/themes/custom/motaded_theme/img/icon-search.svg"/>
				</a>

				<span class="flex justify-center px-0">
					<div class="flex gap-1.5 items-center">
						{{ page.secondary_menu }}
					</div>
				</a>
			</div>

			<!-- Right: Burger -->
			<div class="flex items-center gap-2">
				<button aria-label="Menu" class="w-12 h-12 grid place-items-center" @click="mobileOpen = true">
					<img alt="menu" width="24" height="24" src="/themes/custom/motaded_theme/img/icon-menu.svg"/>
				</button>
			</div>
		</div>

		<!-- Drawer: overlay -->
		<div x-show="mobileOpen" x-transition.opacity class="fixed inset-0 z-[202] bg-black/40" @click="mobileOpen=false" x-cloak></div>

		<!-- Drawer: panel -->
		<aside
			x-show="mobileOpen" x-cloak x-transition:enter="transition ease-out duration-200" x-transition:enter-start="-translate-x-full opacity-0" x-transition:enter-end="translate-x-0 opacity-100" x-transition:leave="transition ease-in duration-150" x-transition:leave-start="translate-x-0 opacity-100" x-transition:leave-end="-translate-x-full opacity-0" class="fixed inset-y-0 left-0 z-[203] w-[88%] max-w-[360px] bg-white shadow-xl flex flex-col" @click.stop role="dialog" aria-modal="true" aria-label="Mobile menu">
			<!-- Drawer header -->
			<div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
				<a href="{{ front_page }}" class="inline-flex items-center gap-2 shrink-0">
					<img alt="Motaded" class="h-8 w-auto max-w-[100px] object-contain" src="{{ logo_path }}" width="500" height="92"/>
				</a>
				<button class="size-10 grid place-items-center rounded-md hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800" @click="mobileOpen=false; mobileSection=null" aria-label="Close menu">
					<img alt="close" width="20" height="20" src="/themes/custom/motaded_theme/img/icon-close.svg"/>
				</button>
			</div>

			<!-- Drawer body (scrollable) -->
			<div class="flex-1 min-h-0 flex flex-col justify-between overflow-y-auto px-2 py-2">
				{{ page.menu_mobile }}
			</div>

			<!-- Drawer CTA (above footer, fixed) -->
			{% if page.drawer_cta %}
			<div class="drawer-cta shrink-0 py-3 pl-4 pr-4 border-t border-gray-200">
				{{ page.drawer_cta }}
			</div>
			{% endif %}

			<!-- Drawer footer (optional) -->
			<div class="mt-auto px-4 py-3 border-t border-gray-200">
				<div class="flex items-center gap-2">
					<a href="{{ search_url|replace({'//s': '/s'}) }}" type="button" class="inline-flex items-center justify-center font-medium transition text-black text-sm px-3 py-2 rounded-md hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800" aria-label="Search">
						<img alt="search" width="20" height="20" src="/themes/custom/motaded_theme/img/icon-search.svg"/>
						<span class="ml-2">{{ "Search"|t }}</span>
					</a>
					<span class="inline-flex items-center gap-2 px-3 py-2 rounded-md hover:bg-gray-100">
						{{ page.secondary_menu }}
					</a>
				</div>
			</div>

		</aside>
	</div>
</header>
