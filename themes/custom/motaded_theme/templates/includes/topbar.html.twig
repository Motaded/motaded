<!-- Top Verification Bar -->
<div x-data="{ open:false, scale:0 }" class="bg-gray-100 py-2 w-full border-b border-blueGray-200 transition-all duration-300">
	<div
		class="max-w-[1320px] mx-auto px-4">
		<!-- ROW -->
		<div
			class="flex justify-between items-center gap-3 flex-wrap">
			<!-- LEFT: flag + label + how to verify -->
			<div class="flex items-center gap-4 hidden">
				<img alt="Saudi flag" width="32" height="23" src="https://my.gov.sa/_next/static/media/icon_saudi.b4b403e4.svg"/>
				<div class="flex items-center gap-3 flex-wrap">
					<p class="text-sm font-medium mb-0">Official Motaded website</p>

					<!-- How to verify toggle -->
					<button type="button" class="inline-flex items-center gap-2 text-primary-600 hover:underline text-sm" @click="open=!open" :aria-expanded="open" aria-controls="verify-panel">
						How to verify
						<img src="/themes/custom/motaded_theme/img/icon-arrow-down.svg" alt="toggle icon" class="transition" :class="open ? 'rotate-180' : ''"/>
					</button>
				</div>
			</div>
			<!-- Date -->
			<div class="flex items-center gap-2">
				<img src="/themes/custom/motaded_theme/img/icon-calender.svg" alt="calendar icon" class="h-5 w-5"/>
				<p class="text-sm font-normal black max-sm:!text-xs leading-[1.6] mb-0">
					{{ "now"|date("l, F j, Y") }}
				</p>
			</div>

			<!-- RIGHT: date + a11y controls + beta -->
			<div
				class="flex items-center gap-3 flex-wrap">

				<!-- A11y: increase font -->
				<div data-tip="Increase font size">
					<button type="button" class="align-middle btn-ghost btn-xs rounded-full text-primary" aria-label="Increase font size" @click="scale = Math.min(scale + 1, 4); document.documentElement.style.fontSize = (100 + scale*6) + '%';">
						<img src="/themes/custom/motaded_theme/img/icon-increase.svg" alt="increase font" role="none"/>
					</button>
				</div>

				<!-- A11y: decrease font -->
				<div data-tip="Decrease font size">
					<button type="button" class="align-middle btn-ghost btn-xs rounded-full text-primary" aria-label="Decrease font size" @click="scale = Math.max(scale - 1, -3); document.documentElement.style.fontSize = (100 + scale*6) + '%';">
						<img src="/themes/custom/motaded_theme/img/icon-decrease.svg" alt="decrease font" role="none"/>
					</button>
				</div>

				<!-- A11y: invert colors -->
				<div data-tip="Invert colors">
					<button type="button" class="align-middle btn-ghost btn-xs rounded-full text-primary" aria-label="Invert colors" @click="document.documentElement.classList.toggle('invert')">
						<img src="/themes/custom/motaded_theme/img/icon-dark-mode.svg" alt="invert colors"/>
					</button>
				</div>
			</div>
		</div>

	</div>
</div>
<!-- // Top Verification Bar -->
