<h1 class="mb-0 text-[1.625rem] font-bold text-primary-600 leading-tight max-sm:text-2xl py-12 mb-12">Latest News</h1>
<div class="flex justify-between items-center flex-wrap gap-5 mt-16 mb-5 text-white">
  <div>
    <div class="flex items-center flex-wrap gap-4 mb-3">
      <a class="underline font-normal" href="#">Privacy Policy</a>
      <a class="underline font-normal" href="#">Terms of Use</a>
      <a class="underline font-normal" href="#">Sitemap</a>
    </div>
    <p class="text-sm font-medium leading-[1.6]">
      ⓒ 2025 Motaded Consultancy. All Rights Reserved.
    </p>
  </div>
  <div class="flex flex-wrap gap-4 items-center">
    <a href="#">
      <img alt="Vision 2030" width="64" height="38" src="./img/logo-vision-2030.svg"/>
    </a>
    <a href="#">
      <img alt="Motaded Logo" width="134" height="40" src="./img/motaded-logo-white.svg"/>
    </a>
  </div>
</div>
<div class="mt-10 flex flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-gray-300 bg-white px-6 py-12 text-center" role="status">
  <h2 class="text-xl font-semibold text-gray-900 m-0">
    No articles found
  </h2>
  <p class="text-sm text-gray-600 m-0">
    <span>We couldn’t find any results</span>
    <template x-if="q">
      <span>
        for
        <span class="font-medium text-primary-700" x-text="'“' + q + '”'"></span>
      </span>
    </template>
    <span>matching your filters.</span>
  </p>
  <p class="text-xs text-gray-500 m-0">
    Try adjusting your search or clearing the filters to discover more articles.
  </p>
</div>

<span class="flex relative gap-1 justify-center items-center px-2 h-6 bg-sky-50 rounded border border-sky-200">
  <span class="relative text-xs font-medium leading-5 text-blue-800">Consulting</span>
</span>
<span class="flex relative gap-1 justify-center items-center px-2 h-6 bg-emerald-50 rounded border border-emerald-200">
  <span class="relative text-xs font-medium leading-5 text-emerald-800">Business Support</span>
</span>
<span class="flex relative gap-1 justify-center items-center px-2 h-6 bg-gray-50 rounded border border-gray-200">
  <span class="relative text-xs font-medium leading-5 text-gray-800">Advisory</span>
</span>

<div class="from-amber-50 to-white border border-amber-200"></div>
<div class="from-green-50 to-white border border-green-200"></div>
<div class="from-blue-50 to-white border border-blue-200"></div>
<div class="from-purple-50 to-white border border-purple-200 pt-12"></div>
