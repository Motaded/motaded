{#
  Theme override for Social Link Field formatter.
#}
{%
set classes = [
  'social-link-field',
  appearance.orientation,
]
%}

{% apply spaceless %}
  {% if links %}
    <ul {{ attributes.addClass(classes) }}>
      {% for link in links %}
        <li>
          <a href="{{ link.url }}" class="{{ link.class }}" title="{{ link.title }}"{% if new_tab %} target="_blank" rel="nofollow noopener noreferrer"{% endif %}>
            {{ link.text|render }}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endapply %}
