{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}
{% set classes = [
  'w-full flex-col gap-4 rounded-2xl border border-dashed border-green-200 bg-emerald-50/40 p-6',
] %}
<form{{ attributes.addClass(classes) }}>
  <h3 class="text-lg font-semibold leading-7 text-neutral-900">
    {{ "Add new comment"|t }}
  </h3>

  <p class="text-sm leading-5 text-gray-700">
    {{ "Share your thoughts or questions about our consultation services. Comments are moderated to maintain a constructive community experience."|t }}
  </p>
  {{ children }}
</form>
