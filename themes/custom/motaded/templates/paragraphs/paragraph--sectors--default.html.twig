{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}
{% block paragraph %} 
    <div class="sector-card">
      {% block content %}
        {% if paragraph.field_media.entity.field_media_image.entity.uri.value is not empty %}
          {% set image_url = file_url(paragraph.field_media.entity.field_media_image.entity.uri.value) %}     
            
              <a href="{{ content.field_link[0]['#title'] }}">
              <span class="sector-icon">
                <img src="{{ image_url }}" alt="{{ paragraph.field_media.entity.field_media_image.alt }}" />          
              </span>
              {{ content.field_title }}
              </a>       
        
        {% endif %}
        
      {% endblock %}
    </div>
{% endblock paragraph %}