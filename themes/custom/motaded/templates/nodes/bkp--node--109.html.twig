																																																								<a href="#mission-vision" class="tab-link">{{ content.field_itc_card_for_services['#title'] }}</a>
																																																							</li>
																																																						{% endif %} #}


						{% if content.field_objectives['#title'] is defined %}
							<li>
								<a href="#objectives" class="tab-link">{{ content.field_objectives['#title'] }}</a>
							</li>
						{% endif %}


						{% if content.field_work_tracks['#title'] is defined %}
							<li>
								<a href="#work-tracks" class="tab-link">{{ content.field_work_tracks['#title'] }}</a>
							</li>
						{% endif %}


						{% if content.field_areas_of_work['#title'] is defined %}
							<li>
								<a href="#work-areas" class="tab-link">{{ content.field_areas_of_work['#title'] }}</a>
							</li>
						{% endif %}


						{% if content.field_steps_to_obtain['#title'] is defined %}
							<li>
								<a href="#stepsTo-obtain" class="tab-link">{{ content.field_steps_to_obtain['#title'] }}</a>
							</li>
						{% endif %}


						{% if content.field_keywords['#title'] is defined %}
							<li>
								<a href="#faqs" class="tab-link">{{ content.field_keywords['#title'] }}</a>
							</li>
						{% endif %}


					</ul>


