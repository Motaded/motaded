			<div class="scrollspy-wrapper"> <div class="scrollspy-container container">
				<nav class="tab-container">
					<ul class="tab-links">
						<li>
							<a href="#overview" class="tab-link">Overview</a>
						</li>


						{% set i = 1 %}
						{% for item in content.field_basic_paragraphs['#items'] %}
							{% if item.entity %}
								{% set paragraph = item.entity %}

								{# Access the 'field_title' data inside the paragraph #}
								{% if paragraph.field_title.value %}
									<li>
										<a href="#{{ paragraph.field_title.value|clean_id }}" class="tab-link">{{ paragraph.field_title.value }}</a>
									</li>
									{% set i = i + 1 %}
								{% endif %}

							{% endif %}
						{% endfor %}


						{# {% if content.field_itc_card_for_services['#title'] is defined %}
