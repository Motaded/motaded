{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('bootstrap5/node') }}

<section class="cms-banner">
    <img src="/themes/custom/motaded/images/cms-banner.png" alt="banner copy">

<div class="banner-content">

   <h1>{{ label }}</h1>
  
</div>
</section>

<article{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {# {% if display_submitted %}
    <footer class="node__meta">
      {{ author_picture }}
      <div{{ author_attributes.addClass('node__submitted') }}>
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
        {{ metadata }}
      </div>
    </footer>
  {% endif %} #}

  <div{{ content_attributes.addClass('node__content') }}>

    <div class="inner-pages-wrapper">
      <div class="container">
        <div class="inner-pages-content">
          {{ content }}
        </div>    
      </div>    
    </div>
  </div>
</article>
<style>
.field.field--name-title.field--type-string.field--label-hidden {
  color: #fff;
}
</style>