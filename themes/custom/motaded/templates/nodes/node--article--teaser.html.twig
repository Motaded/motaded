{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('bootstrap5/node') }}
<article{{attributes.addClass(classes, 'block')}}>

    {# <div class="icons"><img src="{{ file_url(node.field_media.entity.field_media_image.entity.fileuri)  }}" alt=""></div> #}
    {{ title_prefix }}
    {% if label and not page %}
        <h6{{title_attributes}}>
            {{ label }}
        </h6>
    {% endif %}
    {{ title_suffix }}
  <p>{{ content.body.0 }}</p>
      

    <div class="node__links">
    <ul class="links inline"><li><a href="{{ url('entity.node.canonical', {'node': node.id}) }}">{{ 'Read more'|t({}, {'context': 'block_template'}) }}</a></li></ul>  </div>
    
</article>
