{% set base_url = url('<front>')  %}

{% if reset_banner_title %}
    <section class="page-banner" style="background-image: url('{{banner_bg}}');">
        <div class="container">
            <div class="heading">
                <h1>{{reset_banner_title}}</h1>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{base_url}}">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{reset_banner_title}}</li>
                </ol>
            </div>
        </div>
    </section>
{% endif %}
        <section class="dt-section reset-page">
            <div class="container">
                <div class="form-style-3">
                    <div class="head">
                    {% if reset_page_title %}
                        <h3>{{reset_page_title}}</h3>
                    {% endif %}
                    </div>
                     <div class="form">
                        <div class="form-group">
                            <label for="forMail">User Name or Email address</label>
                            {{ form.name }}
                            {% if reset_pass_name_description %}
                            <span>{{reset_pass_name_description}}</span>
                            {% endif %}
                        </div>
                         {{ form.actions }}
                         {{ form.form_build_id }}
                         {{ form.form_id }}
                    </div>
                </div>
            </div>
        </section>