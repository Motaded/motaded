            </svg>
        </a>
        <ul class="dropdown-menu" aria-labelledby="langdropdown">
    {%- for key, item in links -%}
        {% if key is not same as("activeLink") %}
            <li>{{ item.link }}</li>
        {% endif %}
    {% endfor %}
        </ul>
    </li>
</ul>
{% endif %}
