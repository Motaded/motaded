{#
/**
 * @file
 * Theme override to display a single Drupal page while offline.
 *
 * All available variables are mirrored in page.html.twig.
 * Some may be blank but they are provided for consistency.
 *
 * @see template_preprocess_maintenance_page()
 */
#}



{% set base_url = url('<front>') %} 
{% if "1" in mode_type  %}
<section class="coming-maintenance bg-image dt-section" style="background-image: url('{{bg_image_m}}');">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-12 col-12">
                <div class="item">
                    <h2>{{maintenance_mode_title}}</h2>
                    <p>{{maintenance_mode_description}}</p>
                </div>
            </div>
        </div>
    </div>
</section>
{% else %}
<section class="coming-maintenance bg-image dt-section" style="background-image: url('{{bg_image_c}}');">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-md-12 col-12">
                <div class="item">
                    <h2>{{coming_soon_title}}</h2>
                    <p>{{coming_soon_description}}</p>
                    <div id="clockdiv" class="cs-counter">
                        <div class="cs-date">
                             <img src="/sites/default/files/blue.png" alt="icon"> 
                            <div class="overlay">
                                <span class="time days" id="day">00</span>
                                <div class="counting-title">DAYS</div>
                            </div>
                        </div>
                        <div class="cs-date">
                            <img src="/sites/default/files/yellow.png" alt="icon"> 
                            <div class="overlay">
                                <span class="time hours" id="hour">00</span>
                                <div class="counting-title">HOURS</div>
                            </div>
                        </div>
                        <div class="cs-date">
                            <img src="/sites/default/files/green.png" alt="icon"> 
                            <div class="overlay">
                                <span class="time minutes" id="minute">00</span>
                                <div class="counting-title">MINUTES</div>
                            </div>
                        </div>
                        <div class="cs-date">
                            <img src="/sites/default/files/red.png" alt="icon"> 
                            <div class="overlay">
                                <span class="time seconds" id="second">00</span>
                                <div class="counting-title">SECONDS</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}