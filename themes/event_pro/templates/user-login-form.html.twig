{% set base_url = url('<front>')  %}
<!-- Login Banner -->
{% if login_banner_title %}
    <section class="page-banner" style="background-image: url('{{banner_bg}}');">
        <div class="container">
            <div class="heading">
                <h1>{{login_banner_title}}</h1>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{base_url}}">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{login_banner_title}}</li>
                </ol>
            </div>
        </div>
    </section>
{%  endif %}
<!-- Login Form -->
    <section class="dt-section login-page">
        <div class="container">
            <div class="form-style-3">
                <div class="head">
                    {% if login_title %}
                    <h3>{{login_title}}</h3>
                    {% endif %}
                </div>
                 <div class="form">
                    <div class="form-group">
                        <label for="forMail">User Name <sup>*</sup></label>
                        {{ form.name }}
                        {% if login_name_description %}
                        <span>{{login_name_description}}</span>
                        {% endif %}
                    </div>
                    <div class="form-group">
                        <label for="forPassword">Password <sup>*</sup></label>
                        {{ form.pass }}
                        {% if login_password_description %}
                        <span>{{login_password_description}}</span>
                        {% endif %}
                    </div>
                    <button type="submit" class="btn btn-primary btn-style-1 btn-style-sm" title="Login">Login
                        <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                            <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                        </svg>
                    </button>
                    <div class="links">
                        <a href="{{base_url}}user/register" title="Create new account">Create new account</a>
                        <a href="{{ base_url }}user/password" title="Forgot Password?">Forgot Password?</a>
                    </div>
                    {{ form.form_build_id }}
                    {{ form.form_id }}
                </div>
            </div>
        </div>
    </section>