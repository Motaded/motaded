<!-- Event Schedule -->
<div class="event-schedules">
    <div class="tabs-style-2">
        <ul class="nav" id="myTab2" role="tablist">
        {% for key,value in content.field_event_schedule['#items'] %}
            {% if key == 0 %} 
                <li class="nav-item">
                    <a class="nav-link show active" id="tab-1-4" data-bs-toggle="tab" data-bs-target="#Tab-2-{{key}}" role="tab" aria-controls="tab-1-4" aria-selected="true">
                        <h3>Day {{key + 1}}</h3>
                        <span>{{content.field_event_schedule[0]['#paragraph'].field_sessions_date.value|date('F d, Y') }}</span>
                    </a>
                </li>
            {% else %}
                <li class="nav-item">
                    <a class="nav-link show " id="tab-1-4" data-bs-toggle="tab" data-bs-target="#Tab-2-{{key}}" role="tab" aria-controls="tab-1-4" aria-selected="true">
                        <h3>Day {{key + 1}}</h3>
                        <span>{{content.field_event_schedule[key]['#paragraph'].field_sessions_date.value|date('F d, Y') }}</span>
                    </a>
                </li>
            {% endif %}
        {% endfor %}
        </ul>
        <div class="tab-content" id="myTabContent2">
             {% for key,value in content.field_event_schedule['#items'] %}
            {% if key == 0 %}
                <div class="tab-pane fade active show" id="Tab-2-{{key}}" role="tabpanel">
                    <div class="event-lists">
                        {{ content.field_event_schedule[0] }}
                    </div>
                </div>
            {% else %}
            <div class="tab-pane fade " id="Tab-2-{{key}}" role="tabpanel">
                    <div class="event-lists">
                        {{ content.field_event_schedule[key] }}
                    </div>
                </div>
            {% endif %}
            {% endfor %}
        </div>
    </div>
</div>