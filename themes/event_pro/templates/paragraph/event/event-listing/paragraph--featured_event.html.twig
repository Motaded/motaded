<!-- Featured Event -->
<div class="col-lg-4 col-md-6 col-12">
    <div class="item">
        <div class="image">
            <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
            <div class="overlay">
                <a data-fancybox="video-gallery" data-src="{{ content.field_video_link.0['#url'] }}" title="{{ content.field_title.0 }}">
                    <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="130" height="130" viewBox="0 0 130 130">
                        <defs>
                            <linearGradient id="linear-gradient" y1="0.5" x2="1" y2="0.5" gradientUnits="objectBoundingBox">
                            <stop offset="0" stop-color="#fd8a66"/>
                            <stop offset="0.308" stop-color="#fd4c72"/>
                            <stop offset="0.733" stop-color="#fd387c"/>
                            <stop offset="1" stop-color="#fd2384"/>
                            </linearGradient>
                        </defs>
                        <g id="Group_39844" data-name="Group 39844" transform="translate(-2053.715 -2624.715)">
                            <rect id="Rectangle_45" data-name="Rectangle 45" width="130" height="130" rx="65" transform="translate(2053.715 2624.715)" fill="url(#linear-gradient)"/>
                            <path id="Icon_ionic-ios-play" data-name="Icon ionic-ios-play" d="M9,7.79V45.841a.98.98,0,0,0,1.467.9L40.63,27.719a1.078,1.078,0,0,0,0-1.793L10.467,6.9A.971.971,0,0,0,9,7.79Z" transform="translate(2093.66 2662.526)" fill="#fff"/>
                        </g>
                    </svg>
                </a>
            </div>
        </div>
        <div class="item-content">
            <span class="date-style-1">  {{ paragraph.field_date.value|date('M d, Y') }}</span>
            {% if content.field_visiting_link[0] %}
            <h4><a href="{{ content.field_visiting_link.0['#url'] }}" title="{{ content.field_title.0 }}">{{ content.field_title.0 }}</a></h4>
            {% else %}
            <h4>{{ content.field_title.0 }}</h4>
            {% endif %}
            <span>
                <svg xmlns="http://www.w3.org/2000/svg" width="96.667" height="120" viewBox="0 0 96.667 120">
                    <path id="Path_10" data-name="Path 10" d="M52.333,2A48.167,48.167,0,0,0,4,50c0,32.4,42.594,69,44.406,70.56a6.074,6.074,0,0,0,7.854,0C58.375,119,100.667,82.4,100.667,50A48.167,48.167,0,0,0,52.333,2Zm0,105.9c-12.869-12-36.25-37.86-36.25-57.9a36.251,36.251,0,0,1,72.5,0C88.583,70.04,65.2,95.96,52.333,107.9Zm0-81.9A24,24,0,1,0,76.5,50,24.084,24.084,0,0,0,52.333,26Zm0,36A12,12,0,1,1,64.417,50,12.042,12.042,0,0,1,52.333,62Z" transform="translate(-4 -2)" fill="#1a1725"/>
                </svg>{{ content.field_venue.0 }}
            </span>
        </div>
    </div>
</div>