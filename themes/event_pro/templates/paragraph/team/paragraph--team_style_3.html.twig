<!-- Team Style 3 -->
<section class="team-3 dt-section bg-blue">
    <div class="team-style-3">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 col-md-6 col-12">
                    <div class="content">
                        <h2>{{ content.field_title.0 }}</h2>
                        <p>{{ content.field_description.0 }}</p>
                        {%	if  content.field_button_link[0]  %}
                        <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-4 btn-style-sm" title="{{ content.field_button_link.0['#title'] }}">{{ content.field_button_link.0['#title'] }}
                        </a>
                        {% endif %}  
                    </div>
                </div>
                {{ content.field_team_member_ }}
            </div>
        </div>
    </div>
</section>