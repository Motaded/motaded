<!-- Sponsor Section -->
{%	if  content.field_variants.0['#markup'] == "Style 1" %}
<section class="clients-1 dt-section bg-blue">
    <div class="container">
        {% if content.field_title[0]  %}
        <div class="home-1-title">
            <h2>{{ content.field_title.0 }}</h2>
        </div>
        {% endif %}
        <div class="lists">
         {% for key,value in content.field_sponsors['#items'] %}
            <div class="list">
                <div class="client">
                    <img src="{{ file_url(content.field_sponsors['#items'][key].entity.uri.value) }}" alt="{{content.field_sponsors['#items'][key].alt}}" />
                </div>
            </div>
         {% endfor %}
        </div>
        {%	if  content.field_button_link[0]  %}
        <div class="center-btn">
            <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-4 btn-style-sm" title="{{ content.field_button_link.0['#title'] }}">{{ content.field_button_link.0['#title'] }}
            </a>
        </div>
        {% endif %}
    </div>
</section>
{% elseif content.field_variants.0['#markup'] == "Style 2" %}
 {% if 'On' in content.field_bg_color.0 %}
<section class="clients-2 dt-section bg-blue">
{% else %}
<section class="clients-2 dt-section">
{% endif %}
    <div class="container">
        {% if content.field_title[0]  %}
        <div class="home-2-title">
            <span>{{ content.field_tag_line.0 }}</span>
            <h2>{{ content.field_title.0 }}</h2>
            <svg xmlns="http://www.w3.org/2000/svg" width="34.707" height="4.813" viewBox="0 0 34.707 4.813">
                <path id="Path_18" data-name="Path 18" d="M-16839.219-21445.086l3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4" transform="translate(16839.572 21449.191)" fill="none" stroke="#fd4c66" stroke-width="1"/>
            </svg>
        </div>
        {% endif %}
        <div class="clients">
            <div class="row">
            {% for key,value in content.field_sponsors['#items'] %}
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="client">
                        <img src="{{ file_url(content.field_sponsors['#items'][key].entity.uri.value) }}" alt="{{content.field_sponsors['#items'][key].alt}}" />
                    </div>
                </div>
            {% endfor %}
            </div>
        </div>
         {% if 'On' in content.field_bg_color.0 %}
            {%	if  content.field_button_link[0]  %}
            <div class="center-btn">
                <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-4 btn-style-sm" title="{{ content.field_button_link.0['#title'] }}">{{ content.field_button_link.0['#title'] }}
                </a>
            </div>
            {% endif %}
         {% else %}
            {%	if  content.field_button_link[0]  %}
            <div class="center-btn">
                <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-1 btn-style-sm" title="{{ content.field_button_link.0['#title'] }}">{{ content.field_button_link.0['#title'] }}
                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                    <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                </svg>
                </a>
            </div>
            {% endif %}
         {% endif %}
    </div>
</section>
{% else %}
<section class="clients-3 clients-1 dt-section bg-blue">
    <div class="container">
        <div class="lists">
        {% for key,value in content.field_sponsors['#items'] %}
            <div class="list">
                <div class="client">
                    <img src="{{ file_url(content.field_sponsors['#items'][key].entity.uri.value) }}" alt="{{content.field_sponsors['#items'][key].alt}}" />
                </div>
            </div>
         {% endfor %}
        </div>
        {%	if  content.field_button_link[0]  %}
        <div class="center-btn">
            <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-4 btn-style-sm" title="{{ content.field_button_link.0['#title'] }}">{{ content.field_button_link.0['#title'] }}
            </a>
        </div>
        {% endif %}
    </div>
</section>
{% endif %}
