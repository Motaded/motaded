<!-- Contact Section  --> 
{%	if  content.field_style_variant.0['#markup'] == "Variant 1" %}
<section class="contact-3 dt-section">
    <div class="container">
        {% if content.field_title[0] %}
        <div class="home-3-title">
            <h2>{{ content.field_title.0 }}</h2>
            <p>{{ content.field_description.0 }}</p>
        </div>
        {% endif %}
        <div class="row">
            <div class="col-lg-7 col-md-12 col-12">
                <div class="contact-form">
                    <div class="form-style-1">
                        <h3>{{ content.field_form_title.0 }}</h3>
                        {{ content.field_contact_form }}
                    </div>
                </div>
            </div>
            <div class="col-lg-5 col-md-12 col-12">
                <div class="content">
                    <h3>{{ content.field_map_title.0 }}</h3>
                    {{ content.field_map_link.0 }}
                    <ul class="contact-details">
                        <li>
                            <span class="icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                                    <path id="Icon_open-location" data-name="Icon open-location" d="M120,0,0,60,45,75l15,45Z" fill="#1a1725"/>
                                </svg>
                            </span>
                            <a title="Address">{{ content.field_address.0 }}</a>
                        </li>
                        <li>
                            <span class="icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="142.336" height="142.329" viewBox="0 0 142.336 142.329">
                                    <path id="Icon_ionic-ios-call" data-name="Icon ionic-ios-call" d="M121.033,98.465c-4.592-4.592-15.621-11.5-21.057-14.09-6.311-3.03-8.623-2.968-13.09.25-3.718,2.687-6.123,5.186-10.4,4.249-4.28-.906-12.715-7.31-20.9-15.464-8.185-8.185-14.558-16.62-15.464-20.9-.906-4.311,1.593-6.686,4.249-10.4,3.218-4.467,3.312-6.779.25-13.09-2.593-5.467-9.466-16.464-14.09-21.057C25.935,3.367,24.9,4.366,22.373,5.272A46.4,46.4,0,0,0,14.907,9.24C10.314,12.3,7.752,14.864,5.94,18.706,4.16,22.549,2.1,29.7,12.595,48.385c8.466,15.09,16.777,26.524,29.117,38.833h0l.031.031.031.031h0c12.34,12.34,23.743,20.65,38.833,29.117,18.682,10.5,25.837,8.435,29.679,6.654s6.4-4.343,9.466-8.966a46.4,46.4,0,0,0,3.968-7.467C124.626,104.089,125.657,103.058,121.033,98.465Z" transform="matrix(0.978, 0.208, -0.208, 0.978, 21.494, -5.338)" fill="#1a1725"/>
                                </svg>
                            </span>
                            <a href="tel:{{ content.field_contact_number.0 }}" title="Call">{{ content.field_contact_number.0 }}</a>
                        </li>
                        <li>
                            <span class="icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="152.727" height="120" viewBox="0 0 152.727 120">
                                    <path id="Icon_ionic-md-mail" data-name="Icon ionic-md-mail" d="M140.431,5.625H16.8A14.588,14.588,0,0,0,2.25,20.171v90.909A14.588,14.588,0,0,0,16.8,125.625H140.431a14.588,14.588,0,0,0,14.546-14.546V20.171A14.588,14.588,0,0,0,140.431,5.625Zm-1.818,30.909-60,40-60-40V21.989l60,40,60-40Z" transform="translate(-2.25 -5.625)" fill="#1a1725"/>
                                </svg>
                            </span>
                            <a href="mailto:{{ content.field_mail_id.0 }}" title="Mail">{{ content.field_mail_id.0 }}</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
{% else %}
<section class="contact-style-1">
    <div class="map">
        {{ content.field_map_link.0 }}
    </div>
    <div class="container">
        <div class="contact-form">
            <div class="row">
                <div class="col-lg-8 col-md-8 col-12">
                    <div class="form-wrapper">
                        <div class="home-2-title">
                            <span>{{ content.field_form_tag_line.0 }}</span>
                            <h2>{{ content.field_form_title.0 }}</h2>
                            <svg xmlns="http://www.w3.org/2000/svg" width="34.707" height="4.813" viewBox="0 0 34.707 4.813">
                                <path id="Path_18" data-name="Path 18" d="M-16839.219-21445.086l3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4" transform="translate(16839.572 21449.191)" fill="none" stroke="#fd4c66" stroke-width="1"/>
                            </svg>
                        </div>
                        <div class="form-style-1">
                            {{ content.field_contact_form }}
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-12">
                    <div class="image">
                        <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
                    </div>
                </div>
            </div>
        </div>
        <div class="contact-details">
            <div class="detail">
                <h4>
                    <svg xmlns="http://www.w3.org/2000/svg" width="96.667" height="120" viewBox="0 0 96.667 120">
                        <path id="Path_10" data-name="Path 10" d="M52.333,2A48.167,48.167,0,0,0,4,50c0,32.4,42.594,69,44.406,70.56a6.074,6.074,0,0,0,7.854,0C58.375,119,100.667,82.4,100.667,50A48.167,48.167,0,0,0,52.333,2Zm0,105.9c-12.869-12-36.25-37.86-36.25-57.9a36.251,36.251,0,0,1,72.5,0C88.583,70.04,65.2,95.96,52.333,107.9Zm0-81.9A24,24,0,1,0,76.5,50,24.084,24.084,0,0,0,52.333,26Zm0,36A12,12,0,1,1,64.417,50,12.042,12.042,0,0,1,52.333,62Z" transform="translate(-4 -2)" fill="#1a1725"/>
                    </svg>{{ content.field_address_title.0 }}
                </h4>
                <p><a title="Title">{{ content.field_address.0 }}</a></p>
            </div>
            <div class="detail">
                <h4>
                    <svg xmlns="http://www.w3.org/2000/svg" width="142.336" height="142.329" viewBox="0 0 142.336 142.329">
                        <path id="Icon_ionic-ios-call" data-name="Icon ionic-ios-call" d="M121.033,98.465c-4.592-4.592-15.621-11.5-21.057-14.09-6.311-3.03-8.623-2.968-13.09.25-3.718,2.687-6.123,5.186-10.4,4.249-4.28-.906-12.715-7.31-20.9-15.464-8.185-8.185-14.558-16.62-15.464-20.9-.906-4.311,1.593-6.686,4.249-10.4,3.218-4.467,3.312-6.779.25-13.09-2.593-5.467-9.466-16.464-14.09-21.057C25.935,3.367,24.9,4.366,22.373,5.272A46.4,46.4,0,0,0,14.907,9.24C10.314,12.3,7.752,14.864,5.94,18.706,4.16,22.549,2.1,29.7,12.595,48.385c8.466,15.09,16.777,26.524,29.117,38.833h0l.031.031.031.031h0c12.34,12.34,23.743,20.65,38.833,29.117,18.682,10.5,25.837,8.435,29.679,6.654s6.4-4.343,9.466-8.966a46.4,46.4,0,0,0,3.968-7.467C124.626,104.089,125.657,103.058,121.033,98.465Z" transform="matrix(0.978, 0.208, -0.208, 0.978, 21.494, -5.338)" fill="#1a1725"/>
                    </svg>{{ content.field_contact_title.0 }}
                </h4>
                <p><a href="tel:{{ content.field_contact_number.0 }}" title="Title">{{ content.field_contact_number.0 }}</a></p>
            </div>
            <div class="detail">
                <h4>
                    <svg xmlns="http://www.w3.org/2000/svg" width="152.727" height="120" viewBox="0 0 152.727 120">
                        <path id="Icon_ionic-md-mail" data-name="Icon ionic-md-mail" d="M140.431,5.625H16.8A14.588,14.588,0,0,0,2.25,20.171v90.909A14.588,14.588,0,0,0,16.8,125.625H140.431a14.588,14.588,0,0,0,14.546-14.546V20.171A14.588,14.588,0,0,0,140.431,5.625Zm-1.818,30.909-60,40-60-40V21.989l60,40,60-40Z" transform="translate(-2.25 -5.625)" fill="#1a1725"/>
                    </svg>{{ content.field_mail_title.0 }}
                </h4>
                <p><a href="mailto:{{ content.field_mail_id.0 }}" title="Title">{{ content.field_mail_id.0 }}</a></p>
            </div>
        </div>
    </div>
</section>
{% endif %}