<!-- Feature Style 1 -->
 {% if 'Off' in content.field_bg_color.0 %}
<div class="col-lg-4 col-md-6 col-12">
    <div class="item">
        <div class="icon">
            {{ content.field_icon.0 }}
        </div>
        <h4>{{ content.field_title.0 }}</h4>
        <p>{{ content.field_description.0 }}</p>
    </div>
</div>
{% else %}
<div class="col-lg-4 col-md-6 col-12">
    <div class="item">
        <div class="icon">
           {{ content.field_icon.0 }}
        </div>
        <h4>{{ content.field_title.0 }}</h4>
        <p>{{ content.field_description.0 }}</p>
    </div>
</div>
{% endif %}