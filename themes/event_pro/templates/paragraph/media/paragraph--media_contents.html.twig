<!-- Media Section -->
<section class="media-page dt-section">
    <div class="container">
        <div class="media-tab">
            <ul class="nav" id="myTab2" role="tablist">
            {% for key,value in content.field_media_content ['#items'] %}  
                {% if key == 0 %}
                    <li class="nav-item">
                        <a class="nav-link show active" id="tab-{{key}}" data-bs-toggle="tab" data-bs-target="#Tab-2-{{key}}" role="tab" aria-controls="tab-1-4" aria-selected="true">
                            {{content.field_media_content[0]['#paragraph'].field_category.value}}
                        </a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" id="tab-{{key}}" data-bs-toggle="tab" data-bs-target="#Tab-2-{{key}}" role="tab" aria-controls="tab-1-4" aria-selected="true">
                            {{content.field_media_content[key]['#paragraph'].field_category.value}}
                        </a>
                    </li>
                {% endif %}
            {% endfor %}
            </ul>
            <div class="tab-content" id="myTabContent2">
                {{ content.field_media_content }}
            </div>
        </div>
    </div>
</section>