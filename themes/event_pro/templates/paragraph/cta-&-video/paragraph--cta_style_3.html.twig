<!-- Counters Style 1 -->
{% if 'On' in content.field_with_video_section.0 %}
<section class="cta-3 about-us-3 dt-section">
    <div class="container">
        <div class="about-bottom">
            <div class="content">
                <h2>{{ content.field_title.0 }}</h2>
                <p>{{ content.field_description.0 }}</p>
                <div class="about-btns">
                    {%	if  content.field_button_link[0]  %}
                    <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-1 btn-style-sm" title="{{ content.field_button_link.0['#title'] }}">{{ content.field_button_link.0['#title'] }}<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                            <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                        </svg>
                    </a>
                    {% endif %}
                    {%	if  content.field_visit_link[0]  %}
                    <a href="{{ content.field_visit_link.0['#url'] }}" class="btn btn-primary btn-style-3 btn-style-sm" title="{{ content.field_visit_link.0['#title'] }}"><span>{{ content.field_visit_link.0['#title'] }}</span><svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                            <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                        </svg>
                    </a>
                    {% endif %}
                </div>
            </div>
            <div class="video-style-2">
                <div class="item">
                    <div class="image">
                        <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
                        <div class="overlay">
                            <a data-fancybox="video-gallery" data-src="{{ content.field_video_link.0['#url'] }}" title="video">
                                <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="130" height="130" viewBox="0 0 130 130">
                                    <defs>
                                        <linearGradient id="linear-gradient" y1="0.5" x2="1" y2="0.5" gradientUnits="objectBoundingBox">
                                        <stop offset="0" stop-color="#fd8a66"/>
                                        <stop offset="0.308" stop-color="#fd4c72"/>
                                        <stop offset="0.733" stop-color="#fd387c"/>
                                        <stop offset="1" stop-color="#fd2384"/>
                                        </linearGradient>
                                    </defs>
                                    <g id="Group_39844" data-name="Group 39844" transform="translate(-2053.715 -2624.715)">
                                        <rect id="Rectangle_45" data-name="Rectangle 45" width="130" height="130" rx="65" transform="translate(2053.715 2624.715)" fill="url(#linear-gradient)"/>
                                        <path id="Icon_ionic-ios-play" data-name="Icon ionic-ios-play" d="M9,7.79V45.841a.98.98,0,0,0,1.467.9L40.63,27.719a1.078,1.078,0,0,0,0-1.793L10.467,6.9A.971.971,0,0,0,9,7.79Z" transform="translate(2093.66 2662.526)" fill="#fff"/>
                                    </g>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% else %}
<section class="cta-3 about-us-3 dt-section">
    <div class="container">
        <div class="about-bottom">
            <div class="content">
                <h2>{{ content.field_title.0 }}</h2>
                <p>{{ content.field_description.0 }}</p>
                <div class="about-btns">
                    {%	if  content.field_button_link[0]  %}
                    <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-1 btn-style-sm" title="{{ content.field_button_link.0['#title'] }}">{{ content.field_button_link.0['#title'] }}<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                            <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                        </svg>
                    </a>
                    {% endif %}
                    {%	if  content.field_visit_link[0]  %}
                    <a href="{{ content.field_visit_link.0['#url'] }}" class="btn btn-primary btn-style-3 btn-style-sm" title="{{ content.field_visit_link.0['#title'] }}"><span>{{ content.field_visit_link.0['#title'] }}</span><svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                            <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                        </svg>
                    </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}