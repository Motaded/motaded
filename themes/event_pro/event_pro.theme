/**
 * Implements hook_preprocess_page() for settings form.
 *
 * Replace Barrio setting options with subtheme ones.
 *
 */
function event_pro_preprocess_page(&$variables) {
//Setting Pannel 
$variables['header_variation'] = theme_get_setting('header_variation');
$variables['show_pannel'] = theme_get_setting('show_pannel');
$variables['sticky'] = theme_get_setting('sticky');
$variables['loader'] = theme_get_setting('loader');
$variables['scroll_top'] = theme_get_setting('scroll_top');
$variables['styles'] = theme_get_setting('styles');
//Hamburger
  $variables['about_title'] = theme_get_setting('about_title');
  $variables['about_site'] = theme_get_setting('about_site');
  $variables['contact_title'] = theme_get_setting('contact_title');
//General Site Details
  $variables['contact_info_title'] = theme_get_setting('contact_info_title'); 
  $variables['address'] = theme_get_setting('address');
  $variables['contact_number'] = theme_get_setting('contact_number');
  $variables['mail_id'] = theme_get_setting('mail_id');
// CopyRight
  $variables['copyright_detail'] = theme_get_setting('copyright_detail')['value'];
//Menu Button
  $variables['button_text'] = theme_get_setting('button_text');
  $variables['button_title'] = theme_get_setting('button_title');
  $variables['button_link'] = theme_get_setting('button_link');
//Page Banner 
  $path = "";
  if (!empty(theme_get_setting('banner_bg'))) {
    $fid = theme_get_setting('banner_bg')[0];
    if (!empty($fid)) {
    $file =File::load($fid);
    $path = Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
    }
  }
  $variables['banner_bg'] = $path;
//Search Banner Title
  $variables['search_banner_title'] = theme_get_setting('search_banner_title');
}
