//--------------FORM ALTER----------------->
function event_pro_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if($form_id == 'user_login_form'){
    $form['name']['#placeholder']= 'Enter your Name';
    $form['pass']['#placeholder'] = t('Enter your Password');
  }

  if($form_id == 'user_register_form'){
    $form['account']['mail']['#placeholder']= 'Enter your email';
    $form['account']['name']['#placeholder']= 'Enter your name';
    $form['actions']['submit']['#value'] = t('Register');  
  }

  if($form_id == 'user_pass'){
    $form['name']['#attributes']['placeholder']= 'Enter your name or email';
    $form['actions']['submit']['#value'] = t('Reset');  
  }
}

function event_pro_theme(&$existing, $type, $theme, $path) {
  $hooks = array();
  $hooks['user_login_form'] = array(
   'render element' => 'form',
   'template' => 'user-login-form',
   'preprocess functions' => array(
      'event_pro_preprocess_user_login'
   ),
  );
  $hooks['user_register_form'] = array(
   'render element' => 'form',
   'template' => 'user-register-form',
   'preprocess functions' => array(
      'event_pro_preprocess_user_register'
   ),
  );
  $hooks['user_pass'] = array(
   'render element' => 'form',
   'template' => 'user-pass-form',
   'preprocess functions' => array(
      'event_pro_preprocess_user_pass'
   ),
  );
  return $hooks;  
}
