<?php

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_alter().
 */

function email_verification_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if ($form_id === 'webform_submission_book_a_free_consultation_add_form') {
    // Add a Verify Email button.
    $form['actions']['verify_email'] = [
      '#type' => 'submit',
      '#value' => t('Verify Email'),
      '#ajax' => [
        'callback' => 'email_verification_ajax_callback',
        'wrapper' => 'otp-wrapper',  // The element to be updated.
        'event' => 'click',  // Ensure AJAX is triggered on click event.
        'effect' => 'fade',  // Optional: Add a fade effect on update.
      ],
    ];

    // Add the OTP field (initially hidden).
    $form['otp'] = [
      '#type' => 'textfield',
      '#title' => t('Enter OTP'),
      '#description' => t('Check your email for the OTP.'),
      '#required' => FALSE,
      '#prefix' => '<div id="otp-wrapper">',
      '#suffix' => '</div>',
    ];

    // Add custom validation handler.
    $form['#validate'][] = 'email_verification_validate_submission';
  }
}


/**
 * Custom submit handler to send OTP.
 */
function email_verification_send_otp(array &$form, FormStateInterface $form_state) {
  \Drupal::logger('email_verification')->notice('Inside email_verification_send_otp submit handler.');

  // Get the email from the form state.
  $email = $form_state->getValue('email');
  if ($email) {
    \Drupal::logger('email_verification')->notice('Email received: {email}', ['email' => $email]);

    // Generate a random 6-digit OTP.
    $otp = random_int(100000, 999999);
    \Drupal::logger('email_verification')->notice('Generated OTP: {otp} for email: {email}.', [
      'otp' => $otp,
      'email' => $email,
    ]);

    // Store OTP securely using State API.
    \Drupal::state()->set('email_verification_otp_' . $email, $otp);

    // Attempt to send email.
    $mail_manager = \Drupal::service('plugin.manager.mail');
    $module = 'email_verification';
    $key = 'otp';
    $to = $email;
    $params['otp'] = $otp;
    $params['message'] = t('Your One-Time Password (OTP) for email verification is: @otp', ['@otp' => $otp]); // Adding OTP to the message.
    $language_code = \Drupal::currentUser()->getPreferredLangcode();
    $send = TRUE;

    // Log before attempting to send the email
    \Drupal::logger('email_verification')->notice('Attempting to send OTP email to: {email}.', ['email' => $email]);

    $result = $mail_manager->mail($module, $key, $to, $language_code, $params, NULL, $send);

    if ($result['result'] !== TRUE) {
      \Drupal::logger('email_verification')->error('Failed to send OTP email to: {email}.', ['email' => $email]);
      \Drupal::messenger()->addError(t('There was a problem sending the OTP email.'));
    } else {
      \Drupal::logger('email_verification')->notice('Successfully sent OTP: {otp} to email: {email}.', [
        'otp' => $otp,
        'email' => $email,
      ]);
      \Drupal::messenger()->addStatus(t('An OTP has been sent to your email. Please check your inbox.'));

      // Add code to hide the button after successful email sending
      $form['actions']['verify_email']['#access'] = FALSE; // Hide the "Verify Email" button.
    }
  } else {
    \Drupal::logger('email_verification')->error('Attempted to send OTP but email field was empty or invalid.');
    \Drupal::messenger()->addError(t('Please provide a valid email address.'));
  }

  // Return the updated form part to be re-rendered (OTP field).
  return $form['otp'];
}

/**
 * Ajax callback for the Verify Email button.
 */
function email_verification_ajax_callback(array &$form, FormStateInterface $form_state) {
  \Drupal::logger('email_verification')->notice('AJAX callback triggered for OTP field.');

  // Get the email from the form state (ensure email field exists in form).
  $email = $form_state->getValue('email');
  if ($email) {
    \Drupal::logger('email_verification')->notice('Email received: {email}', ['email' => $email]);

    // Generate a random 6-digit OTP.
    $otp = random_int(100000, 999999);
    \Drupal::logger('email_verification')->notice('Generated OTP: {otp} for email: {email}.', [
      'otp' => $otp,
      'email' => $email,
    ]);

    // Store OTP securely using State API.
    \Drupal::state()->set('email_verification_otp_' . $email, $otp);

    $mailManager = \Drupal::service('plugin.manager.mail');
	$module = 'email_verification'; // Replace with your module name.
	$key = 'email_verification_otp';
	$params['message'] = t('Your OTP for email verification is: @otp', ['@otp' => $otp]);
	$params['subject'] = t('Email Verification OTP');
	$to = $email;
	$langcode = \Drupal::currentUser()->getPreferredLangcode();
	$send = TRUE;

    // Log before attempting to send the email
    \Drupal::logger('email_verification')->notice('Attempting to send OTP email to: {email}.', ['email' => $email]);
	$result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, $send);

    if ($result['result'] !== TRUE) {
      \Drupal::logger('email_verification')->error('Failed to send OTP email to: {email}.', ['email' => $email]);
      \Drupal::messenger()->addError(t('There was a problem sending the OTP email.'));
    } else {
      \Drupal::logger('email_verification')->notice('Successfully sent OTP: {otp} to email: {email}.', [
        'otp' => $otp,
        'email' => $email,
      ]);
      \Drupal::messenger()->addStatus(t('An OTP has been sent to your email. Please check your inbox.'));
    }
  } else {
    \Drupal::logger('email_verification')->error('Attempted to send OTP but email field was empty or invalid.');
    \Drupal::messenger()->addError(t('Please provide a valid email address.'));
  }

  // Return the updated form part to be re-rendered (OTP field).
  return $form['otp'];
}


/**
 * Custom validation handler for the webform.
 */
function email_verification_validate_submission(array &$form, FormStateInterface $form_state) {
  $email = $form_state->getValue('email');
  $otp = $form_state->getValue('otp');

  // Check if the email is verified.
  if ($email) {
    $stored_otp = \Drupal::state()->get('email_verification_otp_' . $email);

    if ($stored_otp && $stored_otp == $otp) {
      \Drupal::logger('email_verification')->notice('OTP verified for email: {email}.', ['email' => $email]);
      return; // OTP correct, proceed.
    }

    // If OTP doesn't match or isn't entered.
    if (!$otp) {
      $form_state->setErrorByName('otp', t('Please verify your email by entering the OTP sent to your email address.'));
    } else {
      $form_state->setErrorByName('otp', t('The OTP you entered is incorrect.'));
    }
  } else {
    $form_state->setErrorByName('email', t('Email address is required.'));
  }
}


/**
 * Implements hook_mail().
 */
function email_verification_mail($key, &$message, $params) {
  switch ($key) {
    case 'email_verification_otp':
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['message'];
      break;
  }
}