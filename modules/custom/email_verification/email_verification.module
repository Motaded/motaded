<?php

/**
 * @file
 * Email OTP gate before webform submission (modal + private tempstore).
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_form_alter().
 */
function email_verification_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $webform_id = $form['#webform_id'] ?? NULL;
  if (!$webform_id) {
    return;
  }
  /** @var \Drupal\email_verification\EmailVerificationOtpManager $otp_manager */
  $otp_manager = \Drupal::service('email_verification.otp_manager');
  $protected = $otp_manager->getAllowedWebforms();
  if (!isset($protected[$webform_id])) {
    return;
  }
  $config = $protected[$webform_id];

  $form['#attached']['library'][] = 'email_verification/modal';
  $form['#attached']['drupalSettings']['emailVerification'] = [
    'csrfToken' => \Drupal::csrfToken()->get('rest'),
    'webformId' => $webform_id,
    'emailElementName' => $config['email_element'],
  ];
  $form['#attributes']['data-email-verification'] = $webform_id;

  $form['#validate'][] = 'email_verification_validate_submission';
}

/**
 * Validates that the email was verified via OTP in this session.
 */
function email_verification_validate_submission(array &$form, FormStateInterface $form_state) {
  $webform_id = $form['#webform_id'] ?? NULL;
  if (!$webform_id) {
    return;
  }
  /** @var \Drupal\email_verification\EmailVerificationOtpManager $otp_manager */
  $otp_manager = \Drupal::service('email_verification.otp_manager');
  if (!$otp_manager->isWebformAllowed($webform_id)) {
    return;
  }
  $email_key = $otp_manager->getEmailElementKey($webform_id);
  if (!$email_key) {
    return;
  }
  $email = $form_state->getValue($email_key);
  if ($email === NULL || $email === '') {
    return;
  }
  if (!$otp_manager->isVerified($webform_id, (string) $email)) {
    $form_state->setErrorByName(
      $email_key,
      t('Please confirm your email with the verification code before submitting.'),
    );
  }
}

/**
 * Implements hook_webform_submission_insert().
 */
function email_verification_webform_submission_insert(WebformSubmissionInterface $webform_submission) {
  $webform_id = $webform_submission->getWebform()->id();
  /** @var \Drupal\email_verification\EmailVerificationOtpManager $otp_manager */
  $otp_manager = \Drupal::service('email_verification.otp_manager');
  if (!$otp_manager->isWebformAllowed($webform_id)) {
    return;
  }
  $email_key = $otp_manager->getEmailElementKey($webform_id);
  if (!$email_key) {
    return;
  }
  $data = $webform_submission->getData();
  $email = $data[$email_key] ?? '';
  if ($email !== '') {
    $otp_manager->clearVerification($webform_id, (string) $email);
  }
}

/**
 * Implements hook_theme().
 */
function email_verification_theme($existing, $type, $theme, $path) {
  return [
    'email_verification_otp' => [
      'variables' => [
        'site_url' => '',
        'otp_code' => '',
        'expiry_minutes' => 10,
        'year' => '',
      ],
      'template' => 'email-verification-otp',
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function email_verification_mail($key, &$message, $params) {
  switch ($key) {
    case 'email_verification_otp':
      $message['subject'] = trim((string) ($params['subject'] ?? ''));
      $html = (string) ($params['html_body'] ?? '');
      $message['body'][] = \Drupal\Core\Render\Markup::create($html);
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      break;
  }
}
