{#
/**
 * @file
 * HTML body for OTP verification email (transactional).
 */
#}
<!DOCTYPE html>
<html lang="{{ langcode }}" dir="{{ text_direction }}" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="x-apple-disable-message-reformatting" />
  <title>{{ 'Your verification code'|t }}</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:#f0f4f2;-webkit-font-smoothing:antialiased;" dir="{{ text_direction }}">
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">
    {% trans %}Your Motaded verification code is ready. It expires in {{ expiry_minutes }} minutes.{% endtrans %}
  </div>

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f0f4f2;" dir="{{ text_direction }}">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="max-width:600px;margin:0 auto;">

          <tr>
            <td style="background-color:#ffffff;border-bottom:3px solid #006b44;border-radius:12px 12px 0 0;padding:24px 32px;text-align:center;">
              <a href="{{ site_url }}" target="_blank" style="text-decoration:none;display:inline-block;">
                <img
                  src="{{ site_url }}/themes/custom/motaded_theme/logo.svg"
                  width="220"
                  height="41"
                  alt="{{ 'Motaded'|t }}"
                  style="display:block;border:0;outline:none;text-decoration:none;height:auto;max-width:220px;width:100%;"
                />
              </a>
            </td>
          </tr>

          <tr>
            <td style="background-color:#ffffff;padding:0;">
              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td style="padding:36px 32px 8px 32px;">
                    <h1 style="margin:0 0 12px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:24px;line-height:1.3;font-weight:700;letter-spacing:-0.02em;color:#0f2a1d;">
                      {{ 'Verify your email'|t }}
                    </h1>
                    <p style="margin:0 0 20px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:16px;line-height:1.6;color:#374151;">
                      {% trans %}You’re almost done. To continue with your form submission, use the verification code below. We sent this message because someone entered this email address on the Motaded website.{% endtrans %}
                    </p>
                  </td>
                </tr>
                <tr>
                  <td style="padding:0 32px 28px 32px;">
                    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;">
                      <tr>
                        <td style="padding:24px 20px;text-align:center;">
                          <p style="margin:0 0 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:12px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#166534;">
                            {{ 'Your code'|t }}
                          </p>
                          <p style="margin:0;font-family:'SF Mono',Consolas,'Liberation Mono',Menlo,monospace;font-size:32px;font-weight:700;letter-spacing:0.2em;color:#0f2a1d;line-height:1.2;" dir="ltr">
                            {{ otp_code }}
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td style="padding:0 32px 32px 32px;">
                    <p style="margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:14px;line-height:1.6;color:#6b7280;">
                      {% trans %}This code expires in <strong style="color:#0f2a1d;">{{ expiry_minutes }} minutes</strong>. If you didn’t request it, you can safely ignore this email — your account details won’t be changed.{% endtrans %}
                    </p>
                    <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:14px;line-height:1.6;color:#6b7280;">
                      {% trans %}For your security, never share this code with anyone. Motaded staff will never ask you for it by phone or chat.{% endtrans %}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="background-color:#006b44;border-radius:0 0 12px 12px;padding:22px 28px;text-align:center;">
              <p style="margin:0 0 10px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:12px;line-height:1.55;color:#ecfdf5;">
                <a href="{{ site_url }}" style="color:#ffffff;text-decoration:underline;font-weight:600;">motaded.com.sa</a>
              </p>
              <p style="margin:0 0 14px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:12px;line-height:1.55;color:#d1fae5;">
                {% trans %}Motaded Consultancy is a premier firm facilitating Business Setup in Saudi Arabia.{% endtrans %}
              </p>
              <p style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;font-size:11px;line-height:1.5;color:#bbf7d0;">
                {% trans %}ⓒ {{ year }} Motaded Consultancy. All Rights Reserved.{% endtrans %}<br />
                {% trans %}This is an automated message — please do not reply to this email.{% endtrans %}
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
