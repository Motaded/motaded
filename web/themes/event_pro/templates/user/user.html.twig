{% set base_url = url('<front>')  %}
<section class="page-banner" style="background-image: url({{ file_url(content.field_banner_image['#items'].entity.uri.value) }});">
    <div class="container">
        <div class="heading">
            <h1>{{ user.displayname }}</h1>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('<front>') }}">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ user.displayname }}</li>
            </ol>
        </div>
    </div>
</section>
{% if content.field_designation[0] %}
{% if 'Off' in content.field_with_sidebar.0 %}
<section class="team-subpage dt-section">
    <div class="container">
        <div class="full-width">
            <div class="profile">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-12">
                    {% if content.user_picture %}
                        <a class="image" title="{{ user.displayname }}">
                            {{content.user_picture.0}}
                        </a>
                    {% endif %}
                    </div>
                    <div class="col-lg-6 col-md-6 col-12">
                        <div class="profile-content">
                            <div class="content-head">
                                <h2><a title="{{ user.displayname }}">{{ user.displayname }}</a></h2>
                                {% if content.field_designation[0] %}
                                <h4>{{ content.field_designation.0 }}</h4>
                                {% endif %}
                            </div>
                            {% if content.field_description[0] %}
                            <div class="content-body">
                                {% if content.field_description[0] %}
                                <p>{{ content.field_description.0 }}</p>
                                {% endif %}
                                {% if content.field_description[0] %}
                                {{ content.field_social_profile }}
                                {% endif %}
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
            {% if content.field_session_list_title[0] %}
            <div class="event-lists">
                <h2>{{ content.field_session_list_title.0 }} {{ user.displayname }}</h2>
                {{ content.field_sessions }}
            </div>
            {% endif %} 
        </div>
    </div>
</section>
{% else %}
<section class="team-subpage sidebar-page dt-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-md-12 col-12">
                <div class="full-width">
                    <div class="profile">
                        {% if content.user_picture %}
                            <a class="image" title="{{ user.displayname }}">
                                {{content.user_picture.0}}
                            </a>
                        {% endif %}
                        <div class="profile-content">
                           <h2><a title="{{ user.displayname }}">{{ user.displayname }}</a></h2>
                            {% if content.field_designation[0] %}
                            <h4>{{ content.field_designation.0 }}</h4>
                            {% endif %}
                            {% if content.field_description[0] %}
                            <p>{{ content.field_description.0 }}</p>
                            {{ content.field_social_profile }}
                            {% endif %}  
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 col-12">
                <div class="sidebar">
                    <div class="subpage-title">
                        <h3>{{ content.field_session_list_title.0 }} {{ user.displayname }}</h3>
                        <svg xmlns="http://www.w3.org/2000/svg" width="34.707" height="4.813" viewBox="0 0 34.707 4.813">
                            <path id="Path_18" data-name="Path 18" d="M-16839.219-21445.086l3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4" transform="translate(16839.572 21449.191)" fill="none" stroke="#fd4c66" stroke-width="1"/>
                        </svg>
                    </div>
                    <div class="session-lists">
                    {{ content.field_events_sidebar }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endif %}
{% else %}
<section class="team-subpage dt-section">
    <div class="container">
        <div class="full-width">
            <div class="profile">
                <div class="row">
                    <div class="col-lg-6 col-md-6 col-12">
                    {% if content.user_picture[0] %}
                        <a class="image" title="{{ user.displayname }}">
                            {{content.user_picture.0}}
                        </a>
                    {% else %}
                        <a class="image" title="{{ user.displayname }}">
                            <img src="{{base_url}}/themes/custom/event_pro/assets/img/user.jpeg" alt="{{ user.displayname }}">
                        </a>
                    {% endif %}
                    </div>
                    <div class="col-lg-6 col-md-6 col-12">
                        <div class="profile-content">
                            <div class="content-head">
                                <h2><a title="{{ user.displayname }}">{{ user.displayname }}</a></h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% if content.field_session_list_title[0] %}
            <div class="event-lists">
                <h2>{{ content.field_session_list_title.0 }} {{ user.displayname }}</h2>
                {{ content.field_sessions }}
            </div>
            {% endif %} 
        </div>
    </div>
</section>
{% endif %}