<!--Footer-->
<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <div class="row">
                <div class="col-lg-4 col-md-6 col-12">
                    <div class="footer-1">
                       {% if contact_info_title %}
                        <h3>{{contact_info_title}}</h3>
                        {% endif %}
                        <ul class="contact-details">
                            {% if address %}
                            <li>
                                <span class="icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                                        <path id="Icon_open-location" data-name="Icon open-location" d="M120,0,0,60,45,75l15,45Z" fill="#1a1725"/>
                                    </svg>
                                </span>
                                <a title="Address">{{address}}</a>
                            </li>
                            {% endif %}
                            {% if contact_number %}
                            <li>
                                <span class="icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="142.336" height="142.329" viewBox="0 0 142.336 142.329">
                                        <path id="Icon_ionic-ios-call" data-name="Icon ionic-ios-call" d="M121.033,98.465c-4.592-4.592-15.621-11.5-21.057-14.09-6.311-3.03-8.623-2.968-13.09.25-3.718,2.687-6.123,5.186-10.4,4.249-4.28-.906-12.715-7.31-20.9-15.464-8.185-8.185-14.558-16.62-15.464-20.9-.906-4.311,1.593-6.686,4.249-10.4,3.218-4.467,3.312-6.779.25-13.09-2.593-5.467-9.466-16.464-14.09-21.057C25.935,3.367,24.9,4.366,22.373,5.272A46.4,46.4,0,0,0,14.907,9.24C10.314,12.3,7.752,14.864,5.94,18.706,4.16,22.549,2.1,29.7,12.595,48.385c8.466,15.09,16.777,26.524,29.117,38.833h0l.031.031.031.031h0c12.34,12.34,23.743,20.65,38.833,29.117,18.682,10.5,25.837,8.435,29.679,6.654s6.4-4.343,9.466-8.966a46.4,46.4,0,0,0,3.968-7.467C124.626,104.089,125.657,103.058,121.033,98.465Z" transform="matrix(0.978, 0.208, -0.208, 0.978, 21.494, -5.338)" fill="#1a1725"/>
                                    </svg>
                                </span>
                                <a href="tel:{{contact_number}}" title="Call">{{contact_number}}</a>
                            </li>
                            {% endif %}
                            {% if mail_id %}
                            <li>
                                <span class="icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="152.727" height="120" viewBox="0 0 152.727 120">
                                        <path id="Icon_ionic-md-mail" data-name="Icon ionic-md-mail" d="M140.431,5.625H16.8A14.588,14.588,0,0,0,2.25,20.171v90.909A14.588,14.588,0,0,0,16.8,125.625H140.431a14.588,14.588,0,0,0,14.546-14.546V20.171A14.588,14.588,0,0,0,140.431,5.625Zm-1.818,30.909-60,40-60-40V21.989l60,40,60-40Z" transform="translate(-2.25 -5.625)" fill="#1a1725"/>
                                    </svg>
                                </span>
                                <a href="mailto:{{mail_id}}" title="Mail">{{mail_id}}</a>
                            </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6 col-12">
                    <div class="footer-2">
                        {{page.footer_second}}
                    </div>
                </div>
                <div class="col-lg-5 col-md-12 col-12">
                    <div class="footer-3">
                        <div class="subscribe">
                            {{page.footer_third}}
                        </div>
                        <div class="tickets">
                        {% if button_title %}
                            <h3>{{button_title}}</h3>
                        {% endif %}
                        {% if button_link %}
                            <a href="{{button_link}}" class="btn btn-primary btn-style-1 btn-style-sm" title="{{button_text}}">{{button_text}}<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                                    <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                                </svg>
                            </a>
                        {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copyrights">
            {{page.footer_fourth}}
            <div class="item">
                {{copyright_detail|raw}}
                {{page.footer_fifth}}
            </div>
        </div>
    </div>
</footer>
{% if scroll_top == 1 %}
<!--Back to Top -->
<a href="#" class="back-to-top d-flex align-items-center justify-content-center active">
{% else %}
<!--Back to Top -->
<a href="#" class="back-to-top d-none align-items-center justify-content-center active">
{% endif %}
    <svg xmlns="http://www.w3.org/2000/svg" width="45" height="45" viewBox="0 0 45 45">
        <g transform="translate(45) rotate(90)">
            <g transform="translate(35.438 45) rotate(180)">
                <path d="M25.792,21.463,4.779.451a1.418,1.418,0,0,0-2.074,0L.451,2.706a1.418,1.418,0,0,0,0,2.074L18.171,22.5.451,40.221a1.418,1.418,0,0,0,0,2.074l2.254,2.254a1.419,1.419,0,0,0,2.074,0L25.791,23.538a1.42,1.42,0,0,0,0-2.075Z"></path>
            </g>
        </g>
    </svg>
</a>
