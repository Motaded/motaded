{% set paragraph_parent = paragraph.getParentEntity() %}
{% set variant = paragraph_parent.field_style_variant.value %}
{% if variant in 'Variant 1' %}	
<div class="col-lg-6 col-md-12 col-12">
    <div class="item">
        <span>{{ content.field_year.0 }}</span>
        <div class="item-content">
            <h4>{{ content.field_title.0 }}</h4>
            <p>{{ content.field_description.0 }}</p>
        </div>
    </div>
</div>
{% else %}
<div class="history-list">
    <div class="row">
        <div class="col-lg-2 col-md-1 col-1">
            <div class="year">
                <span>{{ content.field_year.0 }}</span>
            </div>
        </div>
        <div class="col-lg-10 col-md-11 col-11">
            <div class="content">
                <div class="image">
                    <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
                </div>
                <div class="content-item">
                    <h4>{{ content.field_title.0 }}</h4>
                    <p>{{ content.field_description.0 }}</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}