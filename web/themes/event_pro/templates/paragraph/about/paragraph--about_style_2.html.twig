<!-- About Style 2 -->
<section class="about-us-2 dt-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-6  col-12">
                <div class="content">
                    <div class="home-2-title">
                        <h2>{{ content.field_title.0 }}</h2>
                        <svg xmlns="http://www.w3.org/2000/svg" width="34.707" height="4.813" viewBox="0 0 34.707 4.813">
                            <path id="Path_18" data-name="Path 18" d="M-16839.219-21445.086l3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4,3.4-3.4,3.4,3.4" transform="translate(16839.572 21449.191)" fill="none" stroke="#fd4c66" stroke-width="1"/>
                        </svg>
                    </div>
                    {{ content.field_about_description.0 }}
                    <ul class="list-style-1">
                    {% for key,value in content.field_about_list['#items'] %}
                        <li>
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="130.909" height="120" viewBox="0 0 130.909 120">
                                    <path id="Path_224" data-name="Path 224" d="M266.345,279.718,209.2,236.49l10.562-13.884,42.346,32.034,63.46-94.922,14.541,9.666Z" transform="translate(-209.2 -159.718)" fill="#1a1725"/>
                                </svg>
                            </span>{{ content.field_about_list[key] }}
                        </li>
                    {% endfor %}
                    </ul>
                </div>
            </div>
            <div class="col-lg-6  col-12">
                <div class="image">
                    <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
                </div>
            </div>
        </div>
    </div>
</section>