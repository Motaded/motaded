<!-- Counters Style 1 -->
{% if 'On' in content.field_with_video_section.0 %}
<section class="video-counter-1">
    <div class="row">
        <div class="col-lg-7 col-md-12 col-12">
            <div class="image">
                <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
                <div class="overlay">
                    <a data-fancybox="video-gallery" data-src="{{ content.field_video_link.0['#url'] }}"  title="video">
                        <svg xmlns="http://www.w3.org/2000/svg" width="90" height="90" viewBox="0 0 90 90">
                            <g id="Group_37" data-name="Group 37" transform="translate(-725 -3349)">
                                <g id="Rectangle_45" data-name="Rectangle 45" transform="translate(725 3349)" fill="rgba(255,255,255,0)" stroke="#fff" stroke-width="2">
                                <rect width="90" height="90" rx="4" stroke="none"/>
                                <rect x="1" y="1" width="88" height="88" rx="3" fill="none"/>
                                </g>
                                <path id="Icon_ionic-ios-play" data-name="Icon ionic-ios-play" d="M9,7.334V28.666a.549.549,0,0,0,.823.506l16.91-10.666a.6.6,0,0,0,0-1.005L9.823,6.834A.544.544,0,0,0,9,7.334Z" transform="translate(752 3376.248)" fill="#fff"/>
                            </g>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
        <div class="col-lg-5 col-md-12 col-12">
            <div class="counter-style-1 dt-section">
                <div class="row">
                    {{ content.field_counter_style_1 }}
                </div>
            </div>
        </div>
    </div>
</section>
{% else %}
<section class="counters-2 dt-section">
    <div class="counter-style-1">
        <div class="container">
            <div class="row">
                {{ content.field_counter_style_1 }}
            </div>
        </div>
    </div>
</section>
{% endif %}