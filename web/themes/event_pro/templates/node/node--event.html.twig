
<div class="full-width">
    <div class="banner">
        <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
    </div>
    <div class="event-description-schedule">
        <ul class="nav" id="myTab1" role="tablist">
            <li class="nav-item">
                <a class="nav-link show active" id="tab-1-1" data-bs-toggle="tab" data-bs-target="#Tab-1-1" role="tab" aria-controls="tab-1-4" aria-selected="true">
                    {{ content.field_description_title.0 }}
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="tab-1-2" data-bs-toggle="tab" data-bs-target="#Tab-1-2" role="tab" aria-controls="tab-2-4" aria-selected="true">
                    {{ content.field_schedule_title.0 }}
                </a>
            </li>
        </ul>
        <div class="tab-content" id="myTabContent2">
            <div class="tab-pane fade active show" id="Tab-1-1" role="tabpanel">
                <div class="event-description">
                    {% for key,value in content.field_contents['#items'] %}
                    <div class="content-item">
                        {{ content.field_contents[key] }}   
                    </div>
                    {% endfor %}
                    <div class="content-item">  
                        <h3>{{ content.field_event_detail_caption.0 }}</h3>
                        <p>{{ content.field_event_detail_description.0 }}</p>
                        <ul class="details">
                            <li><span>{{ content.field_start_date_title.0 }} : </span>{{ node.field_start_date.value|date('F d,Y')  }}</li>
                            {%	if  content.field_end_date[0]  %}
                            <li><span>{{ content.field_end_date_title.0 }} : </span>{{ node.field_end_date.value|date('F d, Y')  }}</li>
                            {% endif %}
                            <li><span>{{ content.field_timing_title.0 }} : </span>{{ content.field_timing_.0 }}</li>
                            <li><span>{{ content.field_venue_title.0 }} : </span>{{ content.field_venue.0 }}</li>
                        </ul>
                        {% if content.field_ticket_price[0] %}
                            {%	if  content.field_button_link[0]  %}
                            <a href="{{ content.field_button_link.0['#url'] }}" class="btn btn-primary btn-style-1 btn-style-sm" title="Title">{{ content.field_button_link.0['#title'] }}
                                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                                        <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                                </svg>
                            </a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="Tab-1-2" role="tabpanel">
            {{ content.field_schedule }}
            </div>
        </div>
    </div>
</div>
