<section class="award-details-page dt-section">
    <div class="container">
        <div class="content">
            <img src="{{ file_url(content.field_image['#items'].entity.uri.value) }}"  alt="{{content.field_image['#items'].alt}}" />
            {{ content.body.0 }}
            <div class="details">
                <div class="detail">
                    <h4>{{ content.field_caption_1_title.0 }}</h4>
                    <span>{{ content.field_caption_1.0 }}</span>
                </div>
                <div class="detail">
                    <h4>{{ content.field_caption_2_title.0 }}</h4>
                    <span>{{ content.field_caption_2.0 }}</span>
                </div>
            </div>
        </div>
    </div>
</section>