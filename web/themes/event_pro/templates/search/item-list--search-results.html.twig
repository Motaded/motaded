<section class="search-result dt-section">
    <div class="container">
        <div class="search-form">
             <form action="{{base_url}}/search/node" method="get">
                <input class="form-control" type="search" placeholder="Type Something..." aria-label="Search" name="keys">
                <button class="btn btn-primary" type="submit">
                    Search
                </button>
            </form>
            <h2>Search Result - "{{ keyword }}"</h2>
            <p>We found {{total_items_count}} Search results for you</p>
        </div>
        <p class="result-no">Showing {{total_items_count}} Search results</p>
        <div class="search-list">
            {%- if title is not empty -%}
              <h3>{{ title }}</h3>
            {%- endif -%}
            {%- if items -%}
              {%- for item in items -%}
                {{ item.value }}
              {%- endfor -%}
            {%- else -%}
              {{- empty -}}
            {%- endif -%}
        </div>
    </div>
</section>