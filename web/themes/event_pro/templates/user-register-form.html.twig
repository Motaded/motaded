{% set base_url = url('<front>')  %}

{% if register_banner_title %}
<section class="page-banner" style="background-image: url('{{banner_bg}}');">
    <div class="container">
        <div class="heading">
            <h1>{{register_banner_title}}</h1>
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{base_url}}">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{register_banner_title}}</li>
            </ol>
        </div>
    </div>
</section>
{% endif %}
<section class="register-page dt-section">
    <div class="container">
        <div class="form-style-3">
            <div class="head">
                {% if register_title %}
                    <h3>{{register_title}}</h3>
                {% endif %}
            </div>
            <div class="form">
                <div class="form-group">
                    <label for="forMail">Email <sup>*</sup></label>
                    {{ form.account.mail }}
                    {% if register_mail_description %}
                    <span>{{register_mail_description}}</span>
                    {% endif %}
                </div>
                <div class="form-group">
                    <label for="forPassword">User Name <sup>*</sup></label>
                    {{ form.account.name }}
                    {% if register_name_description %}
                    <span>{{register_name_description}}</span>
                    {% endif %}
                </div>
                {{ form.actions }}
                <div class="links">
                    <p>Already have an account? <a href="{{base_url}}user/login" title="Login">Login</a></p>
                </div>
                {{ form.form_build_id }}
                {{ form.form_id }}
            </div>
        </div>
    </div>
</section>