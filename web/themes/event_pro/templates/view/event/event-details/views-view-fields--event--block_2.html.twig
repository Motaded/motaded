                            </svg>
                        </div>
                        {{ fields.field_venue.content }} 
                    </li>
                    <li>
                        <div class="icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="72.295" height="98.113" viewBox="0 0 72.295 98.113">
                                <path id="Path_38980" data-name="Path 38980" d="M46.147,65.966a15.46,15.46,0,0,0,15.44-15.492l.052-30.983a15.492,15.492,0,1,0-30.983,0V50.475A15.5,15.5,0,0,0,46.147,65.966Zm-6.2-46.991a6.2,6.2,0,0,1,12.393,0l-.052,32.016a6.171,6.171,0,1,1-12.342,0Zm33.565,31.5c0,15.492-13.09,26.336-27.368,26.336-14.252,0-27.368-10.844-27.368-26.336H10c0,17.635,14.046,32.2,30.983,34.7v16.937H51.311V85.176c16.937-2.5,30.983-17.067,30.983-34.7Z" transform="translate(-10 -4)" fill="#fd4c66"/>
                            </svg>
                        </div>
                        {{ fields.field_people_1.content }}
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-lg-7 col-md-7 col-12">
            <div class="content">
                <h3><a  href="{{ fields.view_node.content }}" title="Title">{{ fields.title.content }}</a></h3>
                <p>{{ fields.field_contents.content }}</p>
            </div>
        </div>
        <div class="col-lg-2 col-md-2 col-12">
            <div class="profile">
                {{ fields.field_people.content }}
            </div>
        </div>
    </div>
</div>
