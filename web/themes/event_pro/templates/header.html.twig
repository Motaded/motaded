<!-- Header 1 Start -->
<header id="header-1" class="header {{active_1}} ">
	{% if sticky == 1 %}
	<div class="navbar-wrapper navigation-sticky sticky">
	{% else %}
	<div class="navbar-wrapper navigation-sticky">
	{% endif %}
		<div class="container">
			<nav class="navbar navbar-expand-lg">
				<div class="res-header">
					{{page.header}}
					<div class="res-header-right d-lg-none">
                        {{page.top_header_form}}
						<button class="navbar-toggler menu" type="button" data-bs-toggle="collapse"  onclick="this.classList.toggle('opened');this.setAttribute('aria-expanded', this.classList.contains('opened'))"  data-bs-target="#navbarNavDropdown-one" aria-controls="navbarNavDropdown-one" aria-expanded="false" aria-label="Toggle navigation">
							<svg width="100" height="100" viewBox="0 0 100 100">
								<path class="line line1" d="M 20,29.000046 H 80.000231 C 80.000231,29.000046 94.498839,28.817352 94.532987,66.711331 94.543142,77.980673 90.966081,81.670246 85.259173,81.668997 79.552261,81.667751 75.000211,74.999942 75.000211,74.999942 L 25.000021,25.000058" />
								<path class="line line2" d="M 20,50 H 80" />
								<path class="line line3" d="M 20,70.999954 H 80.000231 C 80.000231,70.999954 94.498839,71.182648 94.532987,33.288669 94.543142,22.019327 90.966081,18.329754 85.259173,18.331003 79.552261,18.332249 75.000211,25.000058 75.000211,25.000058 L 25.000021,74.999942" />
							</svg>
						</button>
					</div>
				</div>
				<div class="collapse navbar-collapse" id="navbarNavDropdown-one">
					{{page.primary_menu}}
					<div class="header-right d-none d-lg-flex">
						<ul class="search-btn d-none d-lg-block">
							<li class="">
								<a class="btn">
									<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
										<path id="Path_38950" data-name="Path 38950" d="M121.029,111.565,98.369,88.972a52.783,52.783,0,0,0,11.263-32.656,53.316,53.316,0,1,0-53.316,53.316A52.783,52.783,0,0,0,88.972,98.369l22.593,22.659a6.692,6.692,0,1,0,9.464-9.464ZM16.329,56.316A39.987,39.987,0,1,1,56.316,96.3,39.987,39.987,0,0,1,16.329,56.316Z" transform="translate(-3 -3)" fill="#1a1725"/>
									</svg>
								</a>
								<div class="dropdown-menu search-overlay">
									{{ page.header_form }}
								</div>
							</li>
						</ul>
                        {% if button_link %}
						<a href="{{button_link}}" class="btn btn-primary btn-style-4 btn-style-sm" title="Title">{{button_text}}
                            {# <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
                                <path id="Icon_ionic-ios-arrow-dropright-circle" data-name="Icon ionic-ios-arrow-dropright-circle" d="M3.375,63.375a60,60,0,1,0,60-60A59.991,59.991,0,0,0,3.375,63.375Zm70.529,0L50.279,39.981a5.568,5.568,0,1,1,7.875-7.875L85.673,59.712a5.561,5.561,0,0,1,.173,7.673l-27.115,27.2a5.558,5.558,0,1,1-7.875-7.846Z" transform="translate(-3.375 -3.375)" fill="#1a1725"/>
                            </svg> #}
						</a>
                        {% endif %}
						{{page.top_header_form}}
					</div>
				</div>
			</nav>
		</div>
	</div>
</header>
