{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
{{ attach_library('bootstrap5/node') }}
 <div class="swiper-slide">
                            <div class="block">
                                <div class="autorPic">
                                   <img src="{{ file_url(node.field_media.entity.field_media_image.entity.fileuri) }}" alt="">
                                </div>
                                <h4>{{ node.label }}</h4>
                               {{ content.body.0 }}
                                <div class="name">
                                    <h6>{{ node.field_name.value }}<span>{{ node.field_designation.value }}</span></h6>
                                </div>
                            </div>
                        </div>