{% set classes = [
  'field',
  'field--name-' ~ field_name|clean_class,
  'field--type-' ~ field_type|clean_class,
  'field--label-' ~ label_display,
  label_display == 'inline' ? 'clearfix',
] %}
{% set title_classes = [
  'field__label',
  label_display == 'visually_hidden' ? 'visually-hidden',
] %}

{% if label_hidden %}
  {% if multiple %}
    <div{{ attributes.addClass(classes, 'field__items') }}>
      {% set i = 1 %}
      {% for item in items %}
        {% if i == 2 %}
          <div class="service-detail-row {{ i }}">
        {% endif %}

        <div{{ item.attributes.addClass('field__item') }}>{{ item.content }}</div>

        {% if i == 3 or loop.last %}
          </div>
        {% endif %}

        {% set i = i + 1 %}
      {% endfor %}
    </div>
  {% else %}
    {% set i = 1 %}
    {% for item in items %}
      {% if i == 2 %}
        <div class="service-detail-row {{ i }}">
      {% endif %}

      <div{{ attributes.addClass(classes, 'field__item') }}>{{ item.content }}</div>

      {% if i == 3 or loop.last %}
        </div>
      {% endif %}

      {% set i = i + 1 %}
    {% endfor %}
  {% endif %}
{% else %}
  <div{{ attributes.addClass(classes) }}>
    {% if multiple %}
      <div class="field__items">
    {% endif %}

    {% set i = 1 %}
    {% for item in items %}
      {% if i == 2 %}
        <div class="service-detail-row {{ i }}">
      {% endif %}

      <div{{ item.attributes.addClass('field__item') }}>{{ item.content }}</div>

      {% if i == 3 or loop.last %}
        </div>
      {% endif %}

      {% set i = i + 1 %}
    {% endfor %}

    {% if multiple %}
      </div>
    {% endif %}
  </div>
{% endif %}
