{% set classes = [
    'block',
    'block-' ~ configuration.provider|clean_class,
    'block-' ~ plugin_id|clean_class,
] %}

<section{{attributes.addClass(classes)}}>
{{ title_prefix }}
	{{ title_suffix }}
	{% block content %}
    <div class="stepBg">
        {% if label %}
            <h1 class="titleHead">{{ label }}</h1>
        {% endif %}
        <div class="stepcontaner">
            <div class="setpWrap">

                {% set body_content = content['#block_content'].get('body').value %}
                {% if body_content is not empty %}
                    {{ body_content|raw }}
                {% endif %}

                {% for key, item in content.field_business_activity %}
                    {% if item['#paragraph'] is defined %}
                        {% set paragraph = item['#paragraph'] %}
                        <div class="box">
                            {% if paragraph.field_media.entity is not empty %}
                                {% set image_url = file_url(paragraph.field_media.entity.field_media_image.entity.uri.value) %}
                                {# {% set field_hover_image = file_url(paragraph.field_hover_image.entity.field_media_image.entity.uri.value) %} #}

                                <div class="image">
                                {# <div class="hoverImage">
                                 <img src="{{ field_hover_image }}" alt="{{ paragraph.field_media.alt }}">
                                 </div> #}
                                    <img src="{{ image_url }}" alt="{{ paragraph.field_media.alt }}">
                                </div>
                            {% endif %}

                            <div class="contentBlock">
                                {% if paragraph.field_title is not empty %}
                                    <h5>{{ paragraph.field_title.value }}</h5>
                                {% endif %}
                                {% if paragraph.field_content is not empty %}
                                    <p>{{ paragraph.field_content.value }}</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
	{% endblock %}
</section>
