<div id="language-switcher-outside-cheker" class="language-switcher">
  <button href="#" aria-label="Language switcher" class="language-switcher-title" id="language-switcher-toggle">
    <span class="current-language-display">{{ language_switcher.current_language }}</span>
    <svg width="8" height="7" viewBox="0 0 8 7" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M0.535889 0.535898L7.46409 0.535898L3.99999 6.5359L0.535889 0.535898Z" fill="currentcolor"/>
    </svg>
  </button>
  <div class="language-dropdown">
    {{ content }}
  </div>
</div>
<div class="free-consultation">
  <button class="primary-button consultation-button">{{ 'Free Consultation'|t({}, {'context': 'block_template'}) }}</button>
  <div class="consultation-slide">
    <div class="close-consultation">
				<svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
					<path d="M9.6 28.5L7.5 26.4L15.9 18L7.5 9.6L9.6 7.5L18 15.9L26.4 7.5L28.5 9.6L20.1 18L28.5 26.4L26.4 28.5L18 20.1L9.6 28.5Z" fill="currentcolor"/>
				</svg>
			</div>
    <div class="consultation-form">
    <h4>{{ 'Book A Free Consultation'|t({}, {'context': 'block_template'}) }}</h4>
      {{ drupal_entity('webform', 'book_a_free_consultation') }}
    </div>
  </div>
</div>
