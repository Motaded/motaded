{
  "name": "motaded_theme",
  "type": "module",
  "version": "1.0.0",
  "description": "motaded_theme theme, generated from starterkit_theme.",
  "main": "postcss.config.js",
  "scripts": {
    "build:css": "postcss css/main.css -o dist/main.css",
