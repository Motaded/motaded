<div class="bg-white border border-gray-200 rounded-lg mx-2 mt-2 mb-4 p-4 flex flex-col h-full transition hover:shadow-md">
  <div class="mb-4 icon-wrap bg-primary-50 rounded-full size-[56px] flex items-center justify-center">
    <img class="p-4" alt="{{title}}" src="{{icon_url}}"/>
  </div>
  <h3 class="mb-4 font-bold text-lg text-gray-900">
    {{title}}
  </h3>
  <p class="mb-4 text-gray-600 text-sm leading-relaxed">
    {{desc}}
  </p>
  <div class="flex flex-wrap gap-2 mb-4">
    {% if tags  %}
      <div class="flex flex-wrap gap-2 mb-4">
        {% for tag in tags %}
          {% if tag %}
            <span class="border px-2 py-1 rounded text-xs font-medium bg-gray-50 text-gray-700 border-gray-200">{{ tag }}</span>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
  {% if cta1 or cta2  %}
    <div class="mt-auto flex gap-2">
      {% if cta1 %}
        <a href="{{ cta1.url }}" class="px-4 py-2 rounded-md border border-gray-300 text-sm text-gray-700 hover:bg-gray-100">
          {{ cta1.title }}
        </a>
      {% endif %}
      {% if cta2 %}
        <a href="{{ cta2.url }}" class="px-4 py-2 rounded-md bg-primary-600 text-white text-sm hover:bg-primary-700">
          {{ cta2.title }}
        </a>
      {% endif %}
    </div>
  {% endif %}
</div>
