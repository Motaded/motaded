{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 */
#}
{% set input_attributes = attributes %}
{# Some FAPI date widgets still render with type="text"; force native picker. #}
{% if input_attributes.hasClass('form-date') %}
  {% set input_attributes = input_attributes.setAttribute('type', 'date') %}
{% endif %}
<div class="form-el-wrapper flex relative items-center self-stretch p-0 h-10 bg-gray-100 rounded">
  <input{{ input_attributes.addClass("flex relative items-center self-stretch py-0 pr-4 pl-2 flex-[1_0_0] bg-transparent text-base leading-6 text-gray-500 border-none outline-none") }} />{{ children }}
</div>