{#
/**
 * @file
 * DataSaudi merchandise imports by HS section (latest available month).
 */
#}
{{ attach_library('motaded_theme/datasaudi_trade') }}
{% set trade = trade|default({}) %}
<section{{ attributes.addClass('paragraph', 'datasaudi-trade', 'datasaudi-trade--product') }}>
  <div class="datasaudi-trade__inner mot-shell">
    <div class="datasaudi-trade__panel datasaudi-trade__panel--product">
      <header class="datasaudi-trade__copy">
        <div class="datasaudi-trade__heading">
          {% if paragraph.field_title.value %}
            <h2 class="datasaudi-trade__title">{{ paragraph.field_title.value }}</h2>
          {% endif %}
          {% if trade.period_label %}
            <p class="datasaudi-trade__period">{{ trade.period_label }}</p>
          {% endif %}
        </div>
        {% if content.field_body is not empty %}
          <div class="datasaudi-trade__lede">{{ content.field_body }}</div>
        {% endif %}
        {% if trade.has_data %}
          <p class="datasaudi-trade__hero-value datasaudi-trade__hero-value--product">{{ trade.total_display }}</p>
          <p class="datasaudi-trade__hero-unit">{{ trade.unit_label }}</p>
          <p class="datasaudi-trade__hero-label">{{ 'Merchandise imports'|t }} · {{ trade.period_label }}</p>
        {% endif %}
      </header>

      {% if trade.has_data %}
        <div class="datasaudi-trade__product-main">
          <ol class="datasaudi-trade-bars">
            {% for row in trade.top %}
              <li class="datasaudi-trade-bars__row">
                <div class="datasaudi-trade-bars__head">
                  <span class="datasaudi-trade-bars__label">{{ row.label }}</span>
                  <span class="datasaudi-trade-bars__value">{{ row.value_display }}</span>
                </div>
                <span class="datasaudi-trade-bars__fill" style="width: {{ row.bar_pct }}%" aria-hidden="true"></span>
                <span class="datasaudi-trade-bars__share">{{ row.share_display }}</span>
              </li>
            {% endfor %}
          </ol>
        </div>
      {% else %}
        <p class="datasaudi-trade__empty">{{ trade.empty_message }}</p>
      {% endif %}
    </div>

    {% if trade.has_data %}
      <details class="datasaudi-trade__all">
        <summary>{{ trade.table_title }}</summary>
        <div class="datasaudi-trade__table-wrap">
          <table class="datasaudi-trade__table">
            <thead>
              <tr>
                <th scope="col">{{ 'Category'|t }}</th>
                <th scope="col">{{ trade.unit_label }}</th>
                <th scope="col">{{ 'Share'|t }}</th>
              </tr>
            </thead>
            <tbody>
              {% for row in trade.all %}
                <tr>
                  <th scope="row">{{ row.label }}</th>
                  <td>{{ row.value_detail }}</td>
                  <td>{{ row.share_display }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </details>
      <p class="datasaudi-trade__source">
        <a href="{{ trade.source_url }}" rel="noopener noreferrer">{{ trade.source_label }}</a>
      </p>
    {% endif %}
  </div>
</section>
