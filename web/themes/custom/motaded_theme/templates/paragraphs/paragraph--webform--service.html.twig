{{ attach_library('motaded_theme/service_landing') }}
{% set attributes = attributes.setAttribute('id', 'assessment').addClass('customs-form').removeClass('wrap') %}
<section{{ attributes }}>
  <div class="customs-form__inner mot-shell">
    <div class="customs-form__panel">
      {% if content.field_body|render|striptags|trim %}
        <header class="customs-form__header">
          {{ content.field_body }}
        </header>
      {% endif %}
      <div class="customs-form__body">
        {{ content.field_webform }}
      </div>
    </div>
  </div>
</section>
