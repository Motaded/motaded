{% set header_raw = paragraph.field_sub_title.value|default('') %}
{% set header_parts = header_raw|split('|') %}
{% set col_a = header_parts[0]|trim|default('Company situation'|t) %}
{% set col_b = header_parts[1]|trim|default('Relevant support'|t) %}
{% set col_c = header_parts[2]|default('')|trim %}
{% set two_col = col_c == '' %}
{% embed '@motaded_theme/includes/service-section.html.twig' with { layout: 'matrix', show_header: true, service_cards: service_cards, paragraph: paragraph } %}
  {% block section %}
    <div class="svc-matrix-wrap">
      <table class="svc-matrix{{ two_col ? ' svc-matrix--two' : '' }}">
        <thead>
          <tr>
            <th scope="col">{{ col_a }}</th>
            <th scope="col">{{ col_b }}</th>
            {% if not two_col %}
              <th scope="col">{{ col_c }}</th>
            {% endif %}
          </tr>
        </thead>
        <tbody>
          {% for card in service_cards %}
            {% if card and card.field_title.value and card.field_sub_title.value %}
              <tr>
                <th scope="row" data-label="{{ col_a }}">{{ card.field_title.value }}</th>
                <td data-label="{{ col_b }}">{{ card.field_sub_title.value }}</td>
                {% if not two_col %}
                  <td data-label="{{ col_c }}">{{ card.field_body.processed }}</td>
                {% endif %}
              </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% for card in service_cards %}
      {% if card and card.field_title.value and not card.field_sub_title.value and card.field_body.processed %}
        <div class="svc-matrix__outcome">
          <h3 class="svc-matrix__outcome-title">{{ card.field_title.value }}</h3>
          <div class="svc-matrix__note">{{ card.field_body.processed }}</div>
        </div>
      {% elseif card and not card.field_title.value and card.field_body.processed %}
        <div class="svc-matrix__note">{{ card.field_body.processed }}</div>
      {% endif %}
    {% endfor %}
  {% endblock %}
{% endembed %}
