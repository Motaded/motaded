<section id="sectors" class="section-sectors border-t border-gray-200 bg-white py-16">
  <div class="container layout-container px-4 mx-auto">
    <div class="mx-auto max-w-3xl text-center">
      {% if content.field_sub_title.0 is not empty %}
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-primary-600">
          {{ content.field_sub_title.0 }}
        </p>
      {% endif %}

      {% if content.field_title.0 is not empty %}
        <h2 class="mt-4 text-3xl font-bold text-gray-900">
          {{ content.field_title.0 }}
        </h2>
      {% endif %}

      <p class="mt-4 text-lg text-gray-600">
        {{ content.field_body.0|render|striptags }}
      </p>
    </div>
    <div class="mt-12 grid gap-6 justify-items-center md:grid-cols-2 xl:grid-cols-3">
      {% for key, item in content.field_paragraphs %}
        {% set para = item['#paragraph'] %}
        {% if para is not empty %}
          <article class="sector-card group relative flex w-full max-w-sm flex-col rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary-500 hover:shadow-lg">
            <div class="flex items-center gap-4">
              {# {% if content.field_media|render is not empty %} #}
                {% set field_media = file_url(para.field_media.entity.field_media_svg.entity.uri.value) %}
                <span class="sector-icon inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-50 text-primary-600">
                  <img
                    src="{{ field_media ? field_media : '/themes/custom/motaded_theme/img/icon-target.svg' }}"
                    class="h-7 w-7"
                    alt="{{ para.field_title.value|default('Sector icon') }}"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              {# {% endif %} #}
              
              <div>
                <h3 class="text-lg font-semibold text-gray-900">{{ para.field_title.value }}</h3>
                <p class="text-sm text-gray-500">{{ para.field_sub_title.value }}</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-gray-600">{{ para.field_body.value|striptags }}</p>
            <ul class="mt-4 flex flex-wrap gap-2 text-xs text-gray-600">
              {% for item in para.field_chips %}
                <li class="chip">{{ item.value }}</li>
              {% endfor %}
            </ul>
            {% set link_item = para.field_link.0 %}
            {% if link_item %}
            <a
            class="mt-6 inline-flex items-center text-sm font-semibold text-primary-600"
            href="{{ link_item.url.toString() }}"
            target="_blank"
            rel="noreferrer"
            >
              {{ link_item.title }}
              <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  class="ml-2 h-4 w-4"
              >
                  <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M8.25 15.75L15.75 8.25M15.75 8.25H8.25m7.5 0v7.5"
                  />
              </svg>
            </a>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}

    </div>
</div>
</section>