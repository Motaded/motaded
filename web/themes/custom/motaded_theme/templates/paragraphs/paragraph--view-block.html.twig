{#
/**
 * @file
 * Paragraph view_block: intro + embedded view + optional link.
 */
#}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
  ]|merge((view_block_services_home or view_block_events_home_list or view_block_events_home_calendar) ? [] : ['bg-white'])|merge(
    view_block_services_home ? ['pb-14'] : (view_block_events_home_list or view_block_events_home_calendar ? ['pb-10', 'pt-8'] : ['pb-14', 'pt-28'])
  )|merge([
    view_block_news_latest ? 'paragraph--view-block--news-latest',
    view_block_services_home ? 'paragraph--view-block--services-home',
    view_block_events_home_list ? 'paragraph--view-block--events-home-list',
    view_block_events_home_calendar ? 'paragraph--view-block--events-home-calendar',
    view_block_events_home_list or view_block_events_home_calendar ? 'events-home-strip',
  ])
%}
{% block paragraph %}
  <section{{ attributes.addClass(classes) }} role="region" aria-label="{{ view_block_news_latest ? ('News and insights'|t) : (view_block_services_home ? ('Services'|t) : (view_block_events_home_list or view_block_events_home_calendar ? ('Business events'|t) : ('Content block'|t))) }}">
    {% block content %}
      <div class="view-block-shell max-w-[1320px] mx-auto px-4">
        {% if view_block_news_latest %}
          <div class="view-block-header view-block-header--news-latest max-w-2xl mx-auto mb-6 max-md:mb-5 text-center">
            <div class="view-block-intro-wrap relative w-full">
              <div class="view-block-intro text-base text-gray-800 leading-relaxed">
                {{ content.field_body.0 }}
              </div>
            </div>
          </div>

          {{ content.field_view_block.0 }}

          {% if content.field_link.0 is not empty %}
            {% set news_link_title = content.field_link.0['#title']|default('')|trim %}
            {% set news_link_label = (news_link_title|lower == 'news') ? ('View All'|t) : news_link_title %}
            <div class="latest-news-footer">
              <a href="{{ content.field_link.0['#url'] }}" class="latest-news-footer__link">
                {{ news_link_label }}
                <span aria-hidden="true">→</span>
              </a>
            </div>
          {% endif %}
        {% elseif view_block_events_home_list or view_block_events_home_calendar %}
          {% set events_home_combo = view_block_events_home_calendar or view_block_events_home_list %}
          <div class="events-home-paragraph-inner{{ events_home_combo ? ' events-home events-home__grid' : '' }}">
            {% if content.field_body.0 is not empty %}
              <div class="view-block-intro events-home-strip__intro text-base leading-relaxed text-slate-700">{{ content.field_body.0 }}</div>
            {% endif %}
            {{ content.field_view_block }}
          </div>
        {% elseif view_block_services_home %}
          <div class="services-home-header services-home-header--split flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between lg:gap-12">
            <div class="services-home-header__copy view-block-intro-wrap relative w-full min-w-0 flex-1">
              <div class="view-block-intro services-home-intro text-base text-gray-800 leading-relaxed">
                {{ content.field_body.0 }}
              </div>
            </div>
            <div class="services-home-header__aside flex gap-4 items-start shrink-0 max-w-md">
              <div class="services-home-team-badge" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 48 48" fill="none" focusable="false">
                  <circle cx="24" cy="24" r="24" fill="#0f766e"/>
                  <path d="M24 14c-2.2 0-4 1.8-4 4s1.8 4 4 4 4-1.8 4-4-1.8-4-4-4zm-7 18v-1.5c0-2.5 2-4.5 4.5-4.5h5c2.5 0 4.5 2 4.5 4.5V32" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
                  <path d="M15 22c-1.7 0-3 1.3-3 3v3M33 22c1.7 0 3 1.3 3 3v3" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
                  <circle cx="15" cy="18" r="2.5" stroke="#fff" stroke-width="1.6"/>
                  <circle cx="33" cy="18" r="2.5" stroke="#fff" stroke-width="1.6"/>
                </svg>
              </div>
              <p class="services-home-team-text text-sm leading-relaxed text-slate-600 m-0">
                {{ 'Our multidisciplinary team combines regulatory insight with hands-on business experience to guide your journey in Saudi Arabia.'|t }}
              </p>
            </div>
          </div>
          {% if content.field_link.0 is not empty %}
            <div class="services-home-header-actions flex justify-end mb-6 lg:mb-8">
              <a href="{{ content.field_link.0['#url'] }}" class="services-home-view-all">
                {{ content.field_link.0['#title'] }}
              </a>
            </div>
          {% endif %}

          {{ content.field_view_block.0 }}
        {% elseif view_block_partners_marquee %}
          <div class="view-block-header view-block-header--partners">
            <div class="view-block-intro-wrap relative w-full pl-4">
              <span class="absolute left-0 top-1 h-10 w-1.5 rounded-full bg-primary-600" aria-hidden="true"></span>
              <div class="view-block-intro view-block-intro--partners text-base text-gray-800 leading-relaxed">
                {{ content.field_body.0 }}
              </div>
            </div>
            <a href="/partners" class="view-all view-all--partners inline-flex items-center justify-center rounded-full border border-primary-200 bg-primary-50 px-5 py-2.5 text-sm font-semibold text-primary-800 transition hover:border-primary-300 hover:bg-primary-100">
              {{ 'View all partners'|t }}
            </a>
          </div>

          {{ content.field_view_block.0 }}
        {% else %}
          <div class="flex items-end justify-between gap-4 max-md:flex-col max-md:items-start">
            <div class="view-block-intro-wrap relative w-full pl-4">
              <span class="absolute left-0 top-1 h-10 w-1.5 rounded-full bg-primary-600" aria-hidden="true"></span>
              <div class="view-block-intro text-base text-gray-800 leading-relaxed">
                {{ content.field_body.0 }}
              </div>
            </div>
            {% if content.field_link.0 is not empty %}
              <a href="{{ content.field_link.0['#url'] }}" class="view-all inline-flex items-center justify-center rounded-full border border-primary-200 bg-primary-50 px-5 py-2.5 text-sm font-semibold text-primary-800 transition hover:border-primary-300 hover:bg-primary-100">
                {{ content.field_link.0['#title'] }}
              </a>
            {% endif %}
          </div>

          {{ content.field_view_block.0 }}
        {% endif %}
      </div>

    {% endblock %}
  </section>
{% endblock paragraph %}
