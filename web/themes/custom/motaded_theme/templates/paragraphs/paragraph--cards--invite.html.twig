{% embed '@motaded_theme/includes/service-section.html.twig' with { layout: 'invite', show_header: false, service_cards: service_cards, paragraph: paragraph } %}
  {% block section %}
    <div class="customs-invite">
      <div class="customs-invite__copy">
        {% if paragraph.field_title.value %}
          <h2 class="customs-svc__title">{{ paragraph.field_title.value }}</h2>
        {% endif %}
        {% if paragraph.field_body.processed %}
          <div class="customs-svc__lede">{{ paragraph.field_body.processed }}</div>
        {% endif %}
      </div>
      <div class="customs-invite__actions">
        {% for card in service_cards %}
          {% if card and card.field_link.0 %}
            <a class="{{ loop.first ? 'customs-invite__cta' : 'customs-invite__action' }}" href="{{ card.field_link.0.url.toString() }}">{{ card.field_link.0.title }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endblock %}
{% endembed %}
