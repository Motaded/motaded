{#
/**
 * @file
 * Customs clearance assessment form.
 */
#}
{{ attach_library('motaded_theme/customs_clearance_landing') }}
<section{{ attributes.addClass('customs-form').removeClass('wrap') }}>
  <div class="customs-form__inner mot-shell">
    <div class="customs-form__panel">
      {% if content.field_body|render|striptags|trim %}
        <header class="customs-form__header">
          {{ content.field_body }}
        </header>
      {% endif %}
      <div class="customs-form__body">
        {{ content.field_webform }}
      </div>
    </div>
  </div>
</section>
