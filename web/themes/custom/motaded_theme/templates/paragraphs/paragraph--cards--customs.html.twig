{#
/**
 * @file
 * Distinct layouts per section on the customs clearance landing page.
 */
#}
{{ attach_library('motaded_theme/customs_clearance_landing') }}
{% set title = paragraph.field_title.value|default('') %}
{% set items = customs_items|default([]) %}
{% if items is empty %}
  {% for item in paragraph.field_paragraphs %}
    {% if item.entity %}
      {% set items = items|merge([item.entity]) %}
    {% endif %}
  {% endfor %}
{% endif %}
{% set layout = customs_layout|default('features') %}

<section{{ attributes.addClass('customs-svc', 'customs-svc--' ~ layout).removeClass('wrap') }}>
  <div class="customs-svc__inner mot-shell">
    {% if layout != 'features' and title %}
      <header class="customs-svc__header">
        <h2 class="customs-svc__title">{{ title }}</h2>
        {% if paragraph.field_body.processed %}
          <div class="customs-svc__lede">{{ paragraph.field_body.processed }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if layout == 'stack' %}
      <ol class="customs-svc__stages">
        {% for card in items %}
          <li class="customs-svc__stage">
            <div class="customs-svc__stage-index" aria-hidden="true">{{ '%02d'|format(loop.index) }}</div>
            <div class="customs-svc__stage-main">
              <h3 class="customs-svc__stage-title">{{ card.field_title.value }}</h3>
              <div class="customs-svc__stage-body">{{ card.field_body.processed }}</div>
            </div>
          </li>
        {% endfor %}
      </ol>

    {% elseif layout == 'workstreams' %}
      <ul class="customs-ws">
        {% for card in items %}
          <li class="customs-ws__item">
            {% if customs_item_icons[loop.index0] %}
              <span class="customs-ws__icon" aria-hidden="true">{{ customs_item_icons[loop.index0] }}</span>
            {% endif %}
            <h3 class="customs-ws__title">{{ card.field_title.value }}</h3>
            <div class="customs-ws__body">{{ card.field_body.processed }}</div>
          </li>
        {% endfor %}
      </ul>

    {% elseif layout == 'directory' %}
      <ul class="customs-dir">
        {% for card in items %}
          {% set logo = customs_item_logos[loop.index0]|default({}) %}
          <li class="customs-dir__row">
            <div class="customs-dir__logo">
              {% if logo.src %}
                <img src="{{ logo.src }}" {% if logo.srcset %}srcset="{{ logo.srcset }}" sizes="56px" {% endif %}{% if logo.width %}width="{{ logo.width }}" {% endif %}{% if logo.height %}height="{{ logo.height }}" {% endif %}alt="{{ (logo.alt|default(card.field_title.value))|e('html_attr') }}" loading="lazy" decoding="async">
              {% else %}
                <span class="customs-dir__mark" aria-hidden="true">{{ card.field_title.value|slice(0, 1) }}</span>
              {% endif %}
            </div>
            <div class="customs-dir__copy">
              <h3 class="customs-dir__name">{{ card.field_title.value }}</h3>
              <div class="customs-dir__body">{{ card.field_body.processed }}</div>
              {% if card.field_link.0 %}
                <a class="customs-dir__link" href="{{ card.field_link.0.url.toString() }}">{{ card.field_link.0.title }}</a>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
      <p class="customs-dir__note">{{ customs_is_ar ? 'تنشر كل جهة القواعد وتقرر التقييم والرسوم ونتيجة المنتج والإفراج.' : 'Each authority publishes the rules and decides assessment, duty, product outcome and release.' }}</p>

    {% elseif layout == 'table' %}
      <div class="customs-table-wrap">
        <table class="customs-table">
          <thead>
            <tr>
              <th scope="col">{{ customs_is_ar ? 'الفئة'|t : 'Category'|t }}</th>
              <th scope="col">{{ customs_is_ar ? 'ما قد ينطبق أيضاً'|t : 'What may also apply'|t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for card in items %}
              <tr>
                <th scope="row">{{ card.field_title.value }}</th>
                <td>{{ card.field_body.processed }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

    {% elseif layout == 'lists' %}
      <div class="customs-docs">
        <div class="customs-docs__cols">
          {% for card in items|slice(0, 2) %}
            <div class="customs-docs__col">
              <h3 class="customs-docs__title">{{ card.field_title.value }}</h3>
              <div class="customs-docs__body">{{ card.field_body.processed }}</div>
            </div>
          {% endfor %}
        </div>
        {% if items|length > 2 %}
          <p class="customs-docs__note">
            <strong>{{ items[2].field_title.value }}</strong>
            {{ items[2].field_body.value|striptags|trim }}
          </p>
        {% endif %}
      </div>

    {% elseif layout == 'related' %}
      <ul class="customs-related">
        {% for card in items %}
          <li class="customs-related__item">
            {% if card.field_link.0 %}
              <a class="customs-related__title" href="{{ card.field_link.0.url.toString() }}">{{ card.field_title.value }}</a>
            {% else %}
              <span class="customs-related__title">{{ card.field_title.value }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>

    {% elseif layout == 'contact' %}
      {% set cta = items|first %}
      {% if cta and cta.field_link.0 %}
        <a class="customs-contact__cta" href="{{ cta.field_link.0.url.toString() }}">{{ cta.field_link.0.title }}</a>
      {% endif %}

    {% elseif layout == 'fees' %}
      <div class="customs-fees">
        {% for card in items %}
          <div class="customs-fees__col customs-fees__col--{{ loop.index }}">
            <h3 class="customs-fees__title">{{ card.field_title.value }}</h3>
            <div class="customs-fees__body">{{ card.field_body.processed }}</div>
            {% if card.field_link.0 %}
              <a class="customs-fees__link" href="{{ card.field_link.0.url.toString() }}">{{ card.field_link.0.title }}</a>
            {% endif %}
          </div>
        {% endfor %}
      </div>

    {% elseif layout == 'features' %}
      <div class="customs-work">
        <div class="customs-work__intro">
          {% if title %}
            <h2 class="customs-svc__title">{{ title }}</h2>
          {% endif %}
          {% if paragraph.field_body.processed %}
            <div class="customs-svc__lede">{{ paragraph.field_body.processed }}</div>
          {% endif %}
          <a class="customs-work__cta" href="#assessment">{{ customs_is_ar ? 'طلب تقييم التخليص' : 'Request a Clearance Assessment' }}</a>
        </div>
        <ul class="customs-work__list">
          {% for card in items %}
            <li class="customs-work__item">
              {% if customs_item_icons[loop.index0] %}
                <span class="customs-work__icon" aria-hidden="true">{{ customs_item_icons[loop.index0] }}</span>
              {% endif %}
              <div class="customs-work__copy">
                <h3 class="customs-work__title">{{ card.field_title.value }}</h3>
                <div class="customs-work__body">{{ card.field_body.processed }}</div>
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>

    {% else %}
      <div class="customs-feat">
        {% for card in items %}
          <div class="customs-feat__item">
            <h3 class="customs-feat__title">{{ card.field_title.value }}</h3>
            <div class="customs-feat__body">{{ card.field_body.processed }}</div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
