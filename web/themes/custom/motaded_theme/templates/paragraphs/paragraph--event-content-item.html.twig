{#
/**
 * @file
 * Event content item — layout styled via parent .event-page__* wrappers.
 */
#}
{% set pclasses = [
  'paragraph',
  'paragraph--type-' ~ paragraph.bundle|clean_class,
  'event-content-item',
] %}
<div{{ attributes.addClass(pclasses) }}>
  {% if content.field_title is defined and content.field_title|render|trim != '' %}
    <div class="event-content-item__title">{{ content.field_title }}</div>
  {% endif %}
  {% if content.field_body is defined and content.field_body|render|trim != '' %}
    <div class="event-content-item__body">{{ content.field_body }}</div>
  {% endif %}
</div>
