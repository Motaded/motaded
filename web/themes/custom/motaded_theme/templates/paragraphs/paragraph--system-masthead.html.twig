{#
/**
 * @file
 * Section masthead (paragraph: system_masthead).
 */
#}
{{ attach_library('motaded_theme/system_masthead') }}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'system-masthead',
  ]
%}

<section{{ attributes.addClass(classes) }}>
  <div class="system-masthead__inner">
    <div class="system-masthead__mark" aria-hidden="true">
      <span class="system-masthead__line"></span>
      <span class="system-masthead__icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M12 3l8 5-8 5-8-5 8-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M4 12l8 5 8-5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M4 16l8 5 8-5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="system-masthead__line"></span>
    </div>

    {% if content.field_system_masthead_eyebrow is not empty %}
      <div class="system-masthead__eyebrow mot-eyebrow">{{ content.field_system_masthead_eyebrow }}</div>
    {% endif %}

    {% if content.field_title is not empty %}
      <h2 class="system-masthead__title">{{ content.field_title }}</h2>
    {% endif %}

    {% if content.field_system_masthead_body is not empty %}
      <div class="system-masthead__subtitle">{{ content.field_system_masthead_body }}</div>
    {% endif %}

    <div class="system-masthead__cue" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
        <path d="M12 5v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        <path d="M7 15l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</section>

