{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}
{{ attach_library('motaded_theme/featured-contents') }}
{% set fc_count = paragraph.field_contents|length %}
{% set fc_last = fc_count > 0 ? fc_count - 1 : 0 %}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished',
    'featured-contents-modern pb-12 mt-[140px]'
  ]
%}
{% block paragraph %}
  <div{{attributes.addClass(classes)}}>
    {% block content %}
      <!-- Header -->
      <div class="max-w-[1320px] mx-auto px-4 mb-8">
        <div class="featured-contents__header">
          <div class="featured-contents__intro text-base md:w-2/3">
            {{ content.field_body.0 }}
          </div>
          {% if content.field_link is not empty %}
            <a href="{{ content.field_link.0['#url'] }}" class="featured-contents__view-all ml-auto md:ml-0 inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-medium hover:bg-gray-50 border-gray-300">
              {{ content.field_link.0['#title'] }}
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Content -->
      <div
        class="max-w-[1320px] mx-auto px-4" x-data="articlesCarousel" data-articles-length="{{ fc_count }}">
        <!-- Desktop / Tablet grid -->
        <div class="hidden md:grid grid-cols-1 md:grid-cols-3 gap-5">
          {% for key, item in paragraph.field_contents %}
            {% set article = content.field_contents[key]['#node'] %}
            {% set card_img = featured_card_images[article.id()] ?? {} %}
            <a href="{{ path('entity.node.canonical', {'node': article.id()}) }}" class="featured-contents__card-link group">
              <article class="featured-contents__card bg-white border border-gray-200 rounded-lg p-4 flex flex-col h-full transition hover:shadow-md">
                <div class="featured-contents__media mb-4 rounded-md overflow-hidden aspect-[16/9]">
                  {% if card_img.src %}
                    {% if card_img.srcset %}
                      <img loading="lazy" decoding="async" src="{{ card_img.src }}" srcset="{{ card_img.srcset }}" sizes="(max-width: 767px) 100vw, (min-width: 768px) 33vw" width="{{ card_img.width }}" height="{{ card_img.height }}" alt="{{ card_img.alt }}" class="w-full h-full object-cover group-hover:opacity-95 transition"/>
                    {% else %}
                      <img loading="lazy" decoding="async" src="{{ card_img.src }}" width="{{ card_img.width }}" height="{{ card_img.height }}" alt="{{ card_img.alt }}" class="w-full h-full object-cover group-hover:opacity-95 transition"/>
                    {% endif %}
                  {% endif %}
                </div>
                <h3 class="featured-contents__title font-bold text-lg mb-2">{{ article.label }}</h3>
                <div class="featured-contents__excerpt text-black/80 mb-4">
                  {% if article.body.summary %}
                    {{ article.body.summary|striptags|truncate(120) ~ "..." }}
                  {% elseif article.body.value %}
                    {{ article.body.value|striptags|truncate(120) }}
                  {% endif %}
                </div>
                <span class="featured-contents__readmore inline-flex items-center gap-2 text-sm underline mt-auto">
                  {{ "Read More" | t }}
                  <img src="/themes/custom/motaded_theme/img/icon-arrow-down.svg" alt="Arrow icon" width="18" height="18" class="rtl:rotate-90 ltr:-rotate-90 -scale-x-100"/>
                </span>
              </article>
            </a>
          {% endfor %}
        </div>

        <!-- Mobile carousel -->
        <div class="md:hidden">
          <div
            class="relative">
            <!-- Track -->
            <div class="overflow-hidden">
              <div class="flex transition-transform duration-500" :style="isRtl ? `transform: translateX(${current * 100}%);` : `transform: translateX(-${current * 100}%);`" @touchstart="onTouchStart($event)" @touchmove.prevent="onTouchMove($event)" @touchend="onTouchEnd()">
                {% for key, item in paragraph.field_contents %}
                  {% set article = content.field_contents[key]['#node'] %}
                  {% set card_img = featured_card_images[article.id()] ?? {} %}
                  <div class="min-w-full px-1">
                    <a href="{{ path('entity.node.canonical', {'node': article.id()}) }}" class="block min-h-72">
                      <article class="featured-contents__card bg-white border rounded-xl p-4 h-full hover:border-primary-600 transition">
                        <div class="flex flex-col h-full">
                          <div class="featured-contents__media w-full rounded-lg overflow-hidden aspect-[16/9]">
                            {% if card_img.src %}
                              {% if card_img.srcset %}
                                <img loading="lazy" decoding="async" src="{{ card_img.src }}" srcset="{{ card_img.srcset }}" sizes="100vw" width="{{ card_img.width }}" height="{{ card_img.height }}" alt="{{ card_img.alt }}" class="w-full h-full object-cover"/>
                              {% else %}
                                <img loading="lazy" decoding="async" src="{{ card_img.src }}" width="{{ card_img.width }}" height="{{ card_img.height }}" alt="{{ card_img.alt }}" class="w-full h-full object-cover"/>
                              {% endif %}
                            {% endif %}
                          </div>
                          <div class="mt-5 flex-1 flex flex-col">
                            <p class="featured-contents__title font-bold text-base leading-[1.6]">{{ article.label }}</p>
                            <p class="featured-contents__excerpt text-black/80 mt-2">
                              {% if article.body.summary %}
                                {{ article.body.summary|striptags|truncate(150) }}
                              {% elseif article.body.value %}
                                {{ article.body.value|striptags|truncate(150) }}
                              {% endif %}
                            </p>
                            <span class="featured-contents__readmore inline-flex items-center gap-2 text-sm underline mt-4">
                              {{ "Read More" | t }}
                              <img src="/themes/custom/motaded_theme/img/icon-arrow-down.svg" alt="Arrow icon" width="18" height="18" class="rtl:rotate-90 ltr:-rotate-90 -scale-x-100"/>
                            </span>
                          </div>
                        </div>
                      </article>
                    </a>
                  </div>
                {% endfor %}
              </div>
            </div>

            <!-- Controls -->
            <div class="mt-3 flex items-center justify-between">
              <button type="button" class="w-9 h-9 grid place-items-center rounded-full border hover:bg-gray-50" @click="prev()" :disabled="current===0" :class="current===0 && 'opacity-40 cursor-not-allowed'" aria-label="Previous">
                <img src="/themes/custom/motaded_theme/img/icon-arrow-down.svg" class="-rotate-90 rtl:rotate-90" alt="Previous slide" width="18" height="18"/>
              </button>

              <!-- Dots -->
              <div class="flex items-center gap-3">
                {% for key, item in paragraph.field_contents %}
                  <button type="button" class="size-3 rounded-full transition" :class="current === {{ key }} ? 'bg-primary-600' : 'bg-gray-300'" @click="go({{ key }})" :aria-label="`Go to slide {{ key + 1 }}`"></button>
                {% endfor %}
              </div>

              <button type="button" class="w-9 h-9 grid place-items-center rounded-full border hover:bg-gray-50" @click="next()" :disabled="current === {{ fc_last }}" :class="current === {{ fc_last }} && 'opacity-40 cursor-not-allowed'" aria-label="Next">
                <img src="/themes/custom/motaded_theme/img/icon-arrow-down.svg" class="rotate-90 -scale-x-100 rtl:-rotate-90" alt="Next slide" width="18" height="18" class="-scale-x-100 rtl:rotate-180"/>
              </button>
            </div>
          </div>
        </div>
      </div>

    {% endblock %}
  </div>
{% endblock paragraph %}
