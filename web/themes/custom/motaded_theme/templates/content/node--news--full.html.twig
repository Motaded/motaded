{#
/**
 * @file
 * News — full view: hero (title + summary left, media right on lg; meta + facts below), then body.
 */
#}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'node--news-full',
    'mb-12',
  ]
%}
{{ attach_library('motaded_theme/node') }}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if label and not page %}
    <h2{{ title_attributes.addClass('text-xl', 'font-bold', 'text-gray-900') }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <footer class="node__meta visually-hidden">
      {{ author_picture }}
      <div{{ author_attributes.addClass('node__submitted') }}>
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
        {{ metadata }}
      </div>
    </footer>
  {% endif %}

  <div class="news-hero" role="region" aria-label="{{ 'News header'|t }}">
    <div class="news-hero__inner mx-auto w-full max-w-[1320px] px-4 py-6 sm:px-6 sm:py-8 lg:py-10">
      <div class="news-hero__content flex w-full min-w-0 flex-col gap-6">
        <div class="news-hero__lead flex w-full min-w-0 flex-col gap-5{{ news_hero_media|default([]) ? ' news-hero__lead--has-media' : '' }}">
          <div class="news-hero__lead-text min-w-0">
            {% if page and label %}
              <h1{{ title_attributes.addClass('news-hero__title', 'text-3xl', 'font-extrabold', 'text-gray-900', 'lg:text-4xl', 'leading-tight', 'm-0') }}>{{ label }}</h1>
            {% endif %}

            {% if summary %}
              <div class="news-hero__intro prose prose-neutral max-w-none text-base leading-relaxed text-gray-700 mt-4">
                {{ summary }}
              </div>
            {% endif %}
          </div>

          {% if news_hero_media|default([]) %}
            <div class="news-hero__lead-media w-full shrink-0 mx-auto lg:mx-0">
              <div class="news-hero-media overflow-hidden rounded-xl border border-gray-200 bg-gray-50 shadow-sm">
                {{ news_hero_media }}
              </div>
            </div>
          {% endif %}
        </div>

        <div class="news-hero__trail w-full min-w-0">
          <div class="news-hero__meta flex flex-wrap items-center gap-2 text-xs sm:text-sm">
            {% if news_updated_formatted %}
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-3 py-1 font-medium text-slate-800">
                <time datetime="{{ news_changed_iso }}">{{ news_updated_formatted }}</time>
              </span>
            {% endif %}
            <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-3 py-1 font-medium text-amber-950">{{ 'News'|t }}</span>
            {% if content.field_taxonomy is defined and content.field_taxonomy|render|striptags|trim is not empty %}
              <span class="news-hero__meta-chips inline-flex flex-wrap items-center gap-2">
                {{ content.field_taxonomy }}
              </span>
            {% endif %}
            {% if content.field_tags is defined and content.field_tags|render|striptags|trim is not empty %}
              <span class="news-hero__meta-chips inline-flex flex-wrap items-center gap-2">
                {{ content.field_tags }}
              </span>
            {% endif %}
          </div>

          {% set show_glance =
            (content.field_effective_date is defined and content.field_effective_date|render|striptags|trim)
            or (content.field_applies_to is defined and content.field_applies_to|render|striptags|trim)
            or (content.field_requirement is defined and content.field_requirement|render|striptags|trim)
            or (content.field_source_scope is defined and content.field_source_scope|render|striptags|trim)
          %}

          {% if show_glance %}
            <section class="news-facts mt-5" aria-label="{{ 'At a glance'|t }}">
              <p class="news-facts__heading">{{ 'At a glance'|t }}</p>
              {% if content.field_effective_date is defined and content.field_effective_date|render|striptags|trim is not empty %}
                <div class="news-facts__row">
                  <span class="news-facts__label">{{ 'Effective date'|t }}</span>
                  <div class="news-facts__value">{{ content.field_effective_date }}</div>
                </div>
              {% endif %}
              {% if content.field_applies_to is defined and content.field_applies_to|render|striptags|trim is not empty %}
                <div class="news-facts__row">
                  <span class="news-facts__label">{{ 'Applies to'|t }}</span>
                  <div class="news-facts__value">{{ content.field_applies_to }}</div>
                </div>
              {% endif %}
              {% if content.field_requirement is defined and content.field_requirement|render|striptags|trim is not empty %}
                <div class="news-facts__row">
                  <span class="news-facts__label">{{ 'Requirement'|t }}</span>
                  <div class="news-facts__value">{{ content.field_requirement }}</div>
                </div>
              {% endif %}
              {% if content.field_source_scope is defined and content.field_source_scope|render|striptags|trim is not empty %}
                <div class="news-facts__row">
                  <span class="news-facts__label">{{ 'Source / scope'|t }}</span>
                  <div class="news-facts__value">{{ content.field_source_scope }}</div>
                </div>
              {% endif %}
            </section>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div
    {{ content_attributes.addClass('news-main', 'news-body', 'node__content', 'prose', 'prose-neutral', 'max-w-none') }}
    id="news-root"
  >
    {{ content|without(
      'addtoany',
      'field_media',
      'field_effective_date',
      'field_applies_to',
      'field_requirement',
      'field_source_scope',
      'field_meta',
      'field_tags',
      'field_taxonomy',
      'field_comments'
    ) }}
  </div>

  {# AddToAny is mostly icons/links — do not gate on striptags|trim (that hides the block). #}
  {% if content.addtoany %}
    <aside class="news-after-body mx-auto mt-10 w-full max-w-[1320px] px-4 sm:px-6" aria-label="{{ 'Share this article'|t }}">
      <div class="news-after-body__card">
        <p class="news-after-body__title">{{ 'Found this helpful? Share it so colleagues and contacts can stay up to date.'|t }}</p>
        <div class="news-after-body__inner">
          {{ content.addtoany }}
        </div>
      </div>
    </aside>
  {% endif %}
</article>
