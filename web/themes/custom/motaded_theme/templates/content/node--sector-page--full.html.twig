{#
/**
 * @file
 * Sector page — Invest Saudi style hub (hero, triptych, list rows).
 */
#}
{% set sector_t = {'langcode': sector_langcode|default('en')} %}
{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    'sector-page',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
  ]
%}
<article{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  {% set has_highlights = content.field_sector_highlights|render|trim is not empty %}
  {% set has_stats = (content.field_sector_stats|render|trim is not empty) or (sector_api_key_stats is defined and sector_api_key_stats is not empty) %}
  {% set has_overview = content.body|render|trim is not empty %}

  <header class="sector-page__hero{% if sector_hero_bg_url %} sector-page__hero--has-media{% endif %}">
    <div class="sector-page__hero-pattern" aria-hidden="true"></div>
    <div class="sector-page__hero-row{% if sector_hero_bg_url %} sector-page__hero-row--has-media{% endif %}">
      <div class="sector-page__hero-copy-col">
        <div class="sector-page__hero-copy">
          <nav class="sector-page__breadcrumb" aria-label="{{ 'Breadcrumb'|t({}, sector_t) }}">
            <ol>
              <li><a href="{{ path('<front>') }}">{{ 'Home'|t({}, sector_t) }}</a></li>
              <li aria-hidden="true">/</li>
              <li><a href="{{ sector_listing_url|default('/sectors') }}">{{ 'Sectors'|t({}, sector_t) }}</a></li>
              <li aria-hidden="true">/</li>
              <li aria-current="page">{{ node.label() }}</li>
            </ol>
          </nav>

          {% if (sector_page_show_sector_pill and sector_term_pill_name) or sector_page_show_eyebrow %}
          <div class="sector-page__hero-head">
            {% if sector_page_show_sector_pill and sector_term_pill_name %}
              <span class="sector-page__pill-term">{{ sector_term_pill_name }}</span>
            {% endif %}
            {% if sector_page_show_eyebrow %}
              <div class="sector-page__eyebrow sector-page__eyebrow--extra mot-eyebrow">{{ content.field_sector_eyebrow }}</div>
            {% endif %}
          </div>
          {% endif %}

          {% if page %}
            <h1{{ title_attributes.addClass('sector-page__title') }}>{{ node.label() }}</h1>
          {% endif %}

          {% if content.field_short_description|render|trim is not empty %}
            <div class="sector-page__lede">{{ content.field_short_description }}</div>
          {% endif %}

          {% if sector_hero_quick_cards is not empty %}
            <div class="sector-page__quick-cards" role="list">
              {% for card in sector_hero_quick_cards %}
                <div class="sector-page__quick-card" role="listitem">
                  <span class="sector-page__quick-card-icon" aria-hidden="true">{{ card.icon_markup|raw }}</span>
                  <span class="sector-page__quick-card-text">
                    {% if card.value %}
                      <span class="sector-page__quick-card-value">{{ card.value }}</span>
                    {% endif %}
                    {% if card.label %}
                      <span class="sector-page__quick-card-label">{{ card.label }}</span>
                    {% endif %}
                  </span>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>

      {% if sector_hero_bg_url %}
        <div class="sector-page__hero-aside">
          <div class="sector-page__hero-aside-frame">
            <img
              class="sector-page__hero-img"
              src="{{ sector_hero_bg_url|e('html_attr') }}"
              alt="{{ node.label()|e('html_attr') }}"
              width="1200"
              height="800"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      {% endif %}
    </div>
  </header>

  {% if has_overview or has_highlights or has_stats %}
    <div class="sector-page__triptych-wrap">
      <div class="sector-page__triptych">
        {% if has_overview %}
          <section class="sector-page__triptych-cell sector-page__overview prose prose-neutral max-w-none" aria-labelledby="sector-overview-heading">
            <h2 id="sector-overview-heading">{{ 'Overview'|t({}, sector_t) }}</h2>
            {{ content.body }}
          </section>
        {% endif %}

        {% if has_highlights %}
          <section class="sector-page__triptych-cell sector-page__panel sector-page__panel--highlights" aria-labelledby="sector-highlights-heading">
            <h2 id="sector-highlights-heading">{{ 'Key highlights'|t({}, sector_t) }}</h2>
            {{ content.field_sector_highlights }}
          </section>
        {% endif %}

        {% if has_stats %}
          <section class="sector-page__triptych-cell sector-page__panel sector-page__panel--stats" aria-labelledby="sector-stats-heading">
            <h2 id="sector-stats-heading">
              {% if sector_api_key_stats is defined and sector_api_key_stats is not empty and sector_api_key_stats_year is defined %}
                {{ 'Key stats'|t({}, sector_t) }} ({{ sector_api_key_stats_year }})
              {% else %}
                {{ 'Key stats'|t({}, sector_t) }}
              {% endif %}
            </h2>
            {% if sector_api_key_stats is defined and sector_api_key_stats is not empty %}
              {% include '@motaded_theme/sector-page/sector-page-key-stats-api.html.twig' %}
            {% else %}
              {{ content.field_sector_stats }}
            {% endif %}
          </section>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% if sector_trade_volume_chart is defined and sector_trade_volume_chart %}
    <div class="sector-page__trade-chart-wrap">
      {% include '@motaded_theme/sector-page/sector-page-trade-volume-chart.html.twig' %}
    </div>
  {% endif %}

  {% if sector_logistics_gdp_chart is defined and sector_logistics_gdp_chart %}
    <div class="sector-page__gdp-chart-wrap">
      {% include '@motaded_theme/sector-page/sector-page-logistics-gdp-chart.html.twig' %}
    </div>
  {% endif %}

  {% if sector_related_sections is not empty %}
    <div class="sector-page__hub" role="region" aria-label="{{ 'Sector content'|t({}, sector_t) }}">
      {% for section in sector_related_sections %}
        {% if section.layout == 'split' %}
          <section class="sector-page__hub-band sector-page__hub-band--split"{% if section.id %} id="{{ section.id }}"{% endif %}>
            <div class="sector-page__hub-inner">
              <div class="sector-page__split2">
                {% for col in [section.left, section.right] %}
                  <div class="sector-page__split-col"{% if col.id %} id="{{ col.id }}"{% endif %}>
                    <header class="sector-page__hub-head">
                      <h2 class="sector-page__hub-title">{{ col.title }}</h2>
                      {% if col.more_url %}
                        <a href="{{ col.more_url }}" class="sector-page__hub-more"><span>{{ col.more_label|default('View all'|t) }}</span></a>
                      {% endif %}
                    </header>
                    {% if col.rows is not empty %}
                      <ul class="sector-hub-list">
                        {% for row in col.rows %}
                          {% include '@motaded_theme/sector-page/sector-hub-row.html.twig' with { row: row } only %}
                        {% endfor %}
                      </ul>
                    {% else %}
                      <p class="sector-page__hub-empty">{{ col.empty }}</p>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          </section>
        {% else %}
          <section class="sector-page__hub-band sector-page__hub-band--list{% if section.variant == 'news' %} sector-page__hub-band--news{% endif %}"{% if section.id %} id="{{ section.id }}"{% endif %} aria-labelledby="{{ section.id }}-heading">
            <div class="sector-page__hub-inner">
              <header class="sector-page__hub-head">
                <h2 id="{{ section.id }}-heading" class="sector-page__hub-title">{{ section.title }}</h2>
                {% if section.more_url %}
                  <a href="{{ section.more_url }}" class="sector-page__hub-more"><span>{{ section.more_label|default('View all'|t) }}</span></a>
                {% endif %}
              </header>
              {% if section.rows is not empty %}
                <ul class="sector-hub-list">
                  {% for row in section.rows %}
                    {% include '@motaded_theme/sector-page/sector-hub-row.html.twig' with { row: row } only %}
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          </section>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  {% if content.links %}
    <footer class="sector-page__links">{{ content.links }}</footer>
  {% endif %}
</article>
