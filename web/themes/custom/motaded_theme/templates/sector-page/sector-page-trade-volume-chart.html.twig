{#
/**
 * @file
 * Logistics sector: Trade volume over time (World Bank exports + imports).
 */
#}
{% set sector_t = {'langcode': sector_langcode|default('en')} %}
{{ attach_library('motaded_theme/sector_trade_volume_chart') }}
{% set st = sector_trade_volume_chart %}
<section
  class="sector-trade-chart"
  data-sector-trade-volume-chart
  data-chart="{{ st.encoded|e('html_attr') }}"
  data-gradient-id="{{ st.gradient_id|e('html_attr') }}"
  dir="ltr"
  aria-labelledby="sector-trade-chart-title"
>
  <div class="sector-trade-chart__inner">
    <header class="sector-trade-chart__head">
      <div class="sector-trade-chart__title-row">
        <h2 id="sector-trade-chart-title" class="sector-trade-chart__title">{{ 'Trade volume over time'|t({}, sector_t) }}</h2>
      </div>
      <div class="sector-trade-chart__tabs" role="tablist" aria-label="{{ 'Chart metric'|t({}, sector_t) }}">
        <button type="button" class="sector-trade-chart__tab is-active" role="tab" data-tab="value" aria-selected="true" id="sector-trade-tab-value">{{ 'Value (USD Billion)'|t({}, sector_t) }}</button>
        <button type="button" class="sector-trade-chart__tab" role="tab" data-tab="growth" aria-selected="false" id="sector-trade-tab-growth"{% if not st.has_growth %} disabled aria-disabled="true"{% endif %}>{{ 'Growth (%)'|t({}, sector_t) }}</button>
      </div>
    </header>

    <div class="sector-trade-chart__panels">
      <div class="sector-trade-chart__panel" data-panel="value" role="tabpanel" aria-labelledby="sector-trade-tab-value">
        <svg class="sector-trade-chart__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'Trade volume in USD billion by year'|t({}, sector_t) }}"></svg>
      </div>
      <div class="sector-trade-chart__panel" data-panel="growth" role="tabpanel" aria-labelledby="sector-trade-tab-growth" hidden>
        <svg class="sector-trade-chart__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'Year over year growth of trade volume'|t({}, sector_t) }}"></svg>
      </div>
    </div>

    <footer class="sector-trade-chart__foot">
      <p class="sector-trade-chart__source">{{ 'Source: Data Saudi'|t({}, sector_t) }}</p>
    </footer>
  </div>
</section>
