{#
/**
 * @file
 * Logistics sector: Trade volume over time (World Bank exports + imports).
 */
#}
{{ attach_library('motaded_theme/sector_trade_volume_chart') }}
{% set st = sector_trade_volume_chart %}
<section
  class="sector-trade-chart"
  data-sector-trade-volume-chart
  data-chart="{{ st.encoded|e('html_attr') }}"
  data-gradient-id="{{ st.gradient_id|e('html_attr') }}"
  dir="ltr"
  aria-labelledby="sector-trade-chart-title"
>
  <div class="sector-trade-chart__inner">
    <header class="sector-trade-chart__head">
      <div class="sector-trade-chart__title-row">
        <h2 id="sector-trade-chart-title" class="sector-trade-chart__title">{{ 'Trade volume over time'|t }}</h2>
        <a
          class="sector-trade-chart__info"
          href="https://datahelpdesk.worldbank.org/knowledgebase/articles/898596-methodology-for-world-development-indicators-trade"
          rel="noopener noreferrer"
          target="_blank"
          title="{{ 'World Bank methodology for development indicators'|t }}"
        >
          <span class="visually-hidden">{{ 'World Bank methodology for development indicators'|t }}</span>
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
            <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.25"/>
            <path d="M9 12.2v.35" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M9 5.4v4.1" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          </svg>
        </a>
      </div>
      <div class="sector-trade-chart__tabs" role="tablist" aria-label="{{ 'Chart metric'|t }}">
        <button type="button" class="sector-trade-chart__tab is-active" role="tab" data-tab="value" aria-selected="true" id="sector-trade-tab-value">{{ 'Value (USD Billion)'|t }}</button>
        <button type="button" class="sector-trade-chart__tab" role="tab" data-tab="growth" aria-selected="false" id="sector-trade-tab-growth"{% if not st.has_growth %} disabled aria-disabled="true"{% endif %}>{{ 'Growth (%)'|t }}</button>
      </div>
    </header>

    <div class="sector-trade-chart__panels">
      <div class="sector-trade-chart__panel" data-panel="value" role="tabpanel" aria-labelledby="sector-trade-tab-value">
        <svg class="sector-trade-chart__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'Trade volume in USD billion by year'|t }}"></svg>
      </div>
      <div class="sector-trade-chart__panel" data-panel="growth" role="tabpanel" aria-labelledby="sector-trade-tab-growth" hidden>
        <svg class="sector-trade-chart__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ 'Year over year growth of trade volume'|t }}"></svg>
      </div>
    </div>

    <footer class="sector-trade-chart__foot">
      <p class="sector-trade-chart__source">{{ 'Source: World Bank'|t }}</p>
      <a class="sector-trade-chart__method" href="https://data.worldbank.org/country/saudi-arabia" rel="noopener noreferrer" target="_blank">{{ 'View methodology'|t }}</a>
    </footer>
  </div>
</section>
