<header
	class="z-[201] bg-white border-b border-slate-200 site-header-bar"
	@keydown.escape.window="openMenu=null; mobileOpen=false; mobileSection=null; mobileSubsection=null">
	<!-- Desktop (≥992px) -->
	<div class="max-w-[1320px] mx-auto px-4 hidden nav-desktop:block">
		<div class="site-header-bar__inner-row flex items-center justify-between gap-3 lg:gap-4 xl:gap-6 min-h-[80px] py-2">
			<!-- Left: Logo -->
			<div class="shrink-0 flex items-center">
				<a href="{{ front_page }}" class="block">
					<img alt="Motaded" class="h-9 w-auto max-w-[120px] object-contain object-left" src="{{ logo_path }}" width="500" height="92"/>
				</a>
			</div>

			<!-- Center: Nav -->
			<nav class="hidden nav-desktop:flex flex-1 min-w-0 justify-center items-center px-2 mot-header-main-nav" @click.outside="openMenu=null" aria-label="{{ 'Primary'|t }}">
				{{ page.main_menu }}
			</nav>

			{% set search_url = url('<front>')|render ~ '/search/content' %}
			<!-- Right: CTA / Search / Lang -->
			<div class="shrink-0 flex items-center justify-end gap-2">
				{% if page.header_cta %}
					<div class="flex items-center shrink-0">{{ page.header_cta }}</div>
				{% endif %}
				<div class="flex gap-1.5 lg:gap-2 text-xs">
					<!-- Search -->
					<div class="relative flex items-center">
						<a class="inline-flex items-center justify-center font-medium transition rounded-sm text-black text-xs size-8 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800" aria-label="{{ 'Search'|t }}" href="{{ search_url|replace({'//s': '/s'}) }}">
							<img alt="{{ 'Search'|t }}" width="24" height="24" src="/themes/custom/motaded_theme/img/icon-search.svg" aria-hidden="true"/>
						</a>
						<p class="text-xs font-medium leading-[1.6] hidden xl:block ml-1 mb-0">
							{{ "Search"|t }}
						</p>
					</div>

					<!-- Language -->
					<span class="flex justify-center px-0 text-xs">
						<div class="flex gap-1.5 items-center">
							{{ page.secondary_menu }}
						</div>
					</span>
				</div>
			</div>
		</div>
	</div>

	<!-- Mobile bar (≤991px) -->
	<div class="mot-mobile-header nav-desktop:hidden">
		<div class="mot-mobile-header__inner max-w-[1320px] mx-auto px-4">
			<a href="{{ front_page }}" class="mot-mobile-header__logo shrink-0">
				<img alt="Motaded" src="{{ logo_path }}" width="500" height="92"/>
			</a>

			<div class="mot-mobile-header__actions">
				{% if page.header_cta %}
					<div class="mot-mobile-header__cta flex items-center shrink-0">{{ page.header_cta }}</div>
				{% endif %}
				<button
					type="button"
					class="mot-mobile-header__burger"
					aria-label="{{ 'Menu'|t }}"
					:aria-expanded="mobileOpen"
					@click="mobileOpen = true; mobileSection = null; mobileSubsection = null">
					<img alt="{{ 'Menu'|t }}" width="24" height="24" src="/themes/custom/motaded_theme/img/icon-menu.svg" aria-hidden="true"/>
				</button>
			</div>
		</div>
	</div>
</header>
