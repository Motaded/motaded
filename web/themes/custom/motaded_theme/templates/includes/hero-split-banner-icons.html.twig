{#
  Centralized SVG icons for hero split banner (why-style keys + stat keys).
  Use: {% import '@motaded_theme/includes/hero-split-banner-icons.html.twig' as hs_icons %}
       {{ hs_icons.why_icon(icon, 18)|raw }}
       {{ hs_icons.stat_icon(icon, 20)|raw }}
#}
{% macro why_icon(icon, size) %}{% set s = size|default(18) %}{% if icon == 'medal' %}
