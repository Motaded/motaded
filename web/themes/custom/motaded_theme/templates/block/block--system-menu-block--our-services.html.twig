{#
/**
 * @file
 * Our Services: visible at all breakpoints (no hidden md:block from footer template).
 */
#}
{%
  set classes = [
    'block',
    'block-menu',
    'navigation',
    'menu--' ~ derivative_plugin_id|clean_class,
  ]
%}
{% set heading_id = (attributes.id ~ '-menu')|clean_id %}
<div class="block text-white">
  <nav role="navigation" aria-labelledby="{{ heading_id }}"{{ attributes.addClass(classes)|without('role', 'aria-labelledby') }}>

    {{ title_prefix }}
    <p id="{{ heading_id }}" class="text-md font-semibold block mb-3 leading-[1.6]{{ not configuration.label_display ? ' visually-hidden' : '' }}">
      {{ configuration.label }}
    </p>
    {{ title_suffix }}
    <div class="w-full bg-white/30 my-3 h-px"></div>
    {# Menu. #}
    {% block content %}
      {{ content }}
    {% endblock %}
  </nav>
</div>
