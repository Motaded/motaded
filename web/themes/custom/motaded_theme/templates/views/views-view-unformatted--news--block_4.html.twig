{{ attach_library('motaded_theme/latest_news_block') }}
<ul class="latest-news-list">
  {% for row in rows %}
    <li class="latest-news-list__item">
      <a href="{{ row.url }}" class="latest-news-list__link">
        <div class="latest-news-list__thumb">
          {% if row.image.srcset %}
            <img
              loading="lazy"
              decoding="async"
              alt="{{ row.image.alt }}"
              src="{{ row.image.src }}"
              srcset="{{ row.image.srcset }}"
              sizes="96px"
              width="{{ row.image.width }}"
              height="{{ row.image.height }}"
            />
          {% else %}
            <img
              loading="lazy"
              decoding="async"
              alt="{{ row.image.alt }}"
              width="{{ row.image.width }}"
              height="{{ row.image.height }}"
              src="{{ row.image.src }}"
            />
          {% endif %}
        </div>
        <div class="latest-news-list__main">
          {% if row.created %}
            <time class="latest-news-list__date" datetime="{{ row.created_iso }}">{{ row.created }}</time>
          {% endif %}
          <div class="latest-news-list__title-row">
            <p class="latest-news-list__title">{{ row.title }}</p>
            <span class="latest-news-list__arrow" aria-hidden="true">→</span>
          </div>
        </div>
      </a>
    </li>
  {% endfor %}
</ul>
