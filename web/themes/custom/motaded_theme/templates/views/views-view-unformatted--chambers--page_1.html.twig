{#
/**
 * @file
 * Chambers — /chambers directory grid.
 */
#}
<div class="chambers-directory__grid" role="list">
  {% for row in rows %}
    {%
      set row_classes = [
        default_row_class ? 'views-row',
      ]
    %}
    <div{{ row.attributes.addClass(row_classes) }}>
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
