{#
/**
 * @file
 * Services directory: horizontal service card (media, meta, platforms, CTA).
 */
#}
{% set view_href = fields.view_node.content|render|striptags|trim %}
{% set media_markup = fields.field_media is defined ? fields.field_media.content|render : '' %}
{% set card_title = fields.title.content|render|striptags|trim %}
<a href="{{ view_href }}" class="service-card-horizontal" rel="bookmark" aria-label="{{ (card_title ~ ' — ' ~ ('View service'|t))|e('html_attr') }}">
  <div class="service-card-horizontal__media">
    {% if media_markup|trim %}
      <div class="service-card-horizontal__img">
        {{ fields.field_media.content }}
      </div>
    {% else %}
      <div class="service-card-horizontal__img service-card-horizontal__img--placeholder" role="img" aria-label=""></div>
    {% endif %}
  </div>
  <div class="service-card-horizontal__body">
    {% if services_card_eyebrow %}
      <p class="service-card-horizontal__eyebrow">{{ services_card_eyebrow }}</p>
    {% endif %}
    <h2 class="service-card-horizontal__title">{{ fields.title.content }}</h2>
    <div class="service-card-horizontal__summary">{{ fields.body.content }}</div>
    {% set feats = services_tag_labels|default([]) %}
    {% if feats is not empty %}
      <ul class="service-card-horizontal__features" aria-label="{{ 'Highlights'|t }}">
        {% for label in feats %}
          <li class="service-card-horizontal__feature">{{ label }}</li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
  <aside class="service-card-horizontal__aside">
    <div class="service-card-horizontal__aside-top">
      <p class="service-card-horizontal__platforms-label">{{ 'Beneficiaries'|t }}</p>
    </div>
    <div class="service-card-horizontal__chips">
      {% for b in services_beneficiary_labels|default([])|slice(0, 6) %}
        <span class="service-card-horizontal__chip">{{ b }}</span>
      {% endfor %}
    </div>
    <span class="service-card-horizontal__cta">
      {{ 'View service'|t }}
      <span class="service-card-horizontal__cta-arrow" aria-hidden="true">→</span>
    </span>
  </aside>
</a>
