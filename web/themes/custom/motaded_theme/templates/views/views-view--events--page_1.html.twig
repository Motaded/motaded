{#
/**
 * @file
 * Events directory — hero (background + stats card + filters), featured, grid, calendar.
 */
#}
{{ attach_library('motaded_theme/events_directory') }}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'events-directory',
    'events-directory-page',
    'page-gray',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% set hero_bg_url = motaded_events_hero_bg_url|default('') %}

  <div class="events-directory__hero"{% if hero_bg_url %} style="--events-hero-bg: url('{{ hero_bg_url|e('html_attr') }}');"{% endif %}>
    <div class="events-directory__hero-bg" aria-hidden="true"></div>
    <div class="events-directory__hero-gradient" aria-hidden="true"></div>

    <div class="events-directory__hero-inner">
      <div class="events-directory__hero-top">
        <div class="events-directory__hero-copy">
          <header class="events-directory__masthead events-directory__masthead--hero">
            <h1 class="events-directory__title">{{ 'Events'|t }}</h1>
            <p class="events-directory__lede">{{ 'Discover business events, conferences, and workshops happening across Saudi Arabia.'|t }}</p>
          </header>
        </div>

        {% if motaded_events_stats is defined and motaded_events_stats is not empty %}
          <div class="events-directory__stats-card" aria-label="{{ 'At a glance'|t }}">
            <div class="events-directory__stats-grid">
              {% for stat in motaded_events_stats %}
                <div class="events-directory__stat-col">
                  <div class="events-directory__stat-icon" aria-hidden="true">
                    {% if stat.icon == 'calendar' %}
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {% elseif stat.icon == 'users' %}
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M8.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm12 10v-2a4 4 0 0 0-3-3.87m-1.5-9.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% elseif stat.icon == 'map' %}
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="11" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
                    {% else %}
                      <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {% endif %}
                  </div>
                  <p class="events-directory__stat-value">{{ stat.value }}</p>
                  <p class="events-directory__stat-label">{{ stat.label }}</p>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>

      {% if exposed %}
        <div class="events-directory__hero-filters view-filters">
          {{ exposed }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="events-directory__shell">

    {% if motaded_events_featured %}
      <section class="events-directory__featured-wrap" aria-labelledby="events-directory-featured-heading">
        <div class="events-directory__featured">
          <div class="events-directory__featured-main">
            {{ motaded_events_featured }}
          </div>
          <aside class="events-directory__featured-aside" aria-label="{{ 'Quick links'|t }}">
            <p class="events-directory__aside-title">{{ 'Quick links'|t }}</p>
            <ul class="events-directory__aside-list">
              <li>
                <a href="/contact-us">{{ 'Contact us'|t }}</a>
              </li>
              <li>
                <a href="/services">{{ 'Our services'|t }}</a>
              </li>
              <li>
                <a href="/blog">{{ 'Blog & insights'|t }}</a>
              </li>
              <li>
                <a href="/search/content">{{ 'Search site'|t }}</a>
              </li>
            </ul>
          </aside>
        </div>
      </section>
    {% endif %}

    <div class="events-directory__toolbar" role="toolbar" aria-label="{{ 'Listing display'|t }}">
      <div class="events-directory__toolbar-intro">
        <h2 class="events-directory__grid-heading">{{ 'Upcoming events'|t }}</h2>
        <p class="events-directory__grid-lede">{{ 'Explore all upcoming business events and opportunities.'|t }}</p>
      </div>
      <div class="events-directory__toolbar-controls">
        <span class="events-directory__toolbar-label" id="events-dir-toggle-label">{{ 'View as'|t }}</span>
        <div class="events-directory__toggle" role="group" aria-labelledby="events-dir-toggle-label">
          <button type="button" class="events-directory__toggle-btn is-active" data-events-dir-mode="list" aria-pressed="true">
            {{ 'Cards'|t }}
          </button>
          <button type="button" class="events-directory__toggle-btn" data-events-dir-mode="calendar" aria-pressed="false">
            {{ 'Calendar'|t }}
          </button>
        </div>
      </div>
    </div>

    {% if attachment_before %}
      <div class="events-directory__panel events-directory__panel--calendar" data-events-dir-panel="calendar" hidden>
        <div class="attachment attachment-before events-directory__calendar-attachment">
          {{ attachment_before }}
        </div>
      </div>
    {% endif %}

    <div class="events-directory__panel events-directory__panel--list" data-events-dir-panel="list">
      {% if rows %}
        <div class="view-content events-directory__grid">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="view-empty">
          {{ empty }}
        </div>
      {% endif %}
      {% if pager %}
        <div class="events-directory__pager">
          {{ pager }}
        </div>
      {% endif %}
    </div>

    <section class="events-directory__newsletter" aria-label="{{ 'Subscribe'|t }}">
      <div class="events-directory__newsletter-inner">
        <div class="events-directory__newsletter-copy">
          <h2 class="events-directory__newsletter-title">{{ 'Get event updates'|t }}</h2>
          <p class="events-directory__newsletter-lede">{{ 'Tell us what you follow — our team can share relevant invitations and briefings.'|t }}</p>
        </div>
        <div class="events-directory__newsletter-form" aria-label="{{ 'Event updates signup'|t }}">
          {{ motaded_event_updates_form }}
        </div>
      </div>
    </section>

    {% if attachment_after %}
      <div class="attachment attachment-after">
        {{ attachment_after }}
      </div>
    {% endif %}
    {% if more %}
      {{ more }}
    {% endif %}
    {% if footer %}
      <div class="view-footer">
        {{ footer }}
      </div>
    {% endif %}
    {% if feed_icons %}
      <div class="feed-icons">
        {{ feed_icons }}
      </div>
    {% endif %}
  </div>
</div>
