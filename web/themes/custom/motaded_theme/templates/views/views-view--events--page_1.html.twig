{#
/**
 * @file
 * Events directory (/events): split-banner hero with events-bg.png on the
 * visual side (same architecture as /services, /sectors, /platforms,
 * /library), filters band below the hero, featured row, results grid +
 * calendar toggle, newsletter.
 */
#}
{{ attach_library('motaded_theme/events_directory') }}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
    'services-directory',
    'services-directory--page-redesign',
    'events-directory',
    'events-directory--page',
    'events-directory-page',
    'page-gray',
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {{ title_suffix }}

  <header class="services-page-hero services-page-hero--split-banner events-directory__split-hero">
    <div class="services-page-hero__bg" aria-hidden="true">
      <div class="services-page-hero__visual-base"></div>
      <div class="services-page-hero__visual-photo events-directory__hero-photo"></div>
      <div class="services-page-hero__visual-arcs"></div>
      <div class="services-page-hero__visual-semi"></div>
      <span class="services-page-hero__visual-dots services-page-hero__visual-dots--tr"></span>
      <span class="services-page-hero__visual-dots services-page-hero__visual-dots--br"></span>
    </div>
    <div class="services-page-hero__split">
      <div class="services-page-hero__col services-page-hero__col--copy hero-split-banner__copy-col">
        <div class="services-page-hero__copy-inner hero-split-banner__copy">
          <h1 class="hero-split-banner__title">{{ 'Business events and meetups in Saudi Arabia'|t }}</h1>
          <div class="hero-split-banner__intro">
            <p>{{ 'Discover conferences, workshops, expos, and networking sessions happening across the Kingdom — curated for investors, founders, and operators expanding in Saudi Arabia.'|t }}</p>
            <p>{{ 'Filter by date, region, or topic to find the events that move your business forward, and reach our team if you need help planning or attending.'|t }}</p>
          </div>
          <nav class="services-page-hero__stats-strip services-page-hero__stats-strip--four" aria-label="{{ 'Quick links'|t }}">
            {% if motaded_events_stats is defined and motaded_events_stats is not empty %}
              {% for stat in motaded_events_stats %}
                <a class="services-page-hero__stat" href="#events-directory-listings" aria-label="{{ (stat.label ~ ' (' ~ stat.value ~ ')')|t }}">
                  <span class="services-page-hero__stat-icon" aria-hidden="true">
                    {% if stat.icon == 'calendar' %}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {% elseif stat.icon == 'users' %}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M8.5 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm12 10v-2a4 4 0 0 0-3-3.87m-1.5-9.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {% elseif stat.icon == 'map' %}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s7-4.35 7-10a7 7 0 1 0-14 0c0 5.65 7 10 7 10Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="11" r="2.5" stroke="currentColor" stroke-width="1.5"/></svg>
                    {% else %}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    {% endif %}
                  </span>
                  <span class="services-page-hero__stat-value">{{ stat.value }}</span>
                  <span class="services-page-hero__stat-label">{{ stat.label }}</span>
                </a>
              {% endfor %}
            {% else %}
              <a class="services-page-hero__stat" href="#events-directory-listings" aria-label="{{ 'Browse upcoming events'|t }}">
                <span class="services-page-hero__stat-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="4" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M16 2v4M8 2v4M3 10h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                </span>
                <span class="services-page-hero__stat-value services-page-hero__stat-value--cta">{{ 'Upcoming'|t }}</span>
                <span class="services-page-hero__stat-label">{{ 'Browse events'|t }}</span>
              </a>
              <a class="services-page-hero__stat" href="#events-directory-filters" aria-label="{{ 'Filter events'|t }}">
                <span class="services-page-hero__stat-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="16" cy="6" r="2" fill="currentColor"/><circle cx="8" cy="12" r="2" fill="currentColor"/><circle cx="13" cy="18" r="2" fill="currentColor"/></svg>
                </span>
                <span class="services-page-hero__stat-value services-page-hero__stat-value--cta">{{ 'Filters'|t }}</span>
                <span class="services-page-hero__stat-label">{{ 'Find events'|t }}</span>
              </a>
              <a class="services-page-hero__stat" href="{{ motaded_events_contact_url|default('/contact-us') }}" aria-label="{{ 'Contact us — speak to our team'|t }}">
                <span class="services-page-hero__stat-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6h16v12H4V6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m4 8 8 5 8-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="services-page-hero__stat-value services-page-hero__stat-value--cta">{{ 'Contact us'|t }}</span>
                <span class="services-page-hero__stat-label">{{ 'Expert support'|t }}</span>
              </a>
            {% endif %}
          </nav>
        </div>
      </div>
      <div class="services-page-hero__col services-page-hero__col--visual" aria-hidden="true"></div>
    </div>
  </header>

  <div class="events-directory__shell">

    {% if exposed %}
      <section class="events-directory__filters-band view-filters" id="events-directory-filters" role="group" aria-label="{{ 'Filter events'|t }}">
        {{ exposed }}
      </section>
    {% endif %}

    {% if motaded_events_featured %}
      <section class="events-directory__featured-wrap" aria-labelledby="events-directory-featured-heading">
        <div class="events-directory__featured">
          <div class="events-directory__featured-main">
            {{ motaded_events_featured }}
          </div>
          <aside class="events-directory__featured-aside" aria-label="{{ 'Quick links'|t }}">
            <p class="events-directory__aside-title">{{ 'Quick links'|t }}</p>
            <ul class="events-directory__aside-list">
              {% for link in motaded_events_quick_links|default([]) %}
                <li>
                  <a href="{{ link.url }}">{{ link.label }}</a>
                </li>
              {% endfor %}
            </ul>
          </aside>
        </div>
      </section>
    {% endif %}

    <div class="events-directory__toolbar" role="toolbar" aria-label="{{ 'Listing display'|t }}">
      <div class="events-directory__toolbar-intro">
        <h2 id="events-directory-listings-heading" class="events-directory__grid-heading">{{ 'Upcoming events'|t }}</h2>
        <p class="events-directory__grid-lede">{{ 'Explore all upcoming business events and opportunities.'|t }}</p>
      </div>
      <div class="events-directory__toolbar-controls">
        <span class="events-directory__toolbar-label" id="events-dir-toggle-label">{{ 'View as'|t }}</span>
        <div class="events-directory__toggle" role="group" aria-labelledby="events-dir-toggle-label">
          <button type="button" class="events-directory__toggle-btn is-active" data-events-dir-mode="list" aria-pressed="true">
            {{ 'Cards'|t }}
          </button>
          <button type="button" class="events-directory__toggle-btn" data-events-dir-mode="calendar" aria-pressed="false">
            {{ 'Calendar'|t }}
          </button>
        </div>
      </div>
    </div>

    {% if attachment_before %}
      <div class="events-directory__panel events-directory__panel--calendar" data-events-dir-panel="calendar" hidden>
        <div class="attachment attachment-before events-directory__calendar-attachment">
          {{ attachment_before }}
        </div>
      </div>
    {% endif %}

    <section class="events-directory__panel events-directory__panel--list" data-events-dir-panel="list" id="events-directory-listings" aria-labelledby="events-directory-listings-heading">
      {% if rows %}
        <div class="view-content events-directory__grid">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="view-empty">
          {{ empty }}
        </div>
      {% endif %}
      {% if pager %}
        <div class="events-directory__pager">
          {{ pager }}
        </div>
      {% endif %}
    </section>

    <section class="events-directory__newsletter" aria-label="{{ 'Subscribe'|t }}">
      <div class="events-directory__newsletter-inner">
        <div class="events-directory__newsletter-copy">
          <h2 class="events-directory__newsletter-title">{{ 'Get event updates'|t }}</h2>
          <p class="events-directory__newsletter-lede">{{ 'Tell us what you follow — our team can share relevant invitations and briefings.'|t }}</p>
        </div>
        <div class="events-directory__newsletter-form" aria-label="{{ 'Event updates signup'|t }}">
          {{ motaded_event_updates_form }}
        </div>
      </div>
    </section>

    {% if attachment_after %}
      <div class="attachment attachment-after">
        {{ attachment_after }}
      </div>
    {% endif %}
    {% if more %}
      {{ more }}
    {% endif %}
    {% if footer %}
      <div class="view-footer">
        {{ footer }}
      </div>
    {% endif %}
    {% if feed_icons %}
      <div class="feed-icons">
        {{ feed_icons }}
      </div>
    {% endif %}
  </div>
</div>
