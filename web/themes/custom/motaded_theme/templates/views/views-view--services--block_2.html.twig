{#
/**
 * @file
 * Services view — home block: sidebar categories + detail column.
 */
#}
{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}
<div{{ attributes.addClass(classes) }}>
  {{ title_prefix }}
  {% if title %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}
  {% if header %}
    <div class="view-header">
      {{ header }}
    </div>
  {% endif %}

  <div class="services-home-shell">
    {% if exposed %}
      <aside class="services-home-sidebar" aria-label="{{ 'Service categories'|t }}">
        <div class="view-filters services-home-sidebar__filters">
          {{ exposed }}
        </div>
      </aside>
    {% endif %}

    <div class="services-home-detail">
      <div class="services-home-category-intro">
        <div class="services-home-category-intro__icon" aria-hidden="true">
          <img
            src="{{ services_home_category_icon_url }}"
            alt=""
            width="56"
            height="56"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="services-home-category-intro__text">
          <h2 class="services-home-category-intro__title">
            {{ services_home_term_name|default('Services'|t) }}
          </h2>
          {% if services_home_term_description %}
            <div class="services-home-category-intro__description text-body">
              {{ services_home_term_description }}
            </div>
          {% endif %}
        </div>
      </div>

      {% if attachment_before %}
        <div class="attachment attachment-before">
          {{ attachment_before }}
        </div>
      {% endif %}

      <h3 class="services-home-offer-heading">{{ 'What we offer'|t }}</h3>

      {% if rows %}
        <div class="services-home-offer-list">
          {{ rows }}
        </div>
      {% elseif empty %}
        <div class="services-home-empty view-empty">
          {{ empty }}
        </div>
      {% endif %}

      {% if pager %}
        {{ pager }}
      {% endif %}
      {% if attachment_after %}
        <div class="attachment attachment-after">
          {{ attachment_after }}
        </div>
      {% endif %}
      {% if more %}
        {{ more }}
      {% endif %}

      <p class="services-home-category-more-wrap">
        <a href="{{ services_home_category_more_url }}" class="services-home-category-more">
          {{ 'View all services in this category'|t }}
          <span class="services-home-category-more__arrow" aria-hidden="true">→</span>
        </a>
      </p>

      {% if footer %}
        <div class="view-footer">
          {{ footer }}
        </div>
      {% endif %}
    </div>
  </div>

  {% if feed_icons %}
    <div class="feed-icons">
      {{ feed_icons }}
    </div>
  {% endif %}
</div>
