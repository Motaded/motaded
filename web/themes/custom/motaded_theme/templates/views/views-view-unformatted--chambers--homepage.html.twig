{#
/**
 * @file
 * Chambers — homepage embed (inside Business Network paragraph).
 */
#}
{% if title %}
  <h3 class="visually-hidden">{{ title }}</h3>
{% endif %}
<div class="chambers-network__grid" role="list">
  {% for row in rows %}
    {%
      set row_classes = [
        default_row_class ? 'views-row',
      ]
    %}
    <div{{ row.attributes.addClass(row_classes) }}>
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
