{#
/**
 * @file
 * Chambers — homepage embed (Business Network paragraph): featured slot + list.
 */
#}
{% if title %}
  <h3 class="visually-hidden">{{ title }}</h3>
{% endif %}
{% if rows %}
  <div class="cnb-home">
    <div class="cnb-home__featured" role="list">
      {% set first_row = rows|first %}
      <div{{ first_row.attributes.addClass('cnb-home__featured-slot') }}>
        {{- first_row.content -}}
      </div>
    </div>
    {% if rows|length > 1 %}
      <h3 class="cnb-home__subheading">{{ 'Other Chambers & Councils'|t }}</h3>
      <div class="cnb-home__list" role="list">
        {% for row in rows|slice(1, 4) %}
          <div{{ row.attributes.addClass('views-row', 'cnb-home__list-item') }}>
            {{- row.content -}}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endif %}
