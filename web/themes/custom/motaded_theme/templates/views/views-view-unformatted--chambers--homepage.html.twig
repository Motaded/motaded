{#
/**
 * @file
 * Chambers — homepage embed (Business Network paragraph): featured slot + grid.
 */
#}
{% if title %}
  <h3 class="visually-hidden">{{ title }}</h3>
{% endif %}
{% if rows %}
  <div class="cnb-home">
    <div class="cnb-home__featured" role="list">
      {% set first_row = rows|first %}
      <div{{ first_row.attributes.addClass('cnb-home__featured-slot') }}>
        {{- first_row.content -}}
      </div>
    </div>
    {% if rows|length > 1 %}
      <h3 class="cnb-home__subheading">{{ 'Other Chambers & Councils'|t }}</h3>
      <div class="cnb-home__grid" role="list">
        {% for row in rows|slice(1, 4) %}
          <div{{ row.attributes.addClass('views-row', 'cnb-home__grid-item') }}>
            {{- row.content -}}
          </div>
        {% endfor %}
      </div>
      <div class="cnb-home__footer">
        <a class="cnb-home__view-all" href="{{ path('view.chambers.page_1') }}">
          <span class="cnb-home__view-all-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <rect x="4" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="13" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="4" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
              <rect x="13" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
            </svg>
          </span>
          {{ 'View all chambers & councils'|t }}
        </a>
      </div>
    {% endif %}
  </div>
{% endif %}
