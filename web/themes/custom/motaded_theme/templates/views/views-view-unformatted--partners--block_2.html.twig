{#
/**
 * @file
 * Partners marquee variant.
 * All partners are rendered server-side for SEO.
 */
#}

{% if title %}
  <h3>{{ title }}</h3>
{% endif %}

{% set total = view.result|length %}

{% if total > 0 %}
  <section class="partners-showcase partners-showcase--marquee">
    <div class="partners-showcase__bg" aria-hidden="true">
      <span class="partners-showcase__blob partners-showcase__blob--one"></span>
      <span class="partners-showcase__blob partners-showcase__blob--two"></span>
    </div>

    <div class="partners-showcase__rail-wrap">
      <div class="partners-showcase__rail-track">
        {% for pass in [1, 2] %}
          {% for result_row in view.result %}
            {% set entity = result_row._entity %}
            {% set media = (entity.hasField('field_media') and not entity.field_media.isEmpty) ? entity.field_media.entity : null %}
            {% set image = (media and media.field_media_image is defined and not media.field_media_image.isEmpty) ? media.field_media_image.entity : null %}
            {% set logo_uri = image ? image.uri.value : '' %}
            {% set logo_url = logo_uri ? file_url(logo_uri) : '' %}
            {% set logo_alt = (media and not media.field_media_image.isEmpty) ? media.field_media_image.alt : '' %}
            {% set partner_name = (entity.hasField('field_partner_name') and not entity.field_partner_name.isEmpty) ? entity.field_partner_name.value : entity.label %}
            {% set role = (entity.hasField('field_one_line_role') and not entity.field_one_line_role.isEmpty) ? entity.field_one_line_role.value : '' %}

            <article class="partners-showcase__logo-card" aria-label="{{ partner_name }}{% if role %} — {{ role }}{% endif %}">
              {% if logo_url %}
                <img
                  src="{{ logo_url }}"
                  alt="{{ logo_alt|default(partner_name)|e }}"
                  class="partners-showcase__logo-img"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  width="180"
                  height="72"
                  sizes="(min-width: 1024px) 180px, 42vw"
                />
              {% endif %}
            </article>
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    <div class="partners-showcase__mobile-grid">
      {% for result_row in view.result %}
        {% set entity = result_row._entity %}
        {% set media = (entity.hasField('field_media') and not entity.field_media.isEmpty) ? entity.field_media.entity : null %}
        {% set image = (media and media.field_media_image is defined and not media.field_media_image.isEmpty) ? media.field_media_image.entity : null %}
        {% set logo_uri = image ? image.uri.value : '' %}
        {% set logo_url = logo_uri ? file_url(logo_uri) : '' %}
        {% set logo_alt = (media and not media.field_media_image.isEmpty) ? media.field_media_image.alt : '' %}
        {% set partner_name = (entity.hasField('field_partner_name') and not entity.field_partner_name.isEmpty) ? entity.field_partner_name.value : entity.label %}
        {% set role = (entity.hasField('field_one_line_role') and not entity.field_one_line_role.isEmpty) ? entity.field_one_line_role.value : '' %}
        <article class="partners-showcase__logo-card partners-showcase__logo-card--mobile" aria-label="{{ partner_name }}{% if role %} — {{ role }}{% endif %}">
          {% if logo_url %}
            <img
              src="{{ logo_url }}"
              alt="{{ logo_alt|default(partner_name)|e }}"
              class="partners-showcase__logo-img"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="160"
              height="64"
              sizes="(max-width: 1023px) 160px"
            />
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>
{% endif %}
