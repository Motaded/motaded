{#
/**
 * @file
 * Partners marquee variant.
 * Desktop (≥1024px): infinite marquee rail.
 * Tablet/mobile (<1024px): Swiper carousel.
 */
#}

{% if title %}
  <h3>{{ title }}</h3>
{% endif %}

{% set total = partner_items|length %}

{% if total > 0 %}
  {{ attach_library('motaded_theme/partner_carousel') }}
  <section class="partners-showcase partners-showcase--marquee">
    <div class="partners-showcase__bg" aria-hidden="true">
      <span class="partners-showcase__blob partners-showcase__blob--one"></span>
      <span class="partners-showcase__blob partners-showcase__blob--two"></span>
    </div>

    <div class="partners-showcase__rail-wrap">
      <div class="partners-showcase__rail-track">
        {% for pass in [1, 2] %}
          {% for item in partner_items %}
            <article class="partners-showcase__logo-card" aria-label="{{ item.name }}{% if item.role %} — {{ item.role }}{% endif %}">
              {% if item.src %}
                <img
                  src="{{ item.src }}"
                  {% if item.srcset %}srcset="{{ item.srcset }}"{% endif %}
                  alt="{{ item.alt|e }}"
                  class="partners-showcase__logo-img"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  width="{{ item.width }}"
                  height="{{ item.height }}"
                  sizes="(min-width: 1024px) 180px, min(42vw, 160px)"
                />
              {% endif %}
            </article>
          {% endfor %}
        {% endfor %}
      </div>
    </div>

    <div class="partners-showcase__mobile-swiper partners-swiper swiper" aria-label="{{ 'Partners'|t }}">
      <div class="swiper-wrapper">
        {% for item in partner_items %}
          <div class="swiper-slide">
            <article class="partners-showcase__logo-card partners-showcase__logo-card--slide" aria-label="{{ item.name }}{% if item.role %} — {{ item.role }}{% endif %}">
              {% if item.src %}
                <img
                  src="{{ item.src }}"
                  {% if item.srcset %}srcset="{{ item.srcset }}"{% endif %}
                  alt="{{ item.alt|e }}"
                  class="partners-showcase__logo-img"
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                  width="{{ item.width }}"
                  height="{{ item.height }}"
                  sizes="min(42vw, 160px)"
                />
              {% endif %}
            </article>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-pagination" aria-hidden="true"></div>
    </div>
  </section>
{% endif %}
