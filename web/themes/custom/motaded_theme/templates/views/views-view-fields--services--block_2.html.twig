{% set service_url = fields.view_node.content|striptags|trim %}
<div class="services-home-row">
  <div class="services-home-row__icon" aria-hidden="true">
    <img
      src="{{ services_home_row_icon_url }}"
      alt=""
      width="22"
      height="22"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="services-home-row__main">
    <h4 class="services-home-row__title">{{ fields.title.content }}</h4>
    <div class="services-home-row__body">{{ fields.body.content }}</div>
  </div>
  <a href="{{ service_url }}" class="services-home-row__cta">
    {{ 'View details'|t }}
    <span class="services-home-row__cta-arrow" aria-hidden="true">→</span>
  </a>
</div>
