{% set service_url = fields.view_node.content|striptags|trim %}
<article class="services-home-card">
  <div class="services-home-card__icon" aria-hidden="true">
    <img
      src="/themes/custom/motaded_theme/img/icon-target.svg"
      alt=""
      width="22"
      height="22"
      loading="lazy"
      decoding="async"
    />
  </div>
  <h3 class="services-home-card__title">{{ fields.title.content }}</h3>
  <p class="services-home-card__body">{{ fields.body.content }}</p>
  <hr class="services-home-card__rule" />
  <a href="{{ service_url }}" class="services-home-card__cta">
    {{ 'Get started'|t }}
  </a>
</article>
