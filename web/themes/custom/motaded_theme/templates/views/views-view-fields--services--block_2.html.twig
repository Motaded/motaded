{#
/**
 * @file
 * Services homepage block — one fully clickable row per service.
 */
#}
{% set service_url = fields.view_node.content|striptags|trim %}
{% set service_title = fields.title.content|striptags|trim %}
<a
  href="{{ service_url }}"
  class="services-home-row services-home-row__link"
  rel="bookmark"
  aria-label="{{ (service_title ~ ' — ' ~ ('View details'|t))|e('html_attr') }}"
>
  <span class="services-home-row__icon" aria-hidden="true">
    <img
      src="{{ services_home_row_icon_url }}"
      alt=""
      width="22"
      height="22"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="services-home-row__main">
    <h4 class="services-home-row__title">{{ fields.title.content }}</h4>
    <span class="services-home-row__body">{{ fields.body.content }}</span>
  </span>
  <span class="services-home-row__cta">
    {{ 'View details'|t }}
    <span class="services-home-row__cta-arrow" aria-hidden="true">→</span>
  </span>
</a>
