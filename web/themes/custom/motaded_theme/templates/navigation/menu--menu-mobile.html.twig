{#
  Mobile drawer menu — accordion (closed by default).
  Level 0: mobileSection. Nested groups inside a panel: mobileSubsection.
#}
{% import _self as menus %}

<div class="mot-mobile-menu">
	{{ menus.menu_links(items, 0, '', '') }}
</div>

{% macro menu_slug(title) %}
	{{- title|render|striptags|trim|lower|replace({'&': 'and', '/': ' ', '-': ' '})|replace({'  ': ' ', ' ': '_'}) -}}
{% endmacro %}

{% macro menu_links(items, menu_level, parent_key, subsection_key) %}
	{% import _self as menus %}
	{% if items %}
		{% if menu_level == 1 %}
			<div
				class="mot-mobile-menu__panel"
				x-show="mobileSection === '{{ parent_key }}'"
				x-cloak
				x-transition.opacity.duration.150ms>
				<ul class="mot-mobile-menu__list mot-mobile-menu__list--child" role="list">
		{% elseif menu_level == 2 %}
			<div
				class="mot-mobile-menu__subpanel"
				x-show="mobileSubsection === '{{ subsection_key }}'"
				x-cloak
				x-transition.opacity.duration.150ms>
				<ul class="mot-mobile-menu__list mot-mobile-menu__list--grandchild" role="list">
		{% endif %}

		{% for item in items %}
			{% set slug = menus.menu_slug(item.title) %}
			{% if menu_level == 0 %}
				<div class="mot-mobile-menu__item border-b border-gray-200{{ item.in_active_trail ? ' menu-item--active-trail' : '' }}">
					{% if item.below %}
						<button
							type="button"
							class="mot-mobile-menu__trigger mot-mobile-menu__trigger--top"
							@click="mobileSection = (mobileSection === '{{ slug }}' ? null : '{{ slug }}'); mobileSubsection = null"
							:aria-expanded="mobileSection === '{{ slug }}'">
							<span>{{ item.title }}</span>
							<img
								alt="{{ 'Toggle submenu'|t }}"
								width="16"
								height="16"
								class="mot-mobile-menu__chev transition-transform"
								:class="mobileSection === '{{ slug }}' ? 'rotate-180' : ''"
								src="/themes/custom/motaded_theme/img/icon-arrow-down.svg"
								aria-hidden="true"/>
						</button>
						{{ menus.menu_links(item.below, 1, slug, '') }}
					{% else %}
						{{ link(item.title, item.url, {
							'class': [
								'mot-mobile-menu__link',
								'mot-mobile-menu__link--top',
								item.in_active_trail ? 'is-active',
							],
						}) }}
					{% endif %}
				</div>
			{% elseif menu_level == 1 %}
				<li class="mot-mobile-menu__list-item">
					{% if item.below %}
						<button
							type="button"
							class="mot-mobile-menu__trigger mot-mobile-menu__trigger--child"
							@click="mobileSubsection = (mobileSubsection === '{{ slug }}' ? null : '{{ slug }}')"
							:aria-expanded="mobileSubsection === '{{ slug }}'">
							<span>{{ item.title }}</span>
							<img
								alt="{{ 'Toggle submenu'|t }}"
								width="16"
								height="16"
								class="mot-mobile-menu__chev transition-transform"
								:class="mobileSubsection === '{{ slug }}' ? 'rotate-180' : ''"
								src="/themes/custom/motaded_theme/img/icon-arrow-down.svg"
								aria-hidden="true"/>
						</button>
						{{ menus.menu_links(item.below, 2, parent_key, slug) }}
					{% else %}
						{% set internal_path = item.url.isRouted ? item.url.getInternalPath() : '' %}
						{% set is_services_hub = internal_path == 'services' %}
						{{ link(item.title, item.url, {
							'class': is_services_hub
								? ['mot-mobile-menu__link', 'mot-mobile-menu__link--hub']
								: ['mot-mobile-menu__link', 'mot-mobile-menu__link--child'],
						}) }}
					{% endif %}
				</li>
			{% else %}
				<li class="mot-mobile-menu__list-item">
					{{ link(item.title, item.url, {
						'class': ['mot-mobile-menu__link', 'mot-mobile-menu__link--grandchild'],
					}) }}
				</li>
			{% endif %}
		{% endfor %}

		{% if menu_level == 1 %}
				</ul>
			</div>
		{% elseif menu_level == 2 %}
				</ul>
			</div>
		{% endif %}
	{% endif %}
{% endmacro %}
