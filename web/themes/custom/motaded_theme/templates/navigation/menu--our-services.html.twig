{#
/**
 * @file
 * Our Services footer menu — columns sized by content (see main.css).
 */
#}
{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}
  {% if items %}
    <div class="menu--our-services__grid">
    {% for item in items %}
      {{ link(item.title, item.url, create_attribute({'class': 'my-0 text-white hover:underline'})) }}
    {% endfor %}
    </div>
  {% endif %}
{% endmacro %}
