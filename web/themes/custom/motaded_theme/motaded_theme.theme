    'pie' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2v10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M21.4 14a9.5 9.5 0 1 1-11.4-11.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
