    'leaf' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 4s-8 0-12 4-4 12-4 12 8 0 12-4 4-12 4-12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 16c2-2 6-6 12-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
