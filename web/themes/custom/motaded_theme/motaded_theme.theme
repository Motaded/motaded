/**
 * Normalizes a URL for duplicate detection (scheme + host + path, no trailing slash).
 */
function _motaded_theme_platform_url_canonical(?string $url): string {
  if ($url === NULL || $url === '') {
    return '';
  }
  $parts = parse_url($url);
  if ($parts === FALSE || empty($parts['host'])) {
    return strtolower(rtrim($url, '/'));
  }
  $scheme = strtolower((string) ($parts['scheme'] ?? 'https'));
  $host = strtolower((string) $parts['host']);
  $path = rtrim((string) ($parts['path'] ?? ''), '/');
  return $scheme . '://' . $host . $path;
}

/**
 * Image style names that must not appear in responsive hero output.
 */
function motaded_theme_responsive_image_blocked_styles(): array {
  return ['max_2600x2600', 'max_1300x1300'];
}

/**
 * Extracts public:// URI from a generated image style URL or URI.
 */
function motaded_theme_responsive_image_source_uri(string $style_uri): ?string {
  if (preg_match('#^public://#', $style_uri)) {
    return $style_uri;
  }
  if (preg_match('#/styles/[^/]+/(?:public|private)/(.+)$#', $style_uri, $matches)) {
    return 'public://' . rawurldecode($matches[1]);
  }
  return NULL;
}

/**
 * Replaces oversized src/srcset entries (legacy max_2600 / max_1300) on responsive images.
 */
function motaded_theme_responsive_image_clamp_oversized_src(array &$variables, string $fallback_style): void {
  if (empty($variables['img_element']) || !is_array($variables['img_element'])) {
    return;
  }

  $blocked = motaded_theme_responsive_image_blocked_styles();
  $uri = (string) ($variables['img_element']['#uri'] ?? '');
  $needs_src_fix = $uri !== '' && array_filter($blocked, static fn(string $style): bool => str_contains($uri, '/styles/' . $style . '/')) !== [];

  $filter_srcset = static function (string $srcset) use ($blocked): string {
    $candidates = array_filter(array_map('trim', explode(',', $srcset)));
    $kept = [];
    foreach ($candidates as $candidate) {
      $skip = FALSE;
      foreach ($blocked as $style) {
        if (str_contains($candidate, '/styles/' . $style . '/')) {
          $skip = TRUE;
          break;
        }
      }
      if (!$skip) {
        $kept[] = $candidate;
      }
    }
    return implode(', ', $kept);
  };

  $attrs = &$variables['img_element']['#attributes'];
  if ($attrs === NULL) {
    return;
  }

  $srcset_value = NULL;
  if ($attrs instanceof \Drupal\Core\Template\Attribute) {
    $srcset_value = $attrs->offsetGet('srcset');
    if (is_string($srcset_value) && $srcset_value !== '') {
      $filtered = $filter_srcset($srcset_value);
      if ($filtered !== $srcset_value) {
        $attrs->setAttribute('srcset', $filtered);
        $needs_src_fix = TRUE;
      }
    }
    $src_value = $attrs->offsetGet('src');
    if (is_string($src_value) && array_filter($blocked, static fn(string $style): bool => str_contains($src_value, '/styles/' . $style . '/')) !== []) {
      $needs_src_fix = TRUE;
    }
  }
  elseif (is_array($attrs)) {
    if (!empty($attrs['srcset']) && is_string($attrs['srcset'])) {
      $filtered = $filter_srcset($attrs['srcset']);
      if ($filtered !== $attrs['srcset']) {
        $variables['img_element']['#attributes']['srcset'] = $filtered;
        $needs_src_fix = TRUE;
      }
    }
    if (!empty($attrs['src']) && is_string($attrs['src'])) {
      foreach ($blocked as $style) {
        if (str_contains($attrs['src'], '/styles/' . $style . '/')) {
          $needs_src_fix = TRUE;
          break;
        }
      }
    }
  }

  if (!$needs_src_fix) {
    return;
  }

  $source_uri = motaded_theme_responsive_image_source_uri($uri);
  if ($source_uri === NULL) {
    return;
  }

  /** @var \Drupal\image\ImageStyleInterface|null $style */
  $style = \Drupal::entityTypeManager()->getStorage('image_style')->load($fallback_style);
  if ($style === NULL) {
    return;
  }

  $variables['img_element']['#uri'] = $style->buildUri($source_uri);
  $url = $style->buildUrl($source_uri);
  if ($attrs instanceof \Drupal\Core\Template\Attribute) {
    $attrs->setAttribute('src', $url);
  }
  elseif (is_array($attrs)) {
    $variables['img_element']['#attributes']['src'] = $url;
  }
}

/**
 * LCP + sizing for responsive hero images (hero_banner style).
 */
function motaded_theme_preprocess_responsive_image_formatter(array &$variables) {
  $style_id = (string) ($variables['responsive_image_style_id'] ?? '');
  if (!in_array($style_id, ['hero_banner', 'banner_sm', 'chamber_card', 'event_teaser', 'news_full'], TRUE)) {
    return;
  }

  $sizes_by_style = [
    'hero_banner' => '(min-width: 1024px) min(45vw, 750px), min(100vw, 320px)',
    'banner_sm' => '(min-width: 1024px) min(40vw, 520px), (min-width: 640px) min(50vw, 520px), min(100vw, 360px)',
    'chamber_card' => '(min-width: 900px) 120px, 88px',
    'event_teaser' => '(min-width: 1024px) 200px, (min-width: 640px) min(42vw, 240px), min(100vw, 360px)',
    'news_full' => '(min-width: 1024px) min(66vw, 720px), min(100vw, 420px)',
  ];
  $fallback_style_by_id = [
    'hero_banner' => 'max_325x325',
    'banner_sm' => 'max_325x325',
    'chamber_card' => 'chamber_card_logo_sm',
    'event_teaser' => 'max_325x325',
    'news_full' => 'max_325x325',
  ];
  motaded_theme_responsive_image_clamp_oversized_src($variables, $fallback_style_by_id[$style_id] ?? 'max_650x650');
  $sizes = $sizes_by_style[$style_id] ?? '';

  foreach (['img_element', 'responsive_image'] as $key) {
    if (empty($variables[$key]['#attributes'])) {
      continue;
    }
    $attr = $variables[$key]['#attributes'];
    if ($attr instanceof \Drupal\Core\Template\Attribute) {
      if ($sizes !== '') {
        $attr->setAttribute('sizes', $sizes);
      }
      if ($style_id === 'hero_banner') {
        $attr->setAttribute('fetchpriority', 'high');
        $attr->setAttribute('decoding', 'async');
      }
      elseif ($style_id === 'chamber_card') {
        $attr->setAttribute('decoding', 'async');
      }
    }
    elseif (is_array($attr)) {
      if ($sizes !== '') {
        $variables[$key]['#attributes']['sizes'] = $sizes;
      }
      if ($style_id === 'hero_banner') {
        $variables[$key]['#attributes']['fetchpriority'] = 'high';
        $variables[$key]['#attributes']['decoding'] = 'async';
      }
      elseif ($style_id === 'chamber_card') {
        $variables[$key]['#attributes']['decoding'] = 'async';
      }
    }
  }
}

/**
 * Renders image media with a responsive hero view mode when available.
 */
function motaded_theme_media_responsive_view(?\Drupal\media\MediaInterface $media, string $preferred_mode = 'hero_banner'): array {
  if ($media === NULL || $media->bundle() !== 'image') {
    return [];
  }
  $modes = array_unique([$preferred_mode, 'hero_banner', 'banner_sm', 'event_teaser', 'default']);
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('media');
  foreach ($modes as $mode) {
    if (\Drupal::entityTypeManager()->getStorage('entity_view_display')->load("media.image.{$mode}")) {
      return $view_builder->view($media, $mode);
    }
  }
  return [];
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Kept as a no-op so the theme hook remains a valid callable (FA uses libraries).
 */
function motaded_theme_page_attachments_alter(array &$attachments): void {
}

/**
 * Whether SEO/marketing third-party tags should be omitted (see settings.php).
 */
function _motaded_theme_suppress_seo_tracking(): bool {
  return (bool) Settings::get('motaded_suppress_seo_tracking', FALSE);
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function motaded_theme_preprocess_html(array &$variables): void {
  $variables['motaded_suppress_seo_tracking'] = _motaded_theme_suppress_seo_tracking();

  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'page'
    && $route_node->hasField('field_display_on_services')
    && !$route_node->get('field_display_on_services')->isEmpty()
    && (int) $route_node->get('field_display_on_services')->value === 1) {
    if (!empty($variables['attributes']) && $variables['attributes'] instanceof \Drupal\Core\Template\Attribute) {
      $variables['attributes']->addClass('is-service-detail-page');
    }
  }

  // Sector page (full node): hide duplicate region breadcrumb; in-hero crumb in node template.
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'sector_page'
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    if (!empty($variables['attributes']) && $variables['attributes'] instanceof \Drupal\Core\Template\Attribute) {
      $variables['attributes']->addClass('is-sector-page');
    }
  }
}

/**
 * Next published event whose start datetime is today or later (for /events hero).
 */
function _motaded_theme_events_directory_next_featured_nid(): ?int {
  try {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $today = gmdate('Y-m-d', \Drupal::time()->getRequestTime());
    $nids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'event')
      ->condition('status', NodeInterface::PUBLISHED)
      ->condition('field_event_start.value', $today . 'T00:00:00', '>=')
      ->sort('field_event_start.value', 'ASC')
      ->range(0, 1)
      ->execute();
    if ($nids !== []) {
      return (int) reset($nids);
    }
  }
  catch (\Exception $e) {
    return NULL;
  }
  return NULL;
}

/**
 * Hero stat strip for /events (counts from content + taxonomies).
 *
 * @return array<int, array{value: string, label: string, icon: string}>
 */
function _motaded_theme_events_directory_stats(): array {
  try {
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $today = gmdate('Y-m-d', \Drupal::time()->getRequestTime());

    $upcoming = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'event')
      ->condition('status', NodeInterface::PUBLISHED)
      ->condition('field_event_start.value', $today . 'T00:00:00', '>=')
      ->count()
      ->execute();

    $total = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'event')
      ->condition('status', NodeInterface::PUBLISHED)
      ->count()
      ->execute();

    $region_count = (int) $term_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'region')
      ->count()
      ->execute();

    $industry_count = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'sector_page')
      ->condition('status', NodeInterface::PUBLISHED)
      ->count()
      ->execute();

    $suffix = static function (int $n): string {
      return $n > 0 ? (string) $n . '+' : '0';
    };

    $volume = static function (int $n) use ($suffix): string {
      if ($n >= 1000) {
        $k = $n / 1000;
        $rounded = abs($k - round($k)) < 0.05 ? (string) (int) round($k) : number_format($k, 1, '.', '');
        return $rounded . 'K+';
      }
      return $suffix($n);
    };

    return [
      [
        'value' => $suffix($upcoming),
        'label' => (string) t('Upcoming events'),
        'icon' => 'calendar',
      ],
      [
        'value' => $volume($total),
        'label' => (string) t('Events hosted'),
        'icon' => 'users',
      ],
      [
        'value' => $suffix($region_count),
        'label' => (string) t('Cities'),
        'icon' => 'map',
      ],
      [
        'value' => (string) max(0, $industry_count),
        'label' => (string) t('Industries'),
        'icon' => 'document',
      ],
    ];
  }
  catch (\Throwable $e) {
    return [];
  }
}

/**
 * Language-aware quick links for /events featured aside.
 *
 * @return array<int, array{url: string, label: string}>
 */
function _motaded_theme_events_directory_quick_links(): array {
  $langcode = motaded_theme_interface_langcode();
  $t_opts = ['langcode' => $langcode];
  try {
    $language = \Drupal::languageManager()->getLanguage($langcode);
  }
  catch (\Throwable $e) {
    $language = NULL;
  }
  $url_opts = $language ? ['language' => $language] : [];
  $paths = [
    '/contact-us',
    '/services',
    '/blog',
    '/search/content',
  ];
  $labels = [
    (string) t('Contact us', [], $t_opts),
    (string) t('Our services', [], $t_opts),
    (string) t('Blog & insights', [], $t_opts),
    (string) t('Search site', [], $t_opts),
  ];
  $links = [];
  foreach ($paths as $i => $path) {
    try {
      $url = Url::fromUserInput($path, $url_opts)->toString();
    }
    catch (\Throwable $e) {
      $url = $langcode === 'ar' ? '/ar' . $path : $path;
    }
    $links[] = ['url' => $url, 'label' => $labels[$i]];
  }
  return $links;
}

/**
 * Hero stat strip for /platforms (counts from content + taxonomies).
 */
function _motaded_theme_platforms_directory_stats(): array {
  try {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $query = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'platform')
      ->condition('status', 1);
    $platforms_count = (int) $query->count()->execute();

    $cat_count = (int) \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'platform_category')
      ->count()
      ->execute();

    $region_count = (int) \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'region')
      ->count()
      ->execute();

    return [
      [
        'label' => (string) t('Official platforms'),
        'value' => $platforms_count > 0 ? $platforms_count . '+' : '—',
        'icon' => 'grid',
      ],
      [
        'label' => (string) t('Categories'),
        'value' => $cat_count > 0 ? $cat_count . '+' : '—',
        'icon' => 'layers',
      ],
      [
        'label' => (string) t('Regions'),
        'value' => $region_count > 0 ? $region_count . '+' : '—',
        'icon' => 'map',
      ],
    ];
  }
  catch (\Throwable $e) {
    return [];
  }
}

/**
 * Category chips row for /platforms (quick filter links).
 */
function _motaded_theme_platforms_directory_category_chips(): array {
  try {
    $t_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $tids = $t_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'platform_category')
      ->sort('weight', 'ASC')
      ->sort('name', 'ASC')
      ->range(0, 8)
      ->execute();
    if (!$tids) {
      return [];
    }
    $terms = $t_storage->loadMultiple($tids);
    $chips = [];
    foreach ($terms as $term) {
      if (!$term instanceof TermInterface) {
        continue;
      }
      $chips[] = [
        'label' => $term->label(),
        'url' => Url::fromUserInput('/platforms', [
          'query' => [
            'field_category_target_id' => (string) $term->id(),
          ],
        ])->toString(),
      ];
    }
    return $chips;
  }
  catch (\Throwable $e) {
    return [];
  }
}

/**
 * Per-category node counts for library sidebar (filtered by active tab’s document types).
 *
 * @param int[] $document_type_tids
 *   Target IDs for field_document_type.
 */
function _motaded_theme_library_category_counts(array $document_type_tids): array {
  if ($document_type_tids === []) {
    return [];
  }
  try {
    $tree = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadTree('document_category', 0, NULL, TRUE);
  }
  catch (\Throwable $e) {
    return [];
  }
  $rows = [];
  foreach ($tree as $term) {
    if (!$term instanceof TermInterface) {
      continue;
    }
    $tid = (int) $term->id();
    try {
      $count = (int) \Drupal::entityQuery('node')
        ->accessCheck(TRUE)
        ->condition('type', 'document')
        ->condition('status', 1)
        ->condition('langcode', \Drupal::languageManager()->getCurrentLanguage()->getId())
        ->condition('field_category', $tid)
        ->condition('field_document_type', $document_type_tids, 'IN')
        ->count()
        ->execute();
    }
    catch (\Throwable $e) {
      $count = 0;
    }
    $rows[] = [
      'tid' => $tid,
      'label' => $term->label(),
      'count' => $count,
    ];
  }
  return $rows;
}

/**
 * Sets tab state, tab URLs, and category counts for Library view displays.
 */
function motaded_theme_preprocess_views_view_library_tabs(array &$variables): void {
  $request = \Drupal::request();
  $templates_tid = function_exists('motaded_custom_library_section_group_tid_by_name')
    ? motaded_custom_library_section_group_tid_by_name('Templates')
    : NULL;
  $regulations_tid = function_exists('motaded_custom_library_section_group_tid_by_name')
    ? motaded_custom_library_section_group_tid_by_name('Regulations')
    : NULL;
  if ($templates_tid === NULL || $regulations_tid === NULL) {
    $variables['library_section'] = 'templates';
    $variables['library_section_active_tid'] = 0;
    $variables['library_section_templates_tid'] = 0;
    $variables['library_section_regulations_tid'] = 0;
    $variables['library_url_templates'] = '';
    $variables['library_url_regulations'] = '';
    $variables['library_category_counts'] = [];
    $variables['library_sidebar_links'] = [];
    $variables['library_category_all_url'] = '';
    $variables['library_category_all_active'] = TRUE;
    return;
  }

  $raw = $request->query->get('library_section');
  if ($raw === NULL || $raw === '') {
    $raw = $request->request->get('library_section');
  }
  $active_tid = function_exists('motaded_custom_library_section_normalize_input')
    ? motaded_custom_library_section_normalize_input($raw, $templates_tid, $regulations_tid)
    : $templates_tid;
  $section = ($active_tid === $regulations_tid) ? 'regulations' : 'templates';
  $variables['library_section'] = $section;
  $variables['library_section_active_tid'] = $active_tid;
  $variables['library_section_templates_tid'] = $templates_tid;
  $variables['library_section_regulations_tid'] = $regulations_tid;

  $query_all = $request->query->all();
  $url_keys = ['library_category', 'field_category_target_id', 'search', 'library_section'];
  foreach ($url_keys as $key) {
    if ((!isset($query_all[$key]) || $query_all[$key] === '' || $query_all[$key] === NULL) && $request->request->has($key)) {
      $query_all[$key] = $request->request->get($key);
    }
  }
  unset($query_all['library_section'], $query_all['q']);
  $query_scoped = $query_all + ['library_section' => (string) $active_tid];
  $library_page_url = static function (array $query): string {
    try {
      return Url::fromRoute('view.library.page_1', [], ['query' => $query])->toString();
    }
    catch (\Throwable $e) {
      return '/library' . ($query !== [] ? '?' . http_build_query($query) : '');
    }
  };
  $variables['library_url_templates'] = $library_page_url($query_all + ['library_section' => (string) $templates_tid]);
  $variables['library_url_regulations'] = $library_page_url($query_all + ['library_section' => (string) $regulations_tid]);

  $type_tids = function_exists('motaded_custom_document_type_tids_for_library_section_tid')
    ? motaded_custom_document_type_tids_for_library_section_tid($active_tid)
    : (function_exists('motaded_custom_library_section_document_type_tids')
      ? motaded_custom_library_section_document_type_tids($section)
      : []);
  $variables['library_category_counts'] = _motaded_theme_library_category_counts($type_tids);

  $active_cat = $request->query->get('library_category');
  if ($active_cat === NULL || $active_cat === '') {
    $active_cat = $request->request->get('library_category');
  }
  if ($active_cat === NULL || $active_cat === '') {
    $active_cat = $request->query->get('field_category_target_id');
  }
  if ($active_cat === NULL || $active_cat === '') {
    $active_cat = $request->request->get('field_category_target_id');
  }
  $active_cat = $active_cat !== NULL && $active_cat !== '' ? (string) $active_cat : '';

  $sidebar = [];
  foreach ($variables['library_category_counts'] as $row) {
    $tid = (string) $row['tid'];
    $q_cat = $query_scoped;
    $q_cat['library_category'] = $tid;
    $sidebar[] = [
      'label' => $row['label'],
      'count' => $row['count'],
      'active' => $active_cat !== '' && $active_cat === $tid,
      'url' => $library_page_url($q_cat),
    ];
  }
  $variables['library_sidebar_links'] = $sidebar;

  $q_all = $query_scoped;
  unset($q_all['library_category'], $q_all['field_category_target_id']);
  $variables['library_category_all_url'] = $library_page_url($q_all);
  $variables['library_category_all_active'] = $active_cat === '';

  $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
  $base = base_path() . $theme_path . '/img/';
  $icons = [
    'icon-target.svg',
    'service-cost.svg',
    'icon-globe.svg',
    'icon-growth.svg',
    'icon-checkmark-circle.svg',
  ];
  $i = 0;
  foreach ($variables['library_sidebar_links'] as &$link_row) {
    $link_row['icon_url'] = $base . ($icons[$i % count($icons)]);
    $i++;
  }
  unset($link_row);
}

/**
 * Implements hook_preprocess_views_view().
 */
function motaded_theme_preprocess_views_view(&$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  // Listing page (/events) only — home strip uses events_home library via block.
  $display_id = $view->current_display ?? '';
  if ($view->id() === 'events' && $display_id === 'page_1') {
    $variables['#attached']['library'][] = 'motaded_theme/events_directory';
    $variables['attributes']['class'][] = 'events-directory-page';
    $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
    $variables['motaded_events_hero_bg_url'] = base_path() . $theme_path . '/images/events-bg.webp';
    $variables['motaded_events_stats'] = _motaded_theme_events_directory_stats();
    $langcode = motaded_theme_interface_langcode();
    try {
      $language = \Drupal::languageManager()->getLanguage($langcode);
      $variables['motaded_events_contact_url'] = Url::fromUserInput('/contact-us', ['language' => $language])->toString();
    }
    catch (\Throwable $e) {
      $variables['motaded_events_contact_url'] = $langcode === 'ar' ? '/ar/contact-us' : '/contact-us';
    }
    $variables['motaded_events_quick_links'] = _motaded_theme_events_directory_quick_links();
    $featured_nid = _motaded_theme_events_directory_next_featured_nid();
    \Drupal::request()->attributes->set('motaded_events_featured_nid', $featured_nid);
    $variables['motaded_events_featured_nid'] = $featured_nid;
    $variables['motaded_events_featured'] = NULL;
    if ($featured_nid !== NULL) {
      $fn = Node::load($featured_nid);
      if ($fn instanceof NodeInterface && $fn->bundle() === 'event' && $fn->access('view')) {
        $build = \Drupal::entityTypeManager()->getViewBuilder('node')->view($fn, 'teaser');
        $build['#motaded_featured_teaser'] = TRUE;
        $variables['motaded_events_featured'] = $build;
      }
    }

    // Render the webform signup inside the view template without Twig Tweak helpers.
    // Twig Tweak's drupal_entity_form() cannot render the Webform entity directly.
    // Render via the webform_block plugin (same as placing a Webform block).
    $variables['motaded_event_updates_form'] = [];
    try {
      if (\Drupal::moduleHandler()->moduleExists('webform')) {
        $block = \Drupal::service('plugin.manager.block')->createInstance('webform_block', [
          'webform_id' => 'event_updates',
          'label_display' => '0',
          'default_data' => '',
          'redirect' => FALSE,
          'lazy' => TRUE,
        ]);
        if ($block && $block->access(\Drupal::currentUser())) {
          $variables['motaded_event_updates_form'] = $block->build();
        }
      }
    }
    catch (\Throwable $e) {
      $variables['motaded_event_updates_form'] = [];
    }
  }

  if ($view->id() === 'events' && in_array($display_id, ['attachment_home_list', 'block_home', 'block_calendar'], TRUE)) {
    $langcode = motaded_theme_interface_langcode();
    $t_opts = ['langcode' => $langcode];
    try {
      $events_path = Url::fromRoute('view.events.page_1', [], [
        'language' => \Drupal::languageManager()->getLanguage($langcode),
      ])->toString();
    }
    catch (\Throwable $e) {
      $events_path = $langcode === 'ar' ? '/ar/events' : '/events';
    }
    $label = (string) t('View all events', [], $t_opts);
    $arrow = $langcode === 'ar' ? '←' : '→';
    $footer_markup = '<div class="events-home__footer-more"><a class="events-home__view-all" href="'
      . Html::escape($events_path) . '">' . Html::escape($label) . ' ' . $arrow . '</a></div>';
    if (in_array($display_id, ['attachment_home_list', 'block_home'], TRUE)) {
      motaded_theme_views_replace_area_markup($variables, 'footer', $footer_markup);
    }

    if ($display_id === 'block_calendar') {
      $language = \Drupal::languageManager()->getLanguage($langcode);
      try {
        $contact_path = Url::fromUserInput('/contact-us', ['language' => $language])->toString();
      }
      catch (\Throwable $e) {
        $contact_path = $langcode === 'ar' ? '/ar/contact-us' : '/contact-us';
      }
      $cta_aria = (string) t('Planning CTA', [], $t_opts);
      $cta_title = (string) t('Planning to attend?', [], $t_opts);
      $cta_body = (string) t('Tell us which events matter to you and our team will follow up.', [], $t_opts);
      $cta_btn = (string) t('Contact our team', [], $t_opts);
      $cta_svg = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M9 16l2 2 4-4"/></svg>';
      $cta_markup = '<aside class="events-home-cta" aria-label="' . Html::escape($cta_aria)
        . '"><span class="events-home-cta__icon" aria-hidden="true">' . $cta_svg
        . '</span><div class="events-home-cta__text"><h3 class="events-home-cta__title">'
        . Html::escape($cta_title) . '</h3><p class="events-home-cta__body">'
        . Html::escape($cta_body) . '</p></div><a class="events-home-cta__btn" href="'
        . Html::escape($contact_path) . '">' . Html::escape($cta_btn) . ' ' . $arrow . '</a></aside>';
      motaded_theme_views_replace_area_markup($variables, 'footer', $cta_markup);
    }

    if ($display_id === 'block_home') {
      $eyebrow = (string) t('Business events', [], $t_opts);
      $title = (string) t('Key Business Events in Saudi Arabia', [], $t_opts);
      $lede = (string) t('Stay informed about major forums, investment events, and industry gatherings shaping the Saudi market.', [], $t_opts);
      $header_markup = '<div class="events-home__intro"><p class="events-home__eyebrow mot-eyebrow">'
        . Html::escape($eyebrow) . '</p><h2 class="events-home__title">'
        . Html::escape($title) . '</h2><p class="events-home__lede">'
        . Html::escape($lede) . '</p></div>';
      motaded_theme_views_replace_area_markup($variables, 'header', $header_markup);
    }
  }

  if ($view->id() === 'insights' && $display_id === 'page_1') {
    $variables['#attached']['library'][] = 'motaded_theme/insights_directory';
    $variables['attributes']['class'][] = 'insights-directory-page';
    $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
    $variables['motaded_insights_hero_bg_url'] = base_path() . $theme_path . '/images/events-bg.webp';

    $variables['motaded_event_updates_form'] = [];
    try {
      if (\Drupal::moduleHandler()->moduleExists('webform')) {
        $block = \Drupal::service('plugin.manager.block')->createInstance('webform_block', [
          'webform_id' => 'event_updates',
          'label_display' => '0',
          'default_data' => '',
          'redirect' => FALSE,
          'lazy' => TRUE,
        ]);
        if ($block && $block->access(\Drupal::currentUser())) {
          $variables['motaded_event_updates_form'] = $block->build();
        }
      }
    }
    catch (\Throwable $e) {
      $variables['motaded_event_updates_form'] = [];
    }
  }

  if ($view->id() === 'platforms' && $display_id === 'page_1') {
    // Library is attached from the Twig template (views-view--platforms--page_1.html.twig).
    $variables['attributes']['class'][] = 'platforms-directory-page';
    $variables['motaded_platforms_stats'] = _motaded_theme_platforms_directory_stats();
  }

  if ($view->id() === 'chambers' && $display_id === 'page_1') {
    $variables['#attached']['library'][] = 'motaded_theme/chambers_network';
  }

  if ($view->id() === 'services' && $display_id === 'block_2') {
    $variables['#attached']['library'][] = 'motaded_theme/services_home_block';

    $input = $view->getExposedInput();
    $tid = $input['field_taxonomy_target_id'] ?? NULL;
    if ($tid === NULL || $tid === '' || $tid === 'All') {
      $tid = \Drupal::request()->query->get('field_taxonomy_target_id');
    }
    $tid = $tid !== NULL && $tid !== '' ? (string) $tid : '';

    $filter_plugin = $view->display_handler->getHandler('filter', 'field_taxonomy_target_id');
    $allowed = [];
    if ($filter_plugin && isset($filter_plugin->options['value']) && is_array($filter_plugin->options['value'])) {
      foreach ($filter_plugin->options['value'] as $key => $enabled) {
        if ($enabled) {
          $allowed[] = (string) $key;
        }
      }
    }

    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $services_category_vid = 'taxonomy';

    if ($allowed !== []) {
      if ($tid === '' || !in_array($tid, $allowed, TRUE)) {
        $tid = $allowed[0];
      }
    }
    else {
      if ($tid !== '' && ctype_digit($tid)) {
        $picked = $term_storage->load((int) $tid);
        if (!$picked instanceof TermInterface || $picked->bundle() !== $services_category_vid) {
          $tid = '';
        }
      }
      else {
        $tid = '';
      }
      if ($tid === '') {
        $first_ids = $term_storage->getQuery()
          ->condition('vid', $services_category_vid)
          ->sort('weight')
          ->accessCheck(TRUE)
          ->range(0, 1)
          ->execute();
        $tid = $first_ids ? (string) reset($first_ids) : '152';
      }
    }

    $variables['services_home_active_tid'] = $tid;
    $variables['services_home_term_name'] = '';
    $variables['services_home_term_description'] = [];

    $term = $term_storage->load($tid);
    if ($term instanceof TermInterface) {
      $term_lang = motaded_theme_interface_langcode();
      $term_view = $term->hasTranslation($term_lang) ? $term->getTranslation($term_lang) : $term;
      $variables['services_home_term_name'] = motaded_theme_entity_label_in_language($term);
      if ($term_view->hasField('description') && !$term_view->get('description')->isEmpty()) {
        $format = $term_view->get('description')->format ?: filter_fallback_format();
        $variables['services_home_term_description'] = [
          '#type' => 'processed_text',
          '#text' => $term_view->get('description')->value,
          '#format' => $format,
        ];
      }
    }

    $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
    $map = [
      '152' => 'service-cost.svg',
      '154' => 'icon-globe.svg',
      '156' => 'icon-growth.svg',
    ];
    $icon_file = $map[$tid] ?? 'icon-target.svg';
    $variables['services_home_category_icon_url'] = base_path() . $theme_path . '/img/' . $icon_file;

    try {
      $variables['services_home_category_more_url'] = Url::fromUri('internal:/services', [
        'query' => ['field_taxonomy_target_id' => $tid],
        'language' => \Drupal::languageManager()->getLanguage(motaded_theme_interface_langcode()),
      ])->toString();
    }
    catch (\Throwable $e) {
      $variables['services_home_category_more_url'] = '/services?field_taxonomy_target_id=' . rawurlencode($tid);
    }

    // Unformatted output can leave `rows` truthy while rendering nothing; use SQL row count for empty state.
    $variables['services_home_offer_has_rows'] = ((int) ($view->total_rows ?? 0)) > 0;
    $variables['services_home_list_arrow'] = motaded_theme_interface_langcode() === 'ar' ? '←' : '→';
  }

  if ($view->id() === 'library' && ($display_id === 'block_1' || $display_id === 'page_1')) {
    motaded_theme_preprocess_views_view_library_tabs($variables);
    if ($display_id === 'page_1') {
      $variables['#attached']['library'][] = 'motaded_theme/library_directory';
      $variables['attributes']['class'][] = 'library-directory-page';
    }
    else {
      $variables['#attached']['library'][] = 'motaded_theme/library_home_block';
      $section_tid = (int) ($variables['library_section_active_tid'] ?? 0);
      if ($section_tid < 1 && function_exists('motaded_custom_library_section_group_tid_by_name')) {
        $fallback = motaded_custom_library_section_group_tid_by_name('Templates');
        $section_tid = $fallback !== NULL ? $fallback : 0;
      }
      try {
        $variables['library_view_all_url'] = $section_tid > 0
          ? Url::fromRoute('view.library.page_1', [], [
            'query' => ['library_section' => (string) $section_tid],
          ])->toString()
          : Url::fromRoute('view.library.page_1')->toString();
      }
      catch (\Throwable $e) {
        $variables['library_view_all_url'] = $section_tid > 0
          ? '/library?' . http_build_query(['library_section' => (string) $section_tid])
          : '/library';
      }
    }
  }

  // Home list keeps an exposed form in the DOM (visually hidden in CSS) so Views AJAX
  // can apply the same filter values as the calendar column when we sync in events-home.js.
}

/**
 * Implements hook_views_pre_render().
 *
 * Chambers: reset per-view statics before rows render so chamber_card nodes pick
 * the correct template (homepage embed vs directory). Relying only on
 * preprocess_views_view_unformatted missed some style / AJAX render paths and
 * left motaded_cnb_home_chamber_card_layout stuck from an earlier embed.
 */
function motaded_theme_views_pre_render(ViewExecutable $view): void {
  if (($view->id() ?? '') !== 'chambers') {
    return;
  }
  $is_homepage = ($view->current_display === 'homepage');
  $flag = &drupal_static('motaded_cnb_home_chamber_card_layout', FALSE);
  $flag = $is_homepage;

  $first_nid = &drupal_static('motaded_cnb_home_first_chamber_nid', NULL);
  $first_nid = NULL;
  if ($is_homepage && !empty($view->result)) {
    $first = reset($view->result);
    if (isset($first->_entity) && $first->_entity instanceof NodeInterface) {
      $first_nid = (int) $first->_entity->id();
    }
    elseif (!empty($first->nid)) {
      $first_nid = (int) $first->nid;
    }
  }
}

/**
 * Events directory: drop the featured row from the grid (page 0) to avoid duplication.
 */
function motaded_theme_preprocess_views_view_unformatted__events__page_1(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->getCurrentPage() !== 0) {
    return;
  }
  $featured = \Drupal::request()->attributes->get('motaded_events_featured_nid');
  if ($featured === NULL || $featured === '') {
    return;
  }
  $featured = (int) $featured;
  if ($featured < 1) {
    return;
  }
  foreach ($variables['rows'] as $delta => $row) {
    $content = $row['content'] ?? [];
    $node = $content['#node'] ?? NULL;
    if ($node instanceof NodeInterface && (int) $node->id() === $featured) {
      unset($variables['rows'][$delta]);
      break;
    }
  }
  $variables['rows'] = array_values($variables['rows']);
}

/**
 * Insights directory: remove featured rows from the main list (page 0) to avoid duplication.
 */
function motaded_theme_preprocess_views_view_unformatted__insights__page_1(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->getCurrentPage() !== 0) {
    return;
  }

  $sub = Views::getView('insights');
  if (!$sub) {
    return;
  }
  $sub->setDisplay('attachment_featured');
  $sub->setExposedInput($view->getExposedInput());
  $sub->execute();

  $featured_nids = [];
  foreach ($sub->result as $row) {
    $nid = NULL;
    if (isset($row->_entity) && $row->_entity instanceof NodeInterface) {
      $nid = (int) $row->_entity->id();
    }
    elseif (!empty($row->nid)) {
      $nid = (int) $row->nid;
    }
    if ($nid) {
      $featured_nids[] = $nid;
    }
  }
  $featured_nids = array_values(array_unique($featured_nids));
  if ($featured_nids === []) {
    return;
  }

  foreach ($variables['rows'] as $delta => $row) {
    $content = $row['content'] ?? [];
    $node = $content['#node'] ?? NULL;
    if ($node instanceof NodeInterface && in_array((int) $node->id(), $featured_nids, TRUE)) {
      unset($variables['rows'][$delta]);
    }
  }
  $variables['rows'] = array_values($variables['rows']);
}

/**
 * Implements hook_preprocess_block().
 */
function motaded_theme_preprocess_block(array &$variables) {
  // Services page: hide standalone exposed block; we render it inside the view.
  if (($variables['elements']['#plugin_id'] ?? '') === 'views_exposed_filter_block:services-page_1') {
    $variables['elements']['#access'] = FALSE;
    return;
  }

  if (!empty($variables['elements']['#id']) && $variables['elements']['#id'] == 'motaded_theme_mainnavigation') {
    $variables['content']['#attributes']['data-block-id'] = $variables['elements']['#id'];
  }
  // Global CTA: pass show_title_on_button, cta_heading, cta_subtitle (badge).
  if (isset($variables['elements']['content']['#block_content'])) {
    $block_content = $variables['elements']['content']['#block_content'];
    if ($block_content->bundle() === 'global_cta') {
      if ($block_content->hasField('field_show_title_on_button')) {
        $variables['show_title_on_button'] = !$block_content->get('field_show_title_on_button')->isEmpty()
          && (bool) $block_content->get('field_show_title_on_button')->value;
      }
      if ($block_content->hasField('field_text') && !$block_content->get('field_text')->isEmpty()) {
        $heading = trim($block_content->get('field_text')->value);
        $variables['cta_heading'] = $heading;
        // Split at first "?" for intentional two-line display (e.g. "Ready to start?" / "Contact us today").
        if (strpos($heading, '?') !== false) {
          $parts = explode('?', $heading, 2);
          $variables['cta_heading_line1'] = trim($parts[0]) . '?';
          $variables['cta_heading_line2'] = trim($parts[1] ?? '');
        }
      }
      if ($block_content->hasField('field_subtitle') && !$block_content->get('field_subtitle')->isEmpty()) {
        $variables['cta_subtitle'] = trim($block_content->get('field_subtitle')->value);
      }
      // Same Global CTA block type: header / mobile drawer = compact icons; footer = card.
      $variables['global_cta_variant'] = 'card';
      if (!empty($variables['elements']['#id'])) {
        $placed_block = Block::load($variables['elements']['#id']);
        if ($placed_block) {
          $region = (string) $placed_block->getRegion();
          if (in_array($region, ['header_cta', 'drawer_cta', 'menu_mobile'], TRUE)
            || strpos($region, 'header') === 0) {
            $variables['global_cta_variant'] = 'compact';
          }
        }
      }
      // Service / blog sidebar: contacts-only strip — no divider, no trust band, compact colored pills.
      $variables['global_cta_card_minimal'] = !empty($variables['elements']['#id'])
        && $variables['elements']['#id'] === 'motaded_theme_ctaservicesblog_2';
    }
  }
  // First footer column (Quick Links): pass logo, front page, and footer CTA block.
  if (isset($variables['elements']['#id']) && $variables['elements']['#id'] === 'motaded_theme_footer') {
    $variables['logo_path'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
    $variables['front_page'] = \Drupal\Core\Url::fromRoute('<front>', [], ['absolute' => TRUE])->toString();
    $cta_block = \Drupal\block\Entity\Block::load('motaded_theme_cta_3');
    if ($cta_block && $cta_block->getRegion() === 'footer') {
      $variables['footer_cta_block'] = \Drupal::entityTypeManager()
        ->getViewBuilder('block')
        ->view($cta_block);
    }
  }
}

/**
 * Implements hook_views_pre_view().
 *
 * Forces services page_1 exposed filters to render inside the view output,
 * even if config still has "Exposed form in block" enabled.
 */
function motaded_theme_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== 'services' || $display_id !== 'page_1') {
    return;
  }
  if ($view->display_handler) {
    $view->display_handler->setOption('exposed_block', FALSE);
  }
}

function motaded_theme_theme_suggestions_menu_alter(array &$suggestions, array $variables) {
  if (isset($variables['attributes']['data-block-id'])) {
    $block = \Drupal\block\Entity\Block::load($variables['attributes']['data-block-id']);
    if ($block) {
      array_push($suggestions, 'menu__' . str_replace('-', '_', $block->getRegion()));
    }
  }
}

/**
 * Recursively decorates main-menu items with their field_menu_icon value.
 *
 * Loads the related menu_link_content entity (when the menu plugin is backed
 * by one) and exposes:
 *   - item.menu_icon_key   : raw key string (e.g. "briefcase") or NULL
 *   - item.menu_icon_svg   : pre-rendered inline SVG markup or NULL
 */
function _motaded_theme_decorate_menu_items_with_icon(array &$items): void {
  foreach ($items as &$item) {
    $icon_key = NULL;
    if (!empty($item['original_link']) && method_exists($item['original_link'], 'getMetaData')) {
      $meta = $item['original_link']->getMetaData();
      $entity_id = $meta['entity_id'] ?? NULL;
      if ($entity_id) {
        try {
          $mlc = \Drupal::entityTypeManager()
            ->getStorage('menu_link_content')
            ->load($entity_id);
          if ($mlc instanceof \Drupal\menu_link_content\Entity\MenuLinkContent
            && $mlc->hasField('field_menu_icon')
            && !$mlc->get('field_menu_icon')->isEmpty()) {
            $icon_key = (string) $mlc->get('field_menu_icon')->value;
          }
        }
        catch (\Throwable $e) {
        }
      }
    }
    $item['menu_icon_key'] = $icon_key;
    $item['menu_icon_svg'] = $icon_key ? motaded_theme_menu_icon_markup($icon_key) : NULL;
    if (!empty($item['below']) && is_array($item['below'])) {
      _motaded_theme_decorate_menu_items_with_icon($item['below']);
    }
  }
}

/**
 * Localizes sector_page menu titles on Arabic interface.
 */
function motaded_theme_preprocess_menu(array &$variables): void {
  if (!empty($variables['items'])) {
    motaded_theme_menu_apply_content_language_titles($variables['items']);
  }
}

/**
 * Exposes field_menu_icon to twig templates for the main menu.
 */
function motaded_theme_preprocess_menu__main(array &$variables): void {
  if (!empty($variables['items'])) {
    _motaded_theme_decorate_menu_items_with_icon($variables['items']);
  }
}

/**
 * Builds the "More on this topic" below_content block (same view + markup for all bundles).
 *
 * @return array|null
 *   Render array, or NULL if no category or view is missing.
 */
function motaded_theme_more_on_topic_build(NodeInterface $node): ?array {
  if (!$node->hasField('field_taxonomy') || $node->get('field_taxonomy')->isEmpty()) {
    return NULL;
  }
  $tid = (int) $node->get('field_taxonomy')->target_id;
  if ($tid <= 0) {
    return NULL;
  }
  $view = Views::getView('related_similar');
  if (!$view) {
    return NULL;
  }
  switch ($node->bundle()) {
    case 'article':
      $display_id = 'block_2';
      break;

    case 'news':
      $display_id = 'block_3';
      break;

    case 'page':
      $display_id = 'block_1';
      $is_service = $node->hasField('field_display_on_services')
        && !$node->get('field_display_on_services')->isEmpty()
        && (int) $node->get('field_display_on_services')->value === 1;
      if (!$is_service) {
        return NULL;
      }
      break;

    default:
      return NULL;
  }

  return [
    '#type' => 'container',
    '#attributes' => ['class' => ['more-on-topic-region', 'mt-10']],
    '#cache' => [
      'contexts' => ['route'],
      'tags' => $node->getCacheTags(),
    ],
    'title' => [
      '#markup' => '<h2 class="more-on-topic-heading">' . (string) t('More on this topic') . '</h2>',
    ],
    'view' => $view->buildRenderable($display_id, [
      (string) $tid,
      (string) $node->id(),
    ]),
    '#weight' => 50,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 *
 * Preprocesses variables for the page template.
 * Adds default logo path variable.
 */
function motaded_theme_preprocess_page(&$variables) {
  $variables['motaded_suppress_seo_tracking'] = _motaded_theme_suppress_seo_tracking();
  // Adds logo path to page.html.twig variables.
  $variables['logo_path'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
  // Hide motaded_theme_cta_3 from footer region; it's rendered inside the footer block.
  if (isset($variables['page']['footer']['motaded_theme_cta_3'])) {
    $variables['page']['footer']['motaded_theme_cta_3']['#access'] = FALSE;
  }

  // Footer: about row, then Our Services | Useful Resources | Legal (see .footer-site in main.css).
  if (!empty($variables['page']['footer']) && is_array($variables['page']['footer'])) {
    $footer = &$variables['page']['footer'];

    $about_keys = ['motaded_theme_footerabouttext'];
    $left_children = [];
    foreach ($about_keys as $key) {
      if (isset($footer[$key])) {
        $left_children[$key] = $footer[$key];
        unset($footer[$key]);
      }
    }
    if ($left_children !== []) {
      $footer['footer_site_col_left'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['footer-site__col-left']],
        '#weight' => -50,
      ];
      foreach ($left_children as $key => $element) {
        $footer['footer_site_col_left'][$key] = $element;
      }
    }

    $menu_keys = ['motaded_theme_ourservices', 'motaded_theme_otherservices', 'motaded_theme_quicklinks'];
    $menu_children = [];
    foreach ($menu_keys as $key) {
      if (isset($footer[$key])) {
        $menu_children[$key] = $footer[$key];
        unset($footer[$key]);
      }
    }
    if ($menu_children !== []) {
      $footer['footer_site_menus'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['footer-site__menus']],
        '#weight' => -45,
      ];
      foreach ($menu_children as $key => $element) {
        $footer['footer_site_menus'][$key] = $element;
      }
    }
  }

  // Service (Basic page + Display on services): full-width hero; sidebar renders in node template.
  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'platform'
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $variables['platform_page_full_bleed'] = TRUE;
  }

  // Chamber full node: full-width hero + breadcrumb in template (reuse layout flag).
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'chamber'
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $variables['platform_page_full_bleed'] = TRUE;
  }

  // Sector page full node: same full-bleed content rail as platform/chamber.
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'sector_page'
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $variables['platform_page_full_bleed'] = TRUE;
  }

  // Document full node: split hero + muted shell (no narrow main max-width rail).
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'document'
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $variables['document_page_full_bleed'] = TRUE;
    unset($variables['page']['breadcrumb']);
  }

  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'page'
    && $route_node->hasField('field_display_on_services')
    && !$route_node->get('field_display_on_services')->isEmpty()
    && (int) $route_node->get('field_display_on_services')->value === 1) {
    $variables['service_page_full_bleed'] = TRUE;
    $sidebar_build = $variables['page']['sidebar_second'] ?? NULL;
    if (is_array($sidebar_build) && Element::children($sidebar_build) !== []) {
      \Drupal::request()->attributes->set('motaded_theme_service_sidebar_second', $sidebar_build);
    }
    // Never render sidebar in page.html.twig for this layout (node template owns it).
    unset($variables['page']['sidebar_second']);

  }

  // Article / News full node: same "More on this topic" band (reuses helper + view + CSS).
  if ($route_node instanceof NodeInterface
    && in_array($route_node->bundle(), ['article', 'news'], TRUE)
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $more_on_topic = motaded_theme_more_on_topic_build($route_node);
    if ($more_on_topic !== NULL) {
      $variables['page']['below_content']['more_on_topic_related'] = $more_on_topic;
    }
  }

}

/**
 * Builds a render array for the active theme's sidebar_second region.
 *
 * Used when the region copy from preprocess_page is missing (ordering / empty()).
 */
function motaded_theme_build_sidebar_second_region(): array {
  /** @var \Drupal\block\BlockRepositoryInterface $repo */
  $repo = \Drupal::service('block.repository');
  $cacheability = [];
  $regions = $repo->getVisibleBlocksPerRegion($cacheability);
  $region_blocks = $regions['sidebar_second'] ?? [];
  if ($region_blocks === []) {
    return [];
  }
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('block');
  $build = [];
  foreach ($region_blocks as $block) {
    if (!$block instanceof BlockInterface) {
      continue;
    }
    if ($block->access('view')) {
      $build[$block->id()] = $view_builder->view($block);
    }
  }
  return $build;
}

/**
 * Truncates HTML to a plain-text string for hero intro fallback.
 */
function motaded_theme_plain_text_truncate(string $html, int $max_length): string {
  $text = trim(preg_replace('/\s+/u', ' ', strip_tags($html)));
  if ($text !== '') {
    $text = trim(Html::decodeEntities($text, ENT_QUOTES | ENT_HTML5));
  }
  if ($text === '') {
    return '';
  }
  if (mb_strlen($text) <= $max_length) {
    return $text;
  }
  return mb_substr($text, 0, $max_length) . '…';
}

/**
 * Decodes HTML entities in plain labels (taxonomy terms, tags) for safe Twig output.
 */
function motaded_theme_decode_plain_label(string $raw): string {
  $raw = trim(strip_tags($raw));
  if ($raw === '') {
    return '';
  }
  return trim(Html::decodeEntities($raw, ENT_QUOTES | ENT_HTML5));
}

/**
 * Resolves [view_id, display_id] pairs from one viewsreference field value row.
 *
 * Viewsreference may store display_id in a column or only inside serialized `data`.
 */
function _motaded_theme_viewsreference_field_item_pairs(array $item): array {
  $pairs = [];
  $tid = isset($item['target_id']) && $item['target_id'] !== '' && $item['target_id'] !== NULL
    ? (string) $item['target_id']
    : '';
  $did = isset($item['display_id']) && $item['display_id'] !== '' && $item['display_id'] !== NULL
    ? trim((string) $item['display_id'])
    : '';

  $decoded = [];
  if (!empty($item['data']) && is_string($item['data'])) {
    $decoded = json_decode($item['data'], TRUE);
    if (!is_array($decoded)) {
      $unserialized = @unserialize($item['data'], ['allowed_classes' => FALSE]);
      $decoded = is_array($unserialized) ? $unserialized : [];
    }
  }

  if ($tid !== '' && $did !== '') {
    return [[$tid, $did]];
  }
  if ($tid !== '' && $did === '' && $decoded !== []) {
    $d = trim((string) ($decoded['display_id'] ?? $decoded['display'] ?? ''));
    if ($d !== '') {
      return [[$tid, $d]];
    }
  }
  if ($decoded !== []) {
    $t = trim((string) ($decoded['target_id'] ?? ''));
    $d = trim((string) ($decoded['display_id'] ?? $decoded['display'] ?? ''));
    if ($t !== '' && $d !== '') {
      $pairs[] = [$t, $d];
    }
  }
  return $pairs;
}

/**
 * Whether a view_block paragraph embeds the partners marquee (partners / block_2).
 */
function _motaded_theme_paragraph_is_partners_marquee_view_block(\Drupal\paragraphs\Entity\Paragraph $paragraph): bool {
  if ($paragraph->bundle() !== 'view_block' || !$paragraph->hasField('field_view_block') || $paragraph->get('field_view_block')->isEmpty()) {
    return FALSE;
  }
  foreach ($paragraph->get('field_view_block')->getValue() as $item) {
    foreach (_motaded_theme_viewsreference_field_item_pairs($item) as [$target, $display]) {
      if ($target === 'partners' && $display === 'block_2') {
        return TRUE;
      }
    }
  }
  return FALSE;
}

/**
 * Moves the partners marquee paragraph to immediately follow the first hero_split_banner.
 */
function _motaded_theme_landing_page_field_paragraphs_move_partners_after_first_hero(array &$field_paragraphs): void {
  $deltas = Element::children($field_paragraphs);
  if ($deltas === []) {
    return;
  }
  $hero_key = NULL;
  $partners_key = NULL;
  foreach ($deltas as $key) {
    $element = $field_paragraphs[$key];
    if (!is_array($element) || !isset($element['#paragraph'])) {
      continue;
    }
    $para = $element['#paragraph'];
    if (!$para instanceof \Drupal\paragraphs\Entity\Paragraph) {
      continue;
    }
    if ($hero_key === NULL && $para->bundle() === 'hero_split_banner') {
      $hero_key = $key;
    }
    if (_motaded_theme_paragraph_is_partners_marquee_view_block($para)) {
      $partners_key = $key;
    }
  }
  if ($hero_key === NULL || $partners_key === NULL) {
    return;
  }
  $hero_pos = array_search($hero_key, $deltas, TRUE);
  $partners_pos = array_search($partners_key, $deltas, TRUE);
  if ($hero_pos === FALSE || $partners_pos === FALSE) {
    return;
  }
  if ($partners_pos === $hero_pos + 1) {
    return;
  }
  $new_order = [];
  foreach ($deltas as $key) {
    if ($key === $partners_key) {
      continue;
    }
    $new_order[] = $key;
    if ($key === $hero_key) {
      $new_order[] = $partners_key;
    }
  }
  $saved = [];
  foreach ($new_order as $key) {
    $saved[$key] = $field_paragraphs[$key];
  }
  foreach ($deltas as $key) {
    unset($field_paragraphs[$key]);
  }
  foreach ($new_order as $weight => $key) {
    $field_paragraphs[$key] = $saved[$key];
    if (isset($field_paragraphs[$key]['#weight'])) {
      $field_paragraphs[$key]['#weight'] = $weight;
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Preprocesses variables for the node template.
 * Adds body summary variable
 */
function motaded_theme_preprocess_node(&$variables) {
  $node = $variables['node'];
  $variables['chamber_external_url'] = NULL;
  $variables['chamber_external_label'] = NULL;
  $variables['sector_page_show_eyebrow'] = FALSE;
  $variables['sector_page_show_sector_pill'] = FALSE;
  $variables['summary'] = NULL;
  $variables['motaded_body_excerpt'] = '';
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_item = $node->get('body')->first();
    if ($body_item) {
      $summary_text = trim((string) $body_item->summary);
      if ($summary_text !== '') {
        $variables['summary'] = ['#markup' => nl2br(Html::escape($summary_text))];
      }
      // Fallback excerpt for hero when summary is empty.
      if ($variables['summary'] === NULL) {
        $raw = (string) $body_item->value;
        $plain = trim(Html::decodeEntities(strip_tags($raw)));
        if ($plain !== '') {
          $variables['motaded_body_excerpt'] = motaded_theme_plain_text_truncate($plain, 220);
        }
      }
    }
  }

  // Chamber (full): localized sidebar / CTA URLs.
  if ($node->bundle() === 'chamber' && ($variables['view_mode'] ?? '') === 'full') {
    $langcode = motaded_theme_interface_langcode();
    try {
      $language = \Drupal::languageManager()->getLanguage($langcode);
      $url_options = ['language' => $language];
      $variables['chamber_contact_url'] = Url::fromUserInput('/contact-us', $url_options)->toString();
      $variables['chamber_sectors_url'] = Url::fromUserInput('/sectors', $url_options)->toString();
    }
    catch (\Throwable $e) {
      $variables['chamber_contact_url'] = $langcode === 'ar' ? '/ar/contact-us' : '/contact-us';
      $variables['chamber_sectors_url'] = $langcode === 'ar' ? '/ar/sectors' : '/sectors';
    }
  }

  // Chamber (full): CTA link text — hide raw URLs; respect editor-set titles otherwise.
  if ($node->bundle() === 'chamber'
    && ($variables['view_mode'] ?? '') === 'full'
    && $node->hasField('field_external_link')
    && !$node->get('field_external_link')->isEmpty()) {
    $link_item = $node->get('field_external_link')->first();
    if ($link_item) {
      $url = $link_item->getUrl()->toString();
      $title_raw = trim((string) ($link_item->getTitle() ?? ''));
      if ($title_raw === ''
        || preg_match('#^https?://#i', $title_raw)
        || $title_raw === $url) {
        $variables['chamber_external_label'] = (string) t('Official website');
      }
      else {
        $variables['chamber_external_label'] = $title_raw;
      }
      $variables['chamber_external_url'] = $url;
    }
  }

  // Chamber (chamber_card): homepage list + featured card (Business Network paragraph).
  if ($node->bundle() === 'chamber' && ($variables['view_mode'] ?? '') === 'chamber_card') {
    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    $chamber = \Drupal::service('entity.repository')->getTranslationFromContext($node, $langcode);
    $in_cnb_home = drupal_static('motaded_cnb_home_chamber_card_layout', FALSE);
    $first_slot_nid = drupal_static('motaded_cnb_home_first_chamber_nid', NULL);
    // Homepage embed: first View row is always the hero banner (ordering via field_featured).
    if ($in_cnb_home) {
      $variables['cnb_is_featured'] = $first_slot_nid !== NULL
        && (int) $node->id() === $first_slot_nid;
    }
    else {
      // Directory and any non–Business-Network context: never use the wide
      // featured stats layout for chamber_card (only the homepage embed may).
      $variables['cnb_is_featured'] = FALSE;
    }

    $variables['cnb_focus_line'] = '';
    $variables['cnb_focus_tooltip'] = '';
    $variables['cnb_type_line'] = '';
    $variables['cnb_external_url'] = NULL;
    $variables['cnb_external_label'] = NULL;
    $variables['cnb_icon_focus'] = NULL;
    $variables['cnb_icon_type'] = NULL;
    if ($in_cnb_home) {
      if ($chamber->hasField('field_external_link') && !$chamber->get('field_external_link')->isEmpty()) {
        $link_item = $chamber->get('field_external_link')->first();
        if ($link_item) {
          $variables['cnb_external_url'] = $link_item->getUrl()->toString();
          $variables['cnb_external_label'] = (string) t('Visit website');
        }
      }
      if ($chamber->hasField('field_relationship_focus') && !$chamber->get('field_relationship_focus')->isEmpty()) {
        $focus = trim((string) $chamber->get('field_relationship_focus')->value);
        if ($focus !== '') {
          $variables['cnb_focus_tooltip'] = (string) t('Focus: @text', ['@text' => $focus]);
          if (!empty($variables['cnb_is_featured'])) {
            $focus = motaded_theme_plain_text_truncate($focus, 120);
          }
          $variables['cnb_focus_line'] = Markup::create((string) t('Focus: @text', ['@text' => $focus]));
        }
      }

      if ($chamber->hasField('field_type') && !$chamber->get('field_type')->isEmpty()) {
        $def = $chamber->getFieldDefinition('field_type');
        $allowed = $def->getSetting('allowed_values');
        $key = (string) $chamber->get('field_type')->value;
        $type_label = '';
        if (is_array($allowed) && isset($allowed[$key])) {
          $type_label = (string) $allowed[$key];
        }
        elseif ($key !== '') {
          $type_label = $key;
        }
        if ($type_label !== '') {
          $type_label = (string) t($type_label);
          $variables['cnb_type_line'] = Markup::create((string) t('Type: @type', ['@type' => $type_label]));
        }
      }

      $variables['cnb_icon_focus'] = _motaded_theme_cnb_icon_markup('target');
      $variables['cnb_icon_type'] = _motaded_theme_cnb_icon_markup('building');
    }

    $variables['cnb_featured_stats'] = [];
    if ($variables['cnb_is_featured']) {
      $icon_keys = ['users', 'briefcase', 'shield'];
      $stats = [];
      if ($node->hasField('field_chamber_featured_stats') && !$node->get('field_chamber_featured_stats')->isEmpty()) {
        foreach ($node->get('field_chamber_featured_stats') as $delta => $item) {
          $text = trim((string) $item->value);
          if ($text === '') {
            continue;
          }
          $icon = $icon_keys[(int) $delta] ?? 'users';
          $stats[] = [
            'icon' => $icon,
            'text' => $text,
          ];
        }
      }
      foreach ($stats as $i => $row) {
        $stats[$i]['icon_markup'] = _motaded_theme_cnb_icon_markup($row['icon']);
      }
      $variables['cnb_featured_stats'] = $stats;
    }

    // Homepage embed vs /chambers directory use different Twig templates; without
    // route.name the entity view cache can serve homepage markup on the directory.
    $variables['#cache']['contexts'][] = 'route.name';
  }

  // Chamber (full canonical page): expose featured stats so the dedicated
  // node page can render them alongside the relationship-focus section.
  // The same icon order (users / briefcase / shield) keeps visual parity
  // with the homepage Business Network featured card.
  if ($node->bundle() === 'chamber' && ($variables['view_mode'] ?? '') === 'full') {
    $variables['cnb_featured_stats'] = [];
    if ($node->hasField('field_chamber_featured_stats')
      && !$node->get('field_chamber_featured_stats')->isEmpty()) {
      $icon_keys = ['users', 'briefcase', 'shield'];
      foreach ($node->get('field_chamber_featured_stats') as $delta => $item) {
        $text = trim((string) $item->value);
        if ($text === '') {
          continue;
        }
        $icon = $icon_keys[(int) $delta] ?? 'users';
        $variables['cnb_featured_stats'][] = [
          'icon' => $icon,
          'text' => $text,
          'icon_markup' => _motaded_theme_cnb_icon_markup($icon),
        ];
      }
    }
  }

  // Article (full page): blog-style hero rail — read time, media, meta for twig.
  if ($node->bundle() === 'article'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    $variables['article_hero_media'] = [];
    if ($node->hasField('field_media') && !$node->get('field_media')->isEmpty()) {
      $media = $node->get('field_media')->entity;
      if ($media) {
        $variables['article_hero_media'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'banner_sm');
      }
    }
    $variables['article_read_time'] = [];
    if ($node->hasField('field_estimated_read_time') && !$node->get('field_estimated_read_time')->isEmpty()) {
      $variables['article_read_time'] = \Drupal::entityTypeManager()
        ->getViewBuilder('node')
        ->viewField($node->get('field_estimated_read_time'), [
          'label' => 'hidden',
          'type' => 'estimated_read_time_text',
          'weight' => 0,
          'settings' => [
            'tokenized_string' => (string) t('@minutes min read'),
          ],
          'third_party_settings' => [],
        ]);
    }
    $variables['article_updated_formatted'] = \Drupal::service('date.formatter')->format(
      (int) $node->getChangedTime(),
      'custom',
      'j F Y'
    );
    $variables['article_changed_iso'] = gmdate('c', (int) $node->getChangedTime());
  }

  // News (full page): hero media (view mode news) + updated date for meta row.
  if ($node->bundle() === 'news'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    $variables['news_hero_media'] = [];
    if ($node->hasField('field_media') && !$node->get('field_media')->isEmpty()) {
      $media = $node->get('field_media')->entity;
      if ($media) {
        $variables['news_hero_media'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'news');
      }
    }
    $variables['news_updated_formatted'] = \Drupal::service('date.formatter')->format(
      (int) $node->getChangedTime(),
      'custom',
      'j F Y'
    );
    $variables['news_changed_iso'] = gmdate('c', (int) $node->getChangedTime());
  }

  // Document (full): library URL, file meta, related resources, page styles.
  if ($node->bundle() === 'document'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    _motaded_theme_preprocess_document_node_full($variables, $node);
  }

  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'full' && !empty($variables['page'])) {
    _motaded_theme_preprocess_event_node_full($variables, $node);
  }
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'teaser') {
    _motaded_theme_preprocess_event_node_teaser($variables, $node);
    if (!empty($variables['elements']['#motaded_featured_teaser'])) {
      $variables['attributes']['class'][] = 'event-teaser--featured-hero';
    }
  }

  if ($node->bundle() === 'market_insight' && ($variables['view_mode'] ?? '') === 'teaser') {
    _motaded_theme_preprocess_market_insight_teaser($variables, $node);
  }

  // Platform (full): CTA / external URLs + marketing layout library.
  if ($node->bundle() === 'platform' && ($variables['view_mode'] ?? '') === 'full') {
    $variables['#attached']['library'][] = 'motaded_theme/platform_node';
    // Defaults so Twig never misses variables (e.g. partial caches).
    $variables += [
      'platform_listing_url' => Url::fromUserInput('/platforms')->toString(),
      'platform_contact_url' => Url::fromUserInput('/contact-us')->toString(),
      'platform_cta_url' => NULL,
      'platform_cta_label' => (string) t('Start your setup'),
      'platform_external_url' => NULL,
      'platform_external_label' => (string) t('Visit official website'),
      'platform_external_new_window' => FALSE,
      'platform_cta_distinct_from_external' => TRUE,
      'platform_wa_url' => NULL,
      'platform_tel_url' => NULL,
    ];
    if ($node->hasField('field_cta_text') && !$node->get('field_cta_text')->isEmpty()) {
      $variables['platform_cta_label'] = trim((string) $node->get('field_cta_text')->value);
    }
    if ($node->hasField('field_cta_link') && !$node->get('field_cta_link')->isEmpty()) {
      $link = $node->get('field_cta_link')->first();
      if ($link && $link->getUrl()) {
        $variables['platform_cta_url'] = $link->getUrl()->toString();
      }
    }
    if ($node->hasField('field_external_link') && !$node->get('field_external_link')->isEmpty()) {
      $ext = $node->get('field_external_link')->first();
      if ($ext && $ext->getUrl()) {
        $url = $ext->getUrl();
        $variables['platform_external_url'] = $url->toString();
        $variables['platform_external_new_window'] = $url->isExternal();
        $title = trim((string) $ext->title);
        if ($title !== '') {
          $variables['platform_external_label'] = $title;
        }
      }
    }
    $ext_url = (string) ($variables['platform_external_url'] ?? '');
    $cta_url = (string) ($variables['platform_cta_url'] ?? '');
    $variables['platform_cta_distinct_from_external'] = $cta_url !== ''
      && ($ext_url === '' || _motaded_theme_platform_url_canonical($cta_url) !== _motaded_theme_platform_url_canonical($ext_url));
    $page_url = \Drupal::request()->getSchemeAndHttpHost() . \Drupal::request()->getBasePath() . \Drupal::request()->getPathInfo();
    $variables['platform_wa_url'] = 'https://wa.me/?text=' . rawurlencode($node->getTitle() . ' — ' . $page_url);
    $variables['platform_tel_url'] = NULL;
    $tel = Settings::get('motaded_platform_phone', '');
    if (is_string($tel) && $tel !== '') {
      $digits = preg_replace('/\D+/', '', $tel);
      if ($digits !== '') {
        $variables['platform_tel_url'] = 'tel:' . $digits;
      }
    }

    // Glance taxonomy + source strings: English canonical values → ar.po (interface lang).
    $lang = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
    $variables += [
      'platform_glance_category_label' => '',
      'platform_glance_region_label' => '',
    ];
    if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
      $term = $node->get('field_category')->entity;
      if ($term instanceof TermInterface) {
        $default_lang = \Drupal::languageManager()->getDefaultLanguage()->getId();
        $term_default = $term->hasTranslation($default_lang) ? $term->getTranslation($default_lang) : $term;
        $variables['platform_glance_category_label'] = (string) t($term_default->getName(), [], ['langcode' => $lang]);
      }
    }
    if ($node->hasField('field_region') && !$node->get('field_region')->isEmpty()) {
      $term = $node->get('field_region')->entity;
      if ($term instanceof TermInterface) {
        $default_lang = \Drupal::languageManager()->getDefaultLanguage()->getId();
        $term_default = $term->hasTranslation($default_lang) ? $term->getTranslation($default_lang) : $term;
        $variables['platform_glance_region_label'] = (string) t($term_default->getName(), [], ['langcode' => $lang]);
      }
    }

    $doc_build = motaded_theme_platform_documents_build($node, 3);
    $variables['platform_documents'] = $doc_build['rows'];
    $variables['platform_documents_more_url'] = $doc_build['more_url'];
    $variables['platform_documents_more_label'] = $doc_build['more_label'];
    $variables['platform_documents_has_more'] = $doc_build['has_more'];
    $variables['#cache']['tags'] = Cache::mergeTags(
      $variables['#cache']['tags'] ?? [],
      $doc_build['cache_tags']
    );
  }

  // Sector page (full): layout + listing URL; suppress redundant eyebrow/pill vs title.
  if ($node->bundle() === 'sector_page'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    $variables['#attached']['library'][] = 'motaded_theme/sector_page';
    $variables['sector_listing_url'] = Url::fromUserInput('/sectors')->toString();

    $normalize_sector_label = static function (?string $text): string {
      $text = trim(strip_tags((string) $text));
      $text = preg_replace('/\s+/u', ' ', $text);
      return mb_strtolower($text);
    };
    $title_norm = $normalize_sector_label($node->getTitle());

    $eyebrow_norm = '';
    if ($node->hasField('field_sector_eyebrow') && !$node->get('field_sector_eyebrow')->isEmpty()) {
      $eyebrow_norm = $normalize_sector_label((string) $node->get('field_sector_eyebrow')->value);
    }
    $variables['sector_page_show_eyebrow'] = $eyebrow_norm !== '' && $eyebrow_norm !== $title_norm;

    $term_norm = '';
    if ($node->hasField('field_sector') && !$node->get('field_sector')->isEmpty()) {
      $term = $node->get('field_sector')->entity;
      if ($term) {
        $term_norm = $normalize_sector_label($term->getName());
      }
    }
    $variables['sector_page_show_sector_pill'] = $term_norm !== '' && $term_norm !== $title_norm;
    $variables['sector_term_pill_name'] = '';
    $sector_langcode = $node->language()->getId();
    $variables['sector_langcode'] = $sector_langcode;
    $variables['sector_is_rtl'] = $sector_langcode === 'ar';
    if ($node->hasField('field_sector') && !$node->get('field_sector')->isEmpty()) {
      $term_entity = $node->get('field_sector')->entity;
      if ($term_entity instanceof TermInterface) {
        $term_entity = \Drupal::service('entity.repository')->getTranslationFromContext($term_entity, $sector_langcode);
        $variables['sector_term_pill_name'] = $term_entity->getName();
      }
    }

    // Hero image via responsive styles (not full-size original URL).
    $variables['sector_hero_bg_url'] = '';
    $variables['sector_hero_media'] = [];
    if ($node->hasField('field_media') && !$node->get('field_media')->isEmpty()) {
      $hero_media = $node->get('field_media')->entity;
      if ($hero_media instanceof \Drupal\media\MediaInterface) {
        $variables['sector_hero_media'] = motaded_theme_media_responsive_view($hero_media, 'hero_banner');
      }
    }

    $variables['sector_hero_quick_cards'] = [];
    if ($node->hasField('field_sector_kpis')) {
      foreach ($node->get('field_sector_kpis') as $delta => $item) {
        if ($delta >= 3) {
          break;
        }
        $p = $item->entity;
        if (!$p instanceof \Drupal\paragraphs\Entity\Paragraph || $p->bundle() !== 'glance_stat_item') {
          continue;
        }
        $gk = !$p->get('field_glance_icon')->isEmpty() ? (string) $p->get('field_glance_icon')->value : '';
        $variables['sector_hero_quick_cards'][] = [
          'icon_markup' => motaded_theme_glance_icon_markup($gk),
          'label' => !$p->get('field_glance_title')->isEmpty() ? trim((string) $p->get('field_glance_title')->value) : '',
          'value' => !$p->get('field_glance_value')->isEmpty() ? trim((string) $p->get('field_glance_value')->value) : '',
        ];
      }
    }

    $related = motaded_theme_sector_page_related_build($node);
    $variables['sector_related_sections'] = $related['sections'];
    $variables['#cache']['contexts'] = Cache::mergeContexts(
      $variables['#cache']['contexts'] ?? [],
      ['languages:language_content'],
    );
    if ($related['cache_tags'] !== []) {
      $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $related['cache_tags']);
    }
  }

  // Sector_page (sector_card): tile for homepage Views / key sectors block.
  if ($node->bundle() === 'sector_page' && ($variables['view_mode'] ?? '') === 'sector_card') {
    $content_langcode = \Drupal::languageManager()
      ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
      ->getId();
    if ($content_langcode !== '' && $node->hasTranslation($content_langcode)) {
      try {
        $node = $node->getTranslation($content_langcode);
        $variables['node'] = $node;
      }
      catch (\Exception $e) {
        // Keep default translation.
      }
    }
    $variables['#attached']['library'][] = 'motaded_theme/sector_card';
    $variables['sector_card_has_custom_icon'] = FALSE;
    $variables['sector_card_icon_custom'] = [];
    if ($node->hasField('field_sector_card_icon_media') && !$node->get('field_sector_card_icon_media')->isEmpty()) {
      $media = $node->get('field_sector_card_icon_media')->entity;
      if ($media) {
        $variables['sector_card_icon_custom'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'default');
        $variables['sector_card_has_custom_icon'] = TRUE;
      }
    }
    $icon_key = '';
    if (!$variables['sector_card_has_custom_icon']
      && $node->hasField('field_sector_card_icon')
      && !$node->get('field_sector_card_icon')->isEmpty()) {
      $icon_key = (string) $node->get('field_sector_card_icon')->value;
    }
    $variables['sector_card_icon_markup'] = motaded_theme_glance_icon_markup($icon_key);
    $kpis = [];
    if ($node->hasField('field_sector_kpis')) {
      foreach ($node->get('field_sector_kpis') as $item) {
        $sub = $item->entity;
        if ($sub instanceof \Drupal\paragraphs\Entity\Paragraph && $sub->bundle() === 'glance_stat_item') {
          $gk = !$sub->get('field_glance_icon')->isEmpty() ? (string) $sub->get('field_glance_icon')->value : '';
          $kpis[] = [
            'icon_markup' => motaded_theme_glance_icon_markup($gk),
            'value' => !$sub->get('field_glance_value')->isEmpty() ? trim((string) $sub->get('field_glance_value')->value) : '',
            'label' => !$sub->get('field_glance_title')->isEmpty() ? trim((string) $sub->get('field_glance_title')->value) : '',
          ];
        }
      }
    }
    $variables['sector_card_kpis'] = $kpis;
    $variables['sector_card_url'] = $node->toUrl()->toString();

    $variables['sector_card_wb'] = NULL;
    if (\Drupal::moduleHandler()->moduleExists('motaded_custom') && function_exists('motaded_custom_sector_wb_overlay_for_node')) {
      $wb = motaded_custom_sector_wb_overlay_for_node($node);
      if ($wb !== NULL) {
        $wb['sparkline_svg'] = _motaded_theme_sector_sparkline_svg_markup($wb['sparkline_points'] ?? [], 'sector-card__spark-svg', TRUE);
        $wb['icon_markup'] = _motaded_theme_key_sector_wb_icon_markup((string) ($wb['icon_key'] ?? ''));
        unset($wb['sparkline_points'], $wb['icon_key']);
        $variables['sector_card_wb'] = $wb;
        $variables['#cache']['tags'][] = 'sector_indicators';
      }
    }
  }

  // Sector_page (sector_directory_card): /sectors directory grid (KPIs + highlights from content).
  if ($node->bundle() === 'sector_page' && ($variables['view_mode'] ?? '') === 'sector_directory_card') {
    $variables['sector_directory_url'] = $node->toUrl()->toString();
    $summary = '';
    if ($node->hasField('field_short_description') && !$node->get('field_short_description')->isEmpty()) {
      $summary = trim(preg_replace('/\s+/u', ' ', strip_tags((string) $node->get('field_short_description')->value)));
    }
    $variables['sector_directory_summary'] = $summary;

    $kpis = [];
    if ($node->hasField('field_sector_kpis')) {
      foreach ($node->get('field_sector_kpis') as $item) {
        $sub = $item->entity;
        if ($sub instanceof \Drupal\paragraphs\Entity\Paragraph && $sub->bundle() === 'glance_stat_item') {
          $label = !$sub->get('field_glance_title')->isEmpty() ? trim((string) $sub->get('field_glance_title')->value) : '';
          $value = !$sub->get('field_glance_value')->isEmpty() ? trim((string) $sub->get('field_glance_value')->value) : '';
          if ($label !== '' || $value !== '') {
            $kpis[] = ['label' => $label, 'value' => $value];
          }
        }
        if (count($kpis) >= 3) {
          break;
        }
      }
    }
    $variables['sector_directory_kpis'] = $kpis;
    $variables['sector_directory_tags'] = _motaded_theme_sector_directory_tag_labels($node);

    $variables['sector_directory_has_custom_icon'] = FALSE;
    $variables['sector_directory_icon_custom'] = [];
    if ($node->hasField('field_sector_card_icon_media') && !$node->get('field_sector_card_icon_media')->isEmpty()) {
      $media = $node->get('field_sector_card_icon_media')->entity;
      if ($media) {
        $variables['sector_directory_icon_custom'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'default');
        $variables['sector_directory_has_custom_icon'] = TRUE;
      }
    }
    $icon_key = '';
    if (!$variables['sector_directory_has_custom_icon']
      && $node->hasField('field_sector_card_icon')
      && !$node->get('field_sector_card_icon')->isEmpty()) {
      $icon_key = (string) $node->get('field_sector_card_icon')->value;
    }
    $variables['sector_directory_icon_markup'] = motaded_theme_glance_icon_markup($icon_key);
  }

  // Market Insight (platform full): translated meta, hero, related list.
  if ($node->bundle() === 'market_insight'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])
    && $node->hasField('field_insight_shell')
    && $node->get('field_insight_shell')->value === 'platform') {
    _motaded_theme_preprocess_market_insight_platform($variables, $node);
  }

  // Service page (Basic page + Display on services): compact hero data.
  if ($node->bundle() === 'page'
    && ($variables['view_mode'] ?? '') === 'full'
    && $node->hasField('field_display_on_services')
    && !$node->get('field_display_on_services')->isEmpty()
    && (int) $node->get('field_display_on_services')->value === 1) {
    $request = \Drupal::request();
    $sidebar_build = [];
    if ($request->attributes->has('motaded_theme_service_sidebar_second')) {
      $sidebar_build = $request->attributes->get('motaded_theme_service_sidebar_second');
      $request->attributes->remove('motaded_theme_service_sidebar_second');
    }
    if (!is_array($sidebar_build) || Element::children($sidebar_build) === []) {
      $sidebar_build = motaded_theme_build_sidebar_second_region();
    }
    $variables['service_sidebar_second'] = $sidebar_build;
    $variables['service_hero_intro'] = NULL;
    $variables['service_contact_url'] = Url::fromUserInput('/contact-us')->toString();
    $variables['service_other_services_url'] = Url::fromUserInput('/services')->toString();
    $has_sidebar_blocks = is_array($sidebar_build) && Element::children($sidebar_build) !== [];
    $variables['service_show_right_column'] = $has_sidebar_blocks;
    $variables['service_body_use_readmore'] = FALSE;
    if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
      $item = $node->get('body')->first();
      $summary = trim((string) $item->summary);
      if ($summary !== '') {
        $variables['service_hero_intro'] = ['#markup' => nl2br(Html::escape($summary))];
      }
      else {
        $truncated = motaded_theme_plain_text_truncate((string) $item->processed, 320);
        if ($truncated !== '') {
          $variables['service_hero_intro'] = ['#markup' => Html::escape($truncated)];
        }
      }
      // Long body: collapsible UI; full HTML stays in the template for SEO.
      $plain_len = mb_strlen(trim(strip_tags((string) $item->value)));
      $variables['service_body_use_readmore'] = $plain_len > 2499;
    }

    $doc_build = motaded_theme_service_documents_build($node, 3);
    $variables['service_documents'] = $doc_build['rows'];
    $variables['service_documents_more_url'] = $doc_build['more_url'];
    $variables['service_documents_more_label'] = $doc_build['more_label'];
    $variables['service_documents_has_more'] = $doc_build['has_more'];
    $variables['#cache']['tags'] = Cache::mergeTags(
      $variables['#cache']['tags'] ?? [],
      $doc_build['cache_tags']
    );
  }

  // Event (full): hide fields rendered manually in node--event--full.html.twig.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'full' && !empty($variables['page'])) {
    foreach ([
      'field_hero_image',
      'field_featured_image',
      'field_event_start',
      'field_event_end',
      'field_location',
      'field_event_type',
      'field_region',
      'field_category',
      'field_cta_type',
      'field_cta_text',
      'field_cta_link',
      'field_secondary_cta',
      'field_featured',
      'field_meeting_enabled',
      'body',
      'field_why_attend',
      'field_what_we_offer',
      'field_who_should_attend',
      'field_agenda',
      'field_gallery',
      'field_partner_logos',
      'field_tags',
      // These are shown via the custom "Event facts" block, not raw {{ content }}.
      'field_city',
      'field_country',
      'field_sector_pages',
      'field_event_format',
      'field_event_status',
      'field_price_range',
      'field_attendance_type',
      'field_official_website',
      'field_organizer',
      'field_documents',
      'field_meta',
      'addtoany',
      'links',
    ] as $hide_field) {
      unset($variables['content'][$hide_field]);
    }
  }

  // Add step numbers to field_steps_to_obtain items.
  if ($node->bundle() == 'page' && !empty($variables['content']['field_steps_to_obtain'])) {
    foreach ($variables['content']['field_steps_to_obtain'] as $i => &$item) {
      if (is_numeric($i)) {
        $item['#number'] = $i;
      }
    }
  }

  $vm = (string) ($variables['view_mode'] ?? '');
  if ($node->bundle() === 'landing_page'
    && ($vm === 'full' || $vm === 'default')
    && isset($variables['content']['field_paragraphs'])
    && is_array($variables['content']['field_paragraphs'])) {
    _motaded_theme_landing_page_field_paragraphs_move_partners_after_first_hero($variables['content']['field_paragraphs']);
  }

  // Front landing: shared design tokens + primitives (see css/components/homepage-ui-system.css).
  if ($node->bundle() === 'landing_page'
    && ($vm === 'full' || $vm === 'default')
    && !empty($variables['page'])
    && \Drupal::service('path.matcher')->isFrontPage()) {
    $variables['#attached']['library'][] = 'motaded_theme/homepage_ui_system';
    if (!empty($variables['attributes']) && $variables['attributes'] instanceof \Drupal\Core\Template\Attribute) {
      $variables['attributes']->addClass('mot-home-page');
    }
  }
}

/**
 * Preprocess variables for Event nodes (full page).
 */
function _motaded_theme_preprocess_event_node_full(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/event_page';
  $em = \Drupal::entityTypeManager();
  $view_builder = $em->getViewBuilder('node');
  $date_formatter = \Drupal::service('date.formatter');
  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();
  $node = \Drupal::service('entity.repository')->getTranslationFromContext($node, $langcode);
  $variables['node'] = $node;
  $request = \Drupal::request();

  $variables['event_hero_media'] = [];
  $media = NULL;
  if ($node->hasField('field_hero_image') && !$node->get('field_hero_image')->isEmpty()) {
    $media = $node->get('field_hero_image')->entity;
  }
  elseif ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
    $media = $node->get('field_featured_image')->entity;
  }
  if ($media) {
    $variables['event_hero_media'] = motaded_theme_media_responsive_view($media, 'hero_banner');
  }

  $variables['event_body'] = [];
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $variables['event_body'] = $view_builder->viewField($node->get('body'), [
      'label' => 'hidden',
      'type' => 'text_default',
      'weight' => 0,
      'settings' => [],
      'third_party_settings' => [],
    ]);
  }

  foreach ([
    'event_why' => 'field_why_attend',
    'event_highlights' => 'field_what_we_offer',
    'event_audience' => 'field_who_should_attend',
    'event_agenda' => 'field_agenda',
  ] as $var => $field) {
    $variables[$var] = [];
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      $variables[$var] = $view_builder->viewField($node->get($field), [
        'label' => 'hidden',
        'type' => 'entity_reference_revisions_entity_view',
        'weight' => 0,
        'settings' => [
          'view_mode' => 'default',
          'link' => '',
        ],
        'third_party_settings' => [],
      ]);
    }
  }

  $variables['event_documents'] = [];
  if ($node->hasField('field_documents') && !$node->get('field_documents')->isEmpty()) {
    $variables['event_documents'] = $view_builder->viewField($node->get('field_documents'), [
      'label' => 'hidden',
      'type' => 'entity_reference_revisions_entity_view',
      'weight' => 0,
      'settings' => [
        'view_mode' => 'default',
        'link' => '',
      ],
      'third_party_settings' => [],
    ]);
  }

  // Event registration help webform (embedded before related events).
  $variables['event_registration_help_form'] = [];
  try {
    if (\Drupal::moduleHandler()->moduleExists('webform')) {
      $default_data = implode("\n", [
        'event_nid: ' . (string) $node->id(),
        'event_title: ' . str_replace("\n", ' ', $node->label()),
        'event_url: ' . $request->getSchemeAndHttpHost() . $request->getRequestUri(),
      ]);
      $block = \Drupal::service('plugin.manager.block')->createInstance('webform_block', [
        'webform_id' => 'event_registration_help',
        'label_display' => '0',
        'default_data' => $default_data,
        'redirect' => FALSE,
        'lazy' => TRUE,
      ]);
      if ($block && $block->access(\Drupal::currentUser())) {
        $variables['event_registration_help_form'] = $block->build();
      }
    }
  }
  catch (\Throwable $e) {
    $variables['event_registration_help_form'] = [];
  }

  $variables['event_gallery'] = [];
  if ($node->hasField('field_gallery') && !$node->get('field_gallery')->isEmpty()) {
    $variables['event_gallery'] = $view_builder->viewField($node->get('field_gallery'), [
      'label' => 'hidden',
      'type' => 'photoswipe_field_formatter',
      'weight' => 0,
      'settings' => [
        'photoswipe_thumbnail_style_first' => '',
        'photoswipe_thumbnail_style' => 'media_gallery_image',
        'photoswipe_image_style' => '',
        'photoswipe_reference_image_field' => 'field_media_image',
        'photoswipe_view_mode' => 'default',
        'image_loading' => [
          'attribute' => 'lazy',
        ],
      ],
      'third_party_settings' => [],
    ]);
  }
  $variables['event_partners'] = [];
  if ($node->hasField('field_partner_logos') && !$node->get('field_partner_logos')->isEmpty()) {
    $variables['event_partners'] = $view_builder->viewField($node->get('field_partner_logos'), [
      'label' => 'hidden',
      'type' => 'entity_reference_entity_view',
      'weight' => 0,
      'settings' => ['view_mode' => 'default', 'link' => FALSE],
      'third_party_settings' => [],
    ]);
  }

  $variables['event_date_line'] = '';
  $variables['event_time_line'] = '';
  $variables['event_datetime_iso_start'] = '';
  $variables['event_datetime_iso_end'] = '';
  $date_node = $node;
  if ($node->hasField('field_event_start') && $node->get('field_event_start')->isEmpty() && $node->hasTranslation('en')) {
    $date_node = $node->getTranslation('en');
  }
  if ($date_node->hasField('field_event_start') && !$date_node->get('field_event_start')->isEmpty()) {
    $start_ts = strtotime($date_node->get('field_event_start')->value);
    if ($start_ts) {
      $variables['event_date_line'] = $date_formatter->format($start_ts, 'custom', 'l, j F Y', NULL, $langcode);
      $variables['event_time_line'] = $date_formatter->format($start_ts, 'custom', 'g:i a', NULL, $langcode);
      $variables['event_datetime_iso_start'] = gmdate('c', $start_ts);
    }
  }
  if ($date_node->hasField('field_event_end') && !$date_node->get('field_event_end')->isEmpty()) {
    $end_ts = strtotime($date_node->get('field_event_end')->value);
    if ($end_ts) {
      $variables['event_datetime_iso_end'] = gmdate('c', $end_ts);
      if ($date_node->hasField('field_event_start') && !$date_node->get('field_event_start')->isEmpty()) {
        $start_ts = strtotime($date_node->get('field_event_start')->value);
        if ($start_ts) {
          if (date('Ymd', $start_ts) === date('Ymd', $end_ts)) {
            $variables['event_time_line'] = $date_formatter->format($start_ts, 'custom', 'g:i a', NULL, $langcode)
              . ' – ' . $date_formatter->format($end_ts, 'custom', 'g:i a', NULL, $langcode);
          }
          else {
            // Multi-day event: show a date range.
            $variables['event_date_line'] = $date_formatter->format($start_ts, 'custom', 'l, j F Y', NULL, $langcode)
              . ' – ' . $date_formatter->format($end_ts, 'custom', 'l, j F Y', NULL, $langcode);
          }
        }
      }
    }
  }

  $variables['event_location_plain'] = '';
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    $variables['event_location_plain'] = trim((string) $node->get('field_location')->value);
  }
  $variables['event_maps_url'] = $variables['event_location_plain'] !== ''
    ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($variables['event_location_plain'])
    : '';

  $variables['event_calendar_url'] = _motaded_theme_event_google_calendar_url($node);

  $variables['event_register_url'] = '';
  $variables['event_register_title'] = (string) t('Register now');
  $variables['event_register_kind'] = 'register';
  if ($node->hasField('field_cta_type') && !$node->get('field_cta_type')->isEmpty()) {
    $variables['event_register_kind'] = (string) $node->get('field_cta_type')->value ?: 'register';
  }
  if ($node->hasField('field_cta_link') && !$node->get('field_cta_link')->isEmpty()) {
    $link_item = $node->get('field_cta_link')->first();
    if ($link_item && $link_item->get('uri') && $link_item->get('uri')->getString() !== '') {
      try {
        $variables['event_register_url'] = Url::fromUri($link_item->get('uri')->getString(), ['absolute' => TRUE])->toString();
      }
      catch (\Throwable $e) {
        $variables['event_register_url'] = '';
      }
      $title = $link_item->get('title')->getString();
      if (trim($title) !== '') {
        $variables['event_register_title'] = trim($title);
      }
    }
  }

  $variables['event_secondary_url'] = '';
  $variables['event_secondary_title'] = (string) t('Add to calendar');
  if ($node->hasField('field_secondary_cta') && !$node->get('field_secondary_cta')->isEmpty()) {
    $sec = $node->get('field_secondary_cta')->first();
    if ($sec && $sec->get('uri') && $sec->get('uri')->getString() !== '') {
      try {
        $variables['event_secondary_url'] = Url::fromUri($sec->get('uri')->getString(), ['absolute' => TRUE])->toString();
      }
      catch (\Throwable $e) {
        $variables['event_secondary_url'] = '';
      }
      $st = $sec->get('title')->getString();
      if (trim($st) !== '') {
        $variables['event_secondary_title'] = trim($st);
      }
    }
  }
  if ($variables['event_secondary_url'] === '' && !empty($variables['event_calendar_url'])) {
    $variables['event_secondary_url'] = $variables['event_calendar_url'];
  }

  $entity_label = static function ($entity) use ($langcode): string {
    if (!$entity) {
      return '';
    }
    if (is_object($entity) && method_exists($entity, 'hasTranslation') && $entity->hasTranslation($langcode)) {
      return (string) $entity->getTranslation($langcode)->label();
    }
    return is_object($entity) && method_exists($entity, 'label') ? (string) $entity->label() : '';
  };

  $variables['event_type_label'] = '';
  if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
    $variables['event_type_label'] = $entity_label($node->get('field_event_type')->entity);
  }

  $variables['event_region_label'] = '';
  if ($node->hasField('field_region') && !$node->get('field_region')->isEmpty()) {
    $variables['event_region_label'] = $entity_label($node->get('field_region')->entity);
  }

  $variables['event_category_label'] = '';
  if ($node->hasField('field_sector_pages') && !$node->get('field_sector_pages')->isEmpty()) {
    $variables['event_category_label'] = $entity_label($node->get('field_sector_pages')->first()?->entity);
  }

  $variables['event_tags'] = [];
  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    $variables['event_tags'] = $view_builder->viewField($node->get('field_tags'), [
      'label' => 'hidden',
      'type' => 'entity_reference_label',
      'weight' => 0,
      'settings' => ['link' => FALSE],
      'third_party_settings' => [],
    ]);
  }

  $variables['event_share_block'] = [];
  if (!empty($variables['content']['addtoany'])) {
    $variables['event_share_block'] = $variables['content']['addtoany'];
  }

  $variables['event_cta_blurb'] = '';
  if ($node->hasField('field_cta_text') && !$node->get('field_cta_text')->isEmpty()) {
    $variables['event_cta_blurb'] = trim((string) $node->get('field_cta_text')->value);
  }

  // Hero chips: show most important facts immediately.
  $variables['event_hero_chips'] = [];
  $add_chip = static function (array &$chips, string $value, string $url = ''): void {
    $value = trim($value);
    if ($value === '') {
      return;
    }
    $chips[] = ['value' => $value, 'url' => $url];
  };

  $list_label = static function (NodeInterface $n, string $field_name) use ($langcode): string {
    if (!$n->hasField($field_name) || $n->get($field_name)->isEmpty()) {
      return '';
    }
    $raw = (string) $n->get($field_name)->value;
    if ($raw === '') {
      return '';
    }
    $allowed = $n->getFieldDefinition($field_name)->getSetting('allowed_values') ?? [];
    if (!isset($allowed[$raw])) {
      return $raw;
    }
    $label = (string) $allowed[$raw];
    return $langcode === 'ar' ? (string) t($label) : $label;
  };
  $term_label = static function (NodeInterface $n, string $field_name) use ($entity_label): string {
    if (!$n->hasField($field_name) || $n->get($field_name)->isEmpty()) {
      return '';
    }
    return $entity_label($n->get($field_name)->entity);
  };
  $first_ref_label = static function (NodeInterface $n, string $field_name) use ($entity_label): string {
    if (!$n->hasField($field_name) || $n->get($field_name)->isEmpty()) {
      return '';
    }
    return $entity_label($n->get($field_name)->first()?->entity);
  };
  $official_host = static function (NodeInterface $n): string {
    if (!$n->hasField('field_official_website') || $n->get('field_official_website')->isEmpty()) {
      return '';
    }
    $uri = (string) ($n->get('field_official_website')->first()?->uri ?? '');
    if ($uri === '') {
      return '';
    }
    $parts = @parse_url($uri);
    return is_array($parts) && !empty($parts['host']) ? (string) $parts['host'] : $uri;
  };

  $stats = [];
  $push_stat = static function (array &$out, string $caption, string $value): void {
    $value = trim($value);
    if ($value === '') {
      return;
    }
    $out[] = ['figure' => $value, 'caption' => $caption];
  };

  // Event facts (real fields) for sidebar display.
  $terms_list = static function (NodeInterface $n, string $field_name, int $limit = 3) use ($entity_label): array {
    if (!$n->hasField($field_name) || $n->get($field_name)->isEmpty()) {
      return [];
    }
    $out = [];
    foreach ($n->get($field_name) as $item) {
      $label = $entity_label($item->entity);
      if ($label !== '') {
        $out[] = $label;
      }
      if (count($out) >= $limit) {
        break;
      }
    }
    return $out;
  };

  // Build chips after helpers are available.
  // Only show Sector as a single linked chip (Format/Status already shown in stats).
  if ($node->hasField('field_sector_pages') && !$node->get('field_sector_pages')->isEmpty()) {
    $sector = $node->get('field_sector_pages')->first()?->entity;
    if ($sector) {
      $add_chip($variables['event_hero_chips'], $entity_label($sector), $sector->toUrl()->toString());
    }
  }

  $variables['event_facts'] = [];
  $add_fact = static function (array &$facts, string $label, string $value, string $url = ''): void {
    $value = trim($value);
    if ($value === '') {
      return;
    }
    $facts[] = ['label' => $label, 'value' => $value, 'url' => $url];
  };

  $add_fact($variables['event_facts'], (string) t('City'), $term_label($node, 'field_city'));
  $add_fact($variables['event_facts'], (string) t('Country'), $term_label($node, 'field_country'));
  $sectors = $terms_list($node, 'field_sector_pages', 3);
  if ($sectors !== []) {
    $add_fact($variables['event_facts'], (string) t('Sector'), implode(', ', $sectors));
  }
  $add_fact($variables['event_facts'], (string) t('Event format'), $list_label($node, 'field_event_format'));
  $add_fact($variables['event_facts'], (string) t('Price range'), $list_label($node, 'field_price_range'));
  $add_fact($variables['event_facts'], (string) t('Attendance type'), $list_label($node, 'field_attendance_type'));
  $add_fact($variables['event_facts'], (string) t('Event status'), $list_label($node, 'field_event_status'));
  if ($node->hasField('field_official_website') && !$node->get('field_official_website')->isEmpty()) {
    $uri = (string) $node->get('field_official_website')->first()->uri;
    $title = trim((string) $node->get('field_official_website')->first()->title);
    $add_fact($variables['event_facts'], (string) t('Official website'), $title !== '' ? $title : (string) t('Official website'), $uri);
  }

  // Prioritize the most useful “real” fields for the hero.
  $push_stat($stats, (string) t('Status'), $list_label($node, 'field_event_status'));
  $push_stat($stats, (string) t('Format'), $list_label($node, 'field_event_format'));
  $push_stat($stats, (string) t('City'), $term_label($node, 'field_city'));
  $push_stat($stats, (string) t('Country'), $term_label($node, 'field_country'));
  $push_stat($stats, (string) t('Sector'), $first_ref_label($node, 'field_sector_pages'));
  $push_stat($stats, (string) t('Price'), $list_label($node, 'field_price_range'));
  $push_stat($stats, (string) t('Attendance'), $list_label($node, 'field_attendance_type'));
  $push_stat($stats, (string) t('Website'), $official_host($node));

  $variables['event_hero_stats'] = array_slice($stats, 0, 3);

  $variables['event_related'] = [];
  // Connected to this event (Related events + relevant sectors + insights).
  $variables['connected_market_label'] = (string) t('Market context');
  $variables['connected_market_subtitle'] = (string) t('Explore related events, key sectors, and curated insights to stay informed and make the most of your participation.');
  $variables['connected_all_events_url'] = Url::fromUserInput('/events')->toString();
  $variables['connected_all_insights_url'] = Url::fromUserInput('/insights')->toString();
  $variables['connected_all_sectors_url'] = Url::fromUserInput('/sectors')->toString();

  // Collect sector_page links and sector taxonomy ids for cross-content linking.
  $sector_page_nids = [];
  $sector_term_ids = [];
  $variables['connected_sectors'] = [];
  if ($node->hasField('field_sector_pages') && !$node->get('field_sector_pages')->isEmpty()) {
    foreach ($node->get('field_sector_pages')->referencedEntities() as $sector_page) {
      if (!$sector_page instanceof NodeInterface) {
        continue;
      }
      if ($sector_page->bundle() !== 'sector_page' || !$sector_page->access('view')) {
        continue;
      }
      $sector_page_nids[] = (int) $sector_page->id();
      $variables['connected_sectors'][] = [
        'title' => $entity_label($sector_page),
        'url' => $sector_page->toUrl()->toString(),
      ];
      if ($sector_page->hasField('field_sector') && !$sector_page->get('field_sector')->isEmpty()) {
        $term = $sector_page->get('field_sector')->entity;
        if ($term instanceof TermInterface) {
          $sector_term_ids[] = (int) $term->id();
        }
      }
    }
  }
  $sector_page_nids = array_values(array_unique(array_filter($sector_page_nids)));
  $sector_term_ids = array_values(array_unique(array_filter($sector_term_ids)));

  // Related events: prioritize matching sector_page links, fallback to upcoming by date.
  $related_q = $em->getStorage('node')->getQuery()
    ->condition('type', 'event')
    ->condition('nid', $node->id(), '<>')
    ->condition('status', 1)
    ->sort('field_event_start', 'ASC')
    ->range(0, 3)
    ->accessCheck(TRUE);
  if ($sector_page_nids !== []) {
    $related_q->condition('field_sector_pages.target_id', $sector_page_nids, 'IN');
  }
  $nids = $related_q->execute();
  if (!$nids) {
    $nids = $em->getStorage('node')->getQuery()
      ->condition('type', 'event')
      ->condition('nid', $node->id(), '<>')
      ->condition('status', 1)
      ->sort('field_event_start', 'ASC')
      ->range(0, 3)
      ->accessCheck(TRUE)
      ->execute();
  }
  $variables['connected_related_events'] = [];
  if ($nids) {
    $related = $em->getStorage('node')->loadMultiple($nids);
    foreach ($related as $rn) {
      if (!$rn instanceof NodeInterface || $rn->bundle() !== 'event' || !$rn->access('view')) {
        continue;
      }
      $rn_view = $rn->hasTranslation($langcode) ? $rn->getTranslation($langcode) : $rn;
      $start_ts = $rn->hasField('field_event_start') && !$rn->get('field_event_start')->isEmpty()
        ? strtotime((string) $rn->get('field_event_start')->value)
        : 0;
      $when = $start_ts ? $date_formatter->format($start_ts, 'custom', 'M Y', NULL, $langcode) : '';
      $city = $term_label($rn, 'field_city');
      $country = $term_label($rn, 'field_country');
      $place = trim(implode(' • ', array_values(array_filter([$city, $country]))));
      if ($place === '' && $rn_view->hasField('field_location') && !$rn_view->get('field_location')->isEmpty()) {
        $place = trim((string) $rn_view->get('field_location')->value);
      }
      $sector = $first_ref_label($rn, 'field_sector_pages');
      $variables['connected_related_events'][] = [
        'title' => $entity_label($rn),
        'url' => $rn_view->toUrl()->toString(),
        'meta' => trim(implode(' • ', array_values(array_filter([$place, $when])))),
        'sector' => $sector,
      ];
    }
  }

  // Insights: match by sector taxonomy term ids (from sector_page.field_sector).
  $variables['connected_insights'] = [];
  if ($sector_term_ids !== []) {
    $iids = $em->getStorage('node')->getQuery()
      ->condition('type', 'market_insight')
      ->condition('status', 1)
      ->condition('field_sector.target_id', $sector_term_ids, 'IN')
      ->sort('field_year', 'DESC')
      ->sort('changed', 'DESC')
      ->range(0, 3)
      ->accessCheck(TRUE)
      ->execute();
    if ($iids) {
      $insights = $em->getStorage('node')->loadMultiple($iids);
      foreach ($insights as $in) {
        if (!$in instanceof NodeInterface || $in->bundle() !== 'market_insight' || !$in->access('view')) {
          continue;
        }
        $in_view = $in->hasTranslation($langcode) ? $in->getTranslation($langcode) : $in;
        $excerpt = '';
        if ($in_view->hasField('body') && !$in_view->get('body')->isEmpty()) {
          $item = $in_view->get('body')->first();
          $summary = $item ? trim((string) $item->summary) : '';
          $raw = $summary !== '' ? $summary : (string) ($item?->value ?? '');
          $plain = trim(Html::decodeEntities(strip_tags($raw)));
          if ($plain !== '') {
            $excerpt = motaded_theme_plain_text_truncate($plain, 92);
          }
        }
        $variables['connected_insights'][] = [
          'title' => $entity_label($in),
          'url' => $in_view->toUrl()->toString(),
          'excerpt' => $excerpt,
        ];
      }
    }
  }

  $variables['event_contact_url'] = Url::fromUserInput('/contact-us')->toString();

  $variables['event_meeting_enabled'] = $node->hasField('field_meeting_enabled')
    && !$node->get('field_meeting_enabled')->isEmpty()
    && (bool) $node->get('field_meeting_enabled')->value;

  $variables['event_lang'] = ['langcode' => $langcode];
  $variables['event_is_past'] = motaded_custom_event_is_past($node);
  $variables['event_events_directory_url'] = '/events';
  try {
    $language = \Drupal::languageManager()->getLanguage($langcode);
    $variables['event_events_directory_url'] = Url::fromRoute('view.events.page_1', [], ['language' => $language])->toString();
  }
  catch (\Throwable $e) {
    // Internal path fallback.
  }
  if ($variables['event_is_past']) {
    $variables['event_register_url'] = '';
    $variables['event_registration_help_form'] = [];
    $variables['event_meeting_enabled'] = FALSE;
  }
}

/**
 * Builds a Google Calendar template URL for an event node.
 */
function _motaded_theme_event_google_calendar_url(NodeInterface $node): ?string {
  if (!$node->hasField('field_event_start') || $node->get('field_event_start')->isEmpty()) {
    return NULL;
  }
  $start_raw = (string) $node->get('field_event_start')->value;
  $end_raw = (!$node->hasField('field_event_end') || $node->get('field_event_end')->isEmpty())
    ? $start_raw
    : (string) $node->get('field_event_end')->value;
  try {
    $start = \DateTimeImmutable::createFromFormat(DateTimeItemInterface::DATETIME_STORAGE_FORMAT, $start_raw, new \DateTimeZone(DateTimeItemInterface::STORAGE_TIMEZONE));
    $end = \DateTimeImmutable::createFromFormat(DateTimeItemInterface::DATETIME_STORAGE_FORMAT, $end_raw, new \DateTimeZone(DateTimeItemInterface::STORAGE_TIMEZONE));
  }
  catch (\Throwable $e) {
    return NULL;
  }
  if ($start === FALSE || $end === FALSE) {
    return NULL;
  }
  $fmt = 'Ymd\THis\Z';
  $text = rawurlencode($node->getTitle());
  return 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' . $text
    . '&dates=' . $start->setTimezone(new \DateTimeZone('UTC'))->format($fmt)
    . '/' . $end->setTimezone(new \DateTimeZone('UTC'))->format($fmt);
}

/**
 * Preprocess variables for Event teaser (cards, related strip).
 */
function _motaded_theme_preprocess_event_node_teaser(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/event_page';
  $em = \Drupal::entityTypeManager();
  $date_formatter = \Drupal::service('date.formatter');
  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();
  if ($langcode !== '' && $node->hasTranslation($langcode)) {
    try {
      $node = $node->getTranslation($langcode);
      $variables['node'] = $node;
    }
    catch (\Exception $e) {
      // Keep default translation.
    }
  }

  $variables['event_teaser_media'] = [];
  if ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
    $media = $node->get('field_featured_image')->entity;
    if ($media) {
      $featured = !empty($variables['elements']['#motaded_featured_teaser']);
      $mode = $featured ? 'hero_banner' : 'event_teaser';
      $variables['event_teaser_media'] = motaded_theme_media_responsive_view($media, $mode);
    }
  }

  $variables['event_teaser_badge'] = '';
  $variables['event_teaser_range'] = '';
  if ($node->hasField('field_event_start') && !$node->get('field_event_start')->isEmpty()) {
    $ts = strtotime($node->get('field_event_start')->value);
    if ($ts) {
      $variables['event_teaser_badge'] = strtoupper($date_formatter->format($ts, 'custom', 'M j', NULL, $langcode));
      $variables['event_teaser_range'] = $date_formatter->format($ts, 'custom', 'j M Y', NULL, $langcode);
    }
  }
  if ($node->hasField('field_event_end') && !$node->get('field_event_end')->isEmpty()) {
    $end_ts = strtotime($node->get('field_event_end')->value);
    $start_ts = $node->get('field_event_start')->isEmpty() ? NULL : strtotime($node->get('field_event_start')->value);
    if ($end_ts && $start_ts) {
      $variables['event_teaser_range'] = $date_formatter->format($start_ts, 'custom', 'j M', NULL, $langcode)
        . ' – ' . $date_formatter->format($end_ts, 'custom', 'j M Y', NULL, $langcode);
    }
  }

  $variables['event_teaser_location'] = '';
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    $variables['event_teaser_location'] = trim((string) $node->get('field_location')->value);
  }

  $variables['event_teaser_chips'] = [];
  $variables['event_teaser_type_pill'] = '';
  if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
    $term = $node->get('field_event_type')->entity;
    if ($term instanceof TermInterface) {
      $type_label = motaded_theme_taxonomy_term_translated_label($term, $langcode);
      $variables['event_teaser_type_pill'] = $langcode === 'ar'
        ? $type_label
        : mb_strtoupper($type_label);
    }
  }
  if ($node->hasField('field_region') && !$node->get('field_region')->isEmpty()) {
    $term = $node->get('field_region')->entity;
    if ($term instanceof TermInterface) {
      $variables['event_teaser_chips'][] = motaded_theme_taxonomy_term_translated_label($term, $langcode);
    }
  }
  if ($node->hasField('field_sector_pages') && !$node->get('field_sector_pages')->isEmpty()) {
    $sector = $node->get('field_sector_pages')->first()?->entity;
    if ($sector instanceof NodeInterface) {
      $sector = \Drupal::service('entity.repository')->getTranslationFromContext($sector, $langcode);
      $sector_label = $sector->label();
      if ($sector_label !== '' && !in_array($sector_label, $variables['event_teaser_chips'], TRUE)) {
        $variables['event_teaser_chips'][] = $sector_label;
      }
    }
  }

  $variables['event_teaser_summary'] = '';
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_item = $node->get('body')->first();
    $raw = $body_item ? (string) ($body_item->summary ?: $body_item->value) : '';
    if ($raw !== '') {
      $variables['event_teaser_summary'] = motaded_theme_decode_plain_label(
        motaded_theme_plain_text_truncate($raw, 176)
      );
    }
  }
}

/**
 * Market insight platform layout: content language, taxonomy labels, related list.
 */
function _motaded_theme_preprocess_market_insight_platform(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/platform_page';

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();
  if ($langcode !== '' && $node->hasTranslation($langcode)) {
    $node = $node->getTranslation($langcode);
    $variables['node'] = $node;
  }

  $variables['summary'] = NULL;
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_item = $node->get('body')->first();
    if ($body_item) {
      $summary_text = trim((string) $body_item->summary);
      if ($summary_text !== '') {
        $variables['summary'] = ['#markup' => nl2br(Html::escape($summary_text))];
      }
    }
  }

  $variables['mi_category_label'] = '';
  $variables['mi_sector_label'] = '';
  $variables['mi_region_label'] = '';
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term instanceof TermInterface) {
      $variables['mi_category_label'] = motaded_theme_entity_label_in_language($term, $langcode);
    }
  }
  if ($node->hasField('field_sector') && !$node->get('field_sector')->isEmpty()) {
    $term = $node->get('field_sector')->entity;
    if ($term instanceof TermInterface) {
      $variables['mi_sector_label'] = motaded_theme_entity_label_in_language($term, $langcode);
    }
  }
  if ($node->hasField('field_region') && !$node->get('field_region')->isEmpty()) {
    $term = $node->get('field_region')->entity;
    if ($term instanceof TermInterface) {
      $variables['mi_region_label'] = motaded_theme_entity_label_in_language($term, $langcode);
    }
  }

  $variables['market_insight_read_mins'] = NULL;
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $plain = trim(preg_replace('/\s+/u', ' ', strip_tags((string) $node->get('body')->value)));
    if ($plain !== '') {
      $words = count(preg_split('/\s+/u', $plain, -1, PREG_SPLIT_NO_EMPTY));
      $variables['market_insight_read_mins'] = max(1, (int) ceil($words / 200));
    }
  }

  try {
    $variables['market_insight_insights_url'] = Url::fromRoute('view.insights.page_1', [], [
      'language' => \Drupal::languageManager()->getLanguage(motaded_theme_interface_langcode()),
    ])->toString();
  }
  catch (\Throwable $e) {
    $variables['market_insight_insights_url'] = motaded_theme_interface_langcode() === 'ar'
      ? '/ar/insights'
      : '/insights';
  }

  $variables['market_insight_related'] = [];
  try {
    $em = \Drupal::entityTypeManager();
    $storage = $em->getStorage('node');
    $build_related = static function (array $nids) use ($em, $storage, $langcode): array {
      if ($nids === []) {
        return [];
      }
      $nodes = [];
      foreach ($storage->loadMultiple($nids) as $related) {
        if (!$related instanceof NodeInterface || !$related->access('view')) {
          continue;
        }
        if ($langcode !== '' && $related->hasTranslation($langcode)) {
          $related = $related->getTranslation($langcode);
        }
        elseif ($langcode !== '' && $langcode !== 'en' && !$related->hasTranslation($langcode)) {
          continue;
        }
        $nodes[] = $related;
      }
      return $nodes === [] ? [] : $em->getViewBuilder('node')->viewMultiple($nodes, 'teaser');
    };

    $q = $storage->getQuery()
      ->condition('type', 'market_insight')
      ->condition('status', 1)
      ->condition('nid', $node->id(), '<>')
      ->sort('field_year', 'DESC')
      ->sort('changed', 'DESC')
      ->range(0, 3)
      ->accessCheck(TRUE);
    if ($langcode !== '') {
      $q->condition('langcode', $langcode);
    }
    if ($node->hasField('field_sector') && !$node->get('field_sector')->isEmpty()) {
      $tid = (int) $node->get('field_sector')->target_id;
      if ($tid > 0) {
        $q->condition('field_sector.target_id', $tid);
      }
    }
    $nids = $q->execute();
    if (!$nids) {
      $q = $storage->getQuery()
        ->condition('type', 'market_insight')
        ->condition('status', 1)
        ->condition('nid', $node->id(), '<>')
        ->sort('field_year', 'DESC')
        ->sort('changed', 'DESC')
        ->range(0, 3)
        ->accessCheck(TRUE);
      if ($langcode !== '') {
        $q->condition('langcode', $langcode);
      }
      $nids = $q->execute();
    }
    $variables['market_insight_related'] = $build_related($nids);
  }
  catch (\Throwable $e) {
    $variables['market_insight_related'] = [];
  }

  $variables['#cache']['contexts'] = Cache::mergeContexts(
    $variables['#cache']['contexts'] ?? [],
    ['languages:language_content', 'languages:language_interface'],
  );
}

/**
 * Preprocess variables for Market insight teaser (directory cards + list).
 */
function _motaded_theme_preprocess_market_insight_teaser(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/event_page';
  $em = \Drupal::entityTypeManager();

  $variables['insight_teaser_media'] = [];
  if ($node->hasField('field_insight_thumbnail') && !$node->get('field_insight_thumbnail')->isEmpty()) {
    $media = $node->get('field_insight_thumbnail')->entity;
    if ($media) {
      $variables['insight_teaser_media'] = $em->getViewBuilder('media')->view($media, 'news');
    }
  }

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)
    ->getId();
  if ($langcode !== '' && $node->hasTranslation($langcode)) {
    $node = $node->getTranslation($langcode);
    $variables['node'] = $node;
  }

  $variables['insight_teaser_category'] = '';
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term instanceof TermInterface) {
      $variables['insight_teaser_category'] = motaded_theme_entity_label_in_language($term, $langcode);
    }
  }

  $variables['insight_teaser_year'] = '';
  if ($node->hasField('field_year') && !$node->get('field_year')->isEmpty()) {
    $variables['insight_teaser_year'] = (string) $node->get('field_year')->value;
  }

  $variables['insight_teaser_excerpt'] = '';
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $item = $node->get('body')->first();
    $summary = trim((string) $item->summary);
    $value = (string) $item->value;
    $raw = $summary !== '' ? $summary : $value;
    if ($raw !== '') {
      $variables['insight_teaser_excerpt'] = motaded_theme_plain_text_truncate($raw, 200);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph templates.
 *
 * Splits objectives body on a blank line into title + description when present.
 */
function motaded_theme_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];

  // Platform paragraphs (help_item, benefit_item, platform_resource) carry an
  // optional `field_icon` (list_string). Expose its SVG markup to Twig.
  if ($paragraph->hasField('field_icon')) {
    $key = $paragraph->get('field_icon')->isEmpty() ? null : (string) $paragraph->get('field_icon')->value;
    $variables['pf_icon_key'] = $key;
    $variables['pf_icon_markup'] = $key ? _motaded_theme_pf_icon_markup($key) : NULL;
  }

  if ($paragraph->bundle() === 'business_cost_estimation') {
    _motaded_theme_preprocess_paragraph_bce($variables);
  }
  if ($paragraph->bundle() !== 'objectives') {
    return;
  }
  if (!$paragraph->hasField('field_content') || $paragraph->get('field_content')->isEmpty()) {
    return;
  }
  $text = trim((string) $paragraph->get('field_content')->value);
  if ($text === '') {
    return;
  }
  $parts = preg_split('/\R(?:\s*\R)+/', $text, 2);
  if (isset($parts[1])) {
    $variables['objectives_card_title'] = trim((string) $parts[0]);
    $variables['objectives_card_body'] = trim((string) $parts[1]);
  }
}

/**
 * Split promo: plain copy + media render (banner_sm / responsive image) for Twig.
 */
function motaded_theme_preprocess_paragraph__split_promo(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['split_promo_heading_id'] = Html::getUniqueId('split-promo-heading-' . $paragraph->id());

  $variables['split_promo_headline'] = '';
  if ($paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['split_promo_headline'] = trim((string) $paragraph->get('field_title')->value);
  }

  $variables['split_promo_sub'] = '';
  if ($paragraph->get('field_sub_title')->access('view') && !$paragraph->get('field_sub_title')->isEmpty()) {
    $variables['split_promo_sub'] = trim((string) $paragraph->get('field_sub_title')->value);
  }

  $bullets = [];
  $bullet_field = $paragraph->get('field_promo_bullet');
  if ($bullet_field->access('view')) {
    foreach ($bullet_field as $item) {
      $line = trim((string) $item->value);
      if ($line !== '') {
        $bullets[] = $line;
      }
    }
  }
  $variables['split_promo_bullets'] = $bullets;

  $variables['split_promo_trust'] = '';
  if ($paragraph->get('field_promo_trust')->access('view') && !$paragraph->get('field_promo_trust')->isEmpty()) {
    $variables['split_promo_trust'] = trim((string) $paragraph->get('field_promo_trust')->value);
  }

  $variables['split_promo_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['split_promo_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }
}

/**
 * Promo split: features, media (banner_sm), optional logo overlay for Twig.
 */
function motaded_theme_preprocess_paragraph__promo_split(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['promo_split_heading_id'] = Html::getUniqueId('promo-split-heading-' . $paragraph->id());

  $variables['promo_split_media_side'] = 'image_right';
  if ($paragraph->get('field_promo_split_side')->access('view') && !$paragraph->get('field_promo_split_side')->isEmpty()) {
    $variables['promo_split_media_side'] = (string) $paragraph->get('field_promo_split_side')->value;
  }

  $variables['promo_split_list_style'] = 'icons_row';
  if ($paragraph->get('field_promo_split_list_style')->access('view') && !$paragraph->get('field_promo_split_list_style')->isEmpty()) {
    $variables['promo_split_list_style'] = (string) $paragraph->get('field_promo_split_list_style')->value;
  }

  $features = [];
  $item_field = $paragraph->get('field_promo_split_item');
  if ($item_field->access('view')) {
    foreach ($item_field as $item) {
      $line = trim((string) $item->value);
      if ($line !== '') {
        $features[] = $line;
      }
    }
  }
  $variables['promo_split_features'] = $features;

  $icon_cycle = ['user', 'shield', 'globe'];
  $variables['promo_split_icon_keys'] = [];
  foreach (array_keys($features) as $i) {
    $variables['promo_split_icon_keys'][$i] = $icon_cycle[$i % 3];
  }

  $variables['promo_split_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['promo_split_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }

  $variables['promo_split_logo'] = [];
  if ($paragraph->get('field_promo_split_logo')->access('view') && !$paragraph->get('field_promo_split_logo')->isEmpty()) {
    $logo = $paragraph->get('field_promo_split_logo')->entity;
    if ($logo) {
      $variables['promo_split_logo'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($logo, 'default');
    }
  }

  $variables['promo_split_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['promo_split_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }
}

/**
 * Investor journey: nested journey_step rows for timeline Twig.
 */
function motaded_theme_preprocess_paragraph__investor_journey(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['investor_journey_heading_id'] = Html::getUniqueId('investor-journey-heading-' . $paragraph->id());

  $steps = [];
  $field = $paragraph->get('field_investor_journey_steps');
  if ($field->access('view')) {
    foreach ($field as $item) {
      $sub = motaded_theme_paragraph_from_context($item->entity);
      if (!$sub instanceof ParagraphInterface || $sub->bundle() !== 'journey_step') {
        continue;
      }
      $icon = (string) ($sub->get('field_journey_icon')->value ?: 'document');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $row = [
        'title' => $title,
        'icon' => $icon,
      ];
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body_markup = motaded_theme_markup_from_text_field($sub, 'field_body');
        if ($body_markup !== '') {
          $row['body'] = Markup::create($body_markup);
        }
      }

      $platform_cards = [];
      if ($sub->hasField('field_journey_platforms') && $sub->get('field_journey_platforms')->access('view') && !$sub->get('field_journey_platforms')->isEmpty()) {
        $entity_repository = \Drupal::service('entity.repository');
        foreach ($sub->get('field_journey_platforms')->referencedEntities() as $platform_node) {
          if (!$platform_node instanceof \Drupal\node\NodeInterface || $platform_node->bundle() !== 'platform') {
            continue;
          }
          $platform_node = $entity_repository->getTranslationFromContext($platform_node);
          $logo = [
            'src' => '',
            'srcset' => '',
            'width' => 0,
            'height' => 0,
            'alt' => '',
          ];
          if ($platform_node->hasField('field_logo') && !$platform_node->get('field_logo')->isEmpty()) {
            $media = $platform_node->get('field_logo')->entity;
            $fallback_alt = (string) t('@name logo', ['@name' => $platform_node->label()]);
            $extracted = motaded_theme_media_image_uri_and_alt($media, $fallback_alt);
            $meta = motaded_theme_platform_logo_image_metadata($extracted['uri']);
            $logo = [
              'src' => $meta['src'],
              'srcset' => $meta['srcset'],
              'width' => $meta['width'],
              'height' => $meta['height'],
              'alt' => $extracted['alt'],
            ];
          }
          $desc = '';
          if ($platform_node->hasField('field_short_description') && !$platform_node->get('field_short_description')->isEmpty()) {
            $desc = trim((string) $platform_node->get('field_short_description')->value);
          }
          $platform_cards[] = [
            'title' => $platform_node->label(),
            'url' => $platform_node->toUrl()->toString(),
            'description' => $desc,
            'logo' => $logo,
          ];
        }
      }
      $row['platforms'] = $platform_cards;

      $steps[] = $row;
    }
  }
  $variables['investor_journey_steps'] = $steps;

  $variables['investor_journey_has_platforms'] = FALSE;
  foreach ($steps as $step_row) {
    if (!empty($step_row['platforms'])) {
      $variables['investor_journey_has_platforms'] = TRUE;
      break;
    }
  }

  $variables['investor_journey_note'] = '';
  if ($paragraph->hasField('field_investor_journey_note') && $paragraph->get('field_investor_journey_note')->access('view') && !$paragraph->get('field_investor_journey_note')->isEmpty()) {
    $variables['investor_journey_note'] = trim((string) $paragraph->get('field_investor_journey_note')->value);
  }

  $variables['investor_journey_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['investor_journey_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }
}

/**
 * Hero split banner: hero image, CTAs, features, highlights for Twig.
 */
function motaded_theme_preprocess_paragraph__hero_split_banner(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/hero_split_banner';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['hero_split_banner_heading_id'] = Html::getUniqueId('hero-split-banner-heading-' . $paragraph->id());

  $variables['hero_split_headline_prefix'] = '';
  if ($paragraph->get('field_hero_split_headline_prefix')->access('view') && !$paragraph->get('field_hero_split_headline_prefix')->isEmpty()) {
    $variables['hero_split_headline_prefix'] = trim((string) $paragraph->get('field_hero_split_headline_prefix')->value);
  }
  $variables['hero_split_headline_accent'] = '';
  if ($paragraph->get('field_hero_split_headline_accent')->access('view') && !$paragraph->get('field_hero_split_headline_accent')->isEmpty()) {
    $variables['hero_split_headline_accent'] = trim((string) $paragraph->get('field_hero_split_headline_accent')->value);
  }

  $variables['hero_split_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['hero_split_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'hero_banner');
    }
  }

  $variables['hero_split_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['hero_split_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }

  $variables['hero_split_cta_secondary'] = [];
  if ($paragraph->hasField('field_link_secondary')) {
    $link2 = $paragraph->get('field_link_secondary');
    if ($link2->access('view') && !$link2->isEmpty()) {
      /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
      $item = $link2->first();
      if ($item) {
        $url = $item->getUrl();
        if ($url) {
          $title = $item->getTitle();
          $variables['hero_split_cta_secondary'] = [
            'url' => $url->toString(),
            'title' => $title !== '' && $title !== NULL ? $title : (string) t('Explore'),
          ];
        }
      }
    }
  }

  $allowed_why_icons = [
    'people', 'medal', 'arrows', 'shield_check', 'clock', 'chart', 'globe', 'trend', 'document', 'monitor',
  ];

  $features = [];
  if ($paragraph->hasField('field_hero_split_features')) {
    $feature_field = $paragraph->get('field_hero_split_features');
    if ($feature_field->access('view')) {
      foreach ($feature_field as $item) {
        $sub = motaded_theme_paragraph_from_context($item->entity);
        if (!$sub instanceof ParagraphInterface || $sub->bundle() !== 'why_feature_card') {
          continue;
        }
        $icon = (string) ($sub->get('field_why_feature_icon')->value ?: 'people');
        if (!in_array($icon, $allowed_why_icons, TRUE)) {
          $icon = 'shield_check';
        }
        $title = '';
        if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
          $title = trim((string) $sub->get('field_title')->value);
        }
        $body = '';
        if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
          $body = trim((string) $sub->get('field_body')->value);
        }
        $row_link = ['url' => '', 'title' => ''];
        $link_field = $sub->get('field_link');
        if ($link_field->access('view') && !$link_field->isEmpty()) {
          /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
          $link_item = $link_field->first();
          if ($link_item) {
            $url = $link_item->getUrl();
            if ($url) {
              $ltitle = $link_item->getTitle();
              $row_link = [
                'url' => $url->toString(),
                'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
              ];
            }
          }
        }
        $features[] = [
          'icon' => $icon,
          'title' => $title,
          'body' => $body,
          'link' => $row_link,
        ];
      }
    }
  }
  $variables['hero_split_features'] = $features;

  $highlights = [];
  if ($paragraph->hasField('field_hero_split_highlights')) {
    $hl_field = $paragraph->get('field_hero_split_highlights');
    if ($hl_field->access('view')) {
      foreach ($hl_field as $item) {
        $sub = motaded_theme_paragraph_from_context($item->entity);
        if (!$sub instanceof ParagraphInterface || $sub->bundle() !== 'hero_split_highlight') {
          continue;
        }
        $icon = (string) ($sub->get('field_why_feature_icon')->value ?: 'shield_check');
        if (!in_array($icon, $allowed_why_icons, TRUE)) {
          $icon = 'shield_check';
        }
        $label = '';
        if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
          $label = trim((string) $sub->get('field_title')->value);
        }
        if ($label === '') {
          continue;
        }
        $highlights[] = [
          'icon' => $icon,
          'label' => $label,
        ];
      }
    }
  }
  $variables['hero_split_highlights'] = $highlights;
}

/**
 * Why opportunities: feature cards, stat bar items, trust line.
 */
function motaded_theme_preprocess_paragraph__why_opportunities(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/why_opportunities';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['why_opportunities_heading_id'] = Html::getUniqueId('why-opportunities-heading-' . $paragraph->id());

  $variables['why_opportunities_trust'] = '';
  if ($paragraph->get('field_why_trust_line')->access('view') && !$paragraph->get('field_why_trust_line')->isEmpty()) {
    $variables['why_opportunities_trust'] = trim((string) $paragraph->get('field_why_trust_line')->value);
  }

  $features = [];
  $feature_field = $paragraph->get('field_why_features');
  if ($feature_field->access('view')) {
    foreach ($feature_field as $item) {
      $sub = motaded_theme_paragraph_from_context($item->entity);
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_feature_card') {
        continue;
      }
      $icon = (string) ($sub->get('field_why_feature_icon')->value ?: 'people');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      // If editors left default "people" on cards that are not team-focused, map by title (EN).
      if ($icon === 'people' && $title !== '') {
        $lower = function_exists('mb_strtolower') ? mb_strtolower($title) : strtolower($title);
        if (str_contains($lower, 'strategic') || str_contains($lower, 'gateway')) {
          $icon = 'globe';
        }
        elseif (str_contains($lower, 'growth') || str_contains($lower, 'sector')) {
          $icon = 'trend';
        }
        elseif (str_contains($lower, 'vision') || str_contains($lower, 'reform')) {
          $icon = 'clock';
        }
      }
      $body = $sub->get('field_body')->access('view')
        ? motaded_theme_render_formatted_text_field($sub, 'field_body')
        : [];
      $link = [];
      $link_field = $sub->get('field_link');
      if ($link_field->access('view') && !$link_field->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
        $link_item = $link_field->first();
        if ($link_item) {
          $url = $link_item->getUrl();
          if ($url) {
            $ltitle = $link_item->getTitle();
            $link = [
              'url' => $url->toString(),
              'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
            ];
          }
        }
      }
      $features[] = [
        'icon' => $icon,
        'title' => $title,
        'body' => $body,
        'link' => $link,
      ];
    }
  }
  $variables['why_opportunities_features'] = $features;

  $stats = [];
  $stat_field = $paragraph->get('field_why_stat_items');
  if ($stat_field->access('view')) {
    foreach ($stat_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_stat_item') {
        continue;
      }
      $icon = (string) ($sub->get('field_why_stat_icon')->value ?: 'globe');
      $value = '';
      if ($sub->get('field_why_stat_value')->access('view') && !$sub->get('field_why_stat_value')->isEmpty()) {
        $value = trim((string) $sub->get('field_why_stat_value')->value);
      }
      $label = '';
      if ($sub->get('field_why_stat_label')->access('view') && !$sub->get('field_why_stat_label')->isEmpty()) {
        $label = trim((string) $sub->get('field_why_stat_label')->value);
      }
      $stats[] = [
        'icon' => $icon,
        'value' => $value,
        'label' => $label,
      ];
    }
  }
  $variables['why_opportunities_stats'] = $stats;
}

/**
 * Business setup options: image cards + bottom trust banner.
 */
function motaded_theme_preprocess_paragraph__business_setup_section(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['business_setup_heading_id'] = Html::getUniqueId('business-setup-heading-' . $paragraph->id());

  $variables['business_setup_banner_line1'] = '';
  if ($paragraph->get('field_setup_banner_line1')->access('view') && !$paragraph->get('field_setup_banner_line1')->isEmpty()) {
    $variables['business_setup_banner_line1'] = trim((string) $paragraph->get('field_setup_banner_line1')->value);
  }
  $variables['business_setup_banner_line2'] = '';
  if ($paragraph->get('field_setup_banner_line2')->access('view') && !$paragraph->get('field_setup_banner_line2')->isEmpty()) {
    $variables['business_setup_banner_line2'] = trim((string) $paragraph->get('field_setup_banner_line2')->value);
  }

  $cards = [];
  $card_field = $paragraph->get('field_business_setup_cards');
  if ($card_field->access('view')) {
    foreach ($card_field as $item) {
      $sub = motaded_theme_paragraph_from_context($item->entity);
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'business_setup_card') {
        continue;
      }
      $icon = (string) ($sub->get('field_business_setup_icon')->value ?: 'city');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body = $sub->get('field_body')->access('view')
        ? motaded_theme_render_formatted_text_field($sub, 'field_body')
        : [];
      $link = [];
      $link_field = $sub->get('field_link');
      if ($link_field->access('view') && !$link_field->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
        $link_item = $link_field->first();
        if ($link_item) {
          $url = $link_item->getUrl();
          if ($url) {
            $ltitle = $link_item->getTitle();
            $link = [
              'url' => $url->toString(),
              'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
            ];
          }
        }
      }
      $media = [];
      if ($sub->get('field_media')->access('view') && !$sub->get('field_media')->isEmpty()) {
        $media_entity = $sub->get('field_media')->entity;
        if ($media_entity) {
          $media = \Drupal::entityTypeManager()
            ->getViewBuilder('media')
            ->view($media_entity, 'default');
        }
      }
      $popular = FALSE;
      if ($sub->hasField('field_business_setup_popular') && $sub->get('field_business_setup_popular')->access('view') && !$sub->get('field_business_setup_popular')->isEmpty()) {
        $popular = (bool) $sub->get('field_business_setup_popular')->value;
      }
      $cards[] = [
        'icon' => $icon,
        'title' => $title,
        'body' => $body,
        'link' => $link,
        'media' => $media,
        'popular' => $popular,
      ];
    }
  }
  $variables['business_setup_cards'] = $cards;
}

/**
 * Business cost estimation: CTA, cost card from fields, highlight rows.
 *
 * Invoked from motaded_theme_preprocess_paragraph() so variables exist when
 * the base paragraph.html.twig is used (bundle-specific twig not selected).
 */
function _motaded_theme_preprocess_paragraph_bce(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  $repository = \Drupal::service('entity.repository');
  $paragraph = $repository->getTranslationFromContext($paragraph, $langcode);
  $variables['paragraph'] = $paragraph;

  $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
  $request = \Drupal::request();
  // Absolute URL so <img src> / overlays work behind reverse proxies and subdirs.
  $variables['bce_cost_bg_url'] = $request->getSchemeAndHttpHost() . base_path() . $theme_path . '/images/cost-bg.svg';
  $variables['bce_heading_id'] = Html::getUniqueId('bce-heading-' . $paragraph->id());
  $variables['bce_title'] = '';
  if ($paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['bce_title'] = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['bce_lead'] = $paragraph->get('field_body')->access('view')
    ? motaded_theme_render_formatted_text_field($paragraph, 'field_body')
    : [];
  $variables['#cache']['contexts'][] = 'languages:language_content';

  $fmt_money = static function (int $n): string {
    return number_format($n, 0, '.', ',');
  };

  $variables['bce_cta'] = [];
  $link_field = $paragraph->get('field_link');
  if ($link_field->access('view') && !$link_field->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
    $link_item = $link_field->first();
    if ($link_item) {
      $url = $link_item->getUrl();
      if ($url) {
        $url = $url->mergeOptions(['language' => $paragraph->language()]);
        $url->setAbsolute(FALSE);
        $ltitle = $link_item->getTitle();
        $variables['bce_cta'] = [
          'url' => $url->toString(),
          'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
        ];
      }
    }
  }

  $currency = 'SAR';
  if ($paragraph->get('field_bce_currency')->access('view') && !$paragraph->get('field_bce_currency')->isEmpty()) {
    $currency = trim((string) $paragraph->get('field_bce_currency')->value) ?: 'SAR';
  }
  $min_total = 0;
  $max_total = 0;
  if ($paragraph->get('field_bce_cost_min')->access('view') && !$paragraph->get('field_bce_cost_min')->isEmpty()) {
    $min_total = (int) $paragraph->get('field_bce_cost_min')->value;
  }
  if ($paragraph->get('field_bce_cost_max')->access('view') && !$paragraph->get('field_bce_cost_max')->isEmpty()) {
    $max_total = (int) $paragraph->get('field_bce_cost_max')->value;
  }

  $icon_for_key = static function (string $key): string {
    $key = strtolower($key);
    if (str_contains($key, 'government') || str_contains($key, 'gov') || $key === 'fees') {
      return 'tag';
    }
    if (str_contains($key, 'licens')) {
      return 'document';
    }
    if (str_contains($key, 'operat')) {
      return 'user';
    }
    return 'tag';
  };

  $rows = [];
  $bf = $paragraph->get('field_bce_breakdown');
  if ($bf->access('view')) {
    foreach ($bf as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'cost_breakdown_line') {
        continue;
      }
      $sub = $repository->getTranslationFromContext($sub, $langcode);
      $label = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $label = trim((string) $sub->get('field_title')->value);
      }
      $row_key = '';
      if ($sub->get('field_bce_row_key')->access('view') && !$sub->get('field_bce_row_key')->isEmpty()) {
        $row_key = trim((string) $sub->get('field_bce_row_key')->value);
      }
      $lmin = 0;
      $lmax = 0;
      if ($sub->get('field_bce_line_min')->access('view') && !$sub->get('field_bce_line_min')->isEmpty()) {
        $lmin = (int) $sub->get('field_bce_line_min')->value;
      }
      if ($sub->get('field_bce_line_max')->access('view') && !$sub->get('field_bce_line_max')->isEmpty()) {
        $lmax = (int) $sub->get('field_bce_line_max')->value;
      }
      $pct = 0;
      if ($sub->get('field_bce_line_percentage')->access('view') && !$sub->get('field_bce_line_percentage')->isEmpty()) {
        $pct = max(0, min(100, (int) $sub->get('field_bce_line_percentage')->value));
      }
      $rows[] = [
        'label' => $label,
        'key' => $row_key,
        'icon' => $icon_for_key($row_key !== '' ? $row_key : $label),
        'min' => $lmin,
        'max' => $lmax,
        'min_f' => $fmt_money($lmin),
        'max_f' => $fmt_money($lmax),
        'pct' => $pct,
      ];
    }
  }

  $card_note = '';
  if ($paragraph->get('field_bce_card_note')->access('view') && !$paragraph->get('field_bce_card_note')->isEmpty()) {
    $card_note = trim((string) $paragraph->get('field_bce_card_note')->value);
  }

  $variables['bce_cost_card'] = [
    'currency' => $currency,
    'min' => $min_total,
    'max' => $max_total,
    'min_f' => $fmt_money($min_total),
    'max_f' => $fmt_money($max_total),
    'rows' => $rows,
    'note' => $card_note,
    'show_range' => $min_total > 0 || $max_total > 0,
  ];

  $variables['bce_meta'] = [
    'updated' => '',
    'source' => '',
  ];
  if ($paragraph->get('field_bce_last_updated')->access('view') && !$paragraph->get('field_bce_last_updated')->isEmpty()) {
    $variables['bce_meta']['updated'] = trim((string) $paragraph->get('field_bce_last_updated')->value);
  }
  if ($paragraph->get('field_bce_meta_source')->access('view') && !$paragraph->get('field_bce_meta_source')->isEmpty()) {
    $variables['bce_meta']['source'] = trim((string) $paragraph->get('field_bce_meta_source')->value);
  }

  $icon_cycle = ['shield', 'document', 'refresh'];
  $highlights = [];
  $hf = $paragraph->get('field_bce_highlights');
  if ($hf->access('view')) {
    $i = 0;
    foreach ($hf as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'help_item') {
        continue;
      }
      $sub = $repository->getTranslationFromContext($sub, $langcode);
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body = $sub->get('field_body')->access('view')
        ? motaded_theme_render_formatted_text_field($sub, 'field_body')
        : [];
      $highlights[] = [
        'title' => $title,
        'body' => $body,
        'icon' => $icon_cycle[$i % 3],
      ];
      $i++;
    }
  }
  $variables['bce_highlights'] = $highlights;
}

/**
 * View block paragraph: flag when embedded view is news / block_4 (compact list layout).
 */
function motaded_theme_preprocess_paragraph__view_block(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['view_block_news_latest'] = FALSE;
  $variables['view_block_services_home'] = FALSE;
  $variables['view_block_events_home_list'] = FALSE;
  $variables['view_block_events_home_calendar'] = FALSE;
  $variables['view_block_partners_marquee'] = FALSE;
  $variables['view_block_library_home'] = FALSE;
  if (!$paragraph->hasField('field_view_block') || $paragraph->get('field_view_block')->isEmpty()) {
    return;
  }
  foreach ($paragraph->get('field_view_block')->getValue() as $item) {
    foreach (_motaded_theme_viewsreference_field_item_pairs($item) as [$target, $display]) {
      if ($target === 'events' && $display === 'block_home') {
        $variables['view_block_events_home_list'] = TRUE;
      }
      elseif ($target === 'events' && $display === 'block_calendar') {
        $variables['view_block_events_home_calendar'] = TRUE;
      }
      elseif ($target === 'news' && $display === 'block_4') {
        $variables['view_block_news_latest'] = TRUE;
      }
      elseif ($target === 'services' && $display === 'block_2') {
        $variables['view_block_services_home'] = TRUE;
      }
      elseif ($target === 'partners' && $display === 'block_2') {
        $variables['view_block_partners_marquee'] = TRUE;
      }
      elseif ($target === 'library' && $display === 'block_1') {
        $variables['view_block_library_home'] = TRUE;
      }
    }
  }

  if ($variables['view_block_events_home_list'] || $variables['view_block_events_home_calendar']) {
    $variables['#attached']['library'][] = 'motaded_theme/events_home';
  }
  if ($variables['view_block_library_home']) {
    $variables['#attached']['library'][] = 'motaded_theme/library_home_block';
  }
}

/**
 * Media lead: image left, icon + headline + body + CTA (Twig + responsive media).
 */
function motaded_theme_preprocess_paragraph__media_lead(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['media_lead_heading_id'] = Html::getUniqueId('media-lead-heading-' . $paragraph->id());
  $variables['media_lead_headline'] = '';
  if ($paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['media_lead_headline'] = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['media_lead_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['media_lead_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }
}

/**
 * Plain title + image alt from media (fallback to title) for article-card output.
 */
function motaded_theme_preprocess_paragraph__business_activity(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $title_plain = '';
  if ($paragraph->hasField('field_title') && !$paragraph->get('field_title')->isEmpty()) {
    $title_plain = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['business_activity_title_plain'] = $title_plain;

  $variables['business_activity_tag'] = '';
  $parent = $paragraph->getParentEntity();
  if ($parent instanceof NodeInterface) {
    $tag_map = [
      'page' => (string) t('Service'),
      'article' => (string) t('Blog'),
      'news' => (string) t('News'),
    ];
    $variables['business_activity_tag'] = $tag_map[$parent->bundle()] ?? '';
  }

  $image_alt = $title_plain;
  $image_uri = NULL;
  if ($paragraph->hasField('field_media') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    $image_data = motaded_theme_media_image_uri_and_alt($media, $title_plain);
    $image_uri = $image_data['uri'];
    if ($image_data['alt'] !== '') {
      $image_alt = $image_data['alt'];
    }
  }
  if ($image_alt === '' && $title_plain !== '') {
    $image_alt = $title_plain;
  }
  if ($image_alt === '') {
    $image_alt = (string) t('Illustration for service information');
  }
  $variables['business_activity_image_alt'] = $image_alt;
  $variables['business_activity_image_meta'] = motaded_theme_responsive_teaser_image_metadata($image_uri);
}

/**
 * Implements hook_preprocess_HOOK() for areas_of_work paragraphs.
 *
 * Splits plain text on the first colon so the lead phrase can be styled bold
 * (e.g. "Mandatory activities: These include…").
 */
function motaded_theme_preprocess_paragraph__areas_of_work(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_content') || $paragraph->get('field_content')->isEmpty()) {
    return;
  }
  $full = trim((string) $paragraph->get('field_content')->value);
  if ($full === '') {
    return;
  }
  $pos = strpos($full, ':');
  if ($pos === FALSE) {
    return;
  }
  $label = trim(substr($full, 0, $pos));
  $rest = trim(substr($full, $pos + 1));
  if ($label === '') {
    return;
  }
  $variables['areas_lead_label'] = $label;
  $variables['areas_rest_safe'] = $rest === ''
    ? NULL
    : Markup::create(nl2br(Html::escape($rest), FALSE));
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function motaded_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Core route /system/404 (system.404) is a normal route match, so Drupal does
  // not add page__404; use the same layout as for real 404 responses.
  if (\Drupal::routeMatch()->getRouteName() === 'system.404') {
    array_unshift($suggestions, 'page__404');
  }

  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $suggestions[] = 'page__' . $node->bundle();
  }
}

/**
 * Implements hook_preprocess_paragraph__steps().
 */
function motaded_theme_preprocess_paragraph__steps(array &$variables) {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $steps = [];
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

  // Check if field_paragraphs exists and has data.
  if ($paragraph->hasField('field_paragraphs') && !$paragraph->get('field_paragraphs')->isEmpty()) {
    foreach ($paragraph->get('field_paragraphs')->referencedEntities() as $item) {
      // Try to get the translation if available.
      if ($item->hasTranslation($langcode)) {
        $item = $item->getTranslation($langcode);
      }
      // Each $item is a sub-paragraph, e.g., a single step/card.
      $stepTitle = $item->hasField('field_sub_title') ? $item->get('field_sub_title')->value : '';
      $title = $item->hasField('field_title') ? $item->get('field_title')->value : '';
      $desc = $item->hasField('field_body') ? $item->get('field_body')->processed : '';

      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($item, (string) $title);
      $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);

      $steps[] = [
        'step_title' => $stepTitle,
        'title' => $title,
        'desc' => $desc,
        'img' => $meta['src'],
        'img_srcset' => $meta['srcset'],
        'img_width' => $meta['width'],
        'img_height' => $meta['height'],
        'img_alt' => $extracted['alt'] !== '' ? $extracted['alt'] : (string) $title,
      ];
    }
  }

  // Attach the structured data to drupalSettings.
  // Use paragraph ID so multiple 'steps' paragraphs don’t overwrite each other.
  $variables['#attached']['drupalSettings']['motaded_theme']['steps'] = $steps;

  // Attach JS library.
  $variables['#attached']['library'][] = 'motaded_theme/steps';
}

/**
 * Implements hook_preprocess_paragraph__featured_contents().
 */
function motaded_theme_preprocess_paragraph__featured_contents(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['featured_card_images'] = [];
  if (!$paragraph->hasField('field_contents') || $paragraph->get('field_contents')->isEmpty()) {
    return;
  }
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  foreach ($paragraph->get('field_contents')->referencedEntities() as $node) {
    if ($node->hasTranslation($langcode)) {
      $node = $node->getTranslation($langcode);
    }
    $nid = (int) $node->id();
    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($node, $node->label());
    $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $meta['alt'] = $extracted['alt'];
    $variables['featured_card_images'][$nid] = $meta;
  }
}

/**
 * Implements hook_preprocess_paragraph__insights_updates().
 */
function motaded_theme_preprocess_paragraph__insights_updates(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['iu_card_images'] = [];
  $variables['iu_item_dates'] = [];
  $variables['iu_item_dates_iso'] = [];
  $variables['iu_insight_nodes'] = [];
  $variables['iu_news_nodes'] = [];

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  $interface_langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  $language = \Drupal::languageManager()->getLanguage($interface_langcode);

  $route_url = static function (string $route_name, string $path) use ($language): string {
    try {
      return Url::fromRoute($route_name, [], ['language' => $language])->toString();
    }
    catch (\Throwable $e) {
      return Url::fromUserInput($path, ['language' => $language])->toString();
    }
  };

  $variables['iu_insights_list_url'] = $route_url('view.news.page_1', '/blog');
  $variables['iu_news_list_url'] = $route_url('view.news.page_2', '/news');
  $variables['#cache']['contexts'][] = 'languages:language_content';
  $variables['#cache']['contexts'][] = 'languages:language_interface';

  $collect_meta = function (array $nodes) use (&$variables, $langcode): void {
    foreach ($nodes as $node) {
      if (!$node instanceof NodeInterface) {
        continue;
      }
      $nid = (int) $node->id();
      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($node, $node->label());
      $meta = motaded_theme_publication_card_image_metadata($extracted['uri']);
      $meta['alt'] = $extracted['alt'];
      $variables['iu_card_images'][$nid] = $meta;
      $ts = (int) $node->getCreatedTime();
      $variables['iu_item_dates'][$nid] = $ts
        ? \Drupal::service('date.formatter')->format($ts, 'custom', 'j F Y', NULL, $langcode)
        : '';
      $variables['iu_item_dates_iso'][$nid] = $ts
        ? \Drupal::service('date.formatter')->format($ts, 'html_datetime', '', NULL, $langcode)
        : '';
    }
  };

  $resolve_node = static function (NodeInterface $node) use ($langcode): ?NodeInterface {
    if ($langcode !== 'en' && !$node->hasTranslation($langcode)) {
      return NULL;
    }
    return $node->hasTranslation($langcode)
      ? $node->getTranslation($langcode)
      : $node;
  };

  if ($paragraph->hasField('field_iu_insights') && !$paragraph->get('field_iu_insights')->isEmpty()) {
    foreach ($paragraph->get('field_iu_insights')->referencedEntities() as $node) {
      if ($node instanceof NodeInterface) {
        $node = $resolve_node($node);
        if ($node instanceof NodeInterface) {
          $variables['iu_insight_nodes'][] = $node;
        }
      }
    }
  }
  if ($paragraph->hasField('field_iu_news') && !$paragraph->get('field_iu_news')->isEmpty()) {
    foreach ($paragraph->get('field_iu_news')->referencedEntities() as $node) {
      if ($node instanceof NodeInterface) {
        $node = $resolve_node($node);
        if ($node instanceof NodeInterface) {
          $variables['iu_news_nodes'][] = $node;
        }
      }
    }
  }

  // Curated limits (no pager): enough for a single grid row + featured density.
  $variables['iu_insight_nodes'] = array_slice($variables['iu_insight_nodes'], 0, 6);
  $variables['iu_news_nodes'] = array_slice($variables['iu_news_nodes'], 0, 6);

  $collect_meta($variables['iu_insight_nodes']);
  $collect_meta($variables['iu_news_nodes']);

  $iu_excerpt = static function (NodeInterface $node): string {
    if (!$node->hasField('body') || $node->get('body')->isEmpty()) {
      return '';
    }
    $first = $node->get('body')->first();
    if (!$first) {
      return '';
    }
    $summary = trim((string) ($first->summary ?? ''));
    $value = (string) ($first->value ?? '');
    $plain = $summary !== '' ? strip_tags($summary) : strip_tags($value);
    $plain = preg_replace('/\s+/u', ' ', $plain) ?? $plain;
    $plain = trim($plain);
    return $plain !== '' ? \Drupal\Component\Utility\Unicode::truncate($plain, 140, TRUE, TRUE) : '';
  };

  $grid = [];
  foreach ($variables['iu_insight_nodes'] as $node) {
    if ($node instanceof NodeInterface) {
      $grid[] = [
        'node' => $node,
        'kind' => 'blog',
        'excerpt' => $iu_excerpt($node),
        'url' => $node->toUrl('canonical', ['language' => $node->language()])->toString(),
      ];
    }
  }
  foreach ($variables['iu_news_nodes'] as $node) {
    if ($node instanceof NodeInterface) {
      $grid[] = [
        'node' => $node,
        'kind' => 'news',
        'excerpt' => $iu_excerpt($node),
        'url' => $node->toUrl('canonical', ['language' => $node->language()])->toString(),
      ];
    }
  }
  usort($grid, static function (array $a, array $b): int {
    $na = $a['node'] ?? NULL;
    $nb = $b['node'] ?? NULL;
    if (!$na instanceof NodeInterface || !$nb instanceof NodeInterface) {
      return 0;
    }
    return $nb->getCreatedTime() <=> $na->getCreatedTime();
  });
  $variables['iu_grid_items'] = $grid;
  $variables['iu_has_blog'] = $variables['iu_insight_nodes'] !== [];
  $variables['iu_has_news'] = $variables['iu_news_nodes'] !== [];
}

/**
 * Implements hook_preprocess_paragraph__glance_block().
 */
function motaded_theme_preprocess_paragraph__glance_block(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/glance_block';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $variables['glance_eyebrow'] = '';
  if ($paragraph->hasField('field_glance_eyebrow') && $paragraph->get('field_glance_eyebrow')->access('view') && !$paragraph->get('field_glance_eyebrow')->isEmpty()) {
    $variables['glance_eyebrow'] = trim((string) $paragraph->get('field_glance_eyebrow')->value);
  }
  $variables['glance_title'] = '';
  if ($paragraph->hasField('field_glance_title') && $paragraph->get('field_glance_title')->access('view') && !$paragraph->get('field_glance_title')->isEmpty()) {
    $variables['glance_title'] = trim((string) $paragraph->get('field_glance_title')->value);
  }
  $variables['glance_title_accent'] = '';
  if ($paragraph->hasField('field_glance_title_accent') && $paragraph->get('field_glance_title_accent')->access('view') && !$paragraph->get('field_glance_title_accent')->isEmpty()) {
    $variables['glance_title_accent'] = trim((string) $paragraph->get('field_glance_title_accent')->value);
  }

  $icon_svg = static function (string $key) {
    // Keep SVGs tiny and consistent with site icons.
    $svg = match ($key) {
      'money' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7h16v10H4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M7 7V5h10v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg>',
      'users' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'pie' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2v10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M21.4 14a9.5 9.5 0 1 1-11.4-11.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'building' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 21h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M9 7h2M9 11h2M9 15h2M13 7h2M13 11h2M13 15h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'chart_up' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 16l6-6 4 4 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 8h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      'layers' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3 3.5 8.2 12 13.4 20.5 8.2 12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3.5 12.1 12 17.3 20.5 12.1" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'globe' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 3a14 14 0 0 1 0 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'leaf' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 4s-8 0-12 4-4 12-4 12 8 0 12-4 4-12 4-12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 16c2-2 6-6 12-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'handshake' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M8 12l2-2a3 3 0 0 1 4 0l2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 12l5-5 4 4-5 5H3v-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M21 12l-5-5-4 4 5 5h4v-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'target' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v3M22 12h-3M12 22v-3M2 12h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'flag' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 22V3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M5 4h10l-1.5 3L15 10H5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      default => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 14l4-4 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    };
    return \Drupal\Core\Render\Markup::create($svg);
  };

  $read_stat = static function (\Drupal\paragraphs\Entity\Paragraph $p) use ($icon_svg): array {
    $icon = $p->hasField('field_glance_icon') ? (string) ($p->get('field_glance_icon')->value ?: '') : '';
    $value = $p->hasField('field_glance_value') ? trim((string) ($p->get('field_glance_value')->value ?? '')) : '';
    $title = $p->hasField('field_glance_title') ? trim((string) ($p->get('field_glance_title')->value ?? '')) : '';
    $body = '';
    if ($p->hasField('field_glance_body') && !$p->get('field_glance_body')->isEmpty()) {
      $body = motaded_theme_glance_body_plain((string) $p->get('field_glance_body')->value);
    }
    $source = $p->hasField('field_glance_source') ? trim((string) ($p->get('field_glance_source')->value ?? '')) : '';
    return [
      'icon' => $icon,
      'icon_svg' => $icon_svg($icon),
      'value' => $value,
      'title' => $title,
      'body' => $body,
      'source' => $source,
      // Optional; used for highlight kicker.
      'kicker' => $title,
    ];
  };

  $variables['glance_highlight'] = [];
  if ($paragraph->hasField('field_glance_highlight') && $paragraph->get('field_glance_highlight')->access('view') && !$paragraph->get('field_glance_highlight')->isEmpty()) {
    $sub = motaded_theme_paragraph_from_context($paragraph->get('field_glance_highlight')->entity);
    if ($sub instanceof ParagraphInterface && $sub->bundle() === 'glance_stat_item') {
      $variables['glance_highlight'] = $read_stat($sub);
      // Highlight uses a separate kicker convention.
      $variables['glance_highlight']['kicker'] = $variables['glance_highlight']['title'];
    }
  }

  $variables['glance_stats'] = [];
  if ($paragraph->hasField('field_glance_stats') && $paragraph->get('field_glance_stats')->access('view') && !$paragraph->get('field_glance_stats')->isEmpty()) {
    foreach ($paragraph->get('field_glance_stats') as $item) {
      $sub = motaded_theme_paragraph_from_context($item->entity);
      if ($sub instanceof ParagraphInterface && $sub->bundle() === 'glance_stat_item') {
        $variables['glance_stats'][] = $read_stat($sub);
      }
    }
  }

  $variables['glance_features'] = [];
  if ($paragraph->hasField('field_glance_features') && $paragraph->get('field_glance_features')->access('view') && !$paragraph->get('field_glance_features')->isEmpty()) {
    foreach ($paragraph->get('field_glance_features') as $item) {
      $sub = motaded_theme_paragraph_from_context($item->entity);
      if (!$sub instanceof ParagraphInterface || $sub->bundle() !== 'why_feature_card') {
        continue;
      }
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body = '';
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body = motaded_theme_glance_body_plain((string) $sub->get('field_body')->value);
      }
      $link_url = '';
      $link_title = '';
      if ($sub->hasField('field_link') && $sub->get('field_link')->access('view') && !$sub->get('field_link')->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $li */
        $li = $sub->get('field_link')->first();
        if ($li && $li->getUrl()) {
          $link_url = $li->getUrl()->toString();
          $link_title = (string) ($li->getTitle() ?: '');
        }
      }
      $variables['glance_features'][] = [
        'title' => $title,
        'body' => $body ? strip_tags($body) : '',
        'link_url' => $link_url,
        'link_title' => $link_title,
      ];
    }
  }

  try {
    $variables['market_indicators'] = _motaded_theme_glance_market_indicators_variables();
  }
  catch (\Throwable $e) {
    $variables['market_indicators'] = [
      'show' => FALSE,
      'rows' => [],
      'chart_year_min' => 0,
      'chart_year_max' => 0,
      'chart_svg' => NULL,
      'chart_source_label' => _motaded_theme_market_indicator_public_source(),
      'more_url' => '',
    ];
  }
  $variables['#cache']['tags'][] = 'market_indicators';
}

/**
 * Implements hook_preprocess_paragraph__gateway_block().
 */
function motaded_theme_preprocess_paragraph__gateway_block(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/gateway_block';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = motaded_theme_paragraph_from_context($variables['paragraph']);
  $variables['paragraph'] = $paragraph;

  $variables['gateway_eyebrow'] = '';
  if ($paragraph->hasField('field_gateway_eyebrow') && $paragraph->get('field_gateway_eyebrow')->access('view') && !$paragraph->get('field_gateway_eyebrow')->isEmpty()) {
    $variables['gateway_eyebrow'] = trim((string) $paragraph->get('field_gateway_eyebrow')->value);
  }
  $variables['gateway_title'] = '';
  if ($paragraph->hasField('field_title') && $paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['gateway_title'] = trim((string) $paragraph->get('field_title')->value);
  }

  $icon_svg = static function (string $key) {
    $svg = match ($key) {
      'platforms' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v10H4z" stroke="currentColor" stroke-width="1.6"/><path d="M8 19h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 15v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'sectors' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M10 6V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 9h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'events' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M7 3v3M17 3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 6h16v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 10h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'insights' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 19V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 19h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 15v-5M12 15V7m4 8v-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'services' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 3l7 3v5c0 4-2.5 7.5-7 8.5-4.5-1-7-4.5-7-8.5V6l7-3z" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"/><path d="M9 12h6M12 9v6" stroke="currentColor" stroke-width="1.55" stroke-linecap="round"/></svg>',
      default => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 14l4-4 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    };
    return \Drupal\Core\Render\Markup::create($svg);
  };

  $variables['gateway_items'] = [];
  if ($paragraph->hasField('field_gateway_items') && $paragraph->get('field_gateway_items')->access('view') && !$paragraph->get('field_gateway_items')->isEmpty()) {
    foreach ($paragraph->get('field_gateway_items') as $ref) {
      $sub = motaded_theme_paragraph_from_context($ref->entity);
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'gateway_item') {
        continue;
      }
      $icon_key = (string) ($sub->get('field_gateway_icon')->value ?? '');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body_html = '';
      $body_has_list = FALSE;
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $raw_body = (string) $sub->get('field_body')->value;
        $format_id = (string) ($sub->get('field_body')->format ?: 'plain_text');
        if ($raw_body !== '') {
          $format_id = motaded_theme_resolved_text_format($format_id, $raw_body);
          $body_html = check_markup($raw_body, $format_id);
          $body_has_list = (bool) preg_match('/<\s*(ul|ol)\b/i', $raw_body);
        }
      }
      $link_url = '';
      $link_title = '';
      if ($sub->hasField('field_link') && $sub->get('field_link')->access('view') && !$sub->get('field_link')->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $li */
        $li = $sub->get('field_link')->first();
        if ($li && $li->getUrl()) {
          $link_url = $li->getUrl()->toString();
          $link_title = (string) ($li->getTitle() ?: '');
        }
      }
      $variables['gateway_items'][] = [
        'icon' => $icon_key,
        'icon_svg' => $icon_svg($icon_key),
        'title' => $title,
        'body_html' => $body_html !== '' ? Markup::create($body_html) : '',
        'body_has_list' => $body_has_list,
        'link_url' => $link_url,
        'link_title' => $link_title,
      ];
    }
  }

  $variables['gateway_footer_title'] = '';
  if ($paragraph->hasField('field_gateway_footer_title') && $paragraph->get('field_gateway_footer_title')->access('view') && !$paragraph->get('field_gateway_footer_title')->isEmpty()) {
    $variables['gateway_footer_title'] = trim((string) $paragraph->get('field_gateway_footer_title')->value);
  }
  $variables['gateway_footer_body_html'] = '';
  if ($paragraph->hasField('field_gateway_footer_body') && $paragraph->get('field_gateway_footer_body')->access('view') && !$paragraph->get('field_gateway_footer_body')->isEmpty()) {
    $fb_raw = (string) $paragraph->get('field_gateway_footer_body')->value;
    $fb_fmt = (string) ($paragraph->get('field_gateway_footer_body')->format ?: 'plain_text');
    if (trim(strip_tags($fb_raw)) !== '') {
      $fb_fmt = motaded_theme_resolved_text_format($fb_fmt, $fb_raw);
      $variables['gateway_footer_body_html'] = Markup::create(check_markup($fb_raw, $fb_fmt));
    }
  }

  $mk = static fn (string $svg) => Markup::create($svg);
  $variables['gateway_footer_pillars'] = [
    [
      'icon' => $mk('<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v4M12 17v4M4 12h4M16 12h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>'),
      'title' => (string) t('Expert guidance'),
      'text' => (string) t('Regulatory and practical answers when you need them.'),
    ],
    [
      'icon' => $mk('<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 19V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 17V7M12 17v-6M16 17v-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'),
      'title' => (string) t('Data-led clarity'),
      'text' => (string) t('Reliable figures and transparent processes.'),
    ],
    [
      'icon' => $mk('<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18" stroke="currentColor" stroke-width="1.6"/></svg>'),
      'title' => (string) t('Sector context'),
      'text' => (string) t('See how opportunities connect across industries.'),
    ],
  ];
  $variables['gateway_footer_link_url'] = '';
  $variables['gateway_footer_link_title'] = '';
  if ($paragraph->hasField('field_gateway_footer_link') && $paragraph->get('field_gateway_footer_link')->access('view') && !$paragraph->get('field_gateway_footer_link')->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $li */
    $li = $paragraph->get('field_gateway_footer_link')->first();
    if ($li && $li->getUrl()) {
      $variables['gateway_footer_link_url'] = $li->getUrl()->toString();
      $variables['gateway_footer_link_title'] = (string) ($li->getTitle() ?: '');
    }
  }
}

/**
 * Implements hook_preprocess_paragraph__gateway_hub_block().
 */
function motaded_theme_preprocess_paragraph__gateway_hub_block(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/gateway_hub_block';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $variables['hub_eyebrow'] = '';
  if ($paragraph->hasField('field_gateway_eyebrow') && $paragraph->get('field_gateway_eyebrow')->access('view') && !$paragraph->get('field_gateway_eyebrow')->isEmpty()) {
    $variables['hub_eyebrow'] = trim((string) $paragraph->get('field_gateway_eyebrow')->value);
  }
  $variables['hub_title'] = '';
  if ($paragraph->hasField('field_title') && $paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['hub_title'] = trim((string) $paragraph->get('field_title')->value);
  }

  $mk_svg = static fn (string $svg) => \Drupal\Core\Render\Markup::create($svg);
  $variables['hub_icons'] = [
    'platforms' => $mk_svg('<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v10H4z" stroke="currentColor" stroke-width="1.6"/><path d="M8 19h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 15v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'),
    'sectors' => $mk_svg('<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M10 6V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 9h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>'),
    'events' => $mk_svg('<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M7 3v3M17 3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 6h16v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 10h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'),
    'insights' => $mk_svg('<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 19V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 19h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 15v-5M12 15V7m4 8v-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'),
  ];

  $variables['hub_platforms'] = [];
  if ($paragraph->hasField('field_gateway_platforms') && $paragraph->get('field_gateway_platforms')->access('view') && !$paragraph->get('field_gateway_platforms')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $platforms */
    $platforms = $paragraph->get('field_gateway_platforms');
    foreach ($platforms->referencedEntities() as $node) {
      if ($node instanceof \Drupal\node\NodeInterface) {
        $variables['hub_platforms'][] = [
          'title' => $node->label(),
          'meta' => '',
          'url' => $node->toUrl()->toString(),
        ];
      }
    }
  }

  $variables['hub_sectors'] = [];
  if ($paragraph->hasField('field_gateway_sectors') && $paragraph->get('field_gateway_sectors')->access('view') && !$paragraph->get('field_gateway_sectors')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $sectors */
    $sectors = $paragraph->get('field_gateway_sectors');
    foreach ($sectors->referencedEntities() as $term) {
      if ($term instanceof \Drupal\taxonomy\TermInterface) {
        $variables['hub_sectors'][] = [
          'title' => $term->label(),
          'url' => $term->toUrl()->toString(),
        ];
      }
    }
  }

  $variables['hub_events'] = [];
  if ($paragraph->hasField('field_gateway_events') && $paragraph->get('field_gateway_events')->access('view') && !$paragraph->get('field_gateway_events')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $events */
    $events = $paragraph->get('field_gateway_events');
    foreach ($events->referencedEntities() as $node) {
      if ($node instanceof \Drupal\node\NodeInterface) {
        $variables['hub_events'][] = [
          'title' => $node->label(),
          'meta' => '',
          'url' => $node->toUrl()->toString(),
        ];
      }
    }
  }

  $variables['hub_insights'] = [];
  if ($paragraph->hasField('field_gateway_insights') && $paragraph->get('field_gateway_insights')->access('view') && !$paragraph->get('field_gateway_insights')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $insights */
    $insights = $paragraph->get('field_gateway_insights');
    foreach ($insights->referencedEntities() as $node) {
      if ($node instanceof \Drupal\node\NodeInterface) {
        $variables['hub_insights'][] = [
          'title' => $node->label(),
          'meta' => '',
          'url' => $node->toUrl()->toString(),
        ];
      }
    }
  }

  // Support badges (small highlight items in the footer strip).
  $variables['hub_support_badges'] = [];
  if ($paragraph->hasField('field_gateway_support_items') && $paragraph->get('field_gateway_support_items')->access('view') && !$paragraph->get('field_gateway_support_items')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $support_items */
    $support_items = $paragraph->get('field_gateway_support_items');
    foreach ($support_items->referencedEntities() as $item) {
      if ($item instanceof \Drupal\paragraphs\ParagraphInterface) {
        $title = '';
        $body = '';
        if ($item->hasField('field_title') && !$item->get('field_title')->isEmpty()) {
          $title = trim((string) $item->get('field_title')->value);
        }
        if ($item->hasField('field_body') && !$item->get('field_body')->isEmpty()) {
          $body = trim((string) $item->get('field_body')->value);
        }
        if ($title !== '' || $body !== '') {
          $variables['hub_support_badges'][] = [
            'title' => $title,
            'body' => $body,
          ];
        }
      }
    }
  }
  if ($variables['hub_support_badges'] === []) {
    $variables['hub_support_badges'] = [
      [
        'title' => (string) t('Expert guidance'),
        'body' => (string) t('Local specialists with deep market knowledge.'),
      ],
      [
        'title' => (string) t('End-to-end support'),
        'body' => (string) t('From setup to growth, we are with you.'),
      ],
      [
        'title' => (string) t('Reliable & official'),
        'body' => (string) t('Accurate, up-to-date information you can trust.'),
      ],
    ];
  }
}

/**
 * Implements hook_preprocess_paragraph__key_sectors().
 *
 * Homepage “Key sectors” band: headings, sidebar, embedded View, footer CTA.
 */
function motaded_theme_preprocess_paragraph__key_sectors(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/key_sectors';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = motaded_theme_paragraph_from_context($variables['paragraph']);
  $variables['paragraph'] = $paragraph;
  $get_plain = static function (\Drupal\paragraphs\Entity\Paragraph $p, string $field): string {
    return $p->hasField($field) && !$p->get($field)->isEmpty()
      ? trim((string) $p->get($field)->value) : '';
  };
  $variables['ksb_eyebrow'] = $get_plain($paragraph, 'field_ksb_eyebrow');
  $variables['ksb_heading'] = '';
  if ($paragraph->hasField('field_title') && $paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['ksb_heading'] = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['ksb_sidebar_title'] = $get_plain($paragraph, 'field_ksb_sidebar_title');
  $sk = '';
  if ($paragraph->hasField('field_ksb_sidebar_icon') && !$paragraph->get('field_ksb_sidebar_icon')->isEmpty()) {
    $sk = (string) $paragraph->get('field_ksb_sidebar_icon')->value;
  }
  $variables['ksb_sidebar_icon_markup'] = motaded_theme_glance_icon_markup($sk !== '' ? $sk : 'chart_up');
  $variables['ksb_footer_title'] = $get_plain($paragraph, 'field_ksb_footer_title');
  $variables['ksb_intro'] = $paragraph->get('field_body')->access('view')
    ? motaded_theme_render_formatted_text_field($paragraph, 'field_body')
    : [];
  $variables['ksb_sidebar_body'] = $paragraph->hasField('field_ksb_sidebar_body') && $paragraph->get('field_ksb_sidebar_body')->access('view')
    ? motaded_theme_render_formatted_text_field($paragraph, 'field_ksb_sidebar_body')
    : [];
  $variables['ksb_footer_body'] = $paragraph->hasField('field_ksb_footer_body') && $paragraph->get('field_ksb_footer_body')->access('view')
    ? motaded_theme_render_formatted_text_field($paragraph, 'field_ksb_footer_body')
    : [];
  $variables['ksb_cta_url'] = '';
  $variables['ksb_cta_label'] = (string) t('View all sectors');
  if ($paragraph->hasField('field_link') && !$paragraph->get('field_link')->isEmpty() && $paragraph->get('field_link')->access('view')) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $li */
    $li = $paragraph->get('field_link')->first();
    if ($li && method_exists($li, 'getUrl')) {
      $url = $li->getUrl();
      if ($url) {
        $variables['ksb_cta_url'] = $url->toString();
      }
      $lt = trim((string) ($li->getTitle() ?: ''));
      if ($lt !== '') {
        $variables['ksb_cta_label'] = $lt;
      }
    }
  }

}

/**
 * Implements hook_preprocess_paragraph__platforms_systems().
 */
function motaded_theme_preprocess_paragraph__platforms_systems(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/platforms_systems';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $mk_svg = static fn (string $svg) => \Drupal\Core\Render\Markup::create($svg);
  $icon_for = static function (string $key) use ($mk_svg) {
    $svg = match ($key) {
      'licensing' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 3h8l4 4v14H6V3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v5h5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 12h8M8 16h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'workforce' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M22 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'tax' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4V5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 9h8M8 13h8M8 17h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'operations' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 21h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M5 21V7l7-4 7 4v14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 21v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'compliance' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 9.4-8 10-4.5-.6-8-5-8-10V6l8-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      default => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 14l4-4 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    };
    return $mk_svg($svg);
  };

  $variables['ps_groups'] = [];
  if ($paragraph->hasField('field_ps_groups') && $paragraph->get('field_ps_groups')->access('view') && !$paragraph->get('field_ps_groups')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $groups */
    $groups = $paragraph->get('field_ps_groups');
    foreach ($groups->referencedEntities() as $group) {
      if (!$group instanceof \Drupal\paragraphs\ParagraphInterface) {
        continue;
      }

      $title = $group->hasField('field_title') && !$group->get('field_title')->isEmpty()
        ? trim((string) $group->get('field_title')->value)
        : '';

      $body = $group->hasField('field_psg_body') && !$group->get('field_psg_body')->isEmpty()
        ? trim((string) $group->get('field_psg_body')->value)
        : '';

      $icon_key = $group->hasField('field_psg_icon') && !$group->get('field_psg_icon')->isEmpty()
        ? (string) $group->get('field_psg_icon')->value
        : '';

      $items = [];
      if ($group->hasField('field_psg_items') && !$group->get('field_psg_items')->isEmpty()) {
        /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $refs */
        $refs = $group->get('field_psg_items');
        foreach ($refs->referencedEntities() as $node) {
          if ($node instanceof \Drupal\node\NodeInterface) {
            $logo = [
              'src' => '',
              'srcset' => '',
              'width' => 0,
              'height' => 0,
              'alt' => '',
            ];
            if ($node->hasField('field_logo') && !$node->get('field_logo')->isEmpty()) {
              $media = $node->get('field_logo')->entity;
              $fallback_alt = (string) t('@name logo', ['@name' => $node->label()]);
              $extracted = motaded_theme_media_image_uri_and_alt($media, $fallback_alt);
              $meta = motaded_theme_platform_logo_image_metadata($extracted['uri']);
              $logo = [
                'src' => $meta['src'],
                'srcset' => $meta['srcset'],
                'width' => $meta['width'],
                'height' => $meta['height'],
                'alt' => $extracted['alt'],
              ];
            }
            $items[] = [
              'title' => $node->label(),
              'url' => $node->toUrl()->toString(),
              'logo' => $logo,
            ];
          }
        }
      }

      $view_all_url = '';
      $view_all_title = '';
      if ($group->hasField('field_psg_view_all') && !$group->get('field_psg_view_all')->isEmpty()) {
        $link_item = $group->get('field_psg_view_all')->first();
        $uri = $link_item && !$link_item->isEmpty() ? $link_item->get('uri')->getString() : '';
        if ($uri !== '') {
          try {
            $view_all_url = \Drupal\Core\Url::fromUri($uri)->toString();
          }
          catch (\Throwable $e) {
            $view_all_url = $uri;
          }
        }
        $view_all_title = $link_item ? trim((string) $link_item->get('title')->getString()) : '';
      }

      $variables['ps_groups'][] = [
        'title' => $title,
        'body' => $body,
        'icon' => $icon_for($icon_key),
        'items' => $items,
        'view_all_url' => $view_all_url,
        'view_all_title' => $view_all_title,
      ];
    }
  }
}

/**
 * Implements hook_preprocess_paragraph__chambers_network().
 */
function motaded_theme_preprocess_paragraph__chambers_network(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/chambers_network';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $nid_args = '';
  $parts = [];
  if ($paragraph->hasField('field_cnb_chambers')
    && $paragraph->get('field_cnb_chambers')->access('view')
    && !$paragraph->get('field_cnb_chambers')->isEmpty()) {
    foreach ($paragraph->get('field_cnb_chambers')->referencedEntities() as $entity) {
      if (!$entity instanceof NodeInterface || $entity->bundle() !== 'chamber' || !$entity->access('view')) {
        continue;
      }
      $parts[] = (string) ((int) $entity->id());
      if (count($parts) >= 9) {
        break;
      }
    }
  }
  if ($parts !== []) {
    $nid_args = implode('+', $parts);
  }

  $build = [];
  try {
    if ($nid_args !== '') {
      $build = views_embed_view('chambers', 'homepage', $nid_args);
    }
    else {
      $build = views_embed_view('chambers', 'homepage');
    }
  }
  catch (\Throwable $e) {
    $build = [];
  }
  $variables['cnb_chambers_view'] = is_array($build) ? $build : [];
}

/**
 * Preprocess for News View block (unformatted).
 */
function motaded_theme_preprocess_views_view_unformatted__news__block_4(&$variables) {
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  foreach ($variables['rows'] as &$row) {
    $entity = $row['content']['#row']->_entity ?? NULL;
    $img_meta = [
      'src' => '',
      'srcset' => '',
      'width' => 151,
      'height' => 120,
    ];
    $img_alt = '';

    if ($entity) {
      if ($entity->hasTranslation($langcode)) {
        $entity = $entity->getTranslation($langcode);
      }

      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
      $img_meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
      $img_alt = $extracted['alt'];

      $row['title'] = $entity->label();
      $row['url'] = $entity->toUrl()->toString();
      $created_ts = (int) $entity->getCreatedTime();
      $row['created'] = $created_ts
        ? \Drupal::service('date.formatter')->format($created_ts, 'custom', 'F j, Y')
        : '';
      $row['created_iso'] = $created_ts ? gmdate('c', $created_ts) : '';
    }
    else {
      $row['title'] = '';
      $row['url'] = '';
      $row['created'] = '';
      $row['created_iso'] = '';
    }

    $row['image']['alt'] = $img_alt;
    $row['image']['src'] = $img_meta['src'];
    $row['image']['srcset'] = $img_meta['srcset'];
    $row['image']['width'] = $img_meta['width'];
    $row['image']['height'] = $img_meta['height'];
    // Back-compat for any code using a single URL.
    $row['image']['url'] = $img_meta['src'];
  }
}
/**
 * Preprocess for News View block (unformatted).
 */
function motaded_theme_preprocess_views_view_unformatted__partners__block_2(&$variables) {
  $variables['#attached']['library'][] = 'motaded_theme/partner_carousel';
  $variables['partner_items'] = [];

  foreach ($variables['view']->result as $result_row) {
    $entity = $result_row->_entity ?? NULL;
    if (!$entity) {
      continue;
    }

    $partner_name = $entity->label();
    if ($entity->hasField('field_partner_name') && !$entity->get('field_partner_name')->isEmpty()) {
      $partner_name = trim((string) $entity->get('field_partner_name')->value) ?: $partner_name;
    }

    $role = '';
    if ($entity->hasField('field_one_line_role') && !$entity->get('field_one_line_role')->isEmpty()) {
      $role = trim((string) $entity->get('field_one_line_role')->value);
    }

    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $partner_name);
    $img_meta = motaded_theme_partner_logo_image_metadata($extracted['uri']);
    $img_alt = trim($extracted['alt']);
    if ($img_alt === '') {
      $img_alt = (string) t('@name logo', ['@name' => $partner_name]);
    }

    $variables['partner_items'][] = [
      'name' => $partner_name,
      'role' => $role,
      'alt' => $img_alt,
      'src' => $img_meta['src'],
      'srcset' => $img_meta['srcset'],
      'width' => $img_meta['width'],
      'height' => $img_meta['height'],
    ];
  }
}

/**
 * Preprocess for Related Similar view fields displays.
 */
function motaded_theme_preprocess_views_view_fields__related_similar(array &$variables): void {
  $entity = $variables['row']->_entity ?? NULL;
  $card_data = motaded_theme_build_views_node_card_data($entity);
  $variables['card_type_label'] = $card_data['card_type_label'];
  $variables['card_bundle'] = $card_data['card_bundle'];
  $variables['card_image'] = $card_data['card_image'];
}

/**
 * Preprocess for News view cards in related displays.
 */
function motaded_theme_preprocess_views_view_fields__news(array &$variables): void {
  $display_id = $variables['view']->current_display ?? '';
  if (!in_array($display_id, ['block_2', 'block_3', 'block_6'], TRUE)) {
    return;
  }
  $entity = $variables['row']->_entity ?? NULL;
  $card_data = motaded_theme_build_views_node_card_data($entity);
  $variables['card_type_label'] = $card_data['card_type_label'];
  $variables['card_bundle'] = $card_data['card_bundle'];
  $variables['card_image'] = $card_data['card_image'];
}

/**
 * Responsive teaser image metadata for news Views row templates (blog + news).
 */
function motaded_theme_preprocess_views_view_fields_news_listing_card_image(array &$variables): void {
  $site_name = (string) \Drupal::config('system.site')->get('name');
  $img_meta = [
    'src' => '',
    'srcset' => '',
    'width' => 325,
    'height' => 200,
    'alt' => $site_name,
  ];

  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity instanceof NodeInterface) {
    $variables['card_image'] = $img_meta;
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  if ($entity->hasTranslation($langcode)) {
    $entity = $entity->getTranslation($langcode);
  }

  $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
  $meta = motaded_theme_blog_listing_card_image_metadata($extracted['uri']);
  $img_meta['src'] = $meta['src'];
  $img_meta['srcset'] = $meta['srcset'];
  $img_meta['width'] = $meta['width'];
  $img_meta['height'] = $meta['height'];
  $img_meta['alt'] = $extracted['alt'] !== '' ? $extracted['alt'] : $entity->label();

  if ($img_meta['src'] === '') {
    $logo_uri = theme_get_setting('logo.url');
    if (is_string($logo_uri) && $logo_uri !== '') {
      $img_meta['src'] = \Drupal::service('file_url_generator')->generateString($logo_uri);
      $img_meta['srcset'] = '';
    }
  }

  $variables['card_image'] = $img_meta;
}

/**
 * Blog listing (/blog): responsive image metadata for article cards.
 */
function motaded_theme_preprocess_views_view_fields__news__page_1(array &$variables): void {
  motaded_theme_preprocess_views_view_fields_news_listing_card_image($variables);
}

/**
 * News listing (/news): responsive image metadata for news cards.
 */
function motaded_theme_preprocess_views_view_fields__news__page_2(array &$variables): void {
  motaded_theme_preprocess_views_view_fields_news_listing_card_image($variables);
}

/**
 * Shared card data builder for Views rows with Node entities.
 *
 * @param mixed $entity
 *   Row entity from Views result.
 *
 * @return array{card_type_label: string, card_bundle: string, card_image: array{src: string, srcset: string, width: int, height: int, alt: string}}
 *   Normalized card metadata for Twig templates.
 */
function motaded_theme_build_views_node_card_data($entity): array {
  $card_type_label = '';
  $card_bundle = '';
  $site_name = (string) \Drupal::config('system.site')->get('name');
  $img_meta = [
    'src' => '',
    'srcset' => '',
    'width' => 151,
    'height' => 120,
    'alt' => $site_name,
  ];

  if ($entity instanceof NodeInterface) {
    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    if ($entity->hasTranslation($langcode)) {
      $entity = $entity->getTranslation($langcode);
    }

    $bundle = $entity->bundle();
    $card_bundle = $bundle;
    $node_type = NodeType::load($bundle);
    $type_label = $node_type !== NULL ? (string) $node_type->label() : $bundle;
    $card_type_map_by_bundle = [
      'page' => (string) t('Service'),
      'article' => (string) t('Blog'),
      'news' => (string) t('News'),
    ];
    $card_type_label = $card_type_map_by_bundle[$bundle] ?? $type_label;

    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
    $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $img_meta['src'] = $meta['src'];
    $img_meta['srcset'] = $meta['srcset'];
    $img_meta['width'] = $meta['width'];
    $img_meta['height'] = $meta['height'];
    $img_meta['alt'] = $extracted['alt'] !== '' ? $extracted['alt'] : $entity->label();
  }

  if ($img_meta['src'] === '') {
    $logo_uri = theme_get_setting('logo.url');
    if (is_string($logo_uri) && $logo_uri !== '') {
      $img_meta['src'] = \Drupal::service('file_url_generator')->generateString($logo_uri);
      $img_meta['srcset'] = '';
    }
  }

  return [
    'card_type_label' => $card_type_label,
    'card_bundle' => $card_bundle,
    'card_image' => $img_meta,
  ];
}

/**
 * Implements hook__preprocess_HOOK().
 */
function motaded_theme_preprocess_breadcrumb(&$variables) {
  $route_name = (string) (\Drupal::routeMatch()->getRouteName() ?? '');
  if ($route_name === 'view.insights.page_1') {
    foreach ($variables['breadcrumb'] as &$crumb) {
      if (!is_array($crumb)) {
        continue;
      }
      $text = trim((string) ($crumb['text'] ?? ''));
      if ($text === 'Insights' || $text === 'Market insights') {
        $crumb['text'] = (string) t('Market insights');
      }
    }
    unset($crumb);
  }

  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    $prefix = getLanguagePrefix();
    $prefix = str_ends_with($prefix, "/") ? $prefix : $prefix . "/";
    
    if (isset($variables['breadcrumb'][1]) && in_array($variables['breadcrumb'][1]['url'], ['/node', '/ar/node', '/beta/node', '/beta/ar/node'])) {
      array_splice($variables['breadcrumb'], 1, 1);
    }

    if ($node->bundle() == "article") {
      $blog_url = $prefix . "blog";
      if (
        isset($variables['breadcrumb'][1]) &&
        motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'blog')
      ) {
        // Normalize the section label even when contributed by Views.
        $variables['breadcrumb'][1]['text'] = (string) t('Blog');
      }
      else {
        $list_crumb = [
          'text' => (string) t('Blog'),
          'url' => $blog_url,
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    } elseif ($node->bundle() == "page") {
      if (
        !isset($variables['breadcrumb'][1]) ||
        !motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'services')
      ) {
        $list_crumb = [
          'text' => t('Services'),
          'url' => $prefix . "services",
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    } elseif ($node instanceof NodeInterface && $node->bundle() === 'sector_page') {
      if (
        !isset($variables['breadcrumb'][1]) ||
        !motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'sectors')
      ) {
        $list_crumb = [
          'text' => (string) t('Sectors'),
          'url' => $prefix . 'sectors',
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    }
    elseif ($node->bundle() === 'market_insight') {
      foreach ($variables['breadcrumb'] as &$crumb) {
        if (!is_array($crumb)) {
          continue;
        }
        $text = trim((string) ($crumb['text'] ?? ''));
        if ($text === 'Insights' || $text === 'Market insights') {
          $crumb['text'] = (string) t('Market insights');
        }
      }
      unset($crumb);
      if (
        !isset($variables['breadcrumb'][1]) ||
        !motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'insights')
      ) {
        $list_crumb = [
          'text' => (string) t('Market insights'),
          'url' => $prefix . 'insights',
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    }
  }
}

/**
 * Checks whether breadcrumb URL already points to a section root.
 */
function motaded_theme_breadcrumb_url_matches_section($url, string $section): bool {
  if (!is_string($url) || $url === '') {
    return FALSE;
  }

  $path = parse_url($url, PHP_URL_PATH);
  if (!is_string($path) || $path === '') {
    return FALSE;
  }

  $normalized = '/' . trim($path, '/');
  return (bool) preg_match(
    '#^/(?:beta/)?(?:[a-z]{2}/)?' . preg_quote($section, '#') . '$#i',
    $normalized
  );
}

/**
 * Helper function to get language prefix.
 */
function getLanguagePrefix() {
  if($prefixes = \Drupal::config('language.negotiation')->get('url.prefixes')) {
    $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
    return "/". $prefixes[$language];
  }
  return null;
}

/**
 * TRUE when the current request carries a non-empty exposed value for this filter key.
 *
 * Used to set <details open> only on panels that have an active selection so AJAX
 * rebuilds do not always re-open the wrong accordion while the user works in another.
 */
function _motaded_theme_services_exposed_filter_query_is_active(string $form_key): bool {
  $q = \Drupal::request()->query;
  if (!$q->has($form_key)) {
    return FALSE;
  }
  $v = $q->get($form_key);
  if ($v === NULL || $v === '') {
    return FALSE;
  }
  if (is_array($v)) {
    foreach ($v as $sub_key => $sub_val) {
      if ((string) $sub_key === 'All' && (string) $sub_val === 'All') {
        continue;
      }
      if ($sub_val !== NULL && $sub_val !== '' && strcasecmp((string) $sub_val, 'All') !== 0) {
        return TRUE;
      }
    }
    return FALSE;
  }
  return strcasecmp((string) $v, 'All') !== 0;
}

/**
 * Implements hook_preprocess_views_exposed_form().
 *
 * Services page_1: groups exposed filters into a sidebar container (accordion
 * markup) and a toolbar container while keeping everything inside one form so
 * Better Exposed Filters autosubmit works without custom JS.
 */
function motaded_theme_preprocess_views_exposed_form(&$variables) {
  $form = &$variables['form'];
  $form_id = (string) ($form['#id'] ?? '');

  if ($form_id === 'views-exposed-form-sectors-directory-page-1') {
    $toolbar_children = [];
    foreach (Element::children($form) as $key) {
      $toolbar_children[$key] = $form[$key];
      unset($form[$key]);
    }
    if ($toolbar_children !== []) {
      $is_arabic = \Drupal::languageManager()
        ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
        ->getId() === 'ar';
      $filters_aria = $is_arabic ? 'تصفية القطاعات' : (string) t('Filter sectors');
      $form['sectors_exposed_toolbar'] = [
        '#type' => 'container',
        '#weight' => -50,
        '#attributes' => [
          'class' => [
            'services-directory__toolbar',
            'services-exposed-top',
            'services-directory__toolbar-inner',
            'sectors-directory__toolbar',
          ],
          'id' => 'sectors-directory-filters',
          'role' => 'group',
          'aria-label' => $filters_aria,
        ],
      ];
      foreach ($toolbar_children as $k => $child) {
        $form['sectors_exposed_toolbar'][$k] = $child;
      }
    }
    return;
  }

  if ($form_id !== 'views-exposed-form-services-page-1') {
    return;
  }

  $is_arabic = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId() === 'ar';
  $filters_aria = $is_arabic ? 'تصفية الخدمات' : (string) t('Filter services');

  $sidebar_keys_ordered = [
    'field_taxonomy_target_id',
    'field_beneficiaries_target_id',
    'field_sector_target_id',
    'field_tags_target_id',
  ];
  $summaries = [
    'field_taxonomy_target_id' => (string) t('Categories'),
    'field_sector_target_id' => (string) t('Sector'),
    'field_beneficiaries_target_id' => (string) t('Beneficiaries'),
    'field_tags_target_id' => (string) t('Tags'),
  ];

  $sidebar_children = [];
  foreach ($sidebar_keys_ordered as $key) {
    if (empty($form[$key]) || !is_array($form[$key])) {
      continue;
    }
    motaded_theme_services_exposed_filter_suppress_wrapped_titles($form[$key]);
    $open_attr = _motaded_theme_services_exposed_filter_query_is_active($key) ? ' open' : '';
    $summary_html = Html::escape($summaries[$key] ?? '');
    $form[$key]['#prefix'] = '<details class="services-filter-panel"' . $open_attr . '><summary class="services-filter-panel__summary">' . $summary_html . '</summary><div class="services-filter-panel__body">' . ($form[$key]['#prefix'] ?? '');
    $form[$key]['#suffix'] = ($form[$key]['#suffix'] ?? '') . '</div></details>';
    $sidebar_children[$key] = $form[$key];
    unset($form[$key]);
  }

  $toolbar_keys = ['search', 'combine', 'sort_by', 'sort_order', 'sort_bef_combine'];
  $toolbar_children = [];
  foreach ($toolbar_keys as $tk) {
    if (isset($form[$tk]) && is_array($form[$tk])) {
      $toolbar_children[$tk] = $form[$tk];
      unset($form[$tk]);
    }
  }
  if (isset($form['actions']) && is_array($form['actions'])) {
    $toolbar_children['actions'] = $form['actions'];
    unset($form['actions']);
  }

  if ($sidebar_children === [] && $toolbar_children === []) {
    return;
  }

  if ($sidebar_children !== []) {
    $form['services_sidebar_stack'] = [
      '#type' => 'container',
      '#weight' => -100,
      '#attributes' => [
        'class' => ['services-filters-sidebar', 'services-filters-sidebar--accordion'],
        'id' => 'services-directory-filters',
        'role' => 'group',
        'aria-label' => $filters_aria,
      ],
    ];
    foreach ($sidebar_children as $k => $child) {
      $form['services_sidebar_stack'][$k] = $child;
    }

    $contact_url = '/contact-us';
    try {
      $contact_url = Url::fromUserInput('/contact-us')->toString();
    }
    catch (\Exception $e) {
      // Intentionally keep $contact_url fallback.
    }
    $contact_url_safe = Html::escape($contact_url);
    $cta_icon = '<svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3a7 7 0 0 0-7 7v3H4a2 2 0 0 0-2 2v4h18v-4a2 2 0 0 0-2-2h-1v-3a7 7 0 0 0-7-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M9 18v1a3 3 0 0 0 6 0v-1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>';
    $cta_markup = '<div class="services-sidebar-cta">'
      . '<div class="services-sidebar-cta__icon" aria-hidden="true">' . $cta_icon . '</div>'
      . '<p class="services-sidebar-cta__text">' . Html::escape((string) t('Need guidance? Speak with our experts about the right services for your setup.')) . '</p>'
      . '<a href="' . $contact_url_safe . '" class="services-sidebar-cta__link">'
      . Html::escape((string) t('Contact an expert')) . '<span aria-hidden="true"> →</span></a></div>';

    $form['services_sidebar_stack']['services_sidebar_cta'] = [
      '#type' => 'markup',
      '#markup' => Markup::create($cta_markup),
      '#weight' => 100,
    ];
  }

  if ($toolbar_children !== []) {
    $form['services_exposed_toolbar'] = [
      '#type' => 'container',
      '#weight' => -50,
      '#attributes' => [
        'class' => [
          'services-directory__toolbar',
          'services-exposed-top',
          'services-directory__toolbar-inner',
        ],
      ],
    ];
    foreach ($toolbar_children as $k => $child) {
      $form['services_exposed_toolbar'][$k] = $child;
    }
  }
}

/**
 * Published counts for the Services directory hero (matches view filters).
 *
 * @return array{services: int, platforms: int, sectors: int, service_types: int}
 */
function _motaded_theme_services_directory_hero_stats(string $langcode): array {
  $nids = \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'page')
    ->condition('status', 1)
    ->condition('field_display_on_services', 1)
    ->condition('langcode', $langcode)
    ->execute();
  $nids = is_array($nids) ? array_values(array_map('intval', $nids)) : [];
  $service_count = count($nids);

  $platform_count = (int) \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'platform')
    ->condition('status', 1)
    ->condition('langcode', $langcode)
    ->count()
    ->execute();

  $sector_distinct = 0;
  $type_distinct = 0;
  if ($nids !== []) {
    $db = \Drupal::database();
    // Sector / service type values often live on the default translation row only;
    // do not filter field tables by interface langcode or DISTINCT returns 0.
    $q1 = $db->select('node__field_sector', 'fs');
    $q1->addExpression('COUNT(DISTINCT fs.field_sector_target_id)', 'cnt');
    $q1->condition('fs.entity_id', $nids, 'IN');
    $q1->condition('fs.deleted', 0);
    $sector_distinct = (int) $q1->execute()->fetchField();

    $q2 = $db->select('node__field_taxonomy', 'ft');
    $q2->addExpression('COUNT(DISTINCT ft.field_taxonomy_target_id)', 'cnt');
    $q2->condition('ft.entity_id', $nids, 'IN');
    $q2->condition('ft.deleted', 0);
    $type_distinct = (int) $q2->execute()->fetchField();
  }

  return [
    'services' => $service_count,
    'platforms' => $platform_count,
    'sectors' => $sector_distinct,
    'service_types' => $type_distinct,
  ];
}

/**
 * Implements hook_preprocess_views_view__services__page_1().
 */
function motaded_theme_preprocess_views_view__services__page_1(&$variables) {
  try {
    $variables['services_sidebar_contact_url'] = Url::fromUserInput('/contact-us')->toString();
  }
  catch (\Exception $e) {
    $variables['services_sidebar_contact_url'] = '/contact-us';
  }

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId();
  $stats = _motaded_theme_services_directory_hero_stats($langcode);
  $variables['services_hero_stat_services'] = $stats['services'];
  $variables['services_hero_stat_platforms'] = $stats['platforms'];
  $variables['services_hero_stat_sectors'] = $stats['sectors'];
  $variables['services_hero_stat_service_types'] = $stats['service_types'];

  $language = \Drupal::languageManager()->getLanguage($langcode);
  $url_options = $language ? ['language' => $language] : [];
  try {
    $variables['services_hero_url_listings'] = Url::fromRoute('view.services.page_1', [], $url_options + ['fragment' => 'services-directory-listings'])->toString();
  }
  catch (\Throwable $e) {
    $variables['services_hero_url_listings'] = '/services#services-directory-listings';
  }
  try {
    $variables['services_hero_url_filters'] = Url::fromRoute('view.services.page_1', [], $url_options + ['fragment' => 'services-directory-filters'])->toString();
  }
  catch (\Throwable $e) {
    $variables['services_hero_url_filters'] = '/services#services-directory-filters';
  }
  try {
    $variables['services_hero_url_platforms'] = Url::fromRoute('view.platforms.page_1', [], $url_options)->toString();
  }
  catch (\Throwable $e) {
    $variables['services_hero_url_platforms'] = '/platforms';
  }

  $variables['#cache']['contexts'] = Cache::mergeContexts($variables['#cache']['contexts'] ?? [], ['languages:language_interface']);
  $node_list_tags = \Drupal::entityTypeManager()->getDefinition('node')->getListCacheTags();
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $node_list_tags);
}

/**
 * Implements hook_preprocess_views_view__platforms__page_1().
 *
 * Provides stat counts and quick-link URLs for the split-banner hero, matching
 * the visual language of /services and /sectors.
 */
function motaded_theme_preprocess_views_view__platforms__page_1(array &$variables): void {
  try {
    $variables['platforms_sidebar_contact_url'] = Url::fromUserInput('/contact-us')->toString();
  }
  catch (\Exception $e) {
    $variables['platforms_sidebar_contact_url'] = '/contact-us';
  }

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId();

  $platforms_count = (int) \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'platform')
    ->condition('status', 1)
    ->condition('langcode', $langcode)
    ->count()
    ->execute();

  $categories_count = 0;
  $regions_count = 0;
  try {
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $categories_count = (int) $term_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'platform_category')
      ->count()
      ->execute();
    $regions_count = (int) $term_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'region')
      ->count()
      ->execute();
  }
  catch (\Throwable $e) {
    // Leave zeros — hero renders an em-dash on zero values.
  }

  $variables['platforms_hero_stat_platforms'] = $platforms_count;
  $variables['platforms_hero_stat_categories'] = $categories_count;
  $variables['platforms_hero_stat_regions'] = $regions_count;

  $language = \Drupal::languageManager()->getLanguage($langcode);
  $url_options = $language ? ['language' => $language] : [];
  try {
    $variables['platforms_hero_url_services'] = Url::fromRoute('view.services.page_1', [], $url_options)->toString();
  }
  catch (\Throwable $e) {
    $variables['platforms_hero_url_services'] = '/services';
  }
  try {
    $variables['platforms_hero_url_sectors'] = Url::fromRoute('view.sectors_directory.page_1', [], $url_options)->toString();
  }
  catch (\Throwable $e) {
    $variables['platforms_hero_url_sectors'] = '/sectors';
  }
  try {
    $variables['platforms_hero_url_filters'] = Url::fromRoute('view.platforms.page_1', [], $url_options + ['fragment' => 'platforms-directory-filters'])->toString();
  }
  catch (\Throwable $e) {
    $variables['platforms_hero_url_filters'] = '/platforms#platforms-directory-filters';
  }
  try {
    $variables['platforms_hero_url_listings'] = Url::fromRoute('view.platforms.page_1', [], $url_options + ['fragment' => 'platforms-directory-listings'])->toString();
  }
  catch (\Throwable $e) {
    $variables['platforms_hero_url_listings'] = '/platforms#platforms-directory-listings';
  }

  $variables['#cache']['contexts'] = Cache::mergeContexts($variables['#cache']['contexts'] ?? [], ['languages:language_interface']);
  $node_list_tags = \Drupal::entityTypeManager()->getDefinition('node')->getListCacheTags();
  $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $node_list_tags);
}

