/**
 * Plain text for glance stat descriptions (field often stores "<p>…</p>").
 */
function motaded_theme_glance_body_plain(string $html): string {
  $html = trim($html);
  if ($html === '') {
    return '';
  }
  return trim(html_entity_decode(strip_tags($html), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
}

