/**
 * LCP: fetchpriority=high for responsive hero banner images.
 */
function motaded_theme_preprocess_responsive_image_formatter(array &$variables) {
  if (($variables['responsive_image_style_id'] ?? '') !== 'hero_banner') {
    return;
  }
  if (empty($variables['responsive_image']['#attributes'])) {
    return;
  }
  $attr = $variables['responsive_image']['#attributes'];
  if ($attr instanceof \Drupal\Core\Template\Attribute) {
    $attr->setAttribute('fetchpriority', 'high');
  }
  elseif (is_array($attr)) {
    $variables['responsive_image']['#attributes']['fetchpriority'] = 'high';
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Kept as a no-op so the theme hook remains a valid callable (FA uses libraries).
 */
function motaded_theme_page_attachments_alter(array &$attachments): void {
}

/**
 * Whether SEO/marketing third-party tags should be omitted (see settings.php).
 */
function _motaded_theme_suppress_seo_tracking(): bool {
  return (bool) Settings::get('motaded_suppress_seo_tracking', FALSE);
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function motaded_theme_preprocess_html(array &$variables): void {
  $variables['motaded_suppress_seo_tracking'] = _motaded_theme_suppress_seo_tracking();
}

/**
 * Next published event whose start datetime is today or later (for /events hero).
 */
function _motaded_theme_events_directory_next_featured_nid(): ?int {
  try {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $today = gmdate('Y-m-d', \Drupal::time()->getRequestTime());
    $nids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'event')
      ->condition('status', NodeInterface::PUBLISHED)
      ->condition('field_event_start.value', $today . 'T00:00:00', '>=')
      ->sort('field_event_start.value', 'ASC')
      ->range(0, 1)
      ->execute();
    if ($nids !== []) {
      return (int) reset($nids);
    }
  }
  catch (\Exception $e) {
    return NULL;
  }
  return NULL;
}

/**
 * Hero stat strip for /events (counts from content + taxonomies).
 *
 * @return array<int, array{value: string, label: string, icon: string}>
 */
function _motaded_theme_events_directory_stats(): array {
  try {
    $node_storage = \Drupal::entityTypeManager()->getStorage('node');
    $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $today = gmdate('Y-m-d', \Drupal::time()->getRequestTime());

    $upcoming = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'event')
      ->condition('status', NodeInterface::PUBLISHED)
      ->condition('field_event_start.value', $today . 'T00:00:00', '>=')
      ->count()
      ->execute();

    $total = (int) $node_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'event')
      ->condition('status', NodeInterface::PUBLISHED)
      ->count()
      ->execute();

    $region_count = (int) $term_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'region')
      ->count()
      ->execute();

    $industry_count = (int) $term_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'taxonomy')
      ->count()
      ->execute();

    $suffix = static function (int $n): string {
      return $n > 0 ? (string) $n . '+' : '0';
    };

    $volume = static function (int $n) use ($suffix): string {
      if ($n >= 1000) {
        $k = $n / 1000;
        $rounded = abs($k - round($k)) < 0.05 ? (string) (int) round($k) : number_format($k, 1, '.', '');
        return $rounded . 'K+';
      }
      return $suffix($n);
    };

    return [
      [
        'value' => $suffix($upcoming),
        'label' => (string) t('Upcoming events'),
        'icon' => 'calendar',
      ],
      [
        'value' => $volume($total),
        'label' => (string) t('Events hosted'),
        'icon' => 'users',
      ],
      [
        'value' => $suffix($region_count),
        'label' => (string) t('Cities'),
        'icon' => 'map',
      ],
      [
        'value' => (string) max(0, $industry_count),
        'label' => (string) t('Industries'),
        'icon' => 'document',
      ],
    ];
  }
  catch (\Throwable $e) {
    return [];
  }
}

/**
 * Hero stat strip for /platforms (counts from content + taxonomies).
 */
function _motaded_theme_platforms_directory_stats(): array {
  try {
    $storage = \Drupal::entityTypeManager()->getStorage('node');
    $query = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'platform')
      ->condition('status', 1);
    $platforms_count = (int) $query->count()->execute();

    $cat_count = (int) \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'platform_category')
      ->count()
      ->execute();

    $region_count = (int) \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'region')
      ->count()
      ->execute();

    return [
      [
        'label' => (string) t('Official platforms'),
        'value' => $platforms_count > 0 ? $platforms_count . '+' : '—',
        'icon' => 'grid',
      ],
      [
        'label' => (string) t('Categories'),
        'value' => $cat_count > 0 ? $cat_count . '+' : '—',
        'icon' => 'layers',
      ],
      [
        'label' => (string) t('Regions'),
        'value' => $region_count > 0 ? $region_count . '+' : '—',
        'icon' => 'map',
      ],
    ];
  }
  catch (\Throwable $e) {
    return [];
  }
}

/**
 * Category chips row for /platforms (quick filter links).
 */
function _motaded_theme_platforms_directory_category_chips(): array {
  try {
    $t_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
    $tids = $t_storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('vid', 'platform_category')
      ->sort('weight', 'ASC')
      ->sort('name', 'ASC')
      ->range(0, 8)
      ->execute();
    if (!$tids) {
      return [];
    }
    $terms = $t_storage->loadMultiple($tids);
    $chips = [];
    foreach ($terms as $term) {
      if (!$term instanceof TermInterface) {
        continue;
      }
      $chips[] = [
        'label' => $term->label(),
        'url' => Url::fromUserInput('/platforms', [
          'query' => [
            'field_category_target_id' => (string) $term->id(),
          ],
        ])->toString(),
      ];
    }
    return $chips;
  }
  catch (\Throwable $e) {
    return [];
  }
}

/**
 * Implements hook_preprocess_views_view().
 */
function motaded_theme_preprocess_views_view(&$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  // Listing page (/events) only — home strip uses events_home library via block.
  $display_id = $view->current_display ?? '';
  if ($view->id() === 'events' && $display_id === 'page_1') {
    $variables['#attached']['library'][] = 'motaded_theme/events_directory';
    $variables['attributes']['class'][] = 'events-directory-page';
    $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
    $variables['motaded_events_hero_bg_url'] = base_path() . $theme_path . '/images/events-bg.png';
    $variables['motaded_events_stats'] = _motaded_theme_events_directory_stats();
    $featured_nid = _motaded_theme_events_directory_next_featured_nid();
    \Drupal::request()->attributes->set('motaded_events_featured_nid', $featured_nid);
    $variables['motaded_events_featured_nid'] = $featured_nid;
    $variables['motaded_events_featured'] = NULL;
    if ($featured_nid !== NULL) {
      $fn = Node::load($featured_nid);
      if ($fn instanceof NodeInterface && $fn->bundle() === 'event' && $fn->access('view')) {
        $build = \Drupal::entityTypeManager()->getViewBuilder('node')->view($fn, 'teaser');
        $build['#motaded_featured_teaser'] = TRUE;
        $variables['motaded_events_featured'] = $build;
      }
    }

    // Render the webform signup inside the view template without Twig Tweak helpers.
    // Twig Tweak's drupal_entity_form() cannot render the Webform entity directly.
    // Render via the webform_block plugin (same as placing a Webform block).
    $variables['motaded_event_updates_form'] = [];
    try {
      if (\Drupal::moduleHandler()->moduleExists('webform')) {
        $block = \Drupal::service('plugin.manager.block')->createInstance('webform_block', [
          'webform_id' => 'event_updates',
          'label_display' => '0',
          'default_data' => '',
          'redirect' => FALSE,
          'lazy' => TRUE,
        ]);
        if ($block && $block->access(\Drupal::currentUser())) {
          $variables['motaded_event_updates_form'] = $block->build();
        }
      }
    }
    catch (\Throwable $e) {
      $variables['motaded_event_updates_form'] = [];
    }
  }

  if ($view->id() === 'insights' && $display_id === 'page_1') {
    $variables['#attached']['library'][] = 'motaded_theme/insights_directory';
    $variables['attributes']['class'][] = 'insights-directory-page';
    $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
    $variables['motaded_insights_hero_bg_url'] = base_path() . $theme_path . '/images/events-bg.png';

    $variables['motaded_event_updates_form'] = [];
    try {
      if (\Drupal::moduleHandler()->moduleExists('webform')) {
        $block = \Drupal::service('plugin.manager.block')->createInstance('webform_block', [
          'webform_id' => 'event_updates',
          'label_display' => '0',
          'default_data' => '',
          'redirect' => FALSE,
          'lazy' => TRUE,
        ]);
        if ($block && $block->access(\Drupal::currentUser())) {
          $variables['motaded_event_updates_form'] = $block->build();
        }
      }
    }
    catch (\Throwable $e) {
      $variables['motaded_event_updates_form'] = [];
    }
  }

  if ($view->id() === 'platforms' && $display_id === 'page_1') {
    $variables['#attached']['library'][] = 'motaded_theme/platforms_directory';
    $variables['attributes']['class'][] = 'platforms-directory-page';
    $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
    // Reuse the same hero background asset until a dedicated one is added.
    $variables['motaded_platforms_hero_bg_url'] = base_path() . $theme_path . '/images/events-bg.png';
    $variables['motaded_platforms_stats'] = _motaded_theme_platforms_directory_stats();
    $variables['motaded_platforms_category_chips'] = _motaded_theme_platforms_directory_category_chips();
  }
  // Home list keeps an exposed form in the DOM (visually hidden in CSS) so Views AJAX
  // can apply the same filter values as the calendar column when we sync in events-home.js.
}

/**
 * Events directory: drop the featured row from the grid (page 0) to avoid duplication.
 */
function motaded_theme_preprocess_views_view_unformatted__events__page_1(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->getCurrentPage() !== 0) {
    return;
  }
  $featured = \Drupal::request()->attributes->get('motaded_events_featured_nid');
  if ($featured === NULL || $featured === '') {
    return;
  }
  $featured = (int) $featured;
  if ($featured < 1) {
    return;
  }
  foreach ($variables['rows'] as $delta => $row) {
    $content = $row['content'] ?? [];
    $node = $content['#node'] ?? NULL;
    if ($node instanceof NodeInterface && (int) $node->id() === $featured) {
      unset($variables['rows'][$delta]);
      break;
    }
  }
  $variables['rows'] = array_values($variables['rows']);
}

/**
 * Insights directory: remove featured rows from the main list (page 0) to avoid duplication.
 */
function motaded_theme_preprocess_views_view_unformatted__insights__page_1(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->getCurrentPage() !== 0) {
    return;
  }

  $sub = Views::getView('insights');
  if (!$sub) {
    return;
  }
  $sub->setDisplay('attachment_featured');
  $sub->setExposedInput($view->getExposedInput());
  $sub->execute();

  $featured_nids = [];
  foreach ($sub->result as $row) {
    $nid = NULL;
    if (isset($row->_entity) && $row->_entity instanceof NodeInterface) {
      $nid = (int) $row->_entity->id();
    }
    elseif (!empty($row->nid)) {
      $nid = (int) $row->nid;
    }
    if ($nid) {
      $featured_nids[] = $nid;
    }
  }
  $featured_nids = array_values(array_unique($featured_nids));
  if ($featured_nids === []) {
    return;
  }

  foreach ($variables['rows'] as $delta => $row) {
    $content = $row['content'] ?? [];
    $node = $content['#node'] ?? NULL;
    if ($node instanceof NodeInterface && in_array((int) $node->id(), $featured_nids, TRUE)) {
      unset($variables['rows'][$delta]);
    }
  }
  $variables['rows'] = array_values($variables['rows']);
}

/**
 * Implements hook_preprocess_block().
 */
function motaded_theme_preprocess_block(array &$variables) {
  // Services page: hide standalone exposed block; we render it inside the view.
  if (($variables['elements']['#plugin_id'] ?? '') === 'views_exposed_filter_block:services-page_1') {
    $variables['elements']['#access'] = FALSE;
    return;
  }

  if (!empty($variables['elements']['#id']) && $variables['elements']['#id'] == 'motaded_theme_mainnavigation') {
    $variables['content']['#attributes']['data-block-id'] = $variables['elements']['#id'];
  }
  // Global CTA: pass show_title_on_button, cta_heading, cta_subtitle (badge).
  if (isset($variables['elements']['content']['#block_content'])) {
    $block_content = $variables['elements']['content']['#block_content'];
    if ($block_content->bundle() === 'global_cta') {
      if ($block_content->hasField('field_show_title_on_button')) {
        $variables['show_title_on_button'] = !$block_content->get('field_show_title_on_button')->isEmpty()
          && (bool) $block_content->get('field_show_title_on_button')->value;
      }
      if ($block_content->hasField('field_text') && !$block_content->get('field_text')->isEmpty()) {
        $heading = trim($block_content->get('field_text')->value);
        $variables['cta_heading'] = $heading;
        // Split at first "?" for intentional two-line display (e.g. "Ready to start?" / "Contact us today").
        if (strpos($heading, '?') !== false) {
          $parts = explode('?', $heading, 2);
          $variables['cta_heading_line1'] = trim($parts[0]) . '?';
          $variables['cta_heading_line2'] = trim($parts[1] ?? '');
        }
      }
      if ($block_content->hasField('field_subtitle') && !$block_content->get('field_subtitle')->isEmpty()) {
        $variables['cta_subtitle'] = trim($block_content->get('field_subtitle')->value);
      }
    }
  }
  // First footer column (Quick Links): pass logo, front page, and footer CTA block.
  if (isset($variables['elements']['#id']) && $variables['elements']['#id'] === 'motaded_theme_footer') {
    $variables['logo_path'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
    $variables['front_page'] = \Drupal\Core\Url::fromRoute('<front>', [], ['absolute' => TRUE])->toString();
    $cta_block = \Drupal\block\Entity\Block::load('motaded_theme_cta_3');
    if ($cta_block && $cta_block->getRegion() === 'footer') {
      $variables['footer_cta_block'] = \Drupal::entityTypeManager()
        ->getViewBuilder('block')
        ->view($cta_block);
    }
  }
}

/**
 * Implements hook_views_pre_view().
 *
 * Forces services page_1 exposed filters to render inside the view output,
 * even if config still has "Exposed form in block" enabled.
 */
function motaded_theme_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== 'services' || $display_id !== 'page_1') {
    return;
  }
  if ($view->display_handler) {
    $view->display_handler->setOption('exposed_block', FALSE);
  }
}

function motaded_theme_theme_suggestions_menu_alter(array &$suggestions, array $variables) {
  if (isset($variables['attributes']['data-block-id'])) {
    $block = \Drupal\block\Entity\Block::load($variables['attributes']['data-block-id']);
    if ($block) {
      array_push($suggestions, 'menu__' . str_replace('-', '_', $block->getRegion()));
    }
  }
}

/**
 * Builds the "More on this topic" below_content block (same view + markup for all bundles).
 *
 * @return array|null
 *   Render array, or NULL if no category or view is missing.
 */
function motaded_theme_more_on_topic_build(NodeInterface $node): ?array {
  if (!$node->hasField('field_taxonomy') || $node->get('field_taxonomy')->isEmpty()) {
    return NULL;
  }
  $tid = (int) $node->get('field_taxonomy')->target_id;
  if ($tid <= 0) {
    return NULL;
  }
  $view = Views::getView('related_similar');
  if (!$view) {
    return NULL;
  }
  switch ($node->bundle()) {
    case 'article':
      $display_id = 'block_2';
      break;

    case 'news':
      $display_id = 'block_3';
      break;

    case 'page':
      $display_id = 'block_1';
      $is_service = $node->hasField('field_display_on_services')
        && !$node->get('field_display_on_services')->isEmpty()
        && (int) $node->get('field_display_on_services')->value === 1;
      if (!$is_service) {
        return NULL;
      }
      break;

    default:
      return NULL;
  }

  return [
    '#type' => 'container',
    '#attributes' => ['class' => ['more-on-topic-region', 'mt-10']],
    '#cache' => [
      'contexts' => ['route'],
      'tags' => $node->getCacheTags(),
    ],
    'title' => [
      '#markup' => '<h2 class="more-on-topic-heading">' . (string) t('More on this topic') . '</h2>',
    ],
    'view' => $view->buildRenderable($display_id, [
      (string) $tid,
      (string) $node->id(),
    ]),
    '#weight' => 50,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 *
 * Preprocesses variables for the page template.
 * Adds default logo path variable.
 */
function motaded_theme_preprocess_page(&$variables) {
  $variables['motaded_suppress_seo_tracking'] = _motaded_theme_suppress_seo_tracking();
  // Adds logo path to page.html.twig variables.
  $variables['logo_path'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
  // Hide motaded_theme_cta_3 from footer region; it's rendered inside the footer block.
  if (isset($variables['page']['footer']['motaded_theme_cta_3'])) {
    $variables['page']['footer']['motaded_theme_cta_3']['#access'] = FALSE;
  }

  // Footer: about row, then Our Services | Useful Resources | Legal (see .footer-site in main.css).
  if (!empty($variables['page']['footer']) && is_array($variables['page']['footer'])) {
    $footer = &$variables['page']['footer'];

    $about_keys = ['motaded_theme_footerabouttext'];
    $left_children = [];
    foreach ($about_keys as $key) {
      if (isset($footer[$key])) {
        $left_children[$key] = $footer[$key];
        unset($footer[$key]);
      }
    }
    if ($left_children !== []) {
      $footer['footer_site_col_left'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['footer-site__col-left']],
        '#weight' => -50,
      ];
      foreach ($left_children as $key => $element) {
        $footer['footer_site_col_left'][$key] = $element;
      }
    }

    $menu_keys = ['motaded_theme_ourservices', 'motaded_theme_otherservices', 'motaded_theme_quicklinks'];
    $menu_children = [];
    foreach ($menu_keys as $key) {
      if (isset($footer[$key])) {
        $menu_children[$key] = $footer[$key];
        unset($footer[$key]);
      }
    }
    if ($menu_children !== []) {
      $footer['footer_site_menus'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['footer-site__menus']],
        '#weight' => -45,
      ];
      foreach ($menu_children as $key => $element) {
        $footer['footer_site_menus'][$key] = $element;
      }
    }
  }

  // Service (Basic page + Display on services): full-width hero; sidebar renders in node template.
  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'platform'
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $variables['platform_page_full_bleed'] = TRUE;
  }

  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'page'
    && $route_node->hasField('field_display_on_services')
    && !$route_node->get('field_display_on_services')->isEmpty()
    && (int) $route_node->get('field_display_on_services')->value === 1) {
    $variables['service_page_full_bleed'] = TRUE;
    $sidebar_build = $variables['page']['sidebar_second'] ?? NULL;
    if (is_array($sidebar_build) && Element::children($sidebar_build) !== []) {
      \Drupal::request()->attributes->set('motaded_theme_service_sidebar_second', $sidebar_build);
    }
    // Never render sidebar in page.html.twig for this layout (node template owns it).
    unset($variables['page']['sidebar_second']);

  }

  // Article / News full node: same "More on this topic" band (reuses helper + view + CSS).
  if ($route_node instanceof NodeInterface
    && in_array($route_node->bundle(), ['article', 'news'], TRUE)
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $more_on_topic = motaded_theme_more_on_topic_build($route_node);
    if ($more_on_topic !== NULL) {
      $variables['page']['below_content']['more_on_topic_related'] = $more_on_topic;
    }
  }

}

/**
 * Truncates HTML to a plain-text string for hero intro fallback.
 */
/**
 * Builds a render array for the active theme's sidebar_second region.
 *
 * Used when the region copy from preprocess_page is missing (ordering / empty()).
 */
function motaded_theme_build_sidebar_second_region(): array {
  /** @var \Drupal\block\BlockRepositoryInterface $repo */
  $repo = \Drupal::service('block.repository');
  $cacheability = [];
  $regions = $repo->getVisibleBlocksPerRegion($cacheability);
  $region_blocks = $regions['sidebar_second'] ?? [];
  if ($region_blocks === []) {
    return [];
  }
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('block');
  $build = [];
  foreach ($region_blocks as $block) {
    if (!$block instanceof BlockInterface) {
      continue;
    }
    if ($block->access('view')) {
      $build[$block->id()] = $view_builder->view($block);
    }
  }
  return $build;
}

function motaded_theme_plain_text_truncate(string $html, int $max_length): string {
  $text = trim(preg_replace('/\s+/u', ' ', strip_tags($html)));
  if ($text === '') {
    return '';
  }
  if (mb_strlen($text) <= $max_length) {
    return $text;
  }
  return mb_substr($text, 0, $max_length) . '…';
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Preprocesses variables for the node template.
 * Adds body summary variable
 */
function motaded_theme_preprocess_node(&$variables) {
  $node = $variables['node'];
  $variables['summary'] = NULL;
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_item = $node->get('body')->first();
    if ($body_item) {
      $summary_text = trim((string) $body_item->summary);
      if ($summary_text !== '') {
        $variables['summary'] = ['#markup' => nl2br(Html::escape($summary_text))];
      }
    }
  }

  // Article (full page): blog-style hero rail — read time, media, meta for twig.
  if ($node->bundle() === 'article'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    $variables['article_hero_media'] = [];
    if ($node->hasField('field_media') && !$node->get('field_media')->isEmpty()) {
      $media = $node->get('field_media')->entity;
      if ($media) {
        $variables['article_hero_media'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'banner_sm');
      }
    }
    $variables['article_read_time'] = [];
    if ($node->hasField('field_estimated_read_time') && !$node->get('field_estimated_read_time')->isEmpty()) {
      $variables['article_read_time'] = \Drupal::entityTypeManager()
        ->getViewBuilder('node')
        ->viewField($node->get('field_estimated_read_time'), [
          'label' => 'hidden',
          'type' => 'estimated_read_time_text',
          'weight' => 0,
          'settings' => [
            'tokenized_string' => (string) t('@minutes min read'),
          ],
          'third_party_settings' => [],
        ]);
    }
    $variables['article_updated_formatted'] = \Drupal::service('date.formatter')->format(
      (int) $node->getChangedTime(),
      'custom',
      'j F Y'
    );
    $variables['article_changed_iso'] = gmdate('c', (int) $node->getChangedTime());
  }

  // News (full page): hero media (view mode news) + updated date for meta row.
  if ($node->bundle() === 'news'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    $variables['news_hero_media'] = [];
    if ($node->hasField('field_media') && !$node->get('field_media')->isEmpty()) {
      $media = $node->get('field_media')->entity;
      if ($media) {
        $variables['news_hero_media'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'news');
      }
    }
    $variables['news_updated_formatted'] = \Drupal::service('date.formatter')->format(
      (int) $node->getChangedTime(),
      'custom',
      'j F Y'
    );
    $variables['news_changed_iso'] = gmdate('c', (int) $node->getChangedTime());
  }

  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'full' && !empty($variables['page'])) {
    _motaded_theme_preprocess_event_node_full($variables, $node);
  }
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'teaser') {
    _motaded_theme_preprocess_event_node_teaser($variables, $node);
    if (!empty($variables['elements']['#motaded_featured_teaser'])) {
      $variables['attributes']['class'][] = 'event-teaser--featured-hero';
    }
  }

  if ($node->bundle() === 'market_insight' && ($variables['view_mode'] ?? '') === 'teaser') {
    _motaded_theme_preprocess_market_insight_teaser($variables, $node);
  }

  // Platform (full): CTA / external URLs + marketing layout library.
  if ($node->bundle() === 'platform' && ($variables['view_mode'] ?? '') === 'full') {
    $variables['#attached']['library'][] = 'motaded_theme/platform_node';
    // Defaults so Twig never misses variables (e.g. partial caches).
    $variables += [
      'platform_listing_url' => Url::fromUserInput('/platforms')->toString(),
      'platform_contact_url' => Url::fromUserInput('/contact-us')->toString(),
      'platform_cta_url' => NULL,
      'platform_cta_label' => (string) t('Start your setup'),
      'platform_external_url' => NULL,
      'platform_external_label' => (string) t('Visit official website'),
      'platform_external_new_window' => FALSE,
      'platform_wa_url' => NULL,
      'platform_tel_url' => NULL,
    ];
    if ($node->hasField('field_cta_text') && !$node->get('field_cta_text')->isEmpty()) {
      $variables['platform_cta_label'] = trim((string) $node->get('field_cta_text')->value);
    }
    if ($node->hasField('field_cta_link') && !$node->get('field_cta_link')->isEmpty()) {
      $link = $node->get('field_cta_link')->first();
      if ($link && $link->getUrl()) {
        $variables['platform_cta_url'] = $link->getUrl()->toString();
      }
    }
    if ($node->hasField('field_external_link') && !$node->get('field_external_link')->isEmpty()) {
      $ext = $node->get('field_external_link')->first();
      if ($ext && $ext->getUrl()) {
        $url = $ext->getUrl();
        $variables['platform_external_url'] = $url->toString();
        $variables['platform_external_new_window'] = $url->isExternal();
        $title = trim((string) $ext->title);
        if ($title !== '') {
          $variables['platform_external_label'] = $title;
        }
      }
    }
    $page_url = \Drupal::request()->getSchemeAndHttpHost() . \Drupal::request()->getBasePath() . \Drupal::request()->getPathInfo();
    $variables['platform_wa_url'] = 'https://wa.me/?text=' . rawurlencode($node->getTitle() . ' — ' . $page_url);
    $variables['platform_tel_url'] = NULL;
    $tel = Settings::get('motaded_platform_phone', '');
    if (is_string($tel) && $tel !== '') {
      $digits = preg_replace('/\D+/', '', $tel);
      if ($digits !== '') {
        $variables['platform_tel_url'] = 'tel:' . $digits;
      }
    }
  }

  // Market Insight (platform full): read time for hero meta (breadcrumb uses page region).
  if ($node->bundle() === 'market_insight'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])
    && $node->hasField('field_insight_shell')
    && $node->get('field_insight_shell')->value === 'platform') {
    $variables['market_insight_read_mins'] = NULL;
    if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
      $plain = trim(preg_replace('/\s+/u', ' ', strip_tags((string) $node->get('body')->value)));
      if ($plain !== '') {
        $words = count(preg_split('/\s+/u', $plain, -1, PREG_SPLIT_NO_EMPTY));
        $variables['market_insight_read_mins'] = max(1, (int) ceil($words / 200));
      }
    }
  }

  // Service page (Basic page + Display on services): compact hero data.
  if ($node->bundle() === 'page'
    && ($variables['view_mode'] ?? '') === 'full'
    && $node->hasField('field_display_on_services')
    && !$node->get('field_display_on_services')->isEmpty()
    && (int) $node->get('field_display_on_services')->value === 1) {
    $request = \Drupal::request();
    $sidebar_build = [];
    if ($request->attributes->has('motaded_theme_service_sidebar_second')) {
      $sidebar_build = $request->attributes->get('motaded_theme_service_sidebar_second');
      $request->attributes->remove('motaded_theme_service_sidebar_second');
    }
    if (!is_array($sidebar_build) || Element::children($sidebar_build) === []) {
      $sidebar_build = motaded_theme_build_sidebar_second_region();
    }
    $variables['service_sidebar_second'] = $sidebar_build;
    $variables['service_hero_intro'] = NULL;
    $variables['service_contact_url'] = Url::fromUserInput('/contact-us')->toString();
    $variables['service_other_services_url'] = Url::fromUserInput('/services')->toString();
    $has_sidebar_blocks = is_array($sidebar_build) && Element::children($sidebar_build) !== [];
    $variables['service_show_right_column'] = $has_sidebar_blocks;
    $variables['service_body_use_readmore'] = FALSE;
    if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
      $item = $node->get('body')->first();
      $summary = trim((string) $item->summary);
      if ($summary !== '') {
        $variables['service_hero_intro'] = ['#markup' => nl2br(Html::escape($summary))];
      }
      else {
        $truncated = motaded_theme_plain_text_truncate((string) $item->processed, 320);
        if ($truncated !== '') {
          $variables['service_hero_intro'] = ['#markup' => Html::escape($truncated)];
        }
      }
      // Long body: collapsible UI; full HTML stays in the template for SEO.
      $plain_len = mb_strlen(trim(strip_tags((string) $item->value)));
      $variables['service_body_use_readmore'] = $plain_len > 2499;
    }
  }

  // Event (full): hide fields rendered manually in node--event--full.html.twig.
  if ($node->bundle() === 'event' && ($variables['view_mode'] ?? '') === 'full' && !empty($variables['page'])) {
    foreach ([
      'field_hero_image',
      'field_featured_image',
      'field_event_start',
      'field_event_end',
      'field_location',
      'field_event_type',
      'field_region',
      'field_category',
      'field_cta_type',
      'field_cta_text',
      'field_cta_link',
      'field_secondary_cta',
      'field_featured',
      'field_meeting_enabled',
      'body',
      'field_why_attend',
      'field_what_we_offer',
      'field_who_should_attend',
      'field_agenda',
      'field_gallery',
      'field_partner_logos',
      'field_tags',
      'field_meta',
      'addtoany',
      'links',
    ] as $hide_field) {
      unset($variables['content'][$hide_field]);
    }
  }

  // Add step numbers to field_steps_to_obtain items.
  if ($node->bundle() == 'page' && !empty($variables['content']['field_steps_to_obtain'])) {
    foreach ($variables['content']['field_steps_to_obtain'] as $i => &$item) {
      if (is_numeric($i)) {
        $item['#number'] = $i;
      }
    }
  }
}

/**
 * Preprocess variables for Event nodes (full page).
 */
function _motaded_theme_preprocess_event_node_full(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/event_page';
  $em = \Drupal::entityTypeManager();
  $view_builder = $em->getViewBuilder('node');
  $date_formatter = \Drupal::service('date.formatter');
  $langcode = $node->language()->getId();

  $variables['event_hero_media'] = [];
  $media = NULL;
  if ($node->hasField('field_hero_image') && !$node->get('field_hero_image')->isEmpty()) {
    $media = $node->get('field_hero_image')->entity;
  }
  elseif ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
    $media = $node->get('field_featured_image')->entity;
  }
  if ($media) {
    $variables['event_hero_media'] = $em->getViewBuilder('media')->view($media, 'default');
  }

  $variables['event_body'] = [];
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $variables['event_body'] = $view_builder->viewField($node->get('body'), [
      'label' => 'hidden',
      'type' => 'text_default',
      'weight' => 0,
      'settings' => [],
      'third_party_settings' => [],
    ]);
  }

  foreach ([
    'event_why' => 'field_why_attend',
    'event_highlights' => 'field_what_we_offer',
    'event_audience' => 'field_who_should_attend',
    'event_agenda' => 'field_agenda',
  ] as $var => $field) {
    $variables[$var] = [];
    if ($node->hasField($field) && !$node->get($field)->isEmpty()) {
      $variables[$var] = $view_builder->viewField($node->get($field), [
        'label' => 'hidden',
        'type' => 'entity_reference_revisions_entity_view',
        'weight' => 0,
        'settings' => [
          'view_mode' => 'default',
          'link' => '',
        ],
        'third_party_settings' => [],
      ]);
    }
  }

  $variables['event_gallery'] = [];
  if ($node->hasField('field_gallery') && !$node->get('field_gallery')->isEmpty()) {
    $variables['event_gallery'] = $view_builder->viewField($node->get('field_gallery'), [
      'label' => 'hidden',
      'type' => 'photoswipe_field_formatter',
      'weight' => 0,
      'settings' => [
        'photoswipe_thumbnail_style_first' => '',
        'photoswipe_thumbnail_style' => 'media_gallery_image',
        'photoswipe_image_style' => '',
        'photoswipe_reference_image_field' => 'field_media_image',
        'photoswipe_view_mode' => 'default',
        'image_loading' => [
          'attribute' => 'lazy',
        ],
      ],
      'third_party_settings' => [],
    ]);
  }
  $variables['event_partners'] = [];
  if ($node->hasField('field_partner_logos') && !$node->get('field_partner_logos')->isEmpty()) {
    $variables['event_partners'] = $view_builder->viewField($node->get('field_partner_logos'), [
      'label' => 'hidden',
      'type' => 'entity_reference_entity_view',
      'weight' => 0,
      'settings' => ['view_mode' => 'default', 'link' => FALSE],
      'third_party_settings' => [],
    ]);
  }

  $variables['event_date_line'] = '';
  $variables['event_time_line'] = '';
  $variables['event_datetime_iso_start'] = '';
  $variables['event_datetime_iso_end'] = '';
  if ($node->hasField('field_event_start') && !$node->get('field_event_start')->isEmpty()) {
    $start_ts = strtotime($node->get('field_event_start')->value);
    if ($start_ts) {
      $variables['event_date_line'] = $date_formatter->format($start_ts, 'custom', 'l, j F Y', NULL, $langcode);
      $variables['event_time_line'] = $date_formatter->format($start_ts, 'custom', 'g:i a', NULL, $langcode);
      $variables['event_datetime_iso_start'] = gmdate('c', $start_ts);
    }
  }
  if ($node->hasField('field_event_end') && !$node->get('field_event_end')->isEmpty()) {
    $end_ts = strtotime($node->get('field_event_end')->value);
    if ($end_ts) {
      $variables['event_datetime_iso_end'] = gmdate('c', $end_ts);
      if ($node->hasField('field_event_start') && !$node->get('field_event_start')->isEmpty()) {
        $start_ts = strtotime($node->get('field_event_start')->value);
        if ($start_ts && date('Ymd', $start_ts) === date('Ymd', $end_ts)) {
          $variables['event_time_line'] = $date_formatter->format($start_ts, 'custom', 'g:i a', NULL, $langcode)
            . ' – ' . $date_formatter->format($end_ts, 'custom', 'g:i a', NULL, $langcode);
        }
      }
    }
  }

  $variables['event_location_plain'] = '';
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    $variables['event_location_plain'] = trim((string) $node->get('field_location')->value);
  }
  $variables['event_maps_url'] = $variables['event_location_plain'] !== ''
    ? 'https://www.google.com/maps/search/?api=1&query=' . rawurlencode($variables['event_location_plain'])
    : '';

  $variables['event_calendar_url'] = _motaded_theme_event_google_calendar_url($node);

  $variables['event_register_url'] = '';
  $variables['event_register_title'] = (string) t('Register now');
  if ($node->hasField('field_cta_link') && !$node->get('field_cta_link')->isEmpty()) {
    $link_item = $node->get('field_cta_link')->first();
    if ($link_item && $link_item->get('uri') && $link_item->get('uri')->getString() !== '') {
      try {
        $variables['event_register_url'] = Url::fromUri($link_item->get('uri')->getString(), ['absolute' => TRUE])->toString();
      }
      catch (\Throwable $e) {
        $variables['event_register_url'] = '';
      }
      $title = $link_item->get('title')->getString();
      if (trim($title) !== '') {
        $variables['event_register_title'] = trim($title);
      }
    }
  }

  $variables['event_secondary_url'] = '';
  $variables['event_secondary_title'] = (string) t('Add to calendar');
  if ($node->hasField('field_secondary_cta') && !$node->get('field_secondary_cta')->isEmpty()) {
    $sec = $node->get('field_secondary_cta')->first();
    if ($sec && $sec->get('uri') && $sec->get('uri')->getString() !== '') {
      try {
        $variables['event_secondary_url'] = Url::fromUri($sec->get('uri')->getString(), ['absolute' => TRUE])->toString();
      }
      catch (\Throwable $e) {
        $variables['event_secondary_url'] = '';
      }
      $st = $sec->get('title')->getString();
      if (trim($st) !== '') {
        $variables['event_secondary_title'] = trim($st);
      }
    }
  }
  if ($variables['event_secondary_url'] === '' && !empty($variables['event_calendar_url'])) {
    $variables['event_secondary_url'] = $variables['event_calendar_url'];
  }

  $variables['event_type_label'] = '';
  if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
    $term = $node->get('field_event_type')->entity;
    if ($term) {
      $variables['event_type_label'] = $term->label();
    }
  }

  $variables['event_region_label'] = '';
  if ($node->hasField('field_region') && !$node->get('field_region')->isEmpty()) {
    $term = $node->get('field_region')->entity;
    if ($term) {
      $variables['event_region_label'] = $term->label();
    }
  }

  $variables['event_category_label'] = '';
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term) {
      $variables['event_category_label'] = $term->label();
    }
  }

  $variables['event_tags'] = [];
  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    $variables['event_tags'] = $view_builder->viewField($node->get('field_tags'), [
      'label' => 'hidden',
      'type' => 'entity_reference_label',
      'weight' => 0,
      'settings' => ['link' => FALSE],
      'third_party_settings' => [],
    ]);
  }

  $variables['event_share_block'] = [];
  if (!empty($variables['content']['addtoany'])) {
    $variables['event_share_block'] = $variables['content']['addtoany'];
  }

  $variables['event_cta_blurb'] = '';
  if ($node->hasField('field_cta_text') && !$node->get('field_cta_text')->isEmpty()) {
    $variables['event_cta_blurb'] = trim((string) $node->get('field_cta_text')->value);
  }

  $variables['event_hero_stats'] = [
    ['figure' => '500+', 'caption' => (string) t('Attendees')],
    ['figure' => '45', 'caption' => (string) t('Speakers')],
    ['figure' => '3', 'caption' => (string) t('Days')],
  ];

  $variables['event_related'] = [];
  $nids = $em->getStorage('node')->getQuery()
    ->condition('type', 'event')
    ->condition('nid', $node->id(), '<>')
    ->condition('status', 1)
    ->sort('field_event_start', 'ASC')
    ->range(0, 4)
    ->accessCheck(TRUE)
    ->execute();
  if ($nids) {
    $related = $em->getStorage('node')->loadMultiple($nids);
    $variables['event_related'] = $view_builder->viewMultiple($related, 'teaser');
  }

  $variables['event_contact_url'] = Url::fromUserInput('/contact-us')->toString();

  $variables['event_meeting_enabled'] = $node->hasField('field_meeting_enabled')
    && !$node->get('field_meeting_enabled')->isEmpty()
    && (bool) $node->get('field_meeting_enabled')->value;
}

/**
 * Builds a Google Calendar template URL for an event node.
 */
function _motaded_theme_event_google_calendar_url(NodeInterface $node): ?string {
  if (!$node->hasField('field_event_start') || $node->get('field_event_start')->isEmpty()) {
    return NULL;
  }
  $start_raw = (string) $node->get('field_event_start')->value;
  $end_raw = (!$node->hasField('field_event_end') || $node->get('field_event_end')->isEmpty())
    ? $start_raw
    : (string) $node->get('field_event_end')->value;
  try {
    $start = \DateTimeImmutable::createFromFormat(DateTimeItemInterface::DATETIME_STORAGE_FORMAT, $start_raw, new \DateTimeZone(DateTimeItemInterface::STORAGE_TIMEZONE));
    $end = \DateTimeImmutable::createFromFormat(DateTimeItemInterface::DATETIME_STORAGE_FORMAT, $end_raw, new \DateTimeZone(DateTimeItemInterface::STORAGE_TIMEZONE));
  }
  catch (\Throwable $e) {
    return NULL;
  }
  if ($start === FALSE || $end === FALSE) {
    return NULL;
  }
  $fmt = 'Ymd\THis\Z';
  $text = rawurlencode($node->getTitle());
  return 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' . $text
    . '&dates=' . $start->setTimezone(new \DateTimeZone('UTC'))->format($fmt)
    . '/' . $end->setTimezone(new \DateTimeZone('UTC'))->format($fmt);
}

/**
 * Preprocess variables for Event teaser (cards, related strip).
 */
function _motaded_theme_preprocess_event_node_teaser(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/event_page';
  $em = \Drupal::entityTypeManager();
  $date_formatter = \Drupal::service('date.formatter');
  $langcode = $node->language()->getId();

  $variables['event_teaser_media'] = [];
  if ($node->hasField('field_featured_image') && !$node->get('field_featured_image')->isEmpty()) {
    $media = $node->get('field_featured_image')->entity;
    if ($media) {
      // Responsive image styles (WebP pipeline) instead of fixed `large` default.
      $view_mode = $media->bundle() === 'image' ? 'banner_sm' : 'default';
      $variables['event_teaser_media'] = $em->getViewBuilder('media')->view($media, $view_mode);
    }
  }

  $variables['event_teaser_badge'] = '';
  $variables['event_teaser_range'] = '';
  if ($node->hasField('field_event_start') && !$node->get('field_event_start')->isEmpty()) {
    $ts = strtotime($node->get('field_event_start')->value);
    if ($ts) {
      $variables['event_teaser_badge'] = strtoupper($date_formatter->format($ts, 'custom', 'M j', NULL, $langcode));
      $variables['event_teaser_range'] = $date_formatter->format($ts, 'custom', 'j M Y', NULL, $langcode);
    }
  }
  if ($node->hasField('field_event_end') && !$node->get('field_event_end')->isEmpty()) {
    $end_ts = strtotime($node->get('field_event_end')->value);
    $start_ts = $node->get('field_event_start')->isEmpty() ? NULL : strtotime($node->get('field_event_start')->value);
    if ($end_ts && $start_ts) {
      $variables['event_teaser_range'] = $date_formatter->format($start_ts, 'custom', 'j M', NULL, $langcode)
        . ' – ' . $date_formatter->format($end_ts, 'custom', 'j M Y', NULL, $langcode);
    }
  }

  $variables['event_teaser_location'] = '';
  if ($node->hasField('field_location') && !$node->get('field_location')->isEmpty()) {
    $variables['event_teaser_location'] = trim((string) $node->get('field_location')->value);
  }

  $variables['event_teaser_chips'] = [];
  $variables['event_teaser_type_pill'] = '';
  if ($node->hasField('field_event_type') && !$node->get('field_event_type')->isEmpty()) {
    $term = $node->get('field_event_type')->entity;
    if ($term instanceof TermInterface) {
      $variables['event_teaser_type_pill'] = mb_strtoupper($term->getName());
    }
  }
  if ($node->hasField('field_region') && !$node->get('field_region')->isEmpty()) {
    $term = $node->get('field_region')->entity;
    if ($term instanceof TermInterface) {
      $variables['event_teaser_chips'][] = $term->getName();
    }
  }
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term instanceof TermInterface && !in_array($term->getName(), $variables['event_teaser_chips'], TRUE)) {
      $variables['event_teaser_chips'][] = $term->getName();
    }
  }

  $variables['event_teaser_summary'] = '';
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $raw = (string) $node->get('body')->value;
    $variables['event_teaser_summary'] = motaded_theme_plain_text_truncate($raw, 176);
  }
}

/**
 * Preprocess variables for Market insight teaser (directory cards + list).
 */
function _motaded_theme_preprocess_market_insight_teaser(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/event_page';
  $em = \Drupal::entityTypeManager();

  $variables['insight_teaser_media'] = [];
  if ($node->hasField('field_insight_thumbnail') && !$node->get('field_insight_thumbnail')->isEmpty()) {
    $media = $node->get('field_insight_thumbnail')->entity;
    if ($media) {
      $variables['insight_teaser_media'] = $em->getViewBuilder('media')->view($media, 'news');
    }
  }

  $variables['insight_teaser_category'] = '';
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term instanceof TermInterface) {
      $variables['insight_teaser_category'] = $term->getName();
    }
  }

  $variables['insight_teaser_year'] = '';
  if ($node->hasField('field_year') && !$node->get('field_year')->isEmpty()) {
    $variables['insight_teaser_year'] = (string) $node->get('field_year')->value;
  }

  $variables['insight_teaser_excerpt'] = '';
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $item = $node->get('body')->first();
    $summary = trim((string) $item->summary);
    $value = (string) $item->value;
    $raw = $summary !== '' ? $summary : $value;
    if ($raw !== '') {
      $variables['insight_teaser_excerpt'] = motaded_theme_plain_text_truncate($raw, 200);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph templates.
 *
 * Splits objectives body on a blank line into title + description when present.
 */
function motaded_theme_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];
  if ($paragraph->bundle() !== 'objectives') {
    return;
  }
  if (!$paragraph->hasField('field_content') || $paragraph->get('field_content')->isEmpty()) {
    return;
  }
  $text = trim((string) $paragraph->get('field_content')->value);
  if ($text === '') {
    return;
  }
  $parts = preg_split('/\R(?:\s*\R)+/', $text, 2);
  if (isset($parts[1])) {
    $variables['objectives_card_title'] = trim((string) $parts[0]);
    $variables['objectives_card_body'] = trim((string) $parts[1]);
  }
}

/**
 * Split promo: plain copy + media render (banner_sm / responsive image) for Twig.
 */
function motaded_theme_preprocess_paragraph__split_promo(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['split_promo_heading_id'] = Html::getUniqueId('split-promo-heading-' . $paragraph->id());

  $variables['split_promo_headline'] = '';
  if ($paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['split_promo_headline'] = trim((string) $paragraph->get('field_title')->value);
  }

  $variables['split_promo_sub'] = '';
  if ($paragraph->get('field_sub_title')->access('view') && !$paragraph->get('field_sub_title')->isEmpty()) {
    $variables['split_promo_sub'] = trim((string) $paragraph->get('field_sub_title')->value);
  }

  $bullets = [];
  $bullet_field = $paragraph->get('field_promo_bullet');
  if ($bullet_field->access('view')) {
    foreach ($bullet_field as $item) {
      $line = trim((string) $item->value);
      if ($line !== '') {
        $bullets[] = $line;
      }
    }
  }
  $variables['split_promo_bullets'] = $bullets;

  $variables['split_promo_trust'] = '';
  if ($paragraph->get('field_promo_trust')->access('view') && !$paragraph->get('field_promo_trust')->isEmpty()) {
    $variables['split_promo_trust'] = trim((string) $paragraph->get('field_promo_trust')->value);
  }

  $variables['split_promo_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['split_promo_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }
}

/**
 * Promo split: features, media (banner_sm), optional logo overlay for Twig.
 */
function motaded_theme_preprocess_paragraph__promo_split(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['promo_split_heading_id'] = Html::getUniqueId('promo-split-heading-' . $paragraph->id());

  $variables['promo_split_media_side'] = 'image_right';
  if ($paragraph->get('field_promo_split_side')->access('view') && !$paragraph->get('field_promo_split_side')->isEmpty()) {
    $variables['promo_split_media_side'] = (string) $paragraph->get('field_promo_split_side')->value;
  }

  $variables['promo_split_list_style'] = 'icons_row';
  if ($paragraph->get('field_promo_split_list_style')->access('view') && !$paragraph->get('field_promo_split_list_style')->isEmpty()) {
    $variables['promo_split_list_style'] = (string) $paragraph->get('field_promo_split_list_style')->value;
  }

  $features = [];
  $item_field = $paragraph->get('field_promo_split_item');
  if ($item_field->access('view')) {
    foreach ($item_field as $item) {
      $line = trim((string) $item->value);
      if ($line !== '') {
        $features[] = $line;
      }
    }
  }
  $variables['promo_split_features'] = $features;

  $icon_cycle = ['user', 'shield', 'globe'];
  $variables['promo_split_icon_keys'] = [];
  foreach (array_keys($features) as $i) {
    $variables['promo_split_icon_keys'][$i] = $icon_cycle[$i % 3];
  }

  $variables['promo_split_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['promo_split_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }

  $variables['promo_split_logo'] = [];
  if ($paragraph->get('field_promo_split_logo')->access('view') && !$paragraph->get('field_promo_split_logo')->isEmpty()) {
    $logo = $paragraph->get('field_promo_split_logo')->entity;
    if ($logo) {
      $variables['promo_split_logo'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($logo, 'default');
    }
  }

  $variables['promo_split_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['promo_split_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }
}

/**
 * Investor journey: nested journey_step rows for timeline Twig.
 */
function motaded_theme_preprocess_paragraph__investor_journey(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['investor_journey_heading_id'] = Html::getUniqueId('investor-journey-heading-' . $paragraph->id());

  $steps = [];
  $field = $paragraph->get('field_investor_journey_steps');
  if ($field->access('view')) {
    foreach ($field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'journey_step') {
        continue;
      }
      $icon = (string) ($sub->get('field_journey_icon')->value ?: 'document');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $row = [
        'title' => $title,
        'icon' => $icon,
      ];
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $value = (string) $sub->get('field_body')->value;
        $format = (string) ($sub->get('field_body')->format ?: 'plain_text');
        $body_markup = check_markup($value, $format);
        if ($body_markup !== '') {
          $row['body'] = Markup::create($body_markup);
        }
      }
      $steps[] = $row;
    }
  }
  $variables['investor_journey_steps'] = $steps;

  $variables['investor_journey_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['investor_journey_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }
}

/**
