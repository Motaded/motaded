/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 *
 * Builds translated chip labels for the Services directory cards.
 */
function motaded_theme_preprocess_views_view_fields(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  $display_id = $variables['display_id'] ?? $view->current_display ?? '';

  if ($view->id() === 'services' && $display_id === 'block_2') {
    $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
    $base = base_path() . $theme_path . '/img/';
    $icons = [
      'icon-growth.svg',
      'icon-globe.svg',
      'icon-checkmark-circle.svg',
      'service-cost.svg',
      'icon-target.svg',
      'service-channels.svg',
      'service-duration.svg',
      'icon-calender.svg',
    ];
    $nid = 0;
    $row = $variables['row'] ?? NULL;
    if (is_object($row) && isset($row->_entity) && $row->_entity instanceof NodeInterface) {
      $nid = (int) $row->_entity->id();
    }
    $pick = $nid > 0 ? ($nid % count($icons)) : 0;
    $variables['services_home_row_icon_url'] = $base . $icons[$pick];
    return;
  }

  if ($view->id() !== 'services' || $display_id !== 'page_1') {
    return;
  }

  $variables['services_card_eyebrow'] = '';

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId();
  $is_arabic = $langcode === 'ar';

  $variables['services_book_now_label'] = $is_arabic
    ? 'احجز الآن'
    : (string) t('Book now');
  $variables['services_explore_benefits_label'] = $is_arabic
    ? 'اكتشف المزايا'
    : (string) t('Explore benefits');

  $variables['services_beneficiary_labels'] = [];
  $variables['services_category_labels'] = [];
  $variables['services_tag_labels'] = [];

  $row = $variables['row'] ?? NULL;
  if (!is_object($row) || !isset($row->_entity)) {
    return;
  }

  $node = $row->_entity;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'page') {
    return;
  }

  if ($node->hasField('field_beneficiaries') && !$node->get('field_beneficiaries')->isEmpty()) {
    foreach ($node->get('field_beneficiaries') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_beneficiary_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }

  if ($node->hasField('field_taxonomy') && !$node->get('field_taxonomy')->isEmpty()) {
    foreach ($node->get('field_taxonomy') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_category_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }

  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    foreach ($node->get('field_tags') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_tag_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }

  $eyebrow = '';
  if ($variables['services_category_labels'] !== []) {
    $eyebrow = mb_strtoupper((string) reset($variables['services_category_labels']));
  }
  elseif ($variables['services_beneficiary_labels'] !== []) {
    $eyebrow = mb_strtoupper((string) reset($variables['services_beneficiary_labels']));
  }
  elseif ($variables['services_tag_labels'] !== []) {
    $eyebrow = mb_strtoupper((string) reset($variables['services_tag_labels']));
  }
  $variables['services_card_eyebrow'] = $eyebrow;
}

/**
 * First taxonomy term plain label from a node's entity reference field, or ''.
 */
function _motaded_theme_node_first_taxonomy_label(NodeInterface $node, string $field_name, string $langcode): string {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return '';
  }
  $referenced = $node->get($field_name)->entity;
  if (!$referenced instanceof TermInterface) {
    return '';
  }

  return motaded_theme_taxonomy_term_translated_label($referenced, $langcode !== '' ? $langcode : 'en');
}

/**
 * Implements hook_preprocess_views_view_field().
 *
 * Builds a richer FullCalendar row title field (month view) with taxonomy meta;
 * separators only between non-empty fragments.
 */
function motaded_theme_preprocess_views_view_field(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->id() !== 'events' || !in_array($view->current_display, ['block_calendar', 'attachment_page_calendar'], TRUE)) {
    return;
  }

  $handler = $variables['field'] ?? NULL;
  if (!$handler instanceof FieldPluginInterface) {
    return;
  }
  $fname = ($handler->definition['field_name'] ?? '');
  if ($fname !== 'title') {
    return;
  }

  $row = $variables['row'] ?? NULL;
  if (!is_object($row) || !isset($row->_entity)) {
    return;
  }

  $node = $row->_entity;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'event') {
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  try {
    $display_node = ($langcode !== '' && $node->hasTranslation($langcode))
      ? $node->getTranslation($langcode)
      : $node;
  }
  catch (\Exception $e) {
    $display_node = $node;
  }

  $href = Html::escape($display_node->toUrl()->toString());
  $title_text = Html::escape($display_node->label());

  $type_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_event_type', $langcode);
  $region_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_region', $langcode);

  $meta_segments = [];
  if ($type_plain !== '') {
    $meta_segments[] = Html::escape($type_plain);
  }
  if ($region_plain !== '') {
    $meta_segments[] = Html::escape($region_plain);
  }

  $html = '<div class="fc-event-card"><div class="fc-event-card__title"><a class="fc-event-card__title-link" href="' . $href . '">' . $title_text . '</a></div>';
  if ($meta_segments !== []) {
    $html .= '<div class="fc-event-card__meta">' . implode(' · ', $meta_segments) . '</div>';
  }
  $html .= '</div>';

  $variables['output'] = [
    '#markup' => Markup::create($html),
  ];
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fullcalendar.
 *
 * Adds extendedProps (event type + region) per event for JS eventContent —
 * Contrib Xss::filter on titles can strip markup from preprocess_views_view_field.
 */
function motaded_theme_preprocess_views_view_fullcalendar(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->id() !== 'events' || !in_array($view->current_display, ['block_calendar', 'attachment_page_calendar'], TRUE)) {
    return;
  }
  if (empty($variables['#attached']['drupalSettings']['fullCalendarView'])) {
    return;
  }

  $variables['#attached']['library'][] = 'motaded_theme/events_calendar_crawlable';
  $variables['#attached']['drupalSettings']['motadedEventsCalendar'] = [
    'eventsPath' => Url::fromRoute('view.events.page_1')->toString(),
    'dateFrom' => 'motaded_event_date_from',
    'dateTo' => 'motaded_event_date_to',
  ];

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  foreach (array_keys($variables['#attached']['drupalSettings']['fullCalendarView']) as $view_index) {
    $settings = &$variables['#attached']['drupalSettings']['fullCalendarView'][$view_index];
    if (empty($settings['calendar_options']) || !is_string($settings['calendar_options'])) {
      continue;
    }
    $decoded = Json::decode($settings['calendar_options']);
    if (!is_array($decoded) || empty($decoded['events']) || !is_array($decoded['events'])) {
      continue;
    }
    $nids = [];
    foreach ($decoded['events'] as $ev) {
      if (!empty($ev['eid'])) {
        $nids[(int) $ev['eid']] = (int) $ev['eid'];
      }
    }
    if ($langcode === 'ar') {
      $decoded['locale'] = 'ar';
      $decoded['direction'] = 'rtl';
      if (empty($decoded['buttonText']) || !is_array($decoded['buttonText'])) {
        $decoded['buttonText'] = [];
      }
      $decoded['buttonText']['today'] = (string) t('Today');
    }
    if ($nids === []) {
      $settings['calendar_options'] = Json::encode($decoded);
      unset($settings);
      continue;
    }
    $nodes = Node::loadMultiple($nids);
    foreach ($decoded['events'] as $i => $event) {
      $nid = isset($event['eid']) ? (int) $event['eid'] : 0;
      if ($nid < 1 || !isset($nodes[$nid])) {
        continue;
      }
      $node = $nodes[$nid];
      if (!$node instanceof NodeInterface || $node->bundle() !== 'event') {
        continue;
      }
      try {
        $display_node = ($langcode !== '' && $node->hasTranslation($langcode))
          ? $node->getTranslation($langcode)
          : $node;
      }
      catch (\Exception $e) {
        $display_node = $node;
      }
      $type_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_event_type', $langcode);
      $region_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_region', $langcode);
      $meta_parts = array_filter([$type_plain, $region_plain]);
      $existing = [];
      if (!empty($event['extendedProps']) && is_array($event['extendedProps'])) {
        $existing = $event['extendedProps'];
      }
      $decoded['events'][$i]['extendedProps'] = array_merge($existing, [
        'motaded_type' => $type_plain,
        'motaded_region' => $region_plain,
        'motaded_meta_line' => $meta_parts === [] ? '' : implode(' · ', $meta_parts),
      ]);
      if (!empty($event['title']) && is_string($event['title']) && strpos($event['title'], '<') === FALSE) {
        $decoded['events'][$i]['title'] = $display_node->label();
      }
    }
    $settings['calendar_options'] = Json::encode($decoded);
    unset($settings);
  }
}

/**
 * Returns a taxonomy term label for a requested langcode when available.
 */
function motaded_theme_taxonomy_term_translated_label(TermInterface $term, string $langcode): string {
  if ($langcode !== '' && $term->hasTranslation($langcode)) {
    return (string) $term->getTranslation($langcode)->label();
  }
  return (string) $term->label();
}

/**
 * Hides only the root exposed filter title (accordion <summary> replaces it).
 */
function motaded_theme_services_exposed_filter_suppress_wrapped_titles(array &$element): void {
  if (isset($element['#title'])) {
    $element['#title'] = '';
  }
  $element['#title_display'] = 'invisible';
}

/**
 * After-build: “All categories / sectors / regions” labels on Insights directory filters.
 */
function motaded_theme_insights_directory_views_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-insights-page-1') {
    return $form;
  }
  $pairs = [
    'field_category_target_id' => (string) t('All categories'),
    'field_sector_target_id' => (string) t('All sectors'),
    'field_region_target_id' => (string) t('All regions'),
  ];
  foreach ($pairs as $key => $all_label) {
    if (empty($form[$key]['#options']) || !is_array($form[$key]['#options'])) {
      continue;
    }
    if (isset($form[$key]['#options']['All'])) {
      $form[$key]['#options']['All'] = $all_label;
    }
  }
  return $form;
}

/**
 * After-build: “All types / industries / regions” labels on Events directory filters.
 */
function motaded_theme_events_directory_views_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-events-page-1') {
    return $form;
  }
  $pairs = [
    'field_event_type_target_id' => (string) t('All types'),
    'field_sector_pages_target_id' => (string) t('All sectors'),
    'field_region_target_id' => (string) t('All regions'),
  ];
  foreach ($pairs as $key => $all_label) {
    if (empty($form[$key]['#options']) || !is_array($form[$key]['#options'])) {
      continue;
    }
    if (isset($form[$key]['#options']['All'])) {
      $form[$key]['#options']['All'] = $all_label;
    }
  }
  return $form;
}

/**
 * After-build: “All categories / regions” labels on Platforms directory filters.
 */
function motaded_theme_platforms_directory_views_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-platforms-page-1') {
    return $form;
  }
  $pairs = [
    'field_category_target_id' => (string) t('All categories'),
    'field_region_target_id' => (string) t('All regions'),
  ];
  foreach ($pairs as $key => $all_label) {
    if (empty($form[$key]['#options']) || !is_array($form[$key]['#options'])) {
      continue;
    }
    if (isset($form[$key]['#options']['All'])) {
      $form[$key]['#options']['All'] = $all_label;
    }
  }
  return $form;
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function motaded_theme_form_views_exposed_form_alter(&$form,  Drupal\Core\Form\FormStateInterface $form_state) {
  $form_id = (string) ($form['#id'] ?? '');
  $is_arabic_interface = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId() === 'ar';

  // Views/BEF button labels are config-driven and can lag behind on multilingual
  // pages until config translation is imported. Normalize the Arabic directory
  // forms at render time so exposed filters never fall back to English.
  if ($is_arabic_interface) {
    $directory_action_labels = [
      'views-exposed-form-platforms-page-1' => [
        'submit' => 'تطبيق المرشحات',
        'reset' => 'إعادة ضبط',
      ],
      'views-exposed-form-sectors-directory-page-1' => [
        'submit' => 'بحث',
        'reset' => 'إعادة تعيين المرشحات',
      ],
      'views-exposed-form-services-page-1' => [
        'submit' => 'بحث',
        'reset' => 'إعادة تعيين المرشحات',
      ],
      'views-exposed-form-events-page-1' => [
        'submit' => 'تطبيق المرشحات',
        'reset' => 'إعادة ضبط',
      ],
      'views-exposed-form-insights-page-1' => [
        'submit' => 'تطبيق المرشحات',
        'reset' => 'إعادة ضبط',
      ],
      'views-exposed-form-chambers-page-1' => [
        'submit' => 'تطبيق المرشحات',
        'reset' => 'إعادة ضبط',
      ],
      'views-exposed-form-library-page-1' => [
        'submit' => 'تطبيق المرشحات',
        'reset' => 'إعادة ضبط',
      ],
      'views-exposed-form-news-page-1' => [
        'submit' => 'تطبيق',
        'reset' => 'مسح',
      ],
      'views-exposed-form-news-page-2' => [
        'submit' => 'تطبيق',
        'reset' => 'مسح',
      ],
    ];
    if (isset($directory_action_labels[$form_id], $form['actions']) && is_array($form['actions'])) {
      foreach ($directory_action_labels[$form_id] as $action_key => $label) {
        if (isset($form['actions'][$action_key]) && is_array($form['actions'][$action_key])) {
          $form['actions'][$action_key]['#value'] = $label;
        }
      }
    }
  }

  // ViewsExposedForm uses the view page URL as #action whenever the view has a path
  // (/events); these block displays still need to POST/GET against the current page.
  $view = $form_state->get('view');
  if (
    $view instanceof ViewExecutable
    && $view->storage->id() === 'events'
    && ($view->current_display ?? '') === 'block_calendar'
  ) {
    try {
      $form['#action'] = Url::fromRoute('<current>')->setAbsolute(FALSE)->toString();
    }
    catch (\Exception $e) {
      $request = \Drupal::request();
      $form['#action'] = $request->getBasePath() . $request->getPathInfo();
    }
  }

  if ($form_id === 'views-exposed-form-chambers-page-1' && isset($form['title']) && is_array($form['title'])) {
    $form['title']['#attributes']['placeholder'] = $is_arabic_interface
      ? 'ابحث في الغرف…'
      : (string) t('Search chambers…');
  }

  if ($form_id === 'views-exposed-form-library-page-1' && isset($form['combine']) && is_array($form['combine'])) {
    $form['combine']['#attributes']['placeholder'] = $is_arabic_interface
      ? 'البحث في الوثائق…'
      : (string) t('Search documents…');
  }

  // /blog (view: news, display: page_1): exposed combined search uses
  // identifier "search". Provide a richer placeholder and AR translation so
  // the filter never reads "Search" only.
  if ($form_id === 'views-exposed-form-news-page-1') {
    $search_keys = ['search', 'combine'];
    foreach ($search_keys as $key) {
      if (isset($form[$key]) && is_array($form[$key])) {
        $form[$key]['#attributes']['placeholder'] = $is_arabic_interface
          ? 'ابحث في المقالات، المواضيع أو الكلمات المفتاحية…'
          : (string) t('Search articles, topics, or keywords…');
      }
    }
  }

  if ($form_id === 'views-exposed-form-news-page-2') {
    $search_keys = ['search', 'combine'];
    foreach ($search_keys as $key) {
      if (isset($form[$key]) && is_array($form[$key])) {
        $form[$key]['#attributes']['placeholder'] = $is_arabic_interface
          ? 'ابحث في الأخبار…'
          : (string) t('Search news…');
      }
    }
  }

  if ($form_id === 'views-exposed-form-events-page-1') {
    $form['#attributes']['class'][] = 'events-directory__hero-exposed';
    if (isset($form['title']) && is_array($form['title'])) {
      $form['title']['#attributes']['placeholder'] = $is_arabic_interface
        ? 'ابحث في الفعاليات أو الموضوعات أو الكلمات المفتاحية…'
        : (string) t('Search events, topics, or keywords…');
      $form['title']['#weight'] = -20;
    }

    // Views-exposed date filters (From/To): force native HTML5 date picker.
    // The filters live in Views config, but we normalize the widget here.
    foreach ([
      'motaded_event_date_from' => (string) t('From'),
      'motaded_event_date_to' => (string) t('To'),
    ] as $key => $label) {
      if (!isset($form[$key]) || !is_array($form[$key])) {
        continue;
      }

      // Some views filters use a nested 'value' element; support both shapes.
      $target =& $form[$key];
      if (isset($form[$key]['value']) && is_array($form[$key]['value'])) {
        $target =& $form[$key]['value'];
      }

      // Force an actual HTML5 date input (native date picker).
      $target['#type'] = 'date';
      $target['#title'] = $label;
      $target['#attributes']['type'] = 'date';
      $target['#attributes']['class'][] = 'form-date';
      // Ensure date picker UI (no datetime widget JS).
      $target['#date_date_format'] = 'Y-m-d';
      $target['#date_time_format'] = '';
      $target['#date_timezone'] = date_default_timezone_get();
      // Some widget builds keep #type textfield + form-date class; override explicitly.
      if (($target['#type'] ?? '') === 'textfield') {
        $target['#type'] = 'date';
      }
      // Also set on wrapper element in case the view uses the parent element.
      $form[$key]['#type'] = 'date';
      $form[$key]['#attributes']['type'] = 'date';
      $form[$key]['#attributes']['class'][] = 'form-date';
      // Ensure our hero CSS hooks apply.
      $form[$key]['#wrapper_attributes']['class'][] = 'form-item-' . str_replace('_', '-', $key);
    }

    $form['#after_build'][] = 'motaded_theme_events_directory_views_exposed_form_after_build';
  }

  if ($form_id === 'views-exposed-form-insights-page-1') {
    $form['#attributes']['class'][] = 'insights-directory__hero-exposed';
    if (isset($form['title']) && is_array($form['title'])) {
      $form['title']['#attributes']['placeholder'] = $is_arabic_interface
        ? 'ابحث في الرؤى أو المواضيع أو الكلمات المفتاحية…'
        : (string) t('Search insights, topics, or keywords…');
      $form['title']['#weight'] = -20;
    }
    $form['#after_build'][] = 'motaded_theme_insights_directory_views_exposed_form_after_build';
  }

  if ($form_id === 'views-exposed-form-sectors-directory-page-1' && isset($form['title']) && is_array($form['title'])) {
    $form['title']['#attributes']['placeholder'] = $is_arabic_interface
      ? 'ابحث في القطاعات…'
      : (string) t('Search sectors…');
  }

  if ($form_id === 'views-exposed-form-platforms-page-1') {
    $form['#attributes']['class'][] = 'platforms-directory__hero-exposed';
    if (isset($form['title']) && is_array($form['title'])) {
      $form['title']['#attributes']['placeholder'] = $is_arabic_interface
        ? 'ابحث في المنصات أو الخدمات أو الكلمات المفتاحية…'
        : (string) t('Search platforms, services, or keywords…');
      $form['title']['#weight'] = -20;
    }
    $form['#after_build'][] = 'motaded_theme_platforms_directory_views_exposed_form_after_build';
  }

  if ($form['#id'] == 'views-exposed-form-services-block-2') {
    if (!isset($form['field_taxonomy_target_id'])) {
      return;
    }

    // Remove "All".
    unset($form['field_taxonomy_target_id']['#options']['All']);

    $options = $form['field_taxonomy_target_id']['#options'];
    $first = array_key_first($options);

    $input = $form_state->getUserInput();
    $val = $input['field_taxonomy_target_id'] ?? NULL;

    // Only set first when value missing or "All".
    if ($val === 'All' || empty($val)) {
      $form['field_taxonomy_target_id']['#default_value'] = $first;
      $input['field_taxonomy_target_id'] = $first;
      $form_state->setUserInput($input);
    }

    $form['#after_build'][] = 'motaded_theme_services_home_block_exposed_after_build';
  }

  if (($form['#id'] ?? '') === 'views-exposed-form-services-page-1') {
    $form['#attributes']['class'][] = 'services-directory__exposed-form';
    $form['#attributes']['class'][] = 'services-directory__exposed-form--contents';

    // Defensive: normalize deep-linked query params for taxonomy filters.
    // If BEF renders this filter as checkboxes, the expected input is an array:
    // field_taxonomy_target_id[156]=156. Some links use scalar (?field_taxonomy_target_id=156),
    // which breaks FormBuilder input handling.
    if (!empty($form['field_taxonomy_target_id']) && is_array($form['field_taxonomy_target_id'])) {
      $el =& $form['field_taxonomy_target_id'];
      $input = $form_state->getUserInput();
      $raw = $input['field_taxonomy_target_id'] ?? \Drupal::request()->query->get('field_taxonomy_target_id');

      $type = (string) ($el['#type'] ?? '');
      $is_multiple = !empty($el['#multiple']) || $type === 'checkboxes';

      if ($is_multiple && is_scalar($raw)) {
        $tid = (string) $raw;
        if ($tid !== '' && ctype_digit($tid)) {
          $input['field_taxonomy_target_id'] = [$tid => $tid];
          $form_state->setUserInput($input);
        }
      }
      elseif (!$is_multiple && is_array($raw)) {
        $tid = (string) reset($raw);
        if ($tid !== '' && ctype_digit($tid)) {
          $input['field_taxonomy_target_id'] = $tid;
          $form_state->setUserInput($input);
        }
      }
    }

    // Better Exposed Filters can build some option labels after generic form alters.
    // Ensure Arabic labels for the "All" option and submit/reset strings are applied
    // on the final render array.
    $form['#after_build'][] = 'motaded_theme_services_views_exposed_form_after_build';
  }

  $lib_forms = ['views-exposed-form-library-block-1', 'views-exposed-form-library-page-1'];
  if (in_array(($form['#id'] ?? ''), $lib_forms, TRUE)) {
    unset($form['library_section_hidden']);

    $nav_class = ($form['#id'] ?? '') === 'views-exposed-form-library-page-1'
      ? 'library-directory__tab-cards'
      : 'library-home-view__tab-cards';
    $section_key = NULL;
    foreach (Element::children($form) as $child_key) {
      if ($child_key === 'library_section' || $child_key === 'field_library_section_target_id' || str_contains($child_key, 'library_section')) {
        $section_key = $child_key;
        break;
      }
    }
    if ($section_key !== NULL && !empty($form[$section_key]) && is_array($form[$section_key])) {
      $form[$section_key]['#weight'] = -100;
      $aria = Html::escape((string) t('Library sections'));
      $form[$section_key]['#prefix'] = '<nav class="' . Html::escape($nav_class) . '" aria-label="' . $aria . '">'
        . ($form[$section_key]['#prefix'] ?? '');
      $form[$section_key]['#suffix'] = ($form[$section_key]['#suffix'] ?? '') . '</nav>';
    }

    // Views taxonomy exposed filters can be configured to only list terms "in use".
    // When we deep-link from sidebar (query string), the selected TID may be absent
    // from #options, which triggers "submitted value is not allowed".
    // Filter URL identifier is `library_category` (not field_category_target_id) to avoid
    // colliding with other homepage Views (e.g. events) that share the global query string.
    $cat_key = !empty($form['library_category']) ? 'library_category' : 'field_category_target_id';
    if (!empty($form[$cat_key]) && is_array($form[$cat_key])) {
      $element =& $form[$cat_key];
      if (!empty($element['#options']) && is_array($element['#options'])) {
        $input = $form_state->getUserInput();
        $req = \Drupal::request();
        $raw = $input[$cat_key] ?? $req->query->get('library_category') ?? $req->query->get('field_category_target_id');
        $tid = is_array($raw) ? (string) reset($raw) : (is_scalar($raw) ? (string) $raw : '');
        if ($tid !== '' && ctype_digit($tid) && !isset($element['#options'][$tid])) {
          try {
            $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load((int) $tid);
            if ($term && method_exists($term, 'label')) {
              $element['#options'][$tid] = $term->label();
              // Ensure the element is set to the provided value.
              $element['#default_value'] = $tid;
            }
          }
          catch (\Throwable $e) {
            // Ignore invalid IDs; keep default validation behavior.
          }
        }
      }
    }
    // Library block is linked to the page display (/library), so core sets exposed
    // #action to that path. On /front (viewsreference, etc.) that breaks Views AJAX and
    // causes a full jump to /library. Mirror events block_calendar: submit against current
    // path only when not building the form on the views.ajax route.
    $library_view = $form_state->get('view');
    if (
      $library_view instanceof ViewExecutable
      && $library_view->storage->id() === 'library'
      && ($library_view->current_display ?? '') === 'block_1'
      && \Drupal::routeMatch()->getRouteName() !== 'views.ajax'
    ) {
      try {
        $form['#action'] = Url::fromRoute('<current>')->setAbsolute(FALSE)->toString();
      }
      catch (\Exception $e) {
        $req_action = \Drupal::request();
        $form['#action'] = $req_action->getBasePath() . $req_action->getPathInfo();
      }
    }
    $form['#attributes']['class'][] = 'library-view__exposed-form';
    foreach (['library_category', 'field_category_target_id'] as $cat_hide_key) {
      if (!empty($form[$cat_hide_key]) && is_array($form[$cat_hide_key])) {
        $form[$cat_hide_key]['#title'] = '';
        $form[$cat_hide_key]['#title_display'] = 'invisible';
        $form[$cat_hide_key]['#attributes']['class'][] = 'library-exposed__category--inline';
      }
    }
    if (($form['#id'] ?? '') === 'views-exposed-form-library-block-1') {
      if (isset($form['sort_by']) && is_array($form['sort_by'])) {
        $form['sort_by']['#access'] = FALSE;
      }
      if (isset($form['sort_order']) && is_array($form['sort_order'])) {
        $form['sort_order']['#access'] = FALSE;
      }
    }
    if (isset($form['search']) && is_array($form['search'])) {
      $form['search']['#attributes']['placeholder'] = $is_arabic_interface
        ? 'ابحث في الوثائق والقوالب والنماذج والأدلة…'
        : (string) t('Search documents, templates, forms, guides…');
    }
    $form['#after_build'][] = 'motaded_theme_library_views_exposed_form_after_build';
  }

}

/**
 * After-build: Library exposed — Apply/Reset button classes.
 */
function motaded_theme_library_views_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  $fid = $form['#id'] ?? '';
  if (!in_array($fid, ['views-exposed-form-library-block-1', 'views-exposed-form-library-page-1'], TRUE)) {
    return $form;
  }
  if (isset($form['library_section']['#options']) && is_array($form['library_section']['#options'])) {
    foreach ($form['library_section']['#options'] as $key => $label) {
      $label_plain = trim((string) $label);
      if ($label_plain === 'Document templates & forms') {
        $form['library_section']['#options'][$key] = \Drupal\Core\Render\Markup::create(
          '<span class="library-directory__tab-card-body">'
          . '<span class="library-directory__tab-card-title">' . (string) t('Document templates & forms') . '</span>'
          . ' '
          . '<span class="library-directory__tab-card-desc">'
          . (string) t('Contracts, checklists, and downloadable guides for day-to-day operations.')
          . '</span>'
          . '</span>'
        );
      }
      elseif ($label_plain === 'Regulations & laws') {
        $form['library_section']['#options'][$key] = \Drupal\Core\Render\Markup::create(
          '<span class="library-directory__tab-card-body">'
          . '<span class="library-directory__tab-card-title">' . (string) t('Regulations & laws') . '</span>'
          . ' '
          . '<span class="library-directory__tab-card-desc">'
          . (string) t('Official instruments, policies, and regulatory references.')
          . '</span>'
          . '</span>'
        );
      }
    }
  }
  if (isset($form['actions']['submit']) && is_array($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'][] = 'library-exposed__submit';
    $form['actions']['submit']['#attributes']['class'][] = 'button';
  }
  if (isset($form['actions']['reset']) && is_array($form['actions']['reset'])) {
    $form['actions']['reset']['#attributes']['class'][] = 'library-exposed__reset';
    $form['actions']['reset']['#attributes']['class'][] = 'button';
  }
  return $form;
}

/**
 * Resolves the attached document media file for a document node.
 *
 * @return array{url: string, filename: string, size_label: string, mime_label: string}|null
 */
function _motaded_theme_document_file_from_node(NodeInterface $node, ?string $langcode = NULL): ?array {
  if (!$node->hasField('field_document') || $node->get('field_document')->isEmpty()) {
    return NULL;
  }
  $media = $node->get('field_document')->entity;
  if (!$media instanceof MediaInterface
    || !$media->hasField('field_media_document')
    || $media->get('field_media_document')->isEmpty()) {
    return NULL;
  }
  $file = $media->get('field_media_document')->entity;
  if (!$file instanceof FileInterface) {
    return NULL;
  }
  $langcode ??= $node->language()->getId();
  $t_opts = ['langcode' => $langcode];
  $mime = (string) $file->getMimeType();
  $mime_label = match (TRUE) {
    str_contains($mime, 'pdf') => (string) t('PDF Document', [], $t_opts),
    str_contains($mime, 'word') || str_contains($mime, 'document') => (string) t('Word document', [], $t_opts),
    str_contains($mime, 'sheet') || str_contains($mime, 'excel') => (string) t('Spreadsheet', [], $t_opts),
    default => (string) t('Document', [], $t_opts),
  };
  return [
    'url' => \Drupal::service('file_url_generator')->generateString($file->getFileUri()),
    'filename' => $file->getFilename(),
    'size_label' => _motaded_theme_format_bytes((int) $file->getSize()),
    'mime_label' => $mime_label,
  ];
}

/**
 * Preprocess variables for document full page (hero, download, meta, related).
 */
function _motaded_theme_preprocess_document_node_full(array &$variables, NodeInterface $node): void {
  $variables['#attached']['library'][] = 'motaded_theme/document_page';
  $langcode = $node->language()->getId();
  $node = \Drupal::service('entity.repository')->getTranslationFromContext($node, $langcode);
  $variables['document_library_url'] = '/library';
  try {
    $language = \Drupal::languageManager()->getLanguage($langcode);
    $variables['document_library_url'] = Url::fromRoute('view.library.page_1', [], ['language' => $language])->toString();
  }
  catch (\Throwable $e) {
    // Fallback internal path.
  }
  $t_opts = ['langcode' => $langcode];
  $variables['document_langcode'] = $langcode;
  $variables['document_is_rtl'] = ($langcode === 'ar');
  $variables['document_related_arrow'] = $langcode === 'ar' ? '←' : '→';
  $variables['document_breadcrumb_title'] = $node->getTitle();
  $variables['document_type_label'] = '';
  $variables['document_category_label'] = '';
  if ($node->hasField('field_document_type') && !$node->get('field_document_type')->isEmpty()) {
    $term = $node->get('field_document_type')->entity;
    if ($term instanceof TermInterface) {
      $variables['document_type_label'] = motaded_theme_taxonomy_term_translated_label($term, $langcode);
    }
  }
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $term = $node->get('field_category')->entity;
    if ($term instanceof TermInterface) {
      $variables['document_category_label'] = motaded_theme_taxonomy_term_translated_label($term, $langcode);
    }
  }

  $file = _motaded_theme_document_file_from_node($node, $langcode);
  $variables['document_file_url'] = $file['url'] ?? '';
  $variables['document_file_name'] = $file['filename'] ?? '';
  $variables['document_file_size'] = $file['size_label'] ?? '';
  $variables['document_file_mime_label'] = $file['mime_label'] ?? '';
  $type_label = $variables['document_type_label'];
  $variables['document_download_kicker'] = (stripos($type_label, 'guide') !== FALSE || stripos($type_label, 'دليل') !== FALSE)
    ? (string) t('Download guide', [], $t_opts)
    : (string) t('Download', [], $t_opts);

  $variables['document_meta_items'] = [];
  if ($node->hasField('field_country') && !$node->get('field_country')->isEmpty()) {
    $term = $node->get('field_country')->entity;
    if ($term instanceof TermInterface) {
      $variables['document_meta_items'][] = [
        'icon' => 'globe',
        'label' => (string) t('Country', [], $t_opts),
        'value' => motaded_theme_taxonomy_term_translated_label($term, $langcode),
        'url' => '',
      ];
    }
  }
  if ($node->hasField('field_year') && !$node->get('field_year')->isEmpty()) {
    $variables['document_meta_items'][] = [
      'icon' => 'calendar',
      'label' => (string) t('Publication year', [], $t_opts),
      'value' => (string) $node->get('field_year')->value,
      'url' => '',
    ];
  }
  if ($node->hasField('field_source_link') && !$node->get('field_source_link')->isEmpty()) {
    $link_item = $node->get('field_source_link')->first();
    if ($link_item) {
      $url = $link_item->getUrl()->toString();
      $title = trim((string) $link_item->title);
      $variables['document_meta_items'][] = [
        'icon' => 'link',
        'label' => (string) t('Official source', [], $t_opts),
        'value' => $title !== '' ? $title : $url,
        'url' => $url,
      ];
    }
  }
  if ($node->hasField('field_services') && !$node->get('field_services')->isEmpty()) {
    $links = [];
    foreach ($node->get('field_services')->referencedEntities() as $ref) {
      if ($ref instanceof NodeInterface) {
        $ref = \Drupal::service('entity.repository')->getTranslationFromContext($ref, $langcode);
        $links[] = [
          'title' => $ref->label(),
          'url' => $ref->toUrl()->toString(),
        ];
      }
    }
    if ($links !== []) {
      $variables['document_meta_items'][] = [
        'icon' => 'service',
        'label' => (string) t('Related services', [], $t_opts),
        'value' => '',
        'links' => $links,
      ];
    }
  }
  if ($node->hasField('field_sector_pages') && !$node->get('field_sector_pages')->isEmpty()) {
    $links = [];
    foreach ($node->get('field_sector_pages')->referencedEntities() as $ref) {
      if ($ref instanceof NodeInterface) {
        $ref = \Drupal::service('entity.repository')->getTranslationFromContext($ref, $langcode);
        $links[] = [
          'title' => $ref->label(),
          'url' => $ref->toUrl()->toString(),
        ];
      }
    }
    if ($links !== []) {
      $variables['document_meta_items'][] = [
        'icon' => 'sector',
        'label' => (string) t('Related sectors', [], $t_opts),
        'value' => '',
        'links' => $links,
      ];
    }
  }
  if ($node->hasField('field_platforms') && !$node->get('field_platforms')->isEmpty()) {
    $links = [];
    foreach ($node->get('field_platforms')->referencedEntities() as $ref) {
      if ($ref instanceof NodeInterface) {
        $ref = \Drupal::service('entity.repository')->getTranslationFromContext($ref, $langcode);
        $links[] = [
          'title' => $ref->label(),
          'url' => $ref->toUrl()->toString(),
        ];
      }
    }
    if ($links !== []) {
      $variables['document_meta_items'][] = [
        'icon' => 'platform',
        'label' => (string) t('Related platforms', [], $t_opts),
        'value' => '',
        'links' => $links,
      ];
    }
  }

  $variables['document_related'] = _motaded_theme_document_related_resources($node, $langcode);
}

/**
 * Loads up to three related published documents in the current language.
 *
 * @return list<array{url: string, title: string, summary: string, category_label: string, mime_label: string, size_label: string}>
 */
function _motaded_theme_document_related_resources(NodeInterface $node, string $langcode): array {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $exclude = [(int) $node->id()];

  $nids = [];
  if ($node->hasField('field_category') && !$node->get('field_category')->isEmpty()) {
    $nids = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'document')
      ->condition('status', 1)
      ->condition('langcode', $langcode)
      ->condition('nid', $exclude, 'NOT IN')
      ->condition('field_category', $node->get('field_category')->target_id)
      ->sort('changed', 'DESC')
      ->range(0, 3)
      ->execute();
  }
  if (count($nids) < 3 && $node->hasField('field_document_type') && !$node->get('field_document_type')->isEmpty()) {
    $more = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'document')
      ->condition('status', 1)
      ->condition('langcode', $langcode)
      ->condition('nid', array_merge($exclude, array_map('intval', $nids)), 'NOT IN')
      ->condition('field_document_type', $node->get('field_document_type')->target_id)
      ->sort('changed', 'DESC')
      ->range(0, 3 - count($nids))
      ->execute();
    $nids = array_merge($nids, $more);
  }
  if (count($nids) < 3) {
    $more = $storage->getQuery()
      ->accessCheck(TRUE)
      ->condition('type', 'document')
      ->condition('status', 1)
      ->condition('langcode', $langcode)
      ->condition('nid', array_merge($exclude, array_map('intval', $nids)), 'NOT IN')
      ->sort('changed', 'DESC')
      ->range(0, 3 - count($nids))
      ->execute();
    $nids = array_merge($nids, $more);
  }

  $out = [];
  foreach ($storage->loadMultiple($nids) as $related) {
    if (!$related instanceof NodeInterface) {
      continue;
    }
    $related = \Drupal::service('entity.repository')->getTranslationFromContext($related, $langcode);
    $category_label = '';
    if ($related->hasField('field_category') && !$related->get('field_category')->isEmpty()) {
      $term = $related->get('field_category')->entity;
      if ($term instanceof TermInterface) {
        $category_label = motaded_theme_taxonomy_term_translated_label($term, $langcode);
      }
    }
    $file = _motaded_theme_document_file_from_node($related, $langcode);
    $summary = '';
    if ($related->hasField('field_short_description') && !$related->get('field_short_description')->isEmpty()) {
      $summary = (string) $related->get('field_short_description')->value;
    }
    $out[] = [
      'url' => $related->toUrl()->toString(),
      'title' => $related->label(),
      'summary' => $summary,
      'category_label' => $category_label,
      'mime_label' => $file['mime_label'] ?? (string) t('PDF', [], ['langcode' => $langcode]),
      'size_label' => $file['size_label'] ?? '',
    ];
  }
  return $out;
}

/**
 * Preprocesses Library view row fields: file URL + human link label for the template.
 */
function motaded_theme_preprocess_views_view_fields__library(array &$variables): void {
  $variables['library_row_file_url'] = '';
  $variables['library_row_file_label'] = '';
  $variables['library_row_node_url'] = '';
  $variables['library_row_title'] = '';

  $row = $variables['row'] ?? NULL;
  if (!is_object($row) || !isset($row->_entity)) {
    return;
  }
  $entity = $row->_entity;
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'document') {
    return;
  }

  $langcode = motaded_theme_interface_langcode();
  if (!$entity->hasTranslation($langcode)) {
    return;
  }
  $entity = $entity->getTranslation($langcode);
  $variables['library_row_node_url'] = $entity->toUrl('canonical', ['language' => \Drupal::languageManager()->getLanguage($langcode)])->toString();
  $variables['library_row_title'] = $entity->label();
  $variables['library_row_file_label'] = (string) t('Open document', [], ['langcode' => $langcode]);
  $variables['library_row_category_label'] = '';
  if ($entity->hasField('field_category') && !$entity->get('field_category')->isEmpty()) {
    $category = $entity->get('field_category')->entity;
    if ($category instanceof TermInterface) {
      $variables['library_row_category_label'] = motaded_theme_entity_label_in_language($category, $langcode);
    }
  }

  if (!$entity->hasField('field_document') || $entity->get('field_document')->isEmpty()) {
    return;
  }
  $media = $entity->get('field_document')->entity;
  if (!$media instanceof MediaInterface) {
    return;
  }
  if (!$media->hasField('field_media_document') || $media->get('field_media_document')->isEmpty()) {
    return;
  }
  $file = $media->get('field_media_document')->entity;
  if (!$file instanceof FileInterface) {
    return;
  }
  $variables['library_row_file_url'] = \Drupal::service('file_url_generator')->generateString($file->getFileUri());
}

/**
 * After-build: prepend sidebar icons to category radios (services home block).
 */
function motaded_theme_services_home_block_exposed_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-services-block-2') {
    return $form;
  }
  if (empty($form['field_taxonomy_target_id']) || !is_array($form['field_taxonomy_target_id'])) {
    return $form;
  }

  $element = &$form['field_taxonomy_target_id'];
  $theme_path = \Drupal::service('extension.list.theme')->getPath('motaded_theme');
  $base = base_path() . $theme_path . '/img/';
  $map = [
    '152' => 'service-cost.svg',
    '154' => 'icon-globe.svg',
    '156' => 'icon-growth.svg',
  ];
  $fallback = ['icon-target.svg', 'icon-checkmark-circle.svg', 'service-channels.svg'];
  $i = 0;

  foreach (Element::children($element) as $key) {
    if (!is_numeric($key)) {
      continue;
    }
    if (!isset($element[$key]) || !is_array($element[$key])) {
      continue;
    }
    $tid = (string) $key;
    $file = $map[$tid] ?? $fallback[$i % count($fallback)];
    $i++;
    $src = $base . $file;
    $icon_alt = '';
    $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load((int) $tid);
    if ($term instanceof TermInterface) {
      $label = motaded_theme_entity_label_in_language($term);
      if ($label !== '') {
        $element[$key]['#title'] = $label;
        $icon_alt = $label;
      }
    }
    if ($icon_alt === '') {
      $icon_alt = (string) t('Service category');
    }
    $icon_markup = '<span class="services-home-sidebar-radio__icon" aria-hidden="true"><img src="' . Html::escape($src) . '" alt="' . Html::escape($icon_alt) . '" width="22" height="22" loading="lazy" decoding="async" /></span>';
    $element[$key]['#prefix'] = ($element[$key]['#prefix'] ?? '') . Markup::create($icon_markup);
  }

  // Always show every category: disable BEF soft-limit JS (non-zero soft_limit loads
  // bef_soft_limit.js which hides radios past the limit — misconfigured limit shows ~3).
  if (!empty($form['#attached']['library']) && is_array($form['#attached']['library'])) {
    $form['#attached']['library'] = array_values(array_filter(
      $form['#attached']['library'],
      static fn ($lib) => $lib !== 'better_exposed_filters/soft_limit'
    ));
  }
  if (isset($form['#attached']['drupalSettings']['better_exposed_filters']['soft_limit'])) {
    unset($form['#attached']['drupalSettings']['better_exposed_filters']['soft_limit']);
  }

  return $form;
}

/**
 * After-build callback: finalizes Arabic strings for Services directory exposed form.
 */
function motaded_theme_services_views_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-services-page-1') {
    return $form;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  if ($langcode !== 'ar') {
    return $form;
  }

  if (isset($form['actions']['submit']) && is_array($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = 'بحث';
  }
  if (isset($form['actions']['reset']) && is_array($form['actions']['reset'])) {
    $form['actions']['reset']['#value'] = 'إعادة تعيين المرشحات';
  }

  foreach (['field_beneficiaries_target_id', 'field_sector_target_id', 'field_tags_target_id'] as $key) {
    if (empty($form[$key]) || !is_array($form[$key])) {
      continue;
    }
    if ($key === 'field_beneficiaries_target_id') {
      motaded_theme_services_rewrite_all_option_label($form[$key], ['beneficiaries', 'المستفيدون', 'All stages', 'Business journey', 'Beneficiaries', 'جميع المراحل'], 'الكل');
    }
    elseif ($key === 'field_sector_target_id') {
      motaded_theme_services_rewrite_all_option_label($form[$key], ['All sectors', 'Sector', 'جميع القطاعات', 'القطاع'], 'الكل');
    }
    else {
      motaded_theme_services_rewrite_all_option_label($form[$key], ['tags', 'الوسوم', 'All types', 'All tags', 'Business type', 'جميع الأنواع', 'جميع الوسوم'], 'الكل');
    }
  }

  return $form;
}

/**
 * Rewrites Views/BEF "All" option label for Arabic when it still shows English.
 *
 * @param array $element
 *   A form element (possibly nested) that may contain #options.
 * @param array $english_labels
 *   English labels that should be rewritten to Arabic for the "All" option.
 * @param string $replacement
 *   Replacement label for the "All" option.
 */
function motaded_theme_services_rewrite_all_option_label(array &$element, array $english_labels, string $replacement): void {
  if (isset($element['#options']) && is_array($element['#options']) && isset($element['#options']['All']) && is_string($element['#options']['All'])) {
    $current = trim($element['#options']['All']);
    $lower = mb_strtolower($current);
    foreach ($english_labels as $candidate) {
      $candidate = trim((string) $candidate);
      if ($candidate === '') {
        continue;
      }
      if (mb_strtolower($candidate) === $lower) {
        $element['#options']['All'] = $replacement;
        break;
      }
    }
  }

  foreach (Element::children($element) as $child) {
    if (isset($element[$child]) && is_array($element[$child])) {
      motaded_theme_services_rewrite_all_option_label($element[$child], $english_labels, $replacement);
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 * Prefill service field in contact webform based on query parameter.
 */
function motaded_theme_form_alter(&$form,  Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if ($form_id == "webform_submission_contact_add_form") {
    $nid = \Drupal::request()->request->get('service_id');

    if (!empty($nid) && is_numeric($nid)) {
      $node = Node::load($nid);
      if ($node) {
        $url = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
        $form['elements']['service']['#default_value'] = $url;
      }
    }
  }


}

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function motaded_theme_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  if (\Drupal::routeMatch()->getParameter('theme') !== 'motaded_theme') {
    return;
  }

  $form['motaded_linkedin'] = [
    '#type' => 'details',
    '#title' => t('LinkedIn tracking'),
    '#open' => FALSE,
  ];
  $form['motaded_linkedin']['linkedin_contact_lead_conversion_id'] = [
    '#type' => 'textfield',
    '#title' => t('LinkedIn: contact form lead conversion ID'),
    '#default_value' => theme_get_setting('linkedin_contact_lead_conversion_id') ?: '',
    '#description' => t('Digits only — from LinkedIn Campaign Manager → Conversions (not the Insight partner ID). Do not enter Google Ads IDs (AW-…); those belong in Google Tag Manager. Leave empty to skip LinkedIn conversion tracking on the thank-you page.'),
    '#maxlength' => 24,
    '#pattern' => '\d*',
  ];
}

/**
 * Passes LinkedIn conversion ID to the contact webform confirmation page template.
 */
function motaded_theme_preprocess_page__webform__contact__confirmation(&$variables) {
  $raw = theme_get_setting('linkedin_contact_lead_conversion_id');
  $id = is_string($raw) ? trim($raw) : '';
  if ($id !== '' && ctype_digit($id)) {
    $variables['linkedin_contact_lead_conversion_id'] = (int) $id;
  }
}

/**
 * Drops invalid theme hook suggestions (non-strings break ThemeRegistry::has()).
 *
 * @param string[] $suggestions
 *   Theme hook suggestions, by reference.
 * @param string|null $exclude
 *   Optional suggestion name to remove.
 */
function _motaded_theme_prune_node_theme_suggestions(array &$suggestions, ?string $exclude = NULL, bool $strip_cnb_home = FALSE): void {
  foreach ($suggestions as $delta => $suggestion) {
    if (!is_string($suggestion)) {
      unset($suggestions[$delta]);
      continue;
    }
    if ($strip_cnb_home && str_contains($suggestion, 'cnb_home')) {
      unset($suggestions[$delta]);
      continue;
    }
    if ($exclude !== NULL && $suggestion === $exclude) {
      unset($suggestions[$delta]);
    }
  }
  $suggestions = array_values($suggestions);
}

/**
 * Implements hook_theme_suggestions_node_alter().
 */
function motaded_theme_theme_suggestions_node_alter(array &$suggestions, array $variables): void {
  $node = $variables['elements']['#node'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  if ($node->bundle() === 'chamber' && ($variables['elements']['#view_mode'] ?? '') === 'chamber_card') {
    $route_name = \Drupal::routeMatch()->getRouteName();
    // Directory: never use the homepage embed template (stale drupal_static or contrib
    // must not switch card chrome here).
    if ($route_name === 'view.chambers.page_1') {
      _motaded_theme_prune_node_theme_suggestions($suggestions, strip_cnb_home: TRUE);
      return;
    }
    _motaded_theme_prune_node_theme_suggestions($suggestions);
    if ($route_name !== 'view.chambers.page_1'
      && drupal_static('motaded_cnb_home_chamber_card_layout', FALSE)) {
      $suggestions[] = 'node__chamber__chamber_card__cnb_home';
    }
    return;
  }
  if ($node->bundle() !== 'market_insight' || ($variables['elements']['#view_mode'] ?? '') !== 'full') {
    return;
  }
  if ($node->hasField('field_insight_shell') && $node->get('field_insight_shell')->value === 'platform') {
    // Appended last so after array_reverse() it is tried first (most specific).
    $suggestions[] = 'node__market_insight__platform';
  }
}

/**
 *  Block suggestions for custom block bundles.
 */
function motaded_theme_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (isset($variables['elements']['content']['#block_content'])) {
    array_splice($suggestions, 1, 0, 'block__bundle__' . $variables['elements']['content']['#block_content']->bundle());
  }
}
