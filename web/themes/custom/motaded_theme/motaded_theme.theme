/**
 * Chip labels for /sectors cards: primary taxonomy term + &lt;li&gt; text from highlights.
 *
 * @return list<string>
 */
function _motaded_theme_sector_directory_tag_labels(NodeInterface $node, int $max = 5): array {
  $tags = [];
  if ($node->hasField('field_sector') && !$node->get('field_sector')->isEmpty()) {
    $term = $node->get('field_sector')->entity;
    if ($term instanceof TermInterface) {
      $tags[] = motaded_theme_entity_label_in_language($term, $node->language()->getId());
    }
  }
  if ($node->hasField('field_sector_highlights') && !$node->get('field_sector_highlights')->isEmpty()) {
    $html = (string) $node->get('field_sector_highlights')->value;
    if ($html !== '' && preg_match_all('@<li[^>]*>\s*(.*?)\s*</li>@is', $html, $matches)) {
      foreach ($matches[1] as $raw) {
        $text = trim(html_entity_decode(strip_tags($raw), ENT_QUOTES | ENT_HTML5, 'UTF-8'));
        if ($text === '') {
          continue;
        }
        if (!in_array($text, $tags, TRUE)) {
          $tags[] = $text;
        }
        if (count($tags) >= $max) {
          break;
        }
      }
    }
  }
  return array_slice($tags, 0, $max);
}

/**
 * Builds variables for the “Market indicators” strip under Glance KPI cards.
 */
/**
 * Display label for homepage market indicators (glance block), no external link.
 */
function _motaded_theme_market_indicator_public_source(): string {
  return (string) t('Data Saudi');
}

function _motaded_theme_glance_market_indicators_variables(): array {
  $source_label = _motaded_theme_market_indicator_public_source();
  $fallback = [
    'show' => FALSE,
    'rows' => [],
    'chart_year_min' => 0,
    'chart_year_max' => 0,
    'chart_svg' => NULL,
    'chart_source_label' => $source_label,
    'more_url' => '',
  ];
  if (!\Drupal::moduleHandler()->moduleExists('motaded_custom') || !function_exists('motaded_custom_market_indicators_table_rows')) {
    return $fallback;
  }
  $fallback['show'] = TRUE;
  $order = [
    'gdp_growth' => (string) t('GDP Growth'),
    'population' => (string) t('Population'),
    'fdi_inflow' => (string) t('FDI Inflows'),
    'inflation' => (string) t('Inflation Rate'),
    'unemployment' => (string) t('Unemployment Rate'),
  ];
  $db_rows = motaded_custom_market_indicators_table_rows();
  $by_key = [];
  foreach ($db_rows as $r) {
    if (!empty($r['indicator_key'])) {
      $by_key[(string) $r['indicator_key']] = $r;
    }
  }
  $rows = [];
  foreach ($order as $key => $default_label) {
    $r = $by_key[$key] ?? NULL;
    $value_display = ($r !== NULL && isset($r['value_display'])) ? trim((string) $r['value_display']) : '';
    $label = ($r !== NULL && isset($r['label']) && trim((string) $r['label']) !== '') ? trim((string) $r['label']) : $default_label;
    $rows[] = [
      'indicator' => (string) t($label),
      'value' => $value_display !== '' ? $value_display : '—',
      'year' => ($r !== NULL && isset($r['year'])) ? (string) (int) $r['year'] : '—',
      'source' => $source_label,
      'source_url' => '',
    ];
  }
  $time = \Drupal::time()->getRequestTime();
  $current_year = (int) gmdate('Y', $time);
  $chart_year_min = $current_year - 5;
  $chart_year_max = $current_year;
  $series = function_exists('motaded_custom_market_indicators_gdp_growth_series')
    ? motaded_custom_market_indicators_gdp_growth_series()
    : [];
  $fallback['rows'] = $rows;
  $fallback['chart_year_min'] = $chart_year_min;
  $fallback['chart_year_max'] = $chart_year_max;
  $fallback['chart_svg'] = _motaded_theme_glance_market_chart_svg_markup($series, $chart_year_min, $chart_year_max);
  $fallback['chart_source_label'] = $source_label;
  return $fallback;
}

/**
 * SVG line chart for GDP growth (numeric data only in markup).
 *
 * @param list<array{year: int, value: float}> $series
 */
function _motaded_theme_glance_market_chart_svg_markup(array $series, int $year_min, int $year_max): ?Markup {
  if ($series === []) {
    return NULL;
  }
  $w = 520;
  $h = 300;
  $pl = 52;
  $pr = 16;
  $pad_top = 18;
  $pb = 44;
  $pw = $w - $pl - $pr;
  $ph = $h - $pad_top - $pb;
  $vals = array_column($series, 'value');
  $y_min = min(array_merge([-2.0], array_map('floatval', $vals)));
  $y_max = max(array_merge([10.0], array_map('floatval', $vals)));
  if ($y_max <= $y_min) {
    $y_max = $y_min + 1.0;
  }
  $pad = ($y_max - $y_min) * 0.06;
  $y_min -= $pad;
  $y_max += $pad;
  $year_span = max(1, $year_max - $year_min);
  $ticks = 5;
  $parts = [];
  $circles = [];
  foreach ($series as $obs) {
    $year = (int) $obs['year'];
    $val = (float) $obs['value'];
    $x = $pl + (($year - $year_min) / $year_span) * $pw;
    $y = $pad_top + (1.0 - (($val - $y_min) / ($y_max - $y_min))) * $ph;
    $parts[] = sprintf('%.2f,%.2f', $x, $y);
    $circles[] = sprintf('<circle cx="%.2f" cy="%.2f" r="5" fill="#fff" stroke="#0d9488" stroke-width="1.5"/>', $x, $y);
  }
  $poly = implode(' ', $parts);
  $grid = '';
  for ($i = 0; $i <= $ticks; $i++) {
    $gv = $y_min + ($i / $ticks) * ($y_max - $y_min);
    $gy = $pad_top + (1.0 - (($gv - $y_min) / ($y_max - $y_min))) * $ph;
    $grid .= sprintf(
      '<line class="glance-block__market-chart-grid" x1="%.2f" y1="%.2f" x2="%.2f" y2="%.2f"/>',
      $pl,
      $gy,
      $pl + $pw,
      $gy
    );
    $grid .= sprintf(
      '<text class="glance-block__market-chart-ytick" x="%.2f" y="%.2f">%s</text>',
      4.0,
      $gy + 4.0,
      htmlspecialchars((string) round($gv, 1), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8')
    );
  }
  $xlabels = '';
  foreach ($series as $obs) {
    $year = (int) $obs['year'];
    $x = $pl + (($year - $year_min) / $year_span) * $pw;
    $xlabels .= sprintf(
      '<text class="glance-block__market-chart-xlabel" x="%.2f" y="%.2f" text-anchor="middle">%d</text>',
      $x,
      $h - 10.0,
      $year
    );
  }
  $svg = sprintf(
    '<svg class="glance-block__market-chart-svg" viewBox="0 0 %d %d" width="%d" height="%d" role="img" aria-label="%s">%s<polyline class="glance-block__market-chart-line" fill="none" stroke="#0d9488" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points="%s"/>%s</svg>',
    $w,
    $h,
    $w,
    $h,
    htmlspecialchars((string) t('GDP growth trend chart'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'),
    $grid,
    htmlspecialchars($poly, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'),
    implode('', $circles) . $xlabels
  );
  return Markup::create($svg);
}

/**
 * Sparkline for sector cards: line, optional area fill, point markers, year range labels.
 *
 * @param list<array{year: int, value: float}> $series
 */
function _motaded_theme_sector_sparkline_svg_markup(array $series, string $svg_class = 'sector-card__spark-svg', bool $with_area = TRUE): ?Markup {
  if ($series === []) {
    return NULL;
  }
  $w = 280;
  $h = 88;
  $pl = 6.0;
  $pr = 6.0;
  $pt = 8.0;
  $pb = 24.0;
  $pw = $w - $pl - $pr;
  $ph = $h - $pt - $pb;
  $years = array_column($series, 'year');
  $vals = array_map('floatval', array_column($series, 'value'));
  $year_min = (int) min($years);
  $year_max = (int) max($years);
  $year_time_span = $year_max - $year_min;
  $v_min = min($vals);
  $v_max = max($vals);
  if ($v_max <= $v_min) {
    $v_max = $v_min + ($v_min === 0.0 ? 1.0 : abs($v_min) * 0.001 + 0.01);
  }
  $pad_v = ($v_max - $v_min) * 0.1;
  $v_min -= $pad_v;
  $v_max += $pad_v;
  $coords = [];
  foreach ($series as $obs) {
    $year = (int) $obs['year'];
    $val = (float) $obs['value'];
    // One year in the window → all x at chart centre (avoids clipping at x=padding).
    if ($year_time_span < 1) {
      $x = $pl + $pw / 2;
    }
    else {
      $x = $pl + (($year - $year_min) / $year_time_span) * $pw;
    }
    $y = $pt + (1.0 - (($val - $v_min) / ($v_max - $v_min))) * $ph;
    $coords[] = ['x' => $x, 'y' => $y, 'year' => $year];
  }
  $bottom = $pt + $ph;
  $grad_id = 'scf-' . substr(hash('sha256', serialize($series)), 0, 12);
  $dots = '';
  foreach ($coords as $c) {
    $dots .= sprintf(
      '<circle class="sector-card__spark-dot" cx="%.2f" cy="%.2f" r="3.25" fill="#ffffff" stroke="#0d9488" stroke-width="1.5"/>',
      $c['x'],
      $c['y']
    );
  }
  $n_pts = count($coords);
  if ($n_pts === 1) {
    $c = $coords[0];
    $svg = sprintf(
      '<svg class="%s" viewBox="0 0 %d %d" width="%d" height="%d" role="img" aria-hidden="true" focusable="false">%s<text class="sector-card__spark-xlabel" x="%.2f" y="%.2f" text-anchor="middle">%d</text></svg>',
      htmlspecialchars($svg_class, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'),
      $w,
      $h,
      $w,
      $h,
      $dots,
      $pl + $pw / 2,
      (float) $h - 5.0,
      $c['year']
    );
    return Markup::create($svg);
  }
  $first = $coords[0];
  $path_d = sprintf('M %.2f %.2f', $first['x'], $first['y']);
  $poly_parts = [sprintf('%.2f,%.2f', $first['x'], $first['y'])];
  for ($i = 1, $n = count($coords); $i < $n; $i++) {
    $path_d .= sprintf(' L %.2f %.2f', $coords[$i]['x'], $coords[$i]['y']);
    $poly_parts[] = sprintf('%.2f,%.2f', $coords[$i]['x'], $coords[$i]['y']);
  }
  $last = $coords[array_key_last($coords)];
  $area_d = $path_d . sprintf(' L %.2f %.2f L %.2f %.2f Z', $last['x'], $bottom, $first['x'], $bottom);
  $poly = implode(' ', $poly_parts);
  $defs = '';
  $area_el = '';
  if ($with_area && $n_pts >= 2) {
    $defs = sprintf(
      '<defs><linearGradient id="%s" x1="0" y1="0" x2="0" y2="1"><stop offset="0%%" stop-color="#0d9488" stop-opacity="0.24"/><stop offset="100%%" stop-color="#0d9488" stop-opacity="0"/></linearGradient></defs>',
      htmlspecialchars($grad_id, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8')
    );
    $area_el = sprintf(
      '<path class="sector-card__spark-area" fill="url(#%s)" d="%s"/>',
      htmlspecialchars($grad_id, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'),
      htmlspecialchars($area_d, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8')
    );
  }
  $x_label_y = (float) $h - 5.0;
  $x_mid = $pl + $pw / 2;
  if ($year_min === $year_max) {
    $labels = sprintf(
      '<text class="sector-card__spark-xlabel" x="%.2f" y="%.2f" text-anchor="middle">%d</text>',
      $x_mid,
      $x_label_y,
      $year_min
    );
  }
  else {
    $labels = sprintf(
      '<text class="sector-card__spark-xlabel" x="%.2f" y="%.2f" text-anchor="start">%d</text><text class="sector-card__spark-xlabel" x="%.2f" y="%.2f" text-anchor="end">%d</text>',
      $pl,
      $x_label_y,
      $year_min,
      $pl + $pw,
      $x_label_y,
      $year_max
    );
  }
  $svg = sprintf(
    '<svg class="%s" viewBox="0 0 %d %d" width="%d" height="%d" role="img" aria-label="%s">%s%s<polyline class="sector-card__spark-line" fill="none" stroke="#0d9488" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" points="%s"/>%s%s</svg>',
    htmlspecialchars($svg_class, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'),
    $w,
    $h,
    $w,
    $h,
    htmlspecialchars((string) t('Indicator trend'), ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'),
    $defs,
    $area_el,
    htmlspecialchars($poly, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'),
    $dots,
    $labels
  );
  return Markup::create($svg);
}

