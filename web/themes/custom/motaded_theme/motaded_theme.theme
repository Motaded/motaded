    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['hero_split_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'hero_banner');
    }
  }

  $variables['hero_split_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['hero_split_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }

  $variables['hero_split_cta_secondary'] = [];
  if ($paragraph->hasField('field_link_secondary')) {
    $link2 = $paragraph->get('field_link_secondary');
    if ($link2->access('view') && !$link2->isEmpty()) {
      /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
      $item = $link2->first();
      if ($item) {
        $url = $item->getUrl();
        if ($url) {
          $title = $item->getTitle();
          $variables['hero_split_cta_secondary'] = [
            'url' => $url->toString(),
            'title' => $title !== '' && $title !== NULL ? $title : (string) t('Explore'),
          ];
        }
      }
    }
  }

  $features = [];
  if ($paragraph->hasField('field_hero_split_features')) {
    $feature_field = $paragraph->get('field_hero_split_features');
    if ($feature_field->access('view')) {
      foreach ($feature_field as $item) {
        $sub = $item->entity;
        if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_feature_card') {
          continue;
        }
        $icon = (string) ($sub->get('field_why_feature_icon')->value ?: 'people');
        $title = '';
        if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
          $title = trim((string) $sub->get('field_title')->value);
        }
        $body = '';
        if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
          $body = trim((string) $sub->get('field_body')->value);
        }
        $features[] = [
          'icon' => $icon,
          'title' => $title,
          'body' => $body,
        ];
      }
    }
  }
  $variables['hero_split_features'] = $features;
}

/**
 * Why opportunities: feature cards, stat bar items, trust line.
 */
function motaded_theme_preprocess_paragraph__why_opportunities(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/why_opportunities';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['why_opportunities_heading_id'] = Html::getUniqueId('why-opportunities-heading-' . $paragraph->id());

  $variables['why_opportunities_trust'] = '';
  if ($paragraph->get('field_why_trust_line')->access('view') && !$paragraph->get('field_why_trust_line')->isEmpty()) {
    $variables['why_opportunities_trust'] = trim((string) $paragraph->get('field_why_trust_line')->value);
  }

  $features = [];
  $feature_field = $paragraph->get('field_why_features');
  if ($feature_field->access('view')) {
    foreach ($feature_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_feature_card') {
        continue;
      }
      $icon = (string) ($sub->get('field_why_feature_icon')->value ?: 'people');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      // If editors left default "people" on cards that are not team-focused, map by title (EN).
      if ($icon === 'people' && $title !== '') {
        $lower = function_exists('mb_strtolower') ? mb_strtolower($title) : strtolower($title);
        if (str_contains($lower, 'strategic') || str_contains($lower, 'gateway')) {
          $icon = 'globe';
        }
        elseif (str_contains($lower, 'growth') || str_contains($lower, 'sector')) {
          $icon = 'trend';
        }
        elseif (str_contains($lower, 'vision') || str_contains($lower, 'reform')) {
          $icon = 'clock';
        }
      }
      $body = [];
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body = $sub->get('field_body')->view([
          'type' => 'text_default',
          'label' => 'hidden',
        ]);
      }
      $link = [];
      $link_field = $sub->get('field_link');
      if ($link_field->access('view') && !$link_field->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
        $link_item = $link_field->first();
        if ($link_item) {
          $url = $link_item->getUrl();
          if ($url) {
            $ltitle = $link_item->getTitle();
            $link = [
              'url' => $url->toString(),
              'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
            ];
          }
        }
      }
      $features[] = [
        'icon' => $icon,
        'title' => $title,
        'body' => $body,
        'link' => $link,
      ];
    }
  }
  $variables['why_opportunities_features'] = $features;

  $stats = [];
  $stat_field = $paragraph->get('field_why_stat_items');
  if ($stat_field->access('view')) {
    foreach ($stat_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_stat_item') {
        continue;
      }
      $icon = (string) ($sub->get('field_why_stat_icon')->value ?: 'globe');
      $value = '';
      if ($sub->get('field_why_stat_value')->access('view') && !$sub->get('field_why_stat_value')->isEmpty()) {
        $value = trim((string) $sub->get('field_why_stat_value')->value);
      }
      $label = '';
      if ($sub->get('field_why_stat_label')->access('view') && !$sub->get('field_why_stat_label')->isEmpty()) {
        $label = trim((string) $sub->get('field_why_stat_label')->value);
      }
      $stats[] = [
        'icon' => $icon,
        'value' => $value,
        'label' => $label,
      ];
    }
  }
  $variables['why_opportunities_stats'] = $stats;
}

/**
 * Business setup options: image cards + bottom trust banner.
 */
function motaded_theme_preprocess_paragraph__business_setup_section(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['business_setup_heading_id'] = Html::getUniqueId('business-setup-heading-' . $paragraph->id());

  $variables['business_setup_banner_line1'] = '';
  if ($paragraph->get('field_setup_banner_line1')->access('view') && !$paragraph->get('field_setup_banner_line1')->isEmpty()) {
    $variables['business_setup_banner_line1'] = trim((string) $paragraph->get('field_setup_banner_line1')->value);
  }
  $variables['business_setup_banner_line2'] = '';
  if ($paragraph->get('field_setup_banner_line2')->access('view') && !$paragraph->get('field_setup_banner_line2')->isEmpty()) {
    $variables['business_setup_banner_line2'] = trim((string) $paragraph->get('field_setup_banner_line2')->value);
  }

  $cards = [];
  $card_field = $paragraph->get('field_business_setup_cards');
  if ($card_field->access('view')) {
    foreach ($card_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'business_setup_card') {
        continue;
      }
      $icon = (string) ($sub->get('field_business_setup_icon')->value ?: 'city');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body = [];
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body = $sub->get('field_body')->view([
          'type' => 'text_default',
          'label' => 'hidden',
        ]);
      }
      $link = [];
      $link_field = $sub->get('field_link');
      if ($link_field->access('view') && !$link_field->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
        $link_item = $link_field->first();
        if ($link_item) {
          $url = $link_item->getUrl();
          if ($url) {
            $ltitle = $link_item->getTitle();
            $link = [
              'url' => $url->toString(),
              'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
            ];
          }
        }
      }
      $media = [];
      if ($sub->get('field_media')->access('view') && !$sub->get('field_media')->isEmpty()) {
        $media_entity = $sub->get('field_media')->entity;
        if ($media_entity) {
          $media = \Drupal::entityTypeManager()
            ->getViewBuilder('media')
            ->view($media_entity, 'default');
        }
      }
      $popular = FALSE;
      if ($sub->hasField('field_business_setup_popular') && $sub->get('field_business_setup_popular')->access('view') && !$sub->get('field_business_setup_popular')->isEmpty()) {
        $popular = (bool) $sub->get('field_business_setup_popular')->value;
      }
      $cards[] = [
        'icon' => $icon,
        'title' => $title,
        'body' => $body,
        'link' => $link,
        'media' => $media,
        'popular' => $popular,
      ];
    }
  }
  $variables['business_setup_cards'] = $cards;
}

/**
 * View block paragraph: flag when embedded view is news / block_4 (compact list layout).
 */
function motaded_theme_preprocess_paragraph__view_block(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['view_block_news_latest'] = FALSE;
  $variables['view_block_services_home'] = FALSE;
  $variables['view_block_events_home_list'] = FALSE;
  $variables['view_block_events_home_calendar'] = FALSE;
  $variables['view_block_partners_marquee'] = FALSE;
  if (!$paragraph->hasField('field_view_block') || $paragraph->get('field_view_block')->isEmpty()) {
    return;
  }
  foreach ($paragraph->get('field_view_block')->getValue() as $item) {
    $pairs = [];
    $tid_row = $item['target_id'] ?? '';
    $did_row = $item['display_id'] ?? '';
    if ($tid_row !== '' && $did_row !== '') {
      $pairs[] = [$tid_row, $did_row];
    }
    elseif (!empty($item['data']) && is_string($item['data'])) {
      $decoded = json_decode($item['data'], TRUE);
      if (is_array($decoded)) {
        $t = $decoded['target_id'] ?? '';
        $d = $decoded['display_id'] ?? '';
        if ($t !== '' && $d !== '') {
          $pairs[] = [$t, $d];
        }
      }
    }
    foreach ($pairs as [$target, $display]) {
      if ($target === 'events' && $display === 'block_home') {
        $variables['view_block_events_home_list'] = TRUE;
      }
      elseif ($target === 'events' && $display === 'block_calendar') {
        $variables['view_block_events_home_calendar'] = TRUE;
      }
      elseif ($target === 'news' && $display === 'block_4') {
        $variables['view_block_news_latest'] = TRUE;
      }
      elseif ($target === 'services' && $display === 'block_2') {
        $variables['view_block_services_home'] = TRUE;
      }
      elseif ($target === 'partners' && $display === 'block_2') {
        $variables['view_block_partners_marquee'] = TRUE;
      }
    }
  }

  if ($variables['view_block_events_home_list'] || $variables['view_block_events_home_calendar']) {
    $variables['#attached']['library'][] = 'motaded_theme/events_home';
  }
}

/**
 * Media lead: image left, icon + headline + body + CTA (Twig + responsive media).
 */
function motaded_theme_preprocess_paragraph__media_lead(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['media_lead_heading_id'] = Html::getUniqueId('media-lead-heading-' . $paragraph->id());
  $variables['media_lead_headline'] = '';
  if ($paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['media_lead_headline'] = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['media_lead_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['media_lead_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }
}

/**
 * Plain title + image alt from media (fallback to title) for article-card output.
 */
function motaded_theme_preprocess_paragraph__business_activity(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $title_plain = '';
  if ($paragraph->hasField('field_title') && !$paragraph->get('field_title')->isEmpty()) {
    $title_plain = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['business_activity_title_plain'] = $title_plain;

  $variables['business_activity_tag'] = '';
  $parent = $paragraph->getParentEntity();
  if ($parent instanceof NodeInterface) {
    $tag_map = [
      'page' => (string) t('Service'),
      'article' => (string) t('Blog'),
      'news' => (string) t('News'),
    ];
    $variables['business_activity_tag'] = $tag_map[$parent->bundle()] ?? '';
  }

  $image_alt = $title_plain;
  $image_uri = NULL;
  if ($paragraph->hasField('field_media') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    $image_data = motaded_theme_media_image_uri_and_alt($media, $title_plain);
    $image_uri = $image_data['uri'];
    if ($image_data['alt'] !== '') {
      $image_alt = $image_data['alt'];
    }
  }
  if ($image_alt === '' && $title_plain !== '') {
    $image_alt = $title_plain;
  }
  if ($image_alt === '') {
    $image_alt = (string) t('Illustration for service information');
  }
  $variables['business_activity_image_alt'] = $image_alt;
  $variables['business_activity_image_meta'] = motaded_theme_responsive_teaser_image_metadata($image_uri);
}

/**
 * Implements hook_preprocess_HOOK() for areas_of_work paragraphs.
 *
 * Splits plain text on the first colon so the lead phrase can be styled bold
 * (e.g. "Mandatory activities: These include…").
 */
function motaded_theme_preprocess_paragraph__areas_of_work(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_content') || $paragraph->get('field_content')->isEmpty()) {
    return;
  }
  $full = trim((string) $paragraph->get('field_content')->value);
  if ($full === '') {
    return;
  }
  $pos = strpos($full, ':');
  if ($pos === FALSE) {
    return;
  }
  $label = trim(substr($full, 0, $pos));
  $rest = trim(substr($full, $pos + 1));
  if ($label === '') {
    return;
  }
  $variables['areas_lead_label'] = $label;
  $variables['areas_rest_safe'] = $rest === ''
    ? NULL
    : Markup::create(nl2br(Html::escape($rest), FALSE));
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function motaded_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Core route /system/404 (system.404) is a normal route match, so Drupal does
  // not add page__404; use the same layout as for real 404 responses.
  if (\Drupal::routeMatch()->getRouteName() === 'system.404') {
    array_unshift($suggestions, 'page__404');
  }

  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $suggestions[] = 'page__' . $node->bundle();
  }
}

/**
 * Implements hook_preprocess_paragraph__steps().
 */
function motaded_theme_preprocess_paragraph__steps(array &$variables) {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $steps = [];
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

  // Check if field_paragraphs exists and has data.
  if ($paragraph->hasField('field_paragraphs') && !$paragraph->get('field_paragraphs')->isEmpty()) {
    foreach ($paragraph->get('field_paragraphs')->referencedEntities() as $item) {
      // Try to get the translation if available.
      if ($item->hasTranslation($langcode)) {
        $item = $item->getTranslation($langcode);
      }
      // Each $item is a sub-paragraph, e.g., a single step/card.
      $stepTitle = $item->hasField('field_sub_title') ? $item->get('field_sub_title')->value : '';
      $title = $item->hasField('field_title') ? $item->get('field_title')->value : '';
      $desc = $item->hasField('field_body') ? $item->get('field_body')->processed : '';

      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($item, (string) $title);
      $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);

      $steps[] = [
        'step_title' => $stepTitle,
        'title' => $title,
        'desc' => $desc,
        'img' => $meta['src'],
        'img_srcset' => $meta['srcset'],
        'img_width' => $meta['width'],
        'img_height' => $meta['height'],
        'img_alt' => $extracted['alt'] !== '' ? $extracted['alt'] : (string) $title,
      ];
    }
  }

  // Attach the structured data to drupalSettings.
  // Use paragraph ID so multiple 'steps' paragraphs don’t overwrite each other.
  $variables['#attached']['drupalSettings']['motaded_theme']['steps'] = $steps;

  // Attach JS library.
  $variables['#attached']['library'][] = 'motaded_theme/steps';
}

/**
 * Implements hook_preprocess_paragraph__featured_contents().
 */
function motaded_theme_preprocess_paragraph__featured_contents(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['featured_card_images'] = [];
  if (!$paragraph->hasField('field_contents') || $paragraph->get('field_contents')->isEmpty()) {
    return;
  }
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  foreach ($paragraph->get('field_contents')->referencedEntities() as $node) {
    if ($node->hasTranslation($langcode)) {
      $node = $node->getTranslation($langcode);
    }
    $nid = (int) $node->id();
    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($node, $node->label());
    $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $meta['alt'] = $extracted['alt'];
    $variables['featured_card_images'][$nid] = $meta;
  }
}

/**
 * Implements hook_preprocess_paragraph__insights_updates().
 */
function motaded_theme_preprocess_paragraph__insights_updates(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/insights-updates';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['iu_card_images'] = [];
  $variables['iu_item_dates'] = [];
  $variables['iu_item_dates_iso'] = [];
  $variables['iu_insight_nodes'] = [];
  $variables['iu_news_nodes'] = [];

  $route_url = static function (string $route_name, string $path): string {
    try {
      return Url::fromRoute($route_name)->toString();
    }
    catch (\Throwable $e) {
      return Url::fromUserInput($path)->toString();
    }
  };

  $variables['iu_insights_list_url'] = $route_url('view.news.page_1', '/blog');
  $variables['iu_news_list_url'] = $route_url('view.news.page_2', '/news');

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

  $collect_meta = function (array $nodes) use (&$variables): void {
    foreach ($nodes as $node) {
      if (!$node instanceof NodeInterface) {
        continue;
      }
      $nid = (int) $node->id();
      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($node, $node->label());
      $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
      $meta['alt'] = $extracted['alt'];
      $variables['iu_card_images'][$nid] = $meta;
      $ts = (int) $node->getCreatedTime();
      $variables['iu_item_dates'][$nid] = $ts
        ? \Drupal::service('date.formatter')->format($ts, 'custom', 'j M Y')
        : '';
      $variables['iu_item_dates_iso'][$nid] = $ts
        ? \Drupal::service('date.formatter')->format($ts, 'html_datetime')
        : '';
    }
  };

  if ($paragraph->hasField('field_iu_insights') && !$paragraph->get('field_iu_insights')->isEmpty()) {
    foreach ($paragraph->get('field_iu_insights')->referencedEntities() as $node) {
      if ($node instanceof NodeInterface) {
        if ($node->hasTranslation($langcode)) {
          $node = $node->getTranslation($langcode);
        }
        $variables['iu_insight_nodes'][] = $node;
      }
    }
  }
  if ($paragraph->hasField('field_iu_news') && !$paragraph->get('field_iu_news')->isEmpty()) {
    foreach ($paragraph->get('field_iu_news')->referencedEntities() as $node) {
      if ($node instanceof NodeInterface) {
        if ($node->hasTranslation($langcode)) {
          $node = $node->getTranslation($langcode);
        }
        $variables['iu_news_nodes'][] = $node;
      }
    }
  }

  // Homepage layout: one hero (left) + rest in sidebar with news (up to 4 total insights).
  $variables['iu_insight_nodes'] = array_slice($variables['iu_insight_nodes'], 0, 4);
  $variables['iu_news_nodes'] = array_slice($variables['iu_news_nodes'], 0, 5);

  $collect_meta($variables['iu_insight_nodes']);
  $collect_meta($variables['iu_news_nodes']);
}

/**
 * Implements hook_preprocess_paragraph__glance_block().
 */
function motaded_theme_preprocess_paragraph__glance_block(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/glance_block';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $variables['glance_eyebrow'] = '';
  if ($paragraph->hasField('field_glance_eyebrow') && $paragraph->get('field_glance_eyebrow')->access('view') && !$paragraph->get('field_glance_eyebrow')->isEmpty()) {
    $variables['glance_eyebrow'] = trim((string) $paragraph->get('field_glance_eyebrow')->value);
  }
  $variables['glance_title'] = '';
  if ($paragraph->hasField('field_glance_title') && $paragraph->get('field_glance_title')->access('view') && !$paragraph->get('field_glance_title')->isEmpty()) {
    $variables['glance_title'] = trim((string) $paragraph->get('field_glance_title')->value);
  }
  $variables['glance_title_accent'] = '';
  if ($paragraph->hasField('field_glance_title_accent') && $paragraph->get('field_glance_title_accent')->access('view') && !$paragraph->get('field_glance_title_accent')->isEmpty()) {
    $variables['glance_title_accent'] = trim((string) $paragraph->get('field_glance_title_accent')->value);
  }

  $icon_svg = static function (string $key) {
    // Keep SVGs tiny and consistent with site icons.
    $svg = match ($key) {
      'money' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7h16v10H4z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M7 7V5h10v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="12" cy="12" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg>',
      'users' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'pie' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2v10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M21.4 14a9.5 9.5 0 1 1-11.4-11.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'building' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M6 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 21h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M9 7h2M9 11h2M9 15h2M13 7h2M13 11h2M13 15h2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'chart_up' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 16l6-6 4 4 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 8h6v6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      'layers' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 3 3.5 8.2 12 13.4 20.5 8.2 12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M3.5 12.1 12 17.3 20.5 12.1" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'globe' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 3a14 14 0 0 1 0 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'leaf' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M20 4s-8 0-12 4-4 12-4 12 8 0 12-4 4-12 4-12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 16c2-2 6-6 12-8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'handshake' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M8 12l2-2a3 3 0 0 1 4 0l2 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 12l5-5 4 4-5 5H3v-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M21 12l-5-5-4 4 5 5h4v-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'target' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/><path d="M12 2v3M22 12h-3M12 22v-3M2 12h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'flag' => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 22V3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M5 4h10l-1.5 3L15 10H5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      default => '<svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 14l4-4 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    };
    return \Drupal\Core\Render\Markup::create($svg);
  };

  $read_stat = static function (\Drupal\paragraphs\Entity\Paragraph $p) use ($icon_svg): array {
    $icon = $p->hasField('field_glance_icon') ? (string) ($p->get('field_glance_icon')->value ?: '') : '';
    $value = $p->hasField('field_glance_value') ? trim((string) ($p->get('field_glance_value')->value ?? '')) : '';
    $title = $p->hasField('field_glance_title') ? trim((string) ($p->get('field_glance_title')->value ?? '')) : '';
    $body = '';
    if ($p->hasField('field_glance_body') && !$p->get('field_glance_body')->isEmpty()) {
      $body = trim((string) $p->get('field_glance_body')->value);
    }
    $source = $p->hasField('field_glance_source') ? trim((string) ($p->get('field_glance_source')->value ?? '')) : '';
    return [
      'icon' => $icon,
      'icon_svg' => $icon_svg($icon),
      'value' => $value,
      'title' => $title,
      'body' => $body,
      'source' => $source,
      // Optional; used for highlight kicker.
      'kicker' => $title,
    ];
  };

  $variables['glance_highlight'] = [];
  if ($paragraph->hasField('field_glance_highlight') && $paragraph->get('field_glance_highlight')->access('view') && !$paragraph->get('field_glance_highlight')->isEmpty()) {
    $sub = $paragraph->get('field_glance_highlight')->entity;
    if ($sub instanceof \Drupal\paragraphs\Entity\Paragraph && $sub->bundle() === 'glance_stat_item') {
      $variables['glance_highlight'] = $read_stat($sub);
      // Highlight uses a separate kicker convention.
      $variables['glance_highlight']['kicker'] = $variables['glance_highlight']['title'];
    }
  }

  $variables['glance_stats'] = [];
  if ($paragraph->hasField('field_glance_stats') && $paragraph->get('field_glance_stats')->access('view') && !$paragraph->get('field_glance_stats')->isEmpty()) {
    foreach ($paragraph->get('field_glance_stats') as $item) {
      $sub = $item->entity;
      if ($sub instanceof \Drupal\paragraphs\Entity\Paragraph && $sub->bundle() === 'glance_stat_item') {
        $variables['glance_stats'][] = $read_stat($sub);
      }
    }
  }

  $variables['glance_features'] = [];
  if ($paragraph->hasField('field_glance_features') && $paragraph->get('field_glance_features')->access('view') && !$paragraph->get('field_glance_features')->isEmpty()) {
    foreach ($paragraph->get('field_glance_features') as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_feature_card') {
        continue;
      }
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body = '';
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body = trim((string) $sub->get('field_body')->value);
      }
      $link_url = '';
      $link_title = '';
      if ($sub->hasField('field_link') && $sub->get('field_link')->access('view') && !$sub->get('field_link')->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $li */
        $li = $sub->get('field_link')->first();
        if ($li && $li->getUrl()) {
          $link_url = $li->getUrl()->toString();
          $link_title = (string) ($li->getTitle() ?: '');
        }
      }
      $variables['glance_features'][] = [
        'title' => $title,
        'body' => $body ? strip_tags($body) : '',
        'link_url' => $link_url,
        'link_title' => $link_title,
      ];
    }
  }
}

/**
 * Implements hook_preprocess_paragraph__gateway_block().
 */
function motaded_theme_preprocess_paragraph__gateway_block(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/gateway_block';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $variables['gateway_eyebrow'] = '';
  if ($paragraph->hasField('field_gateway_eyebrow') && $paragraph->get('field_gateway_eyebrow')->access('view') && !$paragraph->get('field_gateway_eyebrow')->isEmpty()) {
    $variables['gateway_eyebrow'] = trim((string) $paragraph->get('field_gateway_eyebrow')->value);
  }
  $variables['gateway_title'] = '';
  if ($paragraph->hasField('field_title') && $paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['gateway_title'] = trim((string) $paragraph->get('field_title')->value);
  }

  $icon_svg = static function (string $key) {
    $svg = match ($key) {
      'platforms' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v10H4z" stroke="currentColor" stroke-width="1.6"/><path d="M8 19h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 15v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'sectors' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M10 6V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 9h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'events' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M7 3v3M17 3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 6h16v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 10h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'insights' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 19V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 19h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 15v-5M12 15V7m4 8v-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      default => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 14l4-4 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    };
    return \Drupal\Core\Render\Markup::create($svg);
  };

  $variables['gateway_items'] = [];
  if ($paragraph->hasField('field_gateway_items') && $paragraph->get('field_gateway_items')->access('view') && !$paragraph->get('field_gateway_items')->isEmpty()) {
    foreach ($paragraph->get('field_gateway_items') as $ref) {
      $sub = $ref->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'gateway_item') {
        continue;
      }
      $icon_key = (string) ($sub->get('field_gateway_icon')->value ?? '');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body = '';
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body = trim((string) $sub->get('field_body')->value);
      }
      $link_url = '';
      $link_title = '';
      if ($sub->hasField('field_link') && $sub->get('field_link')->access('view') && !$sub->get('field_link')->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $li */
        $li = $sub->get('field_link')->first();
        if ($li && $li->getUrl()) {
          $link_url = $li->getUrl()->toString();
          $link_title = (string) ($li->getTitle() ?: '');
        }
      }
      $variables['gateway_items'][] = [
        'icon' => $icon_key,
        'icon_svg' => $icon_svg($icon_key),
        'title' => $title,
        'body' => $body ? strip_tags($body) : '',
        'link_url' => $link_url,
        'link_title' => $link_title,
      ];
    }
  }

  $variables['gateway_footer_title'] = '';
  if ($paragraph->hasField('field_gateway_footer_title') && $paragraph->get('field_gateway_footer_title')->access('view') && !$paragraph->get('field_gateway_footer_title')->isEmpty()) {
    $variables['gateway_footer_title'] = trim((string) $paragraph->get('field_gateway_footer_title')->value);
  }
  $variables['gateway_footer_body'] = '';
  if ($paragraph->hasField('field_gateway_footer_body') && $paragraph->get('field_gateway_footer_body')->access('view') && !$paragraph->get('field_gateway_footer_body')->isEmpty()) {
    $variables['gateway_footer_body'] = trim((string) $paragraph->get('field_gateway_footer_body')->value);
  }
  $variables['gateway_footer_link_url'] = '';
  $variables['gateway_footer_link_title'] = '';
  if ($paragraph->hasField('field_gateway_footer_link') && $paragraph->get('field_gateway_footer_link')->access('view') && !$paragraph->get('field_gateway_footer_link')->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $li */
    $li = $paragraph->get('field_gateway_footer_link')->first();
    if ($li && $li->getUrl()) {
      $variables['gateway_footer_link_url'] = $li->getUrl()->toString();
      $variables['gateway_footer_link_title'] = (string) ($li->getTitle() ?: '');
    }
  }

  $variables['gateway_footer_icon_svg'] = \Drupal\Core\Render\Markup::create(
    '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 3a14 14 0 0 1 0 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'
  );
}

/**
 * Implements hook_preprocess_paragraph__gateway_hub_block().
 */
function motaded_theme_preprocess_paragraph__gateway_hub_block(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/gateway_hub_block';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $variables['hub_eyebrow'] = '';
  if ($paragraph->hasField('field_gateway_eyebrow') && $paragraph->get('field_gateway_eyebrow')->access('view') && !$paragraph->get('field_gateway_eyebrow')->isEmpty()) {
    $variables['hub_eyebrow'] = trim((string) $paragraph->get('field_gateway_eyebrow')->value);
  }
  $variables['hub_title'] = '';
  if ($paragraph->hasField('field_title') && $paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['hub_title'] = trim((string) $paragraph->get('field_title')->value);
  }

  $mk_svg = static fn (string $svg) => \Drupal\Core\Render\Markup::create($svg);
  $variables['hub_icons'] = [
    'sectors' => $mk_svg('<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M10 6V5a2 2 0 0 1 2-2h0a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 9h16v9a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V9Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>'),
    'events' => $mk_svg('<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M7 3v3M17 3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 6h16v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M4 10h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'),
    'insights' => $mk_svg('<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 19V5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4 19h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 15v-5M12 15V7m4 8v-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>'),
  ];

  $variables['hub_platforms'] = [];
  if ($paragraph->hasField('field_gateway_platforms') && $paragraph->get('field_gateway_platforms')->access('view') && !$paragraph->get('field_gateway_platforms')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $platforms */
    $platforms = $paragraph->get('field_gateway_platforms');
    foreach ($platforms->referencedEntities() as $node) {
      if ($node instanceof \Drupal\node\NodeInterface) {
        $variables['hub_platforms'][] = [
          'title' => $node->label(),
          'meta' => '',
          'url' => $node->toUrl()->toString(),
        ];
      }
    }
  }

  $variables['hub_sectors'] = [];
  if ($paragraph->hasField('field_gateway_sectors') && $paragraph->get('field_gateway_sectors')->access('view') && !$paragraph->get('field_gateway_sectors')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $sectors */
    $sectors = $paragraph->get('field_gateway_sectors');
    foreach ($sectors->referencedEntities() as $term) {
      if ($term instanceof \Drupal\taxonomy\TermInterface) {
        $variables['hub_sectors'][] = [
          'title' => $term->label(),
          'url' => $term->toUrl()->toString(),
        ];
      }
    }
  }

  $variables['hub_events'] = [];
  if ($paragraph->hasField('field_gateway_events') && $paragraph->get('field_gateway_events')->access('view') && !$paragraph->get('field_gateway_events')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $events */
    $events = $paragraph->get('field_gateway_events');
    foreach ($events->referencedEntities() as $node) {
      if ($node instanceof \Drupal\node\NodeInterface) {
        $variables['hub_events'][] = [
          'title' => $node->label(),
          'meta' => '',
          'url' => $node->toUrl()->toString(),
        ];
      }
    }
  }

  $variables['hub_insights'] = [];
  if ($paragraph->hasField('field_gateway_insights') && $paragraph->get('field_gateway_insights')->access('view') && !$paragraph->get('field_gateway_insights')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $insights */
    $insights = $paragraph->get('field_gateway_insights');
    foreach ($insights->referencedEntities() as $node) {
      if ($node instanceof \Drupal\node\NodeInterface) {
        $variables['hub_insights'][] = [
          'title' => $node->label(),
          'meta' => '',
          'url' => $node->toUrl()->toString(),
        ];
      }
    }
  }

  // Support badges (small highlight items in the footer strip).
  $variables['hub_support_badges'] = [];
  if ($paragraph->hasField('field_gateway_support_items') && $paragraph->get('field_gateway_support_items')->access('view') && !$paragraph->get('field_gateway_support_items')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $support_items */
    $support_items = $paragraph->get('field_gateway_support_items');
    foreach ($support_items->referencedEntities() as $item) {
      if ($item instanceof \Drupal\paragraphs\ParagraphInterface) {
        $title = '';
        $body = '';
        if ($item->hasField('field_title') && !$item->get('field_title')->isEmpty()) {
          $title = trim((string) $item->get('field_title')->value);
        }
        if ($item->hasField('field_body') && !$item->get('field_body')->isEmpty()) {
          $body = trim((string) $item->get('field_body')->value);
        }
        if ($title !== '' || $body !== '') {
          $variables['hub_support_badges'][] = [
            'title' => $title,
            'body' => $body,
          ];
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_paragraph__platforms_systems().
 */
function motaded_theme_preprocess_paragraph__platforms_systems(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/platforms_systems';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];

  $mk_svg = static fn (string $svg) => \Drupal\Core\Render\Markup::create($svg);
  $icon_for = static function (string $key) use ($mk_svg) {
    $svg = match ($key) {
      'licensing' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 3h8l4 4v14H6V3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v5h5" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 12h8M8 16h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'workforce' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M22 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'tax' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4V5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 9h8M8 13h8M8 17h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>',
      'operations' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M3 21h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M5 21V7l7-4 7 4v14" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 21v-6h6v6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
      'compliance' => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 2l8 4v6c0 5-3.5 9.4-8 10-4.5-.6-8-5-8-10V6l8-4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
      default => '<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M4 14l4-4 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>',
    };
    return $mk_svg($svg);
  };

  $variables['ps_groups'] = [];
  if ($paragraph->hasField('field_ps_groups') && $paragraph->get('field_ps_groups')->access('view') && !$paragraph->get('field_ps_groups')->isEmpty()) {
    /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $groups */
    $groups = $paragraph->get('field_ps_groups');
    foreach ($groups->referencedEntities() as $group) {
      if (!$group instanceof \Drupal\paragraphs\ParagraphInterface) {
        continue;
      }

      $title = $group->hasField('field_title') && !$group->get('field_title')->isEmpty()
        ? trim((string) $group->get('field_title')->value)
        : '';

      $body = $group->hasField('field_psg_body') && !$group->get('field_psg_body')->isEmpty()
        ? trim((string) $group->get('field_psg_body')->value)
        : '';

      $icon_key = $group->hasField('field_psg_icon') && !$group->get('field_psg_icon')->isEmpty()
        ? (string) $group->get('field_psg_icon')->value
        : '';

      $items = [];
      if ($group->hasField('field_psg_items') && !$group->get('field_psg_items')->isEmpty()) {
        /** @var \Drupal\Core\Field\EntityReferenceFieldItemListInterface $refs */
        $refs = $group->get('field_psg_items');
        foreach ($refs->referencedEntities() as $node) {
          if ($node instanceof \Drupal\node\NodeInterface) {
            $logo = [
              'src' => '',
              'srcset' => '',
              'width' => 0,
              'height' => 0,
              'alt' => '',
            ];
            if ($node->hasField('field_logo') && !$node->get('field_logo')->isEmpty()) {
              $media = $node->get('field_logo')->entity;
              $fallback_alt = (string) t('@name logo', ['@name' => $node->label()]);
              $extracted = motaded_theme_media_image_uri_and_alt($media, $fallback_alt);
              $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
              $logo = [
                'src' => $meta['src'],
                'srcset' => $meta['srcset'],
                'width' => $meta['width'],
                'height' => $meta['height'],
                'alt' => $extracted['alt'],
              ];
            }
            $items[] = [
              'title' => $node->label(),
              'url' => $node->toUrl()->toString(),
              'logo' => $logo,
            ];
          }
        }
      }

      $view_all_url = '';
      $view_all_title = '';
      if ($group->hasField('field_psg_view_all') && !$group->get('field_psg_view_all')->isEmpty()) {
        $link_item = $group->get('field_psg_view_all')->first();
        $uri = $link_item && !$link_item->isEmpty() ? $link_item->get('uri')->getString() : '';
        if ($uri !== '') {
          try {
            $view_all_url = \Drupal\Core\Url::fromUri($uri)->toString();
          }
          catch (\Throwable $e) {
            $view_all_url = $uri;
          }
        }
        $view_all_title = $link_item ? trim((string) $link_item->get('title')->getString()) : '';
      }

      $variables['ps_groups'][] = [
        'title' => $title,
        'body' => $body,
        'icon' => $icon_for($icon_key),
        'items' => $items,
        'view_all_url' => $view_all_url,
        'view_all_title' => $view_all_title,
      ];
    }
  }
}

/**
 * Preprocess for News View block (unformatted).
 */
function motaded_theme_preprocess_views_view_unformatted__news__block_4(&$variables) {
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  foreach ($variables['rows'] as &$row) {
    $entity = $row['content']['#row']->_entity ?? NULL;
    $img_meta = [
      'src' => '',
      'srcset' => '',
      'width' => 151,
      'height' => 120,
    ];
    $img_alt = '';

    if ($entity) {
      if ($entity->hasTranslation($langcode)) {
        $entity = $entity->getTranslation($langcode);
      }

      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
      $img_meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
      $img_alt = $extracted['alt'];

      $row['title'] = $entity->label();
      $row['url'] = $entity->toUrl()->toString();
      $created_ts = (int) $entity->getCreatedTime();
      $row['created'] = $created_ts
        ? \Drupal::service('date.formatter')->format($created_ts, 'custom', 'F j, Y')
        : '';
      $row['created_iso'] = $created_ts ? gmdate('c', $created_ts) : '';
    }
    else {
      $row['title'] = '';
      $row['url'] = '';
      $row['created'] = '';
      $row['created_iso'] = '';
    }

    $row['image']['alt'] = $img_alt;
    $row['image']['src'] = $img_meta['src'];
    $row['image']['srcset'] = $img_meta['srcset'];
    $row['image']['width'] = $img_meta['width'];
    $row['image']['height'] = $img_meta['height'];
    // Back-compat for any code using a single URL.
    $row['image']['url'] = $img_meta['src'];
  }
}
/**
 * Preprocess for News View block (unformatted).
 */
function motaded_theme_preprocess_views_view_unformatted__partners__block_2(&$variables) {
  foreach ($variables['rows'] as &$row) {
    $entity = $row['content']['#row']->_entity ?? NULL;
    $fallback_label = $entity ? $entity->label() : '';
    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $fallback_label);
    $img_meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $img_alt = trim($extracted['alt']);
    if ($img_alt === '' && $entity) {
      $img_alt = (string) t('@name logo', ['@name' => $entity->label()]);
    }
    elseif ($img_alt === '') {
      $img_alt = (string) t('Partner logo');
    }

    $row['image']['src'] = $img_meta['src'];
    $row['image']['srcset'] = $img_meta['srcset'];
    $row['image']['width'] = $img_meta['width'];
    $row['image']['height'] = $img_meta['height'];
    $row['image']['url'] = $img_meta['src'];
    $row['image']['alt'] = $img_alt;
    $row['title'] = $entity ? $entity->label() : '';
  }
}

/**
 * Preprocess for Related Similar view fields displays.
 */
function motaded_theme_preprocess_views_view_fields__related_similar(array &$variables): void {
  $entity = $variables['row']->_entity ?? NULL;
  $card_data = motaded_theme_build_views_node_card_data($entity);
  $variables['card_type_label'] = $card_data['card_type_label'];
  $variables['card_bundle'] = $card_data['card_bundle'];
  $variables['card_image'] = $card_data['card_image'];
}

/**
 * Preprocess for News view cards in related displays.
 */
function motaded_theme_preprocess_views_view_fields__news(array &$variables): void {
  $display_id = $variables['view']->current_display ?? '';
  if (!in_array($display_id, ['block_2', 'block_3', 'block_6'], TRUE)) {
    return;
  }
  $entity = $variables['row']->_entity ?? NULL;
  $card_data = motaded_theme_build_views_node_card_data($entity);
  $variables['card_type_label'] = $card_data['card_type_label'];
  $variables['card_bundle'] = $card_data['card_bundle'];
  $variables['card_image'] = $card_data['card_image'];
}

/**
 * Responsive teaser image metadata for news Views row templates (blog + news).
 */
function motaded_theme_preprocess_views_view_fields_news_listing_card_image(array &$variables): void {
  $site_name = (string) \Drupal::config('system.site')->get('name');
  $img_meta = [
    'src' => '',
    'srcset' => '',
    'width' => 325,
    'height' => 200,
    'alt' => $site_name,
  ];

  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity instanceof NodeInterface) {
    $variables['card_image'] = $img_meta;
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  if ($entity->hasTranslation($langcode)) {
    $entity = $entity->getTranslation($langcode);
  }

  $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
  $meta = motaded_theme_blog_listing_card_image_metadata($extracted['uri']);
  $img_meta['src'] = $meta['src'];
  $img_meta['srcset'] = $meta['srcset'];
  $img_meta['width'] = $meta['width'];
  $img_meta['height'] = $meta['height'];
  $img_meta['alt'] = $extracted['alt'] !== '' ? $extracted['alt'] : $entity->label();

  if ($img_meta['src'] === '') {
    $logo_uri = theme_get_setting('logo.url');
    if (is_string($logo_uri) && $logo_uri !== '') {
      $img_meta['src'] = \Drupal::service('file_url_generator')->generateString($logo_uri);
      $img_meta['srcset'] = '';
    }
  }

  $variables['card_image'] = $img_meta;
}

/**
 * Blog listing (/blog): responsive image metadata for article cards.
 */
function motaded_theme_preprocess_views_view_fields__news__page_1(array &$variables): void {
  motaded_theme_preprocess_views_view_fields_news_listing_card_image($variables);
}

/**
 * News listing (/news): responsive image metadata for news cards.
 */
function motaded_theme_preprocess_views_view_fields__news__page_2(array &$variables): void {
  motaded_theme_preprocess_views_view_fields_news_listing_card_image($variables);
}

/**
 * Shared card data builder for Views rows with Node entities.
 *
 * @param mixed $entity
 *   Row entity from Views result.
 *
 * @return array{card_type_label: string, card_bundle: string, card_image: array{src: string, srcset: string, width: int, height: int, alt: string}}
 *   Normalized card metadata for Twig templates.
 */
function motaded_theme_build_views_node_card_data($entity): array {
  $card_type_label = '';
  $card_bundle = '';
  $site_name = (string) \Drupal::config('system.site')->get('name');
  $img_meta = [
    'src' => '',
    'srcset' => '',
    'width' => 151,
    'height' => 120,
    'alt' => $site_name,
  ];

  if ($entity instanceof NodeInterface) {
    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    if ($entity->hasTranslation($langcode)) {
      $entity = $entity->getTranslation($langcode);
    }

    $bundle = $entity->bundle();
    $card_bundle = $bundle;
    $node_type = NodeType::load($bundle);
    $type_label = $node_type !== NULL ? (string) $node_type->label() : $bundle;
    $card_type_map_by_bundle = [
      'page' => (string) t('Service'),
      'article' => (string) t('Blog'),
      'news' => (string) t('News'),
    ];
    $card_type_label = $card_type_map_by_bundle[$bundle] ?? $type_label;

    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
    $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $img_meta['src'] = $meta['src'];
    $img_meta['srcset'] = $meta['srcset'];
    $img_meta['width'] = $meta['width'];
    $img_meta['height'] = $meta['height'];
    $img_meta['alt'] = $extracted['alt'] !== '' ? $extracted['alt'] : $entity->label();
  }

  if ($img_meta['src'] === '') {
    $logo_uri = theme_get_setting('logo.url');
    if (is_string($logo_uri) && $logo_uri !== '') {
      $img_meta['src'] = \Drupal::service('file_url_generator')->generateString($logo_uri);
      $img_meta['srcset'] = '';
    }
  }

  return [
    'card_type_label' => $card_type_label,
    'card_bundle' => $card_bundle,
    'card_image' => $img_meta,
  ];
}

/**
 * Implements hook__preprocess_HOOK().
 */
function motaded_theme_preprocess_breadcrumb(&$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    $prefix = getLanguagePrefix();
    $prefix = str_ends_with($prefix, "/") ? $prefix : $prefix . "/";
    
    if (isset($variables['breadcrumb'][1]) && in_array($variables['breadcrumb'][1]['url'], ['/node', '/ar/node', '/beta/node', '/beta/ar/node'])) {
      array_splice($variables['breadcrumb'], 1, 1);
    }

    if ($node->bundle() == "article") {
      $blog_url = $prefix . "blog";
      if (
        isset($variables['breadcrumb'][1]) &&
        motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'blog')
      ) {
        // Normalize the section label even when contributed by Views.
        $variables['breadcrumb'][1]['text'] = (string) t('Blog');
      }
      else {
        $list_crumb = [
          'text' => (string) t('Blog'),
          'url' => $blog_url,
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    } elseif ($node->bundle() == "page") {
      if (
        !isset($variables['breadcrumb'][1]) ||
        !motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'services')
      ) {
        $list_crumb = [
          'text' => t('Services'),
          'url' => $prefix . "services",
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    } elseif ($node->bundle() == "news") {
      if (
        !isset($variables['breadcrumb'][1]) ||
        !motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'news')
      ) {
        $list_crumb = [
          'text' => t('News'),
          'url' => $prefix . "news",
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    }
  }
}

/**
 * Checks whether breadcrumb URL already points to a section root.
 */
function motaded_theme_breadcrumb_url_matches_section($url, string $section): bool {
  if (!is_string($url) || $url === '') {
    return FALSE;
  }

  $path = parse_url($url, PHP_URL_PATH);
  if (!is_string($path) || $path === '') {
    return FALSE;
  }

  $normalized = '/' . trim($path, '/');
  return (bool) preg_match(
    '#^/(?:beta/)?(?:[a-z]{2}/)?' . preg_quote($section, '#') . '$#i',
    $normalized
  );
}

/**
 * Helper function to get language prefix.
 */
function getLanguagePrefix() {
  if($prefixes = \Drupal::config('language.negotiation')->get('url.prefixes')) {
    $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
    return "/". $prefixes[$language];
  }
  return null;
}

/**
 * Implements hook_preprocess_views_exposed_form().
 *
 * Detaches categories from services page_1 exposed form and stores them for
 * the parent view template where sidebar + results share one container.
 */
function motaded_theme_preprocess_views_exposed_form(&$variables) {
  $form = &$variables['form'];
  if (($form['#id'] ?? '') !== 'views-exposed-form-services-page-1') {
    return;
  }
  if (empty($form['field_taxonomy_target_id']) || !is_array($form['field_taxonomy_target_id'])) {
    return;
  }
  $categories = $form['field_taxonomy_target_id'];
  unset($form['field_taxonomy_target_id']);
  motaded_theme_services_attach_form_attribute_recursive($categories, (string) $form['#id']);
  motaded_theme_services_sidebar_categories_store($categories);
}

/**
 * Implements hook_preprocess_views_view__services__page_1().
 */
function motaded_theme_preprocess_views_view__services__page_1(&$variables) {
  $sidebar = motaded_theme_services_sidebar_categories_store();
  if ($sidebar === NULL && !empty($variables['view']) && $variables['view'] instanceof ViewExecutable) {
    $exposed_plugin = $variables['view']->display_handler
      ? $variables['view']->display_handler->getPlugin('exposed_form')
      : NULL;
    if ($exposed_plugin && method_exists($exposed_plugin, 'renderExposedForm')) {
      $built_form = $exposed_plugin->renderExposedForm(FALSE);
      if (is_array($built_form) && !empty($built_form['field_taxonomy_target_id']) && is_array($built_form['field_taxonomy_target_id'])) {
        $sidebar = $built_form['field_taxonomy_target_id'];
        motaded_theme_services_attach_form_attribute_recursive($sidebar, 'views-exposed-form-services-page-1');
      }
    }
  }
  $variables['services_categories_sidebar'] = $sidebar;
  $is_arabic = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId() === 'ar';
  $variables['services_categories_aria_label'] = $is_arabic
    ? 'الفئات'
    : (string) t('Categories');
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 *
 * Builds translated chip labels for the Services directory cards.
 */
function motaded_theme_preprocess_views_view_fields(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  $display_id = $variables['display_id'] ?? $view->current_display ?? '';
  if ($view->id() !== 'services' || $display_id !== 'page_1') {
    return;
  }

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId();
  $is_arabic = $langcode === 'ar';

  $variables['services_book_now_label'] = $is_arabic
    ? 'احجز الآن'
    : (string) t('Book now');
  $variables['services_explore_benefits_label'] = $is_arabic
    ? 'اكتشف المزايا'
    : (string) t('Explore benefits');

  $variables['services_beneficiary_labels'] = [];
  $variables['services_category_labels'] = [];
  $variables['services_tag_labels'] = [];

  $row = $variables['row'] ?? NULL;
  if (!is_object($row) || !isset($row->_entity)) {
    return;
  }

  $node = $row->_entity;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'page') {
    return;
  }

  if ($node->hasField('field_beneficiaries') && !$node->get('field_beneficiaries')->isEmpty()) {
    foreach ($node->get('field_beneficiaries') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_beneficiary_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }

  if ($node->hasField('field_taxonomy') && !$node->get('field_taxonomy')->isEmpty()) {
    foreach ($node->get('field_taxonomy') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_category_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }

  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    foreach ($node->get('field_tags') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_tag_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }
}

/**
 * First taxonomy term plain label from a node's entity reference field, or ''.
 */
function _motaded_theme_node_first_taxonomy_label(NodeInterface $node, string $field_name, string $langcode): string {
  if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
    return '';
  }
  $referenced = $node->get($field_name)->entity;
  if (!$referenced instanceof TermInterface) {
    return '';
  }

  return motaded_theme_taxonomy_term_translated_label($referenced, $langcode !== '' ? $langcode : 'en');
}

/**
 * Implements hook_preprocess_views_view_field().
 *
 * Builds a richer FullCalendar row title field (month view) with taxonomy meta;
 * separators only between non-empty fragments.
 */
function motaded_theme_preprocess_views_view_field(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->id() !== 'events' || !in_array($view->current_display, ['block_calendar', 'attachment_page_calendar'], TRUE)) {
    return;
  }

  $handler = $variables['field'] ?? NULL;
  if (!$handler instanceof FieldPluginInterface) {
    return;
  }
  $fname = ($handler->definition['field_name'] ?? '');
  if ($fname !== 'title') {
    return;
  }

  $row = $variables['row'] ?? NULL;
  if (!is_object($row) || !isset($row->_entity)) {
    return;
  }

  $node = $row->_entity;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'event') {
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  try {
    $display_node = ($langcode !== '' && $node->hasTranslation($langcode))
      ? $node->getTranslation($langcode)
      : $node;
  }
  catch (\Exception $e) {
    $display_node = $node;
  }

  $href = Html::escape($display_node->toUrl()->toString());
  $title_text = Html::escape($display_node->label());

  $type_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_event_type', $langcode);
  $region_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_region', $langcode);

  $meta_segments = [];
  if ($type_plain !== '') {
    $meta_segments[] = Html::escape($type_plain);
  }
  if ($region_plain !== '') {
    $meta_segments[] = Html::escape($region_plain);
  }

  $html = '<div class="fc-event-card"><div class="fc-event-card__title"><a class="fc-event-card__title-link" href="' . $href . '">' . $title_text . '</a></div>';
  if ($meta_segments !== []) {
    $html .= '<div class="fc-event-card__meta">' . implode(' · ', $meta_segments) . '</div>';
  }
  $html .= '</div>';

  $variables['output'] = [
    '#markup' => Markup::create($html),
  ];
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fullcalendar.
 *
 * Adds extendedProps (event type + region) per event for JS eventContent —
 * Contrib Xss::filter on titles can strip markup from preprocess_views_view_field.
 */
function motaded_theme_preprocess_views_view_fullcalendar(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  if ($view->id() !== 'events' || !in_array($view->current_display, ['block_calendar', 'attachment_page_calendar'], TRUE)) {
    return;
  }
  if (empty($variables['#attached']['drupalSettings']['fullCalendarView'])) {
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  foreach (array_keys($variables['#attached']['drupalSettings']['fullCalendarView']) as $view_index) {
    $settings = &$variables['#attached']['drupalSettings']['fullCalendarView'][$view_index];
    if (empty($settings['calendar_options']) || !is_string($settings['calendar_options'])) {
      continue;
    }
    $decoded = Json::decode($settings['calendar_options']);
    if (!is_array($decoded) || empty($decoded['events']) || !is_array($decoded['events'])) {
      continue;
    }
    $nids = [];
    foreach ($decoded['events'] as $ev) {
      if (!empty($ev['eid'])) {
        $nids[(int) $ev['eid']] = (int) $ev['eid'];
      }
    }
    if ($nids === []) {
      unset($settings);
      continue;
    }
    $nodes = Node::loadMultiple($nids);
    foreach ($decoded['events'] as $i => $event) {
      $nid = isset($event['eid']) ? (int) $event['eid'] : 0;
      if ($nid < 1 || !isset($nodes[$nid])) {
        continue;
      }
      $node = $nodes[$nid];
      if (!$node instanceof NodeInterface || $node->bundle() !== 'event') {
        continue;
      }
      try {
        $display_node = ($langcode !== '' && $node->hasTranslation($langcode))
          ? $node->getTranslation($langcode)
          : $node;
      }
      catch (\Exception $e) {
        $display_node = $node;
      }
      $type_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_event_type', $langcode);
      $region_plain = _motaded_theme_node_first_taxonomy_label($display_node, 'field_region', $langcode);
      $meta_parts = array_filter([$type_plain, $region_plain]);
      $existing = [];
      if (!empty($event['extendedProps']) && is_array($event['extendedProps'])) {
        $existing = $event['extendedProps'];
      }
      $decoded['events'][$i]['extendedProps'] = array_merge($existing, [
        'motaded_type' => $type_plain,
        'motaded_region' => $region_plain,
        'motaded_meta_line' => $meta_parts === [] ? '' : implode(' · ', $meta_parts),
      ]);
    }
    $settings['calendar_options'] = Json::encode($decoded);
    unset($settings);
  }
}

/**
 * Returns a taxonomy term label for a requested langcode when available.
 */
function motaded_theme_taxonomy_term_translated_label(TermInterface $term, string $langcode): string {
  if ($langcode !== '' && $term->hasTranslation($langcode)) {
    return (string) $term->getTranslation($langcode)->label();
  }
  return (string) $term->label();
}

/**
 * Stores/retrieves detached categories for current request.
 */
function motaded_theme_services_sidebar_categories_store(?array $set = NULL): ?array {
  static $stored = NULL;
  if ($set !== NULL) {
    $stored = $set;
  }
  return $stored;
}

/**
 * Sets form="" on form controls (sidebar fields associated with main exposed form).
 */
function motaded_theme_services_attach_form_attribute_recursive(array &$element, string $form_html_id): void {
  $input_types = [
    'textfield', 'search', 'tel', 'email', 'url', 'password', 'textarea',
    'number', 'hidden', 'checkbox', 'radio', 'select', 'file', 'button',
    'submit', 'image_button', 'color', 'range', 'date', 'datetime',
    'entity_autocomplete', 'machine_name', 'weight', 'managed_file',
  ];
  if (isset($element['#type']) && in_array($element['#type'], $input_types, TRUE)) {
    if (!isset($element['#attributes'])) {
      $element['#attributes'] = [];
    }
    if ($element['#attributes'] instanceof \Drupal\Core\Template\Attribute) {
      $element['#attributes']->setAttribute('form', $form_html_id);
    }
    else {
      $element['#attributes']['form'] = $form_html_id;
    }
  }
  foreach (Element::children($element) as $child_key) {
    if (isset($element[$child_key]) && is_array($element[$child_key])) {
      motaded_theme_services_attach_form_attribute_recursive($element[$child_key], $form_html_id);
    }
  }
}

/**
 * After-build: “All categories / sectors / regions” labels on Insights directory filters.
 */
function motaded_theme_insights_directory_views_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-insights-page-1') {
    return $form;
  }
  $pairs = [
    'field_category_target_id' => (string) t('All categories'),
    'field_sector_target_id' => (string) t('All sectors'),
    'field_region_target_id' => (string) t('All regions'),
  ];
  foreach ($pairs as $key => $all_label) {
    if (empty($form[$key]['#options']) || !is_array($form[$key]['#options'])) {
      continue;
    }
    if (isset($form[$key]['#options']['All'])) {
      $form[$key]['#options']['All'] = $all_label;
    }
  }
  return $form;
}

