/**
 * Nested paragraph in the active content language when a translation exists.
 */
function motaded_theme_paragraph_from_context(?ParagraphInterface $paragraph): ?ParagraphInterface {
  if (!$paragraph instanceof ParagraphInterface) {
    return NULL;
  }
  $translated = \Drupal::service('entity.repository')->getTranslationFromContext($paragraph);
  return $translated instanceof ParagraphInterface ? $translated : $paragraph;
}

/**
 * Active UI language code (path prefix / interface).
 */
function motaded_theme_interface_langcode(): string {
  return \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
}

/**
 * Entity label in a specific language (no fallback to default).
 */
function motaded_theme_entity_label_in_language(object $entity, ?string $langcode = NULL): string {
  if (!method_exists($entity, 'label')) {
    return '';
  }
  $langcode ??= motaded_theme_interface_langcode();
  if (method_exists($entity, 'hasTranslation') && $entity->hasTranslation($langcode)) {
    return (string) $entity->getTranslation($langcode)->label();
  }
  return (string) $entity->label();
}

/**
 * Replaces Views area/footer plugin markup when present.
 */
function motaded_theme_views_replace_area_markup(array &$variables, string $area_key, string $markup): void {
  if (empty($variables[$area_key]) || !is_array($variables[$area_key])) {
    return;
  }
  foreach ($variables[$area_key] as $key => $item) {
    if (!is_array($item)) {
      continue;
    }
    if (array_key_exists('#markup', $item)) {
      $variables[$area_key][$key]['#markup'] = Markup::create($markup);
      continue;
    }
    // Views area "text" plugin uses processed_text, not #markup.
    if (($item['#type'] ?? '') === 'processed_text' && array_key_exists('#text', $item)) {
      $variables[$area_key][$key]['#text'] = $markup;
      $variables[$area_key][$key]['#format'] = $item['#format'] ?? 'full_html';
    }
  }
}

