<?php

require_once __DIR__ . '/includes/motaded_theme.image.inc';

use Drupal\block\BlockInterface;
use Drupal\Component\Utility\Html;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Site\Settings;
use Drupal\Core\Language\LanguageInterface;
use Drupal\Core\Render\Element;
use Drupal\Core\Render\Markup;
use Drupal\Core\Url;
use Drupal\node\Entity\Node;
use Drupal\node\Entity\NodeType;
use Drupal\node\NodeInterface;
use Drupal\taxonomy\TermInterface;
use Drupal\views\Views;
use Drupal\views\ViewExecutable;

/**
 * LCP: fetchpriority=high for responsive hero banner images.
 */
function motaded_theme_preprocess_responsive_image_formatter(array &$variables) {
  if (($variables['responsive_image_style_id'] ?? '') !== 'hero_banner') {
    return;
  }
  if (empty($variables['responsive_image']['#attributes'])) {
    return;
  }
  $attr = $variables['responsive_image']['#attributes'];
  if ($attr instanceof \Drupal\Core\Template\Attribute) {
    $attr->setAttribute('fetchpriority', 'high');
  }
  elseif (is_array($attr)) {
    $variables['responsive_image']['#attributes']['fetchpriority'] = 'high';
  }
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Kept as a no-op so the theme hook remains a valid callable (FA uses libraries).
 */
function motaded_theme_page_attachments_alter(array &$attachments): void {
}

/**
 * Whether SEO/marketing third-party tags should be omitted (see settings.php).
 */
function _motaded_theme_suppress_seo_tracking(): bool {
  return (bool) Settings::get('motaded_suppress_seo_tracking', FALSE);
}

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function motaded_theme_preprocess_html(array &$variables): void {
  $variables['motaded_suppress_seo_tracking'] = _motaded_theme_suppress_seo_tracking();
}

function motaded_theme_preprocess_block(array &$variables) {
  // Services page: hide standalone exposed block; we render it inside the view.
  if (($variables['elements']['#plugin_id'] ?? '') === 'views_exposed_filter_block:services-page_1') {
    $variables['elements']['#access'] = FALSE;
    return;
  }

  if (!empty($variables['elements']['#id']) && $variables['elements']['#id'] == 'motaded_theme_mainnavigation') {
    $variables['content']['#attributes']['data-block-id'] = $variables['elements']['#id'];
  }
  // Global CTA: pass show_title_on_button, cta_heading, cta_subtitle (badge).
  if (isset($variables['elements']['content']['#block_content'])) {
    $block_content = $variables['elements']['content']['#block_content'];
    if ($block_content->bundle() === 'global_cta') {
      if ($block_content->hasField('field_show_title_on_button')) {
        $variables['show_title_on_button'] = !$block_content->get('field_show_title_on_button')->isEmpty()
          && (bool) $block_content->get('field_show_title_on_button')->value;
      }
      if ($block_content->hasField('field_text') && !$block_content->get('field_text')->isEmpty()) {
        $heading = trim($block_content->get('field_text')->value);
        $variables['cta_heading'] = $heading;
        // Split at first "?" for intentional two-line display (e.g. "Ready to start?" / "Contact us today").
        if (strpos($heading, '?') !== false) {
          $parts = explode('?', $heading, 2);
          $variables['cta_heading_line1'] = trim($parts[0]) . '?';
          $variables['cta_heading_line2'] = trim($parts[1] ?? '');
        }
      }
      if ($block_content->hasField('field_subtitle') && !$block_content->get('field_subtitle')->isEmpty()) {
        $variables['cta_subtitle'] = trim($block_content->get('field_subtitle')->value);
      }
    }
  }
  // First footer column (Quick Links): pass logo, front page, and footer CTA block.
  if (isset($variables['elements']['#id']) && $variables['elements']['#id'] === 'motaded_theme_footer') {
    $variables['logo_path'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
    $variables['front_page'] = \Drupal\Core\Url::fromRoute('<front>', [], ['absolute' => TRUE])->toString();
    $cta_block = \Drupal\block\Entity\Block::load('motaded_theme_cta_3');
    if ($cta_block && $cta_block->getRegion() === 'footer') {
      $variables['footer_cta_block'] = \Drupal::entityTypeManager()
        ->getViewBuilder('block')
        ->view($cta_block);
    }
  }
}

/**
 * Implements hook_views_pre_view().
 *
 * Forces services page_1 exposed filters to render inside the view output,
 * even if config still has "Exposed form in block" enabled.
 */
function motaded_theme_views_pre_view(ViewExecutable $view, string $display_id, array &$args): void {
  if ($view->id() !== 'services' || $display_id !== 'page_1') {
    return;
  }
  if ($view->display_handler) {
    $view->display_handler->setOption('exposed_block', FALSE);
  }
}

function motaded_theme_theme_suggestions_menu_alter(array &$suggestions, array $variables) {
  if (isset($variables['attributes']['data-block-id'])) {
    $block = \Drupal\block\Entity\Block::load($variables['attributes']['data-block-id']);
    if ($block) {
      array_push($suggestions, 'menu__' . str_replace('-', '_', $block->getRegion()));
    }
  }
}

/**
 * Builds the "More on this topic" below_content block (same view + markup for all bundles).
 *
 * @return array|null
 *   Render array, or NULL if no category or view is missing.
 */
function motaded_theme_more_on_topic_build(NodeInterface $node): ?array {
  if (!$node->hasField('field_taxonomy') || $node->get('field_taxonomy')->isEmpty()) {
    return NULL;
  }
  $tid = (int) $node->get('field_taxonomy')->target_id;
  if ($tid <= 0) {
    return NULL;
  }
  $view = Views::getView('related_similar');
  if (!$view) {
    return NULL;
  }
  switch ($node->bundle()) {
    case 'article':
      $display_id = 'block_2';
      break;

    case 'news':
      $display_id = 'block_3';
      break;

    case 'page':
      $display_id = 'block_1';
      $is_service = $node->hasField('field_display_on_services')
        && !$node->get('field_display_on_services')->isEmpty()
        && (int) $node->get('field_display_on_services')->value === 1;
      if (!$is_service) {
        return NULL;
      }
      break;

    default:
      return NULL;
  }

  return [
    '#type' => 'container',
    '#attributes' => ['class' => ['more-on-topic-region', 'mt-10']],
    '#cache' => [
      'contexts' => ['route'],
      'tags' => $node->getCacheTags(),
    ],
    'title' => [
      '#markup' => '<h2 class="more-on-topic-heading">' . (string) t('More on this topic') . '</h2>',
    ],
    'view' => $view->buildRenderable($display_id, [
      (string) $tid,
      (string) $node->id(),
    ]),
    '#weight' => 50,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 *
 * Preprocesses variables for the page template.
 * Adds default logo path variable.
 */
function motaded_theme_preprocess_page(&$variables) {
  $variables['motaded_suppress_seo_tracking'] = _motaded_theme_suppress_seo_tracking();
  // Adds logo path to page.html.twig variables.
  $variables['logo_path'] = \Drupal::service('file_url_generator')->generateString(theme_get_setting('logo.url'));
  // Hide motaded_theme_cta_3 from footer region; it's rendered inside the footer block.
  if (isset($variables['page']['footer']['motaded_theme_cta_3'])) {
    $variables['page']['footer']['motaded_theme_cta_3']['#access'] = FALSE;
  }

  // Footer: about row, then Our Services | Useful Resources | Legal (see .footer-site in main.css).
  if (!empty($variables['page']['footer']) && is_array($variables['page']['footer'])) {
    $footer = &$variables['page']['footer'];

    $about_keys = ['motaded_theme_footerabouttext'];
    $left_children = [];
    foreach ($about_keys as $key) {
      if (isset($footer[$key])) {
        $left_children[$key] = $footer[$key];
        unset($footer[$key]);
      }
    }
    if ($left_children !== []) {
      $footer['footer_site_col_left'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['footer-site__col-left']],
        '#weight' => -50,
      ];
      foreach ($left_children as $key => $element) {
        $footer['footer_site_col_left'][$key] = $element;
      }
    }

    $menu_keys = ['motaded_theme_ourservices', 'motaded_theme_otherservices', 'motaded_theme_quicklinks'];
    $menu_children = [];
    foreach ($menu_keys as $key) {
      if (isset($footer[$key])) {
        $menu_children[$key] = $footer[$key];
        unset($footer[$key]);
      }
    }
    if ($menu_children !== []) {
      $footer['footer_site_menus'] = [
        '#type' => 'container',
        '#attributes' => ['class' => ['footer-site__menus']],
        '#weight' => -45,
      ];
      foreach ($menu_children as $key => $element) {
        $footer['footer_site_menus'][$key] = $element;
      }
    }
  }

  // Service (Basic page + Display on services): full-width hero; sidebar renders in node template.
  $route_node = \Drupal::routeMatch()->getParameter('node');
  if ($route_node instanceof NodeInterface
    && $route_node->bundle() === 'page'
    && $route_node->hasField('field_display_on_services')
    && !$route_node->get('field_display_on_services')->isEmpty()
    && (int) $route_node->get('field_display_on_services')->value === 1) {
    $variables['service_page_full_bleed'] = TRUE;
    $sidebar_build = $variables['page']['sidebar_second'] ?? NULL;
    if (is_array($sidebar_build) && Element::children($sidebar_build) !== []) {
      \Drupal::request()->attributes->set('motaded_theme_service_sidebar_second', $sidebar_build);
    }
    // Never render sidebar in page.html.twig for this layout (node template owns it).
    unset($variables['page']['sidebar_second']);

  }

  // Article / News full node: same "More on this topic" band (reuses helper + view + CSS).
  if ($route_node instanceof NodeInterface
    && in_array($route_node->bundle(), ['article', 'news'], TRUE)
    && \Drupal::routeMatch()->getRouteName() === 'entity.node.canonical') {
    $more_on_topic = motaded_theme_more_on_topic_build($route_node);
    if ($more_on_topic !== NULL) {
      $variables['page']['below_content']['more_on_topic_related'] = $more_on_topic;
    }
  }
}

/**
 * Truncates HTML to a plain-text string for hero intro fallback.
 */
/**
 * Builds a render array for the active theme's sidebar_second region.
 *
 * Used when the region copy from preprocess_page is missing (ordering / empty()).
 */
function motaded_theme_build_sidebar_second_region(): array {
  /** @var \Drupal\block\BlockRepositoryInterface $repo */
  $repo = \Drupal::service('block.repository');
  $cacheability = [];
  $regions = $repo->getVisibleBlocksPerRegion($cacheability);
  $region_blocks = $regions['sidebar_second'] ?? [];
  if ($region_blocks === []) {
    return [];
  }
  $view_builder = \Drupal::entityTypeManager()->getViewBuilder('block');
  $build = [];
  foreach ($region_blocks as $block) {
    if (!$block instanceof BlockInterface) {
      continue;
    }
    if ($block->access('view')) {
      $build[$block->id()] = $view_builder->view($block);
    }
  }
  return $build;
}

function motaded_theme_plain_text_truncate(string $html, int $max_length): string {
  $text = trim(preg_replace('/\s+/u', ' ', strip_tags($html)));
  if ($text === '') {
    return '';
  }
  if (mb_strlen($text) <= $max_length) {
    return $text;
  }
  return mb_substr($text, 0, $max_length) . '…';
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * Preprocesses variables for the node template.
 * Adds body summary variable
 */
function motaded_theme_preprocess_node(&$variables) {
  $node = $variables['node'];
  $variables['summary'] = NULL;
  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    $body_item = $node->get('body')->first();
    if ($body_item) {
      $summary_text = trim((string) $body_item->summary);
      if ($summary_text !== '') {
        $variables['summary'] = ['#markup' => nl2br(Html::escape($summary_text))];
      }
    }
  }

  // Article (full page): blog-style hero rail — read time, media, meta for twig.
  if ($node->bundle() === 'article'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    $variables['article_hero_media'] = [];
    if ($node->hasField('field_media') && !$node->get('field_media')->isEmpty()) {
      $media = $node->get('field_media')->entity;
      if ($media) {
        $variables['article_hero_media'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'banner_sm');
      }
    }
    $variables['article_read_time'] = [];
    if ($node->hasField('field_estimated_read_time') && !$node->get('field_estimated_read_time')->isEmpty()) {
      $variables['article_read_time'] = \Drupal::entityTypeManager()
        ->getViewBuilder('node')
        ->viewField($node->get('field_estimated_read_time'), [
          'label' => 'hidden',
          'type' => 'estimated_read_time_text',
          'weight' => 0,
          'settings' => [
            'tokenized_string' => (string) t('@minutes min read'),
          ],
          'third_party_settings' => [],
        ]);
    }
    $variables['article_updated_formatted'] = \Drupal::service('date.formatter')->format(
      (int) $node->getChangedTime(),
      'custom',
      'j F Y'
    );
    $variables['article_changed_iso'] = gmdate('c', (int) $node->getChangedTime());
  }

  // News (full page): hero media (view mode news) + updated date for meta row.
  if ($node->bundle() === 'news'
    && ($variables['view_mode'] ?? '') === 'full'
    && !empty($variables['page'])) {
    $variables['news_hero_media'] = [];
    if ($node->hasField('field_media') && !$node->get('field_media')->isEmpty()) {
      $media = $node->get('field_media')->entity;
      if ($media) {
        $variables['news_hero_media'] = \Drupal::entityTypeManager()
          ->getViewBuilder('media')
          ->view($media, 'news');
      }
    }
    $variables['news_updated_formatted'] = \Drupal::service('date.formatter')->format(
      (int) $node->getChangedTime(),
      'custom',
      'j F Y'
    );
    $variables['news_changed_iso'] = gmdate('c', (int) $node->getChangedTime());
  }

  // Service page (Basic page + Display on services): compact hero data.
  if ($node->bundle() === 'page'
    && ($variables['view_mode'] ?? '') === 'full'
    && $node->hasField('field_display_on_services')
    && !$node->get('field_display_on_services')->isEmpty()
    && (int) $node->get('field_display_on_services')->value === 1) {
    $request = \Drupal::request();
    $sidebar_build = [];
    if ($request->attributes->has('motaded_theme_service_sidebar_second')) {
      $sidebar_build = $request->attributes->get('motaded_theme_service_sidebar_second');
      $request->attributes->remove('motaded_theme_service_sidebar_second');
    }
    if (!is_array($sidebar_build) || Element::children($sidebar_build) === []) {
      $sidebar_build = motaded_theme_build_sidebar_second_region();
    }
    $variables['service_sidebar_second'] = $sidebar_build;
    $variables['service_hero_intro'] = NULL;
    $variables['service_contact_url'] = Url::fromUserInput('/contact-us')->toString();
    $variables['service_other_services_url'] = Url::fromUserInput('/services')->toString();
    $has_sidebar_blocks = is_array($sidebar_build) && Element::children($sidebar_build) !== [];
    $variables['service_show_right_column'] = $has_sidebar_blocks;
    $variables['service_body_use_readmore'] = FALSE;
    if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
      $item = $node->get('body')->first();
      $summary = trim((string) $item->summary);
      if ($summary !== '') {
        $variables['service_hero_intro'] = ['#markup' => nl2br(Html::escape($summary))];
      }
      else {
        $truncated = motaded_theme_plain_text_truncate((string) $item->processed, 320);
        if ($truncated !== '') {
          $variables['service_hero_intro'] = ['#markup' => Html::escape($truncated)];
        }
      }
      // Long body: collapsible UI; full HTML stays in the template for SEO.
      $plain_len = mb_strlen(trim(strip_tags((string) $item->value)));
      $variables['service_body_use_readmore'] = $plain_len > 2499;
    }
  }

  // Add step numbers to field_steps_to_obtain items.
  if ($node->bundle() == 'page' && !empty($variables['content']['field_steps_to_obtain'])) {
    foreach ($variables['content']['field_steps_to_obtain'] as $i => &$item) {
      if (is_numeric($i)) {
        $item['#number'] = $i;
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for paragraph templates.
 *
 * Splits objectives body on a blank line into title + description when present.
 */
function motaded_theme_preprocess_paragraph(array &$variables): void {
  $paragraph = $variables['paragraph'];
  if ($paragraph->bundle() !== 'objectives') {
    return;
  }
  if (!$paragraph->hasField('field_content') || $paragraph->get('field_content')->isEmpty()) {
    return;
  }
  $text = trim((string) $paragraph->get('field_content')->value);
  if ($text === '') {
    return;
  }
  $parts = preg_split('/\R(?:\s*\R)+/', $text, 2);
  if (isset($parts[1])) {
    $variables['objectives_card_title'] = trim((string) $parts[0]);
    $variables['objectives_card_body'] = trim((string) $parts[1]);
  }
}

/**
 * Split promo: plain copy + media render (banner_sm / responsive image) for Twig.
 */
function motaded_theme_preprocess_paragraph__split_promo(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['split_promo_heading_id'] = Html::getUniqueId('split-promo-heading-' . $paragraph->id());

  $variables['split_promo_headline'] = '';
  if ($paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['split_promo_headline'] = trim((string) $paragraph->get('field_title')->value);
  }

  $variables['split_promo_sub'] = '';
  if ($paragraph->get('field_sub_title')->access('view') && !$paragraph->get('field_sub_title')->isEmpty()) {
    $variables['split_promo_sub'] = trim((string) $paragraph->get('field_sub_title')->value);
  }

  $bullets = [];
  $bullet_field = $paragraph->get('field_promo_bullet');
  if ($bullet_field->access('view')) {
    foreach ($bullet_field as $item) {
      $line = trim((string) $item->value);
      if ($line !== '') {
        $bullets[] = $line;
      }
    }
  }
  $variables['split_promo_bullets'] = $bullets;

  $variables['split_promo_trust'] = '';
  if ($paragraph->get('field_promo_trust')->access('view') && !$paragraph->get('field_promo_trust')->isEmpty()) {
    $variables['split_promo_trust'] = trim((string) $paragraph->get('field_promo_trust')->value);
  }

  $variables['split_promo_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['split_promo_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }
}

/**
 * Promo split: features, media (banner_sm), optional logo overlay for Twig.
 */
function motaded_theme_preprocess_paragraph__promo_split(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['promo_split_heading_id'] = Html::getUniqueId('promo-split-heading-' . $paragraph->id());

  $variables['promo_split_media_side'] = 'image_right';
  if ($paragraph->get('field_promo_split_side')->access('view') && !$paragraph->get('field_promo_split_side')->isEmpty()) {
    $variables['promo_split_media_side'] = (string) $paragraph->get('field_promo_split_side')->value;
  }

  $variables['promo_split_list_style'] = 'icons_row';
  if ($paragraph->get('field_promo_split_list_style')->access('view') && !$paragraph->get('field_promo_split_list_style')->isEmpty()) {
    $variables['promo_split_list_style'] = (string) $paragraph->get('field_promo_split_list_style')->value;
  }

  $features = [];
  $item_field = $paragraph->get('field_promo_split_item');
  if ($item_field->access('view')) {
    foreach ($item_field as $item) {
      $line = trim((string) $item->value);
      if ($line !== '') {
        $features[] = $line;
      }
    }
  }
  $variables['promo_split_features'] = $features;

  $icon_cycle = ['user', 'shield', 'globe'];
  $variables['promo_split_icon_keys'] = [];
  foreach (array_keys($features) as $i) {
    $variables['promo_split_icon_keys'][$i] = $icon_cycle[$i % 3];
  }

  $variables['promo_split_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['promo_split_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }

  $variables['promo_split_logo'] = [];
  if ($paragraph->get('field_promo_split_logo')->access('view') && !$paragraph->get('field_promo_split_logo')->isEmpty()) {
    $logo = $paragraph->get('field_promo_split_logo')->entity;
    if ($logo) {
      $variables['promo_split_logo'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($logo, 'default');
    }
  }

  $variables['promo_split_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['promo_split_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }
}

/**
 * Investor journey: nested journey_step rows for timeline Twig.
 */
function motaded_theme_preprocess_paragraph__investor_journey(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['investor_journey_heading_id'] = Html::getUniqueId('investor-journey-heading-' . $paragraph->id());

  $steps = [];
  $field = $paragraph->get('field_investor_journey_steps');
  if ($field->access('view')) {
    foreach ($field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'journey_step') {
        continue;
      }
      $icon = (string) ($sub->get('field_journey_icon')->value ?: 'document');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $row = [
        'title' => $title,
        'icon' => $icon,
      ];
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $value = (string) $sub->get('field_body')->value;
        $format = (string) ($sub->get('field_body')->format ?: 'plain_text');
        $body_markup = check_markup($value, $format);
        if ($body_markup !== '') {
          $row['body'] = Markup::create($body_markup);
        }
      }
      $steps[] = $row;
    }
  }
  $variables['investor_journey_steps'] = $steps;

  $variables['investor_journey_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['investor_journey_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }
}

/**
 * Hero split banner: hero image + stats for Twig.
 */
function motaded_theme_preprocess_paragraph__hero_split_banner(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/hero_split_banner';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['hero_split_banner_heading_id'] = Html::getUniqueId('hero-split-banner-heading-' . $paragraph->id());

  $variables['hero_split_headline_prefix'] = '';
  if ($paragraph->get('field_hero_split_headline_prefix')->access('view') && !$paragraph->get('field_hero_split_headline_prefix')->isEmpty()) {
    $variables['hero_split_headline_prefix'] = trim((string) $paragraph->get('field_hero_split_headline_prefix')->value);
  }
  $variables['hero_split_headline_accent'] = '';
  if ($paragraph->get('field_hero_split_headline_accent')->access('view') && !$paragraph->get('field_hero_split_headline_accent')->isEmpty()) {
    $variables['hero_split_headline_accent'] = trim((string) $paragraph->get('field_hero_split_headline_accent')->value);
  }

  $variables['hero_split_trust'] = '';
  if ($paragraph->get('field_hero_split_trust')->access('view') && !$paragraph->get('field_hero_split_trust')->isEmpty()) {
    $variables['hero_split_trust'] = trim((string) $paragraph->get('field_hero_split_trust')->value);
  }

  $stats = [];
  $stat_field = $paragraph->get('field_hero_split_stats');
  if ($stat_field->access('view')) {
    foreach ($stat_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'hero_stat') {
        continue;
      }
      $icon = (string) ($sub->get('field_hero_stat_icon')->value ?: 'clock');
      $value = '';
      if ($sub->get('field_hero_stat_value')->access('view') && !$sub->get('field_hero_stat_value')->isEmpty()) {
        $value = trim((string) $sub->get('field_hero_stat_value')->value);
      }
      $label = '';
      if ($sub->get('field_hero_stat_label')->access('view') && !$sub->get('field_hero_stat_label')->isEmpty()) {
        $label = trim((string) $sub->get('field_hero_stat_label')->value);
      }
      $stats[] = [
        'icon' => $icon,
        'value' => $value,
        'label' => $label,
      ];
    }
  }
  $variables['hero_split_stats'] = $stats;

  $variables['hero_split_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['hero_split_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'hero_banner');
    }
  }

  $variables['hero_split_cta'] = [];
  $link = $paragraph->get('field_link');
  if ($link->access('view') && !$link->isEmpty()) {
    /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $item */
    $item = $link->first();
    if ($item) {
      $url = $item->getUrl();
      if ($url) {
        $title = $item->getTitle();
        $variables['hero_split_cta'] = [
          'url' => $url->toString(),
          'title' => $title !== '' && $title !== NULL ? $title : (string) t('Learn more'),
        ];
      }
    }
  }
}

/**
 * Why opportunities: feature cards, stat bar items, trust line.
 */
function motaded_theme_preprocess_paragraph__why_opportunities(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/why_opportunities';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['why_opportunities_heading_id'] = Html::getUniqueId('why-opportunities-heading-' . $paragraph->id());

  $variables['why_opportunities_trust'] = '';
  if ($paragraph->get('field_why_trust_line')->access('view') && !$paragraph->get('field_why_trust_line')->isEmpty()) {
    $variables['why_opportunities_trust'] = trim((string) $paragraph->get('field_why_trust_line')->value);
  }

  $features = [];
  $feature_field = $paragraph->get('field_why_features');
  if ($feature_field->access('view')) {
    foreach ($feature_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_feature_card') {
        continue;
      }
      $icon = (string) ($sub->get('field_why_feature_icon')->value ?: 'people');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      // If editors left default "people" on cards that are not team-focused, map by title (EN).
      if ($icon === 'people' && $title !== '') {
        $lower = function_exists('mb_strtolower') ? mb_strtolower($title) : strtolower($title);
        if (str_contains($lower, 'strategic') || str_contains($lower, 'gateway')) {
          $icon = 'globe';
        }
        elseif (str_contains($lower, 'growth') || str_contains($lower, 'sector')) {
          $icon = 'trend';
        }
        elseif (str_contains($lower, 'vision') || str_contains($lower, 'reform')) {
          $icon = 'clock';
        }
      }
      $body = [];
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body = $sub->get('field_body')->view([
          'type' => 'text_default',
          'label' => 'hidden',
        ]);
      }
      $link = [];
      $link_field = $sub->get('field_link');
      if ($link_field->access('view') && !$link_field->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
        $link_item = $link_field->first();
        if ($link_item) {
          $url = $link_item->getUrl();
          if ($url) {
            $ltitle = $link_item->getTitle();
            $link = [
              'url' => $url->toString(),
              'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
            ];
          }
        }
      }
      $features[] = [
        'icon' => $icon,
        'title' => $title,
        'body' => $body,
        'link' => $link,
      ];
    }
  }
  $variables['why_opportunities_features'] = $features;

  $stats = [];
  $stat_field = $paragraph->get('field_why_stat_items');
  if ($stat_field->access('view')) {
    foreach ($stat_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'why_stat_item') {
        continue;
      }
      $icon = (string) ($sub->get('field_why_stat_icon')->value ?: 'globe');
      $value = '';
      if ($sub->get('field_why_stat_value')->access('view') && !$sub->get('field_why_stat_value')->isEmpty()) {
        $value = trim((string) $sub->get('field_why_stat_value')->value);
      }
      $label = '';
      if ($sub->get('field_why_stat_label')->access('view') && !$sub->get('field_why_stat_label')->isEmpty()) {
        $label = trim((string) $sub->get('field_why_stat_label')->value);
      }
      $stats[] = [
        'icon' => $icon,
        'value' => $value,
        'label' => $label,
      ];
    }
  }
  $variables['why_opportunities_stats'] = $stats;
}

/**
 * Business setup options: image cards + bottom trust banner.
 */
function motaded_theme_preprocess_paragraph__business_setup_section(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['business_setup_heading_id'] = Html::getUniqueId('business-setup-heading-' . $paragraph->id());

  $variables['business_setup_banner_line1'] = '';
  if ($paragraph->get('field_setup_banner_line1')->access('view') && !$paragraph->get('field_setup_banner_line1')->isEmpty()) {
    $variables['business_setup_banner_line1'] = trim((string) $paragraph->get('field_setup_banner_line1')->value);
  }
  $variables['business_setup_banner_line2'] = '';
  if ($paragraph->get('field_setup_banner_line2')->access('view') && !$paragraph->get('field_setup_banner_line2')->isEmpty()) {
    $variables['business_setup_banner_line2'] = trim((string) $paragraph->get('field_setup_banner_line2')->value);
  }

  $cards = [];
  $card_field = $paragraph->get('field_business_setup_cards');
  if ($card_field->access('view')) {
    foreach ($card_field as $item) {
      $sub = $item->entity;
      if (!$sub instanceof \Drupal\paragraphs\Entity\Paragraph || $sub->bundle() !== 'business_setup_card') {
        continue;
      }
      $icon = (string) ($sub->get('field_business_setup_icon')->value ?: 'city');
      $title = '';
      if ($sub->get('field_title')->access('view') && !$sub->get('field_title')->isEmpty()) {
        $title = trim((string) $sub->get('field_title')->value);
      }
      $body = [];
      if ($sub->get('field_body')->access('view') && !$sub->get('field_body')->isEmpty()) {
        $body = $sub->get('field_body')->view([
          'type' => 'text_default',
          'label' => 'hidden',
        ]);
      }
      $link = [];
      $link_field = $sub->get('field_link');
      if ($link_field->access('view') && !$link_field->isEmpty()) {
        /** @var \Drupal\link\Plugin\Field\FieldType\LinkItem|null $link_item */
        $link_item = $link_field->first();
        if ($link_item) {
          $url = $link_item->getUrl();
          if ($url) {
            $ltitle = $link_item->getTitle();
            $link = [
              'url' => $url->toString(),
              'title' => $ltitle !== '' && $ltitle !== NULL ? $ltitle : (string) t('Learn more'),
            ];
          }
        }
      }
      $media = [];
      if ($sub->get('field_media')->access('view') && !$sub->get('field_media')->isEmpty()) {
        $media_entity = $sub->get('field_media')->entity;
        if ($media_entity) {
          $media = \Drupal::entityTypeManager()
            ->getViewBuilder('media')
            ->view($media_entity, 'default');
        }
      }
      $popular = FALSE;
      if ($sub->hasField('field_business_setup_popular') && $sub->get('field_business_setup_popular')->access('view') && !$sub->get('field_business_setup_popular')->isEmpty()) {
        $popular = (bool) $sub->get('field_business_setup_popular')->value;
      }
      $cards[] = [
        'icon' => $icon,
        'title' => $title,
        'body' => $body,
        'link' => $link,
        'media' => $media,
        'popular' => $popular,
      ];
    }
  }
  $variables['business_setup_cards'] = $cards;
}

/**
 * View block paragraph: flag when embedded view is news / block_4 (compact list layout).
 */
function motaded_theme_preprocess_paragraph__view_block(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['view_block_news_latest'] = FALSE;
  $variables['view_block_services_home'] = FALSE;
  if (!$paragraph->hasField('field_view_block') || $paragraph->get('field_view_block')->isEmpty()) {
    return;
  }
  foreach ($paragraph->get('field_view_block')->getValue() as $item) {
    $target = $item['target_id'] ?? '';
    $display = $item['display_id'] ?? '';
    if ($target === 'news' && $display === 'block_4') {
      $variables['view_block_news_latest'] = TRUE;
      return;
    }
    if ($target === 'services' && $display === 'block_2') {
      $variables['view_block_services_home'] = TRUE;
      return;
    }
    if (!empty($item['data']) && is_string($item['data'])) {
      $decoded = json_decode($item['data'], TRUE);
      if (!is_array($decoded)) {
        continue;
      }
      $tid = $decoded['target_id'] ?? '';
      $did = $decoded['display_id'] ?? '';
      if ($tid === 'news' && $did === 'block_4') {
        $variables['view_block_news_latest'] = TRUE;
        return;
      }
      if ($tid === 'services' && $did === 'block_2') {
        $variables['view_block_services_home'] = TRUE;
        return;
      }
    }
  }
}

/**
 * Media lead: image left, icon + headline + body + CTA (Twig + responsive media).
 */
function motaded_theme_preprocess_paragraph__media_lead(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['media_lead_heading_id'] = Html::getUniqueId('media-lead-heading-' . $paragraph->id());
  $variables['media_lead_headline'] = '';
  if ($paragraph->get('field_title')->access('view') && !$paragraph->get('field_title')->isEmpty()) {
    $variables['media_lead_headline'] = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['media_lead_media'] = [];
  if ($paragraph->get('field_media')->access('view') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    if ($media) {
      $variables['media_lead_media'] = \Drupal::entityTypeManager()
        ->getViewBuilder('media')
        ->view($media, 'banner_sm');
    }
  }
}

/**
 * Plain title + image alt from media (fallback to title) for article-card output.
 */
function motaded_theme_preprocess_paragraph__business_activity(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $title_plain = '';
  if ($paragraph->hasField('field_title') && !$paragraph->get('field_title')->isEmpty()) {
    $title_plain = trim((string) $paragraph->get('field_title')->value);
  }
  $variables['business_activity_title_plain'] = $title_plain;

  $variables['business_activity_tag'] = '';
  $parent = $paragraph->getParentEntity();
  if ($parent instanceof NodeInterface) {
    $tag_map = [
      'page' => (string) t('Service'),
      'article' => (string) t('Blog'),
      'news' => (string) t('News'),
    ];
    $variables['business_activity_tag'] = $tag_map[$parent->bundle()] ?? '';
  }

  $image_alt = $title_plain;
  $image_uri = NULL;
  if ($paragraph->hasField('field_media') && !$paragraph->get('field_media')->isEmpty()) {
    $media = $paragraph->get('field_media')->entity;
    $image_data = motaded_theme_media_image_uri_and_alt($media, $title_plain);
    $image_uri = $image_data['uri'];
    if ($image_data['alt'] !== '') {
      $image_alt = $image_data['alt'];
    }
  }
  if ($image_alt === '' && $title_plain !== '') {
    $image_alt = $title_plain;
  }
  if ($image_alt === '') {
    $image_alt = (string) t('Illustration for service information');
  }
  $variables['business_activity_image_alt'] = $image_alt;
  $variables['business_activity_image_meta'] = motaded_theme_responsive_teaser_image_metadata($image_uri);
}

/**
 * Implements hook_preprocess_HOOK() for areas_of_work paragraphs.
 *
 * Splits plain text on the first colon so the lead phrase can be styled bold
 * (e.g. "Mandatory activities: These include…").
 */
function motaded_theme_preprocess_paragraph__areas_of_work(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  if (!$paragraph->hasField('field_content') || $paragraph->get('field_content')->isEmpty()) {
    return;
  }
  $full = trim((string) $paragraph->get('field_content')->value);
  if ($full === '') {
    return;
  }
  $pos = strpos($full, ':');
  if ($pos === FALSE) {
    return;
  }
  $label = trim(substr($full, 0, $pos));
  $rest = trim(substr($full, $pos + 1));
  if ($label === '') {
    return;
  }
  $variables['areas_lead_label'] = $label;
  $variables['areas_rest_safe'] = $rest === ''
    ? NULL
    : Markup::create(nl2br(Html::escape($rest), FALSE));
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function motaded_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Core route /system/404 (system.404) is a normal route match, so Drupal does
  // not add page__404; use the same layout as for real 404 responses.
  if (\Drupal::routeMatch()->getRouteName() === 'system.404') {
    array_unshift($suggestions, 'page__404');
  }

  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $suggestions[] = 'page__' . $node->bundle();
  }
}

/**
 * Implements hook_preprocess_paragraph__steps().
 */
function motaded_theme_preprocess_paragraph__steps(array &$variables) {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $steps = [];
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

  // Check if field_paragraphs exists and has data.
  if ($paragraph->hasField('field_paragraphs') && !$paragraph->get('field_paragraphs')->isEmpty()) {
    foreach ($paragraph->get('field_paragraphs')->referencedEntities() as $item) {
      // Try to get the translation if available.
      if ($item->hasTranslation($langcode)) {
        $item = $item->getTranslation($langcode);
      }
      // Each $item is a sub-paragraph, e.g., a single step/card.
      $stepTitle = $item->hasField('field_sub_title') ? $item->get('field_sub_title')->value : '';
      $title = $item->hasField('field_title') ? $item->get('field_title')->value : '';
      $desc = $item->hasField('field_body') ? $item->get('field_body')->processed : '';

      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($item, (string) $title);
      $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);

      $steps[] = [
        'step_title' => $stepTitle,
        'title' => $title,
        'desc' => $desc,
        'img' => $meta['src'],
        'img_srcset' => $meta['srcset'],
        'img_width' => $meta['width'],
        'img_height' => $meta['height'],
        'img_alt' => $extracted['alt'] !== '' ? $extracted['alt'] : (string) $title,
      ];
    }
  }

  // Attach the structured data to drupalSettings.
  // Use paragraph ID so multiple 'steps' paragraphs don’t overwrite each other.
  $variables['#attached']['drupalSettings']['motaded_theme']['steps'] = $steps;

  // Attach JS library.
  $variables['#attached']['library'][] = 'motaded_theme/steps';
}

/**
 * Implements hook_preprocess_paragraph__featured_contents().
 */
function motaded_theme_preprocess_paragraph__featured_contents(array &$variables): void {
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['featured_card_images'] = [];
  if (!$paragraph->hasField('field_contents') || $paragraph->get('field_contents')->isEmpty()) {
    return;
  }
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  foreach ($paragraph->get('field_contents')->referencedEntities() as $node) {
    if ($node->hasTranslation($langcode)) {
      $node = $node->getTranslation($langcode);
    }
    $nid = (int) $node->id();
    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($node, $node->label());
    $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $meta['alt'] = $extracted['alt'];
    $variables['featured_card_images'][$nid] = $meta;
  }
}

/**
 * Implements hook_preprocess_paragraph__insights_updates().
 */
function motaded_theme_preprocess_paragraph__insights_updates(array &$variables): void {
  $variables['#attached']['library'][] = 'motaded_theme/insights-updates';
  /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
  $paragraph = $variables['paragraph'];
  $variables['iu_card_images'] = [];
  $variables['iu_item_dates'] = [];
  $variables['iu_item_dates_iso'] = [];
  $variables['iu_insight_nodes'] = [];
  $variables['iu_news_nodes'] = [];

  $route_url = static function (string $route_name, string $path): string {
    try {
      return Url::fromRoute($route_name)->toString();
    }
    catch (\Throwable $e) {
      return Url::fromUserInput($path)->toString();
    }
  };

  $variables['iu_insights_list_url'] = $route_url('view.news.page_1', '/blog');
  $variables['iu_news_list_url'] = $route_url('view.news.page_2', '/news');

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();

  $collect_meta = function (array $nodes) use (&$variables): void {
    foreach ($nodes as $node) {
      if (!$node instanceof NodeInterface) {
        continue;
      }
      $nid = (int) $node->id();
      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($node, $node->label());
      $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
      $meta['alt'] = $extracted['alt'];
      $variables['iu_card_images'][$nid] = $meta;
      $ts = (int) $node->getCreatedTime();
      $variables['iu_item_dates'][$nid] = $ts
        ? \Drupal::service('date.formatter')->format($ts, 'custom', 'j M Y')
        : '';
      $variables['iu_item_dates_iso'][$nid] = $ts
        ? \Drupal::service('date.formatter')->format($ts, 'html_datetime')
        : '';
    }
  };

  if ($paragraph->hasField('field_iu_insights') && !$paragraph->get('field_iu_insights')->isEmpty()) {
    foreach ($paragraph->get('field_iu_insights')->referencedEntities() as $node) {
      if ($node instanceof NodeInterface) {
        if ($node->hasTranslation($langcode)) {
          $node = $node->getTranslation($langcode);
        }
        $variables['iu_insight_nodes'][] = $node;
      }
    }
  }
  if ($paragraph->hasField('field_iu_news') && !$paragraph->get('field_iu_news')->isEmpty()) {
    foreach ($paragraph->get('field_iu_news')->referencedEntities() as $node) {
      if ($node instanceof NodeInterface) {
        if ($node->hasTranslation($langcode)) {
          $node = $node->getTranslation($langcode);
        }
        $variables['iu_news_nodes'][] = $node;
      }
    }
  }

  // Homepage layout: one hero (left) + rest in sidebar with news (up to 4 total insights).
  $variables['iu_insight_nodes'] = array_slice($variables['iu_insight_nodes'], 0, 4);
  $variables['iu_news_nodes'] = array_slice($variables['iu_news_nodes'], 0, 5);

  $collect_meta($variables['iu_insight_nodes']);
  $collect_meta($variables['iu_news_nodes']);
}

/**
 * Preprocess for News View block (unformatted).
 */
function motaded_theme_preprocess_views_view_unformatted__news__block_4(&$variables) {
  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  foreach ($variables['rows'] as &$row) {
    $entity = $row['content']['#row']->_entity ?? NULL;
    $img_meta = [
      'src' => '',
      'srcset' => '',
      'width' => 151,
      'height' => 120,
    ];
    $img_alt = '';

    if ($entity) {
      if ($entity->hasTranslation($langcode)) {
        $entity = $entity->getTranslation($langcode);
      }

      $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
      $img_meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
      $img_alt = $extracted['alt'];

      $row['title'] = $entity->label();
      $row['url'] = $entity->toUrl()->toString();
      $created_ts = (int) $entity->getCreatedTime();
      $row['created'] = $created_ts
        ? \Drupal::service('date.formatter')->format($created_ts, 'custom', 'F j, Y')
        : '';
      $row['created_iso'] = $created_ts ? gmdate('c', $created_ts) : '';
    }
    else {
      $row['title'] = '';
      $row['url'] = '';
      $row['created'] = '';
      $row['created_iso'] = '';
    }

    $row['image']['alt'] = $img_alt;
    $row['image']['src'] = $img_meta['src'];
    $row['image']['srcset'] = $img_meta['srcset'];
    $row['image']['width'] = $img_meta['width'];
    $row['image']['height'] = $img_meta['height'];
    // Back-compat for any code using a single URL.
    $row['image']['url'] = $img_meta['src'];
  }
}
/**
 * Preprocess for News View block (unformatted).
 */
function motaded_theme_preprocess_views_view_unformatted__partners__block_2(&$variables) {
  foreach ($variables['rows'] as &$row) {
    $entity = $row['content']['#row']->_entity ?? NULL;
    $fallback_label = $entity ? $entity->label() : '';
    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $fallback_label);
    $img_meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $img_alt = trim($extracted['alt']);
    if ($img_alt === '' && $entity) {
      $img_alt = (string) t('@name logo', ['@name' => $entity->label()]);
    }
    elseif ($img_alt === '') {
      $img_alt = (string) t('Partner logo');
    }

    $row['image']['src'] = $img_meta['src'];
    $row['image']['srcset'] = $img_meta['srcset'];
    $row['image']['width'] = $img_meta['width'];
    $row['image']['height'] = $img_meta['height'];
    $row['image']['url'] = $img_meta['src'];
    $row['image']['alt'] = $img_alt;
    $row['title'] = $entity ? $entity->label() : '';
  }
}

/**
 * Preprocess for Related Similar view fields displays.
 */
function motaded_theme_preprocess_views_view_fields__related_similar(array &$variables): void {
  $entity = $variables['row']->_entity ?? NULL;
  $card_data = motaded_theme_build_views_node_card_data($entity);
  $variables['card_type_label'] = $card_data['card_type_label'];
  $variables['card_bundle'] = $card_data['card_bundle'];
  $variables['card_image'] = $card_data['card_image'];
}

/**
 * Preprocess for News view cards in related displays.
 */
function motaded_theme_preprocess_views_view_fields__news(array &$variables): void {
  $display_id = $variables['view']->current_display ?? '';
  if (!in_array($display_id, ['block_2', 'block_3', 'block_6'], TRUE)) {
    return;
  }
  $entity = $variables['row']->_entity ?? NULL;
  $card_data = motaded_theme_build_views_node_card_data($entity);
  $variables['card_type_label'] = $card_data['card_type_label'];
  $variables['card_bundle'] = $card_data['card_bundle'];
  $variables['card_image'] = $card_data['card_image'];
}

/**
 * Responsive teaser image metadata for news Views row templates (blog + news).
 */
function motaded_theme_preprocess_views_view_fields_news_listing_card_image(array &$variables): void {
  $site_name = (string) \Drupal::config('system.site')->get('name');
  $img_meta = [
    'src' => '',
    'srcset' => '',
    'width' => 325,
    'height' => 200,
    'alt' => $site_name,
  ];

  $entity = $variables['row']->_entity ?? NULL;
  if (!$entity instanceof NodeInterface) {
    $variables['card_image'] = $img_meta;
    return;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
  if ($entity->hasTranslation($langcode)) {
    $entity = $entity->getTranslation($langcode);
  }

  $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
  $meta = motaded_theme_blog_listing_card_image_metadata($extracted['uri']);
  $img_meta['src'] = $meta['src'];
  $img_meta['srcset'] = $meta['srcset'];
  $img_meta['width'] = $meta['width'];
  $img_meta['height'] = $meta['height'];
  $img_meta['alt'] = $extracted['alt'] !== '' ? $extracted['alt'] : $entity->label();

  if ($img_meta['src'] === '') {
    $logo_uri = theme_get_setting('logo.url');
    if (is_string($logo_uri) && $logo_uri !== '') {
      $img_meta['src'] = \Drupal::service('file_url_generator')->generateString($logo_uri);
      $img_meta['srcset'] = '';
    }
  }

  $variables['card_image'] = $img_meta;
}

/**
 * Blog listing (/blog): responsive image metadata for article cards.
 */
function motaded_theme_preprocess_views_view_fields__news__page_1(array &$variables): void {
  motaded_theme_preprocess_views_view_fields_news_listing_card_image($variables);
}

/**
 * News listing (/news): responsive image metadata for news cards.
 */
function motaded_theme_preprocess_views_view_fields__news__page_2(array &$variables): void {
  motaded_theme_preprocess_views_view_fields_news_listing_card_image($variables);
}

/**
 * Shared card data builder for Views rows with Node entities.
 *
 * @param mixed $entity
 *   Row entity from Views result.
 *
 * @return array{card_type_label: string, card_bundle: string, card_image: array{src: string, srcset: string, width: int, height: int, alt: string}}
 *   Normalized card metadata for Twig templates.
 */
function motaded_theme_build_views_node_card_data($entity): array {
  $card_type_label = '';
  $card_bundle = '';
  $site_name = (string) \Drupal::config('system.site')->get('name');
  $img_meta = [
    'src' => '',
    'srcset' => '',
    'width' => 151,
    'height' => 120,
    'alt' => $site_name,
  ];

  if ($entity instanceof NodeInterface) {
    $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_CONTENT)->getId();
    if ($entity->hasTranslation($langcode)) {
      $entity = $entity->getTranslation($langcode);
    }

    $bundle = $entity->bundle();
    $card_bundle = $bundle;
    $node_type = NodeType::load($bundle);
    $type_label = $node_type !== NULL ? (string) $node_type->label() : $bundle;
    $card_type_map_by_bundle = [
      'page' => (string) t('Service'),
      'article' => (string) t('Blog'),
      'news' => (string) t('News'),
    ];
    $card_type_label = $card_type_map_by_bundle[$bundle] ?? $type_label;

    $extracted = motaded_theme_entity_field_media_image_uri_and_alt($entity, $entity->label());
    $meta = motaded_theme_responsive_teaser_image_metadata($extracted['uri']);
    $img_meta['src'] = $meta['src'];
    $img_meta['srcset'] = $meta['srcset'];
    $img_meta['width'] = $meta['width'];
    $img_meta['height'] = $meta['height'];
    $img_meta['alt'] = $extracted['alt'] !== '' ? $extracted['alt'] : $entity->label();
  }

  if ($img_meta['src'] === '') {
    $logo_uri = theme_get_setting('logo.url');
    if (is_string($logo_uri) && $logo_uri !== '') {
      $img_meta['src'] = \Drupal::service('file_url_generator')->generateString($logo_uri);
      $img_meta['srcset'] = '';
    }
  }

  return [
    'card_type_label' => $card_type_label,
    'card_bundle' => $card_bundle,
    'card_image' => $img_meta,
  ];
}

/**
 * Implements hook__preprocess_HOOK().
 */
function motaded_theme_preprocess_breadcrumb(&$variables) {
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node) {
    $prefix = getLanguagePrefix();
    $prefix = str_ends_with($prefix, "/") ? $prefix : $prefix . "/";
    
    if (isset($variables['breadcrumb'][1]) && in_array($variables['breadcrumb'][1]['url'], ['/node', '/ar/node', '/beta/node', '/beta/ar/node'])) {
      array_splice($variables['breadcrumb'], 1, 1);
    }

    if ($node->bundle() == "article") {
      $blog_url = $prefix . "blog";
      if (
        isset($variables['breadcrumb'][1]) &&
        motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'blog')
      ) {
        // Normalize the section label even when contributed by Views.
        $variables['breadcrumb'][1]['text'] = (string) t('Blog');
      }
      else {
        $list_crumb = [
          'text' => (string) t('Blog'),
          'url' => $blog_url,
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    } elseif ($node->bundle() == "page") {
      if (
        !isset($variables['breadcrumb'][1]) ||
        !motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'services')
      ) {
        $list_crumb = [
          'text' => t('Services'),
          'url' => $prefix . "services",
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    } elseif ($node->bundle() == "news") {
      if (
        !isset($variables['breadcrumb'][1]) ||
        !motaded_theme_breadcrumb_url_matches_section($variables['breadcrumb'][1]['url'] ?? NULL, 'news')
      ) {
        $list_crumb = [
          'text' => t('News'),
          'url' => $prefix . "news",
        ];
        array_splice($variables['breadcrumb'], 1, 0, [$list_crumb]);
      }
    }
  }
}

/**
 * Checks whether breadcrumb URL already points to a section root.
 */
function motaded_theme_breadcrumb_url_matches_section($url, string $section): bool {
  if (!is_string($url) || $url === '') {
    return FALSE;
  }

  $path = parse_url($url, PHP_URL_PATH);
  if (!is_string($path) || $path === '') {
    return FALSE;
  }

  $normalized = '/' . trim($path, '/');
  return (bool) preg_match(
    '#^/(?:beta/)?(?:[a-z]{2}/)?' . preg_quote($section, '#') . '$#i',
    $normalized
  );
}

/**
 * Helper function to get language prefix.
 */
function getLanguagePrefix() {
  if($prefixes = \Drupal::config('language.negotiation')->get('url.prefixes')) {
    $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
    return "/". $prefixes[$language];
  }
  return null;
}

/**
 * Implements hook_preprocess_views_exposed_form().
 *
 * Detaches categories from services page_1 exposed form and stores them for
 * the parent view template where sidebar + results share one container.
 */
function motaded_theme_preprocess_views_exposed_form(&$variables) {
  $form = &$variables['form'];
  if (($form['#id'] ?? '') !== 'views-exposed-form-services-page-1') {
    return;
  }
  if (empty($form['field_taxonomy_target_id']) || !is_array($form['field_taxonomy_target_id'])) {
    return;
  }
  $categories = $form['field_taxonomy_target_id'];
  unset($form['field_taxonomy_target_id']);
  motaded_theme_services_attach_form_attribute_recursive($categories, (string) $form['#id']);
  motaded_theme_services_sidebar_categories_store($categories);
}

/**
 * Implements hook_preprocess_views_view__services__page_1().
 */
function motaded_theme_preprocess_views_view__services__page_1(&$variables) {
  $sidebar = motaded_theme_services_sidebar_categories_store();
  if ($sidebar === NULL && !empty($variables['view']) && $variables['view'] instanceof ViewExecutable) {
    $exposed_plugin = $variables['view']->display_handler
      ? $variables['view']->display_handler->getPlugin('exposed_form')
      : NULL;
    if ($exposed_plugin && method_exists($exposed_plugin, 'renderExposedForm')) {
      $built_form = $exposed_plugin->renderExposedForm(FALSE);
      if (is_array($built_form) && !empty($built_form['field_taxonomy_target_id']) && is_array($built_form['field_taxonomy_target_id'])) {
        $sidebar = $built_form['field_taxonomy_target_id'];
        motaded_theme_services_attach_form_attribute_recursive($sidebar, 'views-exposed-form-services-page-1');
      }
    }
  }
  $variables['services_categories_sidebar'] = $sidebar;
  $is_arabic = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId() === 'ar';
  $variables['services_categories_aria_label'] = $is_arabic
    ? 'الفئات'
    : (string) t('Categories');
}

/**
 * Implements hook_preprocess_HOOK() for views_view_fields.
 *
 * Builds translated chip labels for the Services directory cards.
 */
function motaded_theme_preprocess_views_view_fields(array &$variables): void {
  $view = $variables['view'] ?? NULL;
  if (!$view instanceof ViewExecutable) {
    return;
  }
  $display_id = $variables['display_id'] ?? $view->current_display ?? '';
  if ($view->id() !== 'services' || $display_id !== 'page_1') {
    return;
  }

  $langcode = \Drupal::languageManager()
    ->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)
    ->getId();
  $is_arabic = $langcode === 'ar';

  $variables['services_book_now_label'] = $is_arabic
    ? 'احجز الآن'
    : (string) t('Book now');
  $variables['services_explore_benefits_label'] = $is_arabic
    ? 'اكتشف المزايا'
    : (string) t('Explore benefits');

  $variables['services_beneficiary_labels'] = [];
  $variables['services_category_labels'] = [];
  $variables['services_tag_labels'] = [];

  $row = $variables['row'] ?? NULL;
  if (!is_object($row) || !isset($row->_entity)) {
    return;
  }

  $node = $row->_entity;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'page') {
    return;
  }

  if ($node->hasField('field_beneficiaries') && !$node->get('field_beneficiaries')->isEmpty()) {
    foreach ($node->get('field_beneficiaries') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_beneficiary_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }

  if ($node->hasField('field_taxonomy') && !$node->get('field_taxonomy')->isEmpty()) {
    foreach ($node->get('field_taxonomy') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_category_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }

  if ($node->hasField('field_tags') && !$node->get('field_tags')->isEmpty()) {
    foreach ($node->get('field_tags') as $item) {
      $entity = $item->entity ?? NULL;
      if ($entity instanceof TermInterface) {
        $variables['services_tag_labels'][] = motaded_theme_taxonomy_term_translated_label($entity, $langcode);
      }
    }
  }
}

/**
 * Returns a taxonomy term label for a requested langcode when available.
 */
function motaded_theme_taxonomy_term_translated_label(TermInterface $term, string $langcode): string {
  if ($langcode !== '' && $term->hasTranslation($langcode)) {
    return (string) $term->getTranslation($langcode)->label();
  }
  return (string) $term->label();
}

/**
 * Stores/retrieves detached categories for current request.
 */
function motaded_theme_services_sidebar_categories_store(?array $set = NULL): ?array {
  static $stored = NULL;
  if ($set !== NULL) {
    $stored = $set;
  }
  return $stored;
}

/**
 * Sets form="" on form controls (sidebar fields associated with main exposed form).
 */
function motaded_theme_services_attach_form_attribute_recursive(array &$element, string $form_html_id): void {
  $input_types = [
    'textfield', 'search', 'tel', 'email', 'url', 'password', 'textarea',
    'number', 'hidden', 'checkbox', 'radio', 'select', 'file', 'button',
    'submit', 'image_button', 'color', 'range', 'date', 'datetime',
    'entity_autocomplete', 'machine_name', 'weight', 'managed_file',
  ];
  if (isset($element['#type']) && in_array($element['#type'], $input_types, TRUE)) {
    if (!isset($element['#attributes'])) {
      $element['#attributes'] = [];
    }
    if ($element['#attributes'] instanceof \Drupal\Core\Template\Attribute) {
      $element['#attributes']->setAttribute('form', $form_html_id);
    }
    else {
      $element['#attributes']['form'] = $form_html_id;
    }
  }
  foreach (Element::children($element) as $child_key) {
    if (isset($element[$child_key]) && is_array($element[$child_key])) {
      motaded_theme_services_attach_form_attribute_recursive($element[$child_key], $form_html_id);
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function motaded_theme_form_views_exposed_form_alter(&$form,  Drupal\Core\Form\FormStateInterface $form_state) {
  if ($form['#id'] == 'views-exposed-form-services-block-2') {
    if (!isset($form['field_taxonomy_target_id'])) {
      return;
    }

    // Remove "All".
    unset($form['field_taxonomy_target_id']['#options']['All']);

    $options = $form['field_taxonomy_target_id']['#options'];
    $first = array_key_first($options);

    $input = $form_state->getUserInput();
    $val = $input['field_taxonomy_target_id'] ?? NULL;

    // Only set first when value missing or "All".
    if ($val === 'All' || empty($val)) {
      $form['field_taxonomy_target_id']['#default_value'] = $first;
      $input['field_taxonomy_target_id'] = $first;
      $form_state->setUserInput($input);
    }
  }

  if (($form['#id'] ?? '') === 'views-exposed-form-services-page-1') {
    $form['#attributes']['class'][] = 'services-directory__exposed-form';
    // Better Exposed Filters can build some option labels after generic form alters.
    // Ensure Arabic labels for the "All" option and submit/reset strings are applied
    // on the final render array.
    $form['#after_build'][] = 'motaded_theme_services_views_exposed_form_after_build';
  }

}

/**
 * After-build callback: finalizes Arabic strings for Services directory exposed form.
 */
function motaded_theme_services_views_exposed_form_after_build(array $form, FormStateInterface $form_state): array {
  if (($form['#id'] ?? '') !== 'views-exposed-form-services-page-1') {
    return $form;
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage(LanguageInterface::TYPE_INTERFACE)->getId();
  if ($langcode !== 'ar') {
    return $form;
  }

  if (isset($form['actions']['submit']) && is_array($form['actions']['submit'])) {
    $form['actions']['submit']['#value'] = 'بحث';
  }
  if (isset($form['actions']['reset']) && is_array($form['actions']['reset'])) {
    $form['actions']['reset']['#value'] = 'إعادة تعيين المرشحات';
  }

  foreach (['field_beneficiaries_target_id', 'field_tags_target_id'] as $key) {
    if (empty($form[$key]) || !is_array($form[$key])) {
      continue;
    }
    if ($key === 'field_beneficiaries_target_id') {
      motaded_theme_services_rewrite_all_option_label($form[$key], ['beneficiaries', 'المستفيدون'], 'الكل');
    }
    else {
      motaded_theme_services_rewrite_all_option_label($form[$key], ['tags', 'الوسوم'], 'الكل');
    }
  }

  return $form;
}

/**
 * Rewrites Views/BEF "All" option label for Arabic when it still shows English.
 *
 * @param array $element
 *   A form element (possibly nested) that may contain #options.
 * @param array $english_labels
 *   English labels that should be rewritten to Arabic for the "All" option.
 * @param string $replacement
 *   Replacement label for the "All" option.
 */
function motaded_theme_services_rewrite_all_option_label(array &$element, array $english_labels, string $replacement): void {
  if (isset($element['#options']) && is_array($element['#options']) && isset($element['#options']['All']) && is_string($element['#options']['All'])) {
    $current = trim($element['#options']['All']);
    $lower = mb_strtolower($current);
    foreach ($english_labels as $candidate) {
      $candidate = trim((string) $candidate);
      if ($candidate === '') {
        continue;
      }
      if (mb_strtolower($candidate) === $lower) {
        $element['#options']['All'] = $replacement;
        break;
      }
    }
  }

  foreach (Element::children($element) as $child) {
    if (isset($element[$child]) && is_array($element[$child])) {
      motaded_theme_services_rewrite_all_option_label($element[$child], $english_labels, $replacement);
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 * Prefill service field in contact webform based on query parameter.
 */
function motaded_theme_form_alter(&$form,  Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  if ($form_id == "webform_submission_contact_add_form") {
    $nid = \Drupal::request()->request->get('service_id');

    if (!empty($nid) && is_numeric($nid)) {
      $node = Node::load($nid);
      if ($node) {
        $url = $node->toUrl('canonical', ['absolute' => TRUE])->toString();
        $form['elements']['service']['#default_value'] = $url;
      }
    }
  }


}

/**
 * Implements hook_form_system_theme_settings_alter().
 */
function motaded_theme_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  if (\Drupal::routeMatch()->getParameter('theme') !== 'motaded_theme') {
    return;
  }

  $form['motaded_linkedin'] = [
    '#type' => 'details',
    '#title' => t('LinkedIn tracking'),
    '#open' => FALSE,
  ];
  $form['motaded_linkedin']['linkedin_contact_lead_conversion_id'] = [
    '#type' => 'textfield',
    '#title' => t('LinkedIn: contact form lead conversion ID'),
    '#default_value' => theme_get_setting('linkedin_contact_lead_conversion_id') ?: '',
    '#description' => t('Digits only — from LinkedIn Campaign Manager → Conversions (not the Insight partner ID). Do not enter Google Ads IDs (AW-…); those belong in Google Tag Manager. Leave empty to skip LinkedIn conversion tracking on the thank-you page.'),
    '#maxlength' => 24,
    '#pattern' => '\d*',
  ];
}

/**
 * Passes LinkedIn conversion ID to the contact webform confirmation page template.
 */
function motaded_theme_preprocess_page__webform__contact__confirmation(&$variables) {
  $raw = theme_get_setting('linkedin_contact_lead_conversion_id');
  $id = is_string($raw) ? trim($raw) : '';
  if ($id !== '' && ctype_digit($id)) {
    $variables['linkedin_contact_lead_conversion_id'] = (int) $id;
  }
}

/**
 *  Block suggestions for custom block bundles.
 */
function motaded_theme_theme_suggestions_block_alter(array &$suggestions, array $variables) {
  if (isset($variables['elements']['content']['#block_content'])) {
    array_splice($suggestions, 1, 0, 'block__bundle__' . $variables['elements']['content']['#block_content']->bundle());
  }
}
