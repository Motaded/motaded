      $services_url = Url::fromUri('internal:/services')->toString();
    }
    catch (\Throwable $throwable) {
      $services_url = NULL;
    }
  }

  $has_services = FALSE;
  foreach ($items as $index => $item) {
    $text = isset($item['text']) ? trim((string) $item['text']) : '';
    if ($text === '') {
      continue;
    }

    if (strcasecmp($text, $services_label) === 0) {
      $has_services = TRUE;
      if ($services_url !== NULL && (empty($item['url']) || !is_string($item['url']))) {
        $items[$index]['url'] = $services_url;
      }
      break;
    }
  }

  if (!$has_services) {
    $service_item = [
      'text' => $services_label,
      'url' => $services_url,
    ];

    $last_index = array_key_last($items);
    if ($last_index === NULL) {
      $items[] = $service_item;
    }
    else {
      array_splice($items, $last_index, 0, [$service_item]);
    }
  }

  $home_label = (string) t('Home');
  $has_home = FALSE;
  foreach ($items as $item) {
    $text = isset($item['text']) ? trim((string) $item['text']) : '';
    if ($text === '') {
      continue;
    }

    if (strcasecmp($text, $home_label) === 0) {
      $has_home = TRUE;
      break;
    }
  }

  if (!$has_home) {
    $home_url = NULL;
    try {
      $home_url = Url::fromRoute('<front>')->toString();
    }
    catch (\Throwable $throwable) {
      $home_url = NULL;
    }

    array_unshift($items, [
      'text' => $home_label,
      'url' => $home_url,
    ]);
  }

  return $items;
}

/**
 * Builds breadcrumb items for the current route.
 */
function muin_build_breadcrumb_items(?string $label = NULL): array {
  try {
    $breadcrumb = \Drupal::service('breadcrumb')->build(\Drupal::routeMatch());
  }
  catch (\Throwable $throwable) {
    if ($label === NULL || $label === '') {
      return [];
    }

    return [
      [
        'text' => $label,
        'url' => NULL,
      ],
    ];
  }

  $items = [];
  $renderer = \Drupal::service('renderer');

  foreach ($breadcrumb->getLinks() as $link) {
    $text = muin_renderable_to_text($link->getText(), $renderer);
    $url = $link->getUrl();
    $url_string = NULL;
    if ($url instanceof Url) {
      $url_string = $url->toString();
    }
    elseif ($url) {
      try {
        $url_string = $url->toString();
      }
      catch (\Throwable $throwable) {
        $url_string = NULL;
      }
    }

    $items[] = [
      'text' => $text,
      'url' => $url_string,
    ];
  }

  if ($label !== NULL && $label !== '') {
    $last = end($items);
    if (!$last || $last['text'] !== $label) {
      $items[] = [
        'text' => $label,
        'url' => NULL,
      ];
    }
  }

  return $items;
}

/**
 * Generates a table of contents structure for an article.
 */
function muin_build_article_toc(NodeInterface $node, $body_render_array = NULL): array {
  $markup_candidates = [];

  if ($node->hasField('body') && !$node->get('body')->isEmpty()) {
    try {
      $body_item = $node->get('body')->first();
      if ($body_item && isset($body_item->value)) {
        $markup_candidates[] = (string) $body_item->value;
      }
    }
    catch (\Throwable $throwable) {
      // Ignore body extraction errors.
    }
  }

  if ($body_render_array) {
    $candidate = $body_render_array;
    if ($candidate instanceof RenderableInterface) {
      $candidate = $candidate->toRenderable();
    }

    if ($candidate instanceof MarkupInterface) {
      $markup_candidates[] = $candidate->__toString();
    }
    elseif (is_array($candidate)) {
      try {
        $renderer = \Drupal::service('renderer');
        $rendered = $renderer->renderPlain($candidate);
        if ($rendered instanceof MarkupInterface) {
          $markup_candidates[] = $rendered->__toString();
        }
        else {
          $markup_candidates[] = (string) $rendered;
        }
      }
      catch (\Throwable $throwable) {
        // Ignore rendering issues when generating the TOC.
      }
    }
    else {
      $markup_candidates[] = (string) $candidate;
    }
  }

  $markup = '';
  foreach ($markup_candidates as $candidate) {
    $candidate = trim((string) $candidate);
    if ($candidate !== '') {
      $markup = $candidate;
      break;
    }
  }

  if ($markup === '') {
    return [];
  }

  try {
    $document = Html::load($markup);
  }
  catch (\Throwable $throwable) {
    return [];
  }

  $xpath = new \DOMXPath($document);
  $nodes = $xpath->query('//h2|//h3');
  if (!$nodes || $nodes->length === 0) {
    return [];
  }

  $used_ids = [];
  $headings = [];
  foreach ($nodes as $element) {
    $text = trim($element->textContent ?? '');
    if ($text === '') {
      continue;
    }

    $tag = strtolower($element->nodeName ?? '');
    $level = (int) substr($tag, 1);
    if ($level < 2) {
      $level = 2;
    }

    $id = (string) $element->getAttribute('id');
    if ($id === '') {
      $base_id = Html::getId($text);
      if ($base_id === '') {
        $base_id = 'section';
      }

      $suffix = 1;
      $candidate = $base_id;
      while (in_array($candidate, $used_ids, TRUE)) {
        $candidate = $base_id . '-' . ++$suffix;
      }
      $id = $candidate;
    }

    $used_ids[] = $id;
    $headings[] = [
      'id' => $id,
      'label' => Html::decodeEntities($text),
      'level' => $level,
    ];
  }

  if (empty($headings)) {
    return [];
  }

  $items = [];
  $current_index = NULL;
  $order = 0;

  foreach ($headings as $heading) {
    $entry = [
      'id' => $heading['id'],
      'label' => $heading['label'],
      'level' => $heading['level'],
      'order' => $order++,
    ];

    if ($heading['level'] <= 2) {
      $entry['children'] = [];
      $items[] = $entry;
      $current_index = array_key_last($items);
    }
    else {
      if ($current_index !== NULL && isset($items[$current_index])) {
        $items[$current_index]['children'][] = $entry;
      }
      else {
        $entry['children'] = [];
        $items[] = $entry;
        $current_index = array_key_last($items);
      }
    }
  }

  return $items;
}

/**
 * Converts a renderable or markup value into plain text.
 */
function muin_renderable_to_text($value, $renderer = NULL): string {
  if ($value instanceof MarkupInterface) {
    return trim(Html::decodeEntities(strip_tags($value->__toString())));
  }

  if ($value instanceof RenderableInterface) {
    $value = $value->toRenderable();
  }

  if (is_array($value)) {
    $renderer = $renderer ?? \Drupal::service('renderer');
    $value = $renderer->renderPlain($value);
    if ($value instanceof MarkupInterface) {
      return trim(Html::decodeEntities(strip_tags($value->__toString())));
    }
  }

  return trim(Html::decodeEntities(strip_tags((string) $value)));
}

/**
 * Extracts the first existing render array for the provided field candidates.
 */
function muin_extract_render_array(array &$content, array $candidates): ?array {
  foreach ($candidates as $field_name) {
    if (isset($content[$field_name])) {
      $element = $content[$field_name];
      unset($content[$field_name]);
      return $element;
    }
  }

  return NULL;
}

/**
 * Extracts a link field as a normalized array with URL and title.
 */
function muin_extract_link_field(NodeInterface $node, array &$content, array $candidates): ?array {
  $stored_render = NULL;

  foreach ($candidates as $field_name) {
    if (isset($content[$field_name])) {
      if ($stored_render === NULL) {
        $stored_render = $content[$field_name];
      }
      unset($content[$field_name]);
    }

    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $node->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    if (!$item) {
      continue;
    }

    $title = NULL;
    if (isset($item->title) && $item->title !== '') {
      $title = (string) $item->title;
    }
    elseif (isset($item->value) && $item->value !== '') {
      $title = (string) $item->value;
    }

    $url_string = NULL;
    $options = [];

    try {
      if (method_exists($item, 'getUrl')) {
        $url_object = $item->getUrl();
        if ($url_object instanceof Url) {
          $url_string = $url_object->toString();
          $options = $url_object->getOptions();
        }
        elseif ($url_object) {
          $url_string = $url_object->toString();
          if (method_exists($url_object, 'getOptions')) {
            $options = $url_object->getOptions();
          }
        }
      }
    }
    catch (\Throwable $throwable) {
      // Ignore URL extraction issues and fallback to uri.
    }

    if ($url_string === NULL && isset($item->uri) && $item->uri !== '') {
      try {
        $url_object = Url::fromUri($item->uri, $item->options ?? []);
        $url_string = $url_object->toString();
        $options = $url_object->getOptions();
      }
      catch (\Throwable $throwable) {
        $url_string = (string) $item->uri;
        $options = is_array($item->options ?? NULL) ? $item->options : [];
      }
    }

    if ($url_string !== NULL) {
      if ($title === NULL || $title === '') {
        $title = $url_string;
      }

      return [
        'title' => $title !== NULL ? (string) $title : '',
        'url' => $url_string,
        'options' => $options,
      ];
    }
  }

  if ($stored_render !== NULL) {
    return [
      'render' => $stored_render,
    ];
  }

  return NULL;
}

/**
 * Retrieves multiple plain text values from a field.
 */
function muin_extract_text_items(NodeInterface $node, array &$content, array $candidates): array {
  foreach ($candidates as $field_name) {
    if (isset($content[$field_name])) {
      unset($content[$field_name]);
    }

    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    $items = [];
    foreach ($node->get($field_name) as $item) {
      $value = NULL;
      if (isset($item->value) && $item->value !== '') {
        $value = $item->value;
      }
      elseif (isset($item->title) && $item->title !== '') {
        $value = $item->title;
      }
      elseif (isset($item->text) && $item->text !== '') {
        $value = $item->text;
      }

      if ($value !== NULL) {
        $trimmed = trim((string) $value);
        if ($trimmed !== '') {
          $items[] = $trimmed;
        }
      }
    }

    if (!empty($items)) {
      return $items;
    }
  }

  return [];
}

/**
 * Retrieves label values for taxonomy or string reference fields.
 */
function muin_extract_label_items(NodeInterface $node, array &$content, array $candidates): array {
  foreach ($candidates as $field_name) {
    if (isset($content[$field_name])) {
      unset($content[$field_name]);
    }

    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    $items = [];
    foreach ($node->get($field_name) as $item) {
      $label = NULL;
      if (isset($item->entity) && $item->entity) {
        try {
          $label = $item->entity->label();
        }
        catch (\Throwable $throwable) {
          $label = NULL;
        }
      }

      if (($label === NULL || $label === '') && isset($item->value) && $item->value !== '') {
        $label = $item->value;
      }

      if (($label === NULL || $label === '') && isset($item->title) && $item->title !== '') {
        $label = $item->title;
      }

      if (($label === NULL || $label === '') && isset($item->name) && $item->name !== '') {
        $label = $item->name;
      }

      $label = trim((string) ($label ?? ''));
      if ($label !== '') {
        $items[] = $label;
      }
    }

    if (!empty($items)) {
      return $items;
    }
  }

  return [];
}

/**
 * Retrieves the first non-empty plain text value for a field on the node.
 */
function muin_extract_text_field(NodeInterface $node, array $candidates, ?array &$content = NULL): ?string {
  foreach ($candidates as $field_name) {
    if ($content !== NULL && isset($content[$field_name])) {
      unset($content[$field_name]);
    }

    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $node->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    if (!$item) {
      continue;
    }

    $value = NULL;
    if (isset($item->value) && $item->value !== '') {
      $value = $item->value;
    }
    elseif (isset($item->title) && $item->title !== '') {
      $value = $item->title;
    }
    elseif (isset($item->text) && $item->text !== '') {
      $value = $item->text;
    }

    if ($value !== NULL) {
      $trimmed = trim((string) $value);
      if ($trimmed !== '') {
        return $trimmed;
      }
    }
  }

  return NULL;
}

/**
 * Determines if the provided node should use the About the Kingdom layout.
 */
function muin_is_about_kingdom_page(NodeInterface $node): bool {
  if ($node->bundle() !== 'page') {
    return FALSE;
  }

  $matches_identifier = static function ($value): bool {
    if ($value === NULL) {
      return FALSE;
    }

    if ($value instanceof TranslatableMarkup) {
      $value = $value->render();
    }

    if (is_object($value) && !method_exists($value, '__toString')) {
      return FALSE;
    }

    $normalized = muin_normalize_about_identifier((string) $value);
    if ($normalized === NULL) {
      return FALSE;
    }

    $allowed_identifiers = [
      'about-kingdom',
      'about-the-kingdom',
      'why-invest-in-saudi-arabia',
    ];

    if (in_array($normalized, $allowed_identifiers, TRUE)) {
      return TRUE;
    }

    foreach ($allowed_identifiers as $identifier) {
      if (str_contains($normalized, $identifier)) {
        return TRUE;
      }
    }

    return FALSE;
  };

  $candidate_fields = [
    'field_page_template',
    'field_page_layout',
    'field_layout_variant',
  ];

  foreach ($candidate_fields as $field_name) {
    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $field = $node->get($field_name);
    }
    catch (\Throwable $throwable) {
      continue;
    }

    $values_to_check = [];

    if (method_exists($field, 'getString')) {
      $values_to_check[] = $field->getString();
    }

    try {
      $item = $field->first();
    }
    catch (\Throwable $throwable) {
      $item = NULL;
    }

    if ($item) {
      foreach (['value', 'target_id', 'title'] as $property) {
        if (isset($item->{$property})) {
          $values_to_check[] = $item->{$property};
        }
      }

      if (isset($item->entity) && $item->entity) {
        try {
          $entity = $item->entity;
          if (method_exists($entity, 'label')) {
            $values_to_check[] = $entity->label();
          }
          if (method_exists($entity, 'id')) {
            $values_to_check[] = $entity->id();
          }
        }
        catch (\Throwable $throwable) {
          // Ignore entity inspection failures.
        }
      }
    }

    foreach ($values_to_check as $value) {
      if ($matches_identifier($value)) {
        return TRUE;
      }
    }
  }

  $langcode = $node->language()->getId();

  try {
    $alias_manager = \Drupal::service('path_alias.manager');
  }
  catch (\Throwable $throwable) {
    $alias_manager = NULL;
  }

  if ($alias_manager) {
    $paths = ['/node/' . $node->id()];
    foreach (array_unique([$langcode, 'en']) as $langcode_candidate) {
      foreach ($paths as $path) {
        try {
          $alias = $alias_manager->getAliasByPath($path, $langcode_candidate);
        }
        catch (\Throwable $throwable) {
          $alias = NULL;
        }

        if ($matches_identifier($alias)) {
          return TRUE;
        }
      }
    }
  }

  if ($matches_identifier($node->label())) {
    return TRUE;
  }

  return FALSE;
}

/**
 * Normalizes possible About the Kingdom identifiers.
 */
function muin_normalize_about_identifier($value): ?string {
  if ($value === NULL) {
    return NULL;
  }

  if ($value instanceof TranslatableMarkup) {
    $value = $value->render();
  }

  if (is_object($value) && !method_exists($value, '__toString')) {
    return NULL;
  }

  $string = strtolower(trim((string) $value));
  if ($string === '') {
    return NULL;
  }

  $string = str_replace(['_', '\\'], '-', $string);
  $string = str_replace(["\t", "\n", "\r"], ' ', $string);
  $string = preg_replace('/[^a-z0-9\-\/ ]+/', '', $string);
  $string = preg_replace('/\s+/', '-', $string);
  $string = preg_replace('/-+/', '-', $string);
  $string = preg_replace('/^\/+/', '', $string);
  $string = preg_replace('/\/+$/', '', $string);
  $string = trim($string, '-');

  return $string === '' ? NULL : $string;
}

/**
 * Builds the About the Kingdom page data structure.
 */
function muin_build_about_kingdom_page(NodeInterface $node, array &$content, array $variables, array $basic = []): array {
  $langcode = $node->language()->getId();
  $about = muin_about_kingdom_default_content($langcode);

  if (!empty($basic['breadcrumb'])) {
    $about['breadcrumb'] = $basic['breadcrumb'];
  }
  else {
    $about['breadcrumb'] = muin_build_basic_page_breadcrumb($variables);
  }

  if (!empty($basic['back_to_top'])) {
    $about['back_to_top'] = $basic['back_to_top'];
  }

  $about['hero']['title'] = $node->label();

  $hero_lead = muin_extract_markup_field($node, $content, [
    'field_lead',
    'field_intro',
    'field_summary',
    'field_lead_text',
  ]);
  if ($hero_lead !== NULL) {
    $about['hero']['lead'] = $hero_lead;
  }

  $hero_description = muin_extract_markup_field($node, $content, [
    'field_description',
    'field_intro_long',
    'field_summary_long',
    'body',
  ]);
  if ($hero_description !== NULL) {
    $about['hero']['description'] = $hero_description;
  }

  $primary_cta = muin_extract_link_field($node, $content, [
    'field_primary_cta',
    'field_cta_link',
    'field_start_now',
    'field_cta',
    'field_call_to_action',
  ]);
  if ($primary_cta !== NULL) {
    $about['hero']['primary_cta'] = $primary_cta;
  }

  $secondary_cta = muin_extract_link_field($node, $content, [
    'field_secondary_cta',
    'field_cta_secondary',
    'field_learn_more',
    'field_secondary_call_to_action',
  ]);
  if ($secondary_cta !== NULL) {
    $about['hero']['secondary_cta'] = $secondary_cta;
  }

  $hero_image = muin_extract_image_field($node, $content, [
    'field_hero_image',
    'field_banner_image',
    'field_main_image',
    'field_image',
    'field_featured_media',
    'field_media_image',
  ]);
  if ($hero_image !== NULL) {
    $about['hero']['image'] = $hero_image;
  }

  $hero_badges = muin_extract_paragraph_cards($node, $content, [
    'field_hero_badges',
    'field_key_highlights',
    'field_value_badges',
    'field_highlights',
  ]);
  if (!empty($hero_badges)) {
    $about['hero']['badges'] = $hero_badges;
  }

  $chips = muin_extract_link_items($node, $content, [
    'field_quick_links',
    'field_reference_links',
    'field_navigation_links',
    'field_section_links',
  ]);
  if (!empty($chips)) {
    $about['chips'] = $chips;
  }

  $sections = &$about['sections'];

  $why_heading = muin_extract_text_field($node, [
    'field_why_heading',
    'field_section_why_heading',
    'field_highlight_heading',
  ], $content);
  if ($why_heading !== NULL && $why_heading !== '') {
    $sections['why_now']['heading'] = $why_heading;
  }

  $why_lead = muin_extract_markup_field($node, $content, [
    'field_why_lead',
    'field_section_why_lead',
    'field_highlight_intro',
  ]);
  if ($why_lead !== NULL) {
    $sections['why_now']['lead'] = $why_lead;
  }

  $why_cards = muin_extract_paragraph_cards($node, $content, [
    'field_why_cards',
    'field_why_points',
    'field_why_items',
    'field_highlight_cards',
  ]);
  if (!empty($why_cards)) {
    $sections['why_now']['cards'] = $why_cards;
  }

  $routes_heading = muin_extract_text_field($node, [
    'field_routes_heading',
    'field_entry_routes_heading',
  ], $content);
  if ($routes_heading !== NULL && $routes_heading !== '') {
    $sections['routes']['heading'] = $routes_heading;
  }

  $routes_cards = muin_extract_paragraph_cards($node, $content, [
    'field_routes',
    'field_entry_routes',
    'field_routes_cards',
  ]);
  if (!empty($routes_cards)) {
    $sections['routes']['cards'] = $routes_cards;
  }

  $incentives_heading = muin_extract_text_field($node, [
    'field_incentives_heading',
    'field_investor_incentives_heading',
  ], $content);
  if ($incentives_heading !== NULL && $incentives_heading !== '') {
    $sections['incentives']['heading'] = $incentives_heading;
  }

  $incentives_cards = muin_extract_paragraph_cards($node, $content, [
    'field_incentives',
    'field_incentive_cards',
  ]);
  if (!empty($incentives_cards)) {
    $sections['incentives']['cards'] = $incentives_cards;
  }

  $sectors_heading = muin_extract_text_field($node, [
    'field_sectors_heading',
    'field_high_potential_heading',
  ], $content);
  if ($sectors_heading !== NULL && $sectors_heading !== '') {
    $sections['sectors']['heading'] = $sectors_heading;
  }

  $sectors_cards = muin_extract_paragraph_cards($node, $content, [
    'field_sectors',
    'field_sector_cards',
  ]);
  if (!empty($sectors_cards)) {
    $sections['sectors']['cards'] = $sectors_cards;
  }

  $residency_heading = muin_extract_text_field($node, [
    'field_residency_heading',
    'field_premium_residency_heading',
  ], $content);
  if ($residency_heading !== NULL && $residency_heading !== '') {
    $sections['residency']['heading'] = $residency_heading;
  }

  $residency_cards = muin_extract_paragraph_cards($node, $content, [
    'field_residency',
    'field_residency_cards',
  ]);
  if (!empty($residency_cards)) {
    $sections['residency']['cards'] = $residency_cards;
  }

  $residency_image = muin_extract_image_field($node, $content, [
    'field_residency_image',
    'field_premium_residency_image',
  ]);
  if ($residency_image !== NULL) {
    $sections['residency']['image'] = $residency_image;
  }

  $residency_cta = muin_extract_link_field($node, $content, [
    'field_residency_cta',
    'field_premium_residency_cta',
  ]);
  if ($residency_cta !== NULL) {
    $sections['residency']['cta'] = $residency_cta;
  }

  $free_heading = muin_extract_text_field($node, [
    'field_free_zones_heading',
    'field_free_zone_heading',
  ], $content);
  if ($free_heading !== NULL && $free_heading !== '') {
    $sections['free_zones']['heading'] = $free_heading;
  }

  $free_cards = muin_extract_paragraph_cards($node, $content, [
    'field_free_zones',
    'field_free_zone_cards',
  ]);
  if (!empty($free_cards)) {
    $sections['free_zones']['cards'] = $free_cards;
  }

  $free_image = muin_extract_image_field($node, $content, [
    'field_free_zone_image',
    'field_free_zones_image',
  ]);
  if ($free_image !== NULL) {
    $sections['free_zones']['image'] = $free_image;
  }

  $free_cta = muin_extract_link_field($node, $content, [
    'field_free_zone_cta',
    'field_free_zones_cta',
  ]);
  if ($free_cta !== NULL) {
    $sections['free_zones']['cta'] = $free_cta;
  }

  $costs_heading = muin_extract_text_field($node, [
    'field_costs_heading',
    'field_cheatsheet_heading',
  ], $content);
  if ($costs_heading !== NULL && $costs_heading !== '') {
    $sections['costs']['heading'] = $costs_heading;
  }

  $costs_cards = muin_extract_paragraph_cards($node, $content, [
    'field_costs',
    'field_cost_cards',
  ]);
  if (!empty($costs_cards)) {
    $sections['costs']['cards'] = $costs_cards;
  }

  $costs_note = muin_extract_markup_field($node, $content, [
    'field_costs_note',
    'field_cheatsheet_note',
  ]);
  if ($costs_note !== NULL) {
    $sections['costs']['note'] = $costs_note;
  }

  $faq_heading = muin_extract_text_field($node, [
    'field_faq_heading',
    'field_investor_faq_heading',
  ], $content);
  if ($faq_heading !== NULL && $faq_heading !== '') {
    $sections['faq']['heading'] = $faq_heading;
  }

  $faq_items = muin_extract_about_faq($node, $content, [
    'field_faq',
    'field_investor_faq',
  ]);
  if (!empty($faq_items)) {
    $sections['faq']['items'] = $faq_items;
  }

  $cta_heading = muin_extract_text_field($node, [
    'field_cta_heading',
    'field_call_to_action_heading',
  ], $content);
  if ($cta_heading !== NULL && $cta_heading !== '') {
    $sections['cta']['heading'] = $cta_heading;
  }

  $cta_body = muin_extract_markup_field($node, $content, [
    'field_cta_body',
    'field_call_to_action_body',
    'field_cta',
  ]);
  if ($cta_body !== NULL) {
    $sections['cta']['body'] = $cta_body;
  }

  $cta_primary = muin_extract_link_field($node, $content, [
    'field_cta_primary',
    'field_cta_link',
    'field_primary_cta',
    'field_contact_cta',
  ]);
  if ($cta_primary !== NULL) {
    $sections['cta']['cta'] = $cta_primary;
  }

  return $about;
}

