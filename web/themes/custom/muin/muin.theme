<?php
/**
 * @file
 * Theme hooks for Muin theme.
 */

use Drupal\Component\Render\Markup;
use Drupal\Component\Render\MarkupInterface;
use Drupal\Component\Utility\Html;
use Drupal\Core\Messenger\MessengerInterface;
use Drupal\Core\Render\RenderableInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;
use Drupal\file\FileInterface;
use Drupal\node\NodeInterface;
use Drupal\paragraphs\ParagraphInterface;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_preprocess_page().
 */
function muin_preprocess_page(array &$variables): void {
  $language = \Drupal::languageManager()->getCurrentLanguage();
  $langcode = $language->getId();

  $date_formatter = \Drupal::service('date.formatter');
  $date = $date_formatter->format(time(), 'custom', 'l, F j, Y', NULL, $langcode);

  $settings = [
    'date' => $date,
    'increaseFontTip' => (string) t('Increase font size'),
    'increaseFontLabel' => (string) t('Increase font size'),
    'decreaseFontTip' => (string) t('Decrease font size'),
    'decreaseFontLabel' => (string) t('Decrease font size'),
    'invertColorsTip' => (string) t('Invert colors'),
    'invertColorsLabel' => (string) t('Invert colors'),
    'calendarAlt' => (string) t('Calendar icon'),
    'langcode' => $langcode,
  ];

  $variables['topbar_settings'] = $settings;
  $variables['#attached']['drupalSettings']['muin']['topbar'] = $settings;
}

/**
 * Implements hook_preprocess_views_view().
 */
function muin_preprocess_views_view(array &$variables): void {
  if (empty($variables['view']) || !$variables['view'] instanceof ViewExecutable) {
    return;
  }

  $view = $variables['view'];
  $view_id = $view->id();
  $display = $view->current_display;

  if ($view_id === 'articles' && $display === 'page') {
    muin_preprocess_articles_view_page($variables, $view);
    return;
  }

  if ($view_id === 'services' && $display === 'page') {
    muin_preprocess_services_view_page($variables, $view);
  }
}

/**
 * Preprocesses the Articles view page display variables.
 */
function muin_preprocess_articles_view_page(array &$variables, ViewExecutable $view): void {
  $renderer = \Drupal::service('renderer');

  if (empty($variables['rows'])) {
    $has_empty_behavior = FALSE;
    if (array_key_exists('empty', $variables)) {
      $empty_candidate = $variables['empty'];

      try {
        if ($empty_candidate instanceof RenderableInterface) {
          $empty_candidate = $empty_candidate->toRenderable();
        }

        if ($empty_candidate instanceof MarkupInterface) {
          $rendered = $empty_candidate->__toString();
        }
        elseif (is_array($empty_candidate)) {
          $render_array = $empty_candidate;
          $render_result = $renderer->renderPlain($render_array);
          if ($render_result instanceof MarkupInterface) {
            $rendered = $render_result->__toString();
          }
          else {
            $rendered = (string) $render_result;
          }
        }
        else {
          $rendered = (string) $empty_candidate;
        }

        if (trim($rendered) !== '') {
          $has_empty_behavior = TRUE;
        }
      }
      catch (\Throwable $throwable) {
        $has_empty_behavior = TRUE;
      }
    }

    if (!$has_empty_behavior) {
      $variables['empty'] = [
        '#type' => 'status_messages',
      ];
    }
  }

  $title_markup = $view->getTitle();
  $title = muin_renderable_to_text($title_markup, $renderer ?? NULL);
  if ($title === '' && $view->storage) {
    $title = muin_renderable_to_text($view->storage->label(), $renderer ?? NULL);
  }

  $default_title = (string) t('Articles');
  if ($title === '') {
    $title = $default_title;
  }
  elseif (strcasecmp($title, 'articles') === 0 || strcasecmp($title, $default_title) === 0) {
    $title = $default_title;
  }

  $subtitle = NULL;
  if (!empty($variables['header'])) {
    try {
      $subtitle_markup = $renderer->render($variables['header']);
      if ($subtitle_markup instanceof MarkupInterface) {
        $subtitle_string = trim($subtitle_markup->__toString());
        if ($subtitle_string !== '') {
          $subtitle = Markup::create($subtitle_string);
        }
      }
      else {
        $subtitle_string = trim((string) $subtitle_markup);
        if ($subtitle_string !== '') {
          $subtitle = Markup::create($subtitle_string);
        }
      }
    }
    catch (\Throwable $throwable) {
      $subtitle = NULL;
    }
  }

  $breadcrumb_items = muin_build_breadcrumb_items($title);
  $home_label = (string) t('Home');
  $home_url = NULL;
  try {
    $home_url = Url::fromRoute('<front>')->toString();
  }
  catch (\Throwable $throwable) {
    $home_url = NULL;
  }

  $normalized_items = [];
  $has_home = FALSE;
  foreach ($breadcrumb_items as $item) {
    $text = isset($item['text']) ? trim((string) $item['text']) : '';
    $url = $item['url'] ?? NULL;
    if ($text === '') {
      continue;
    }

    if (strcasecmp($text, 'home') === 0 || strcasecmp($text, $home_label) === 0) {
      $text = $home_label;
      if ($url === NULL && $home_url !== NULL) {
        $url = $home_url;
      }
      $has_home = TRUE;
    }

    if (strcasecmp($text, 'articles') === 0 || strcasecmp($text, $default_title) === 0) {
      $text = $title;
      $url = NULL;
    }

    $normalized_items[] = [
      'text' => $text,
      'url' => $url,
    ];
  }

  if (!$has_home) {
    $normalized_items = array_merge([
      [
        'text' => $home_label,
        'url' => $home_url,
      ],
    ], $normalized_items);
  }

  if ($title !== '') {
    $last_index = array_key_last($normalized_items);
    if ($last_index === NULL || strcasecmp($normalized_items[$last_index]['text'], $title) !== 0) {
      $normalized_items[] = [
        'text' => $title,
        'url' => NULL,
      ];
    }
    else {
      $normalized_items[$last_index]['text'] = $title;
      $normalized_items[$last_index]['url'] = NULL;
    }
  }

  $variables['muin_articles'] = [
    'title' => $title,
    'subtitle' => $subtitle,
    'breadcrumb' => $normalized_items,
  ];
}

/**
 * Preprocesses the Services view page display variables.
 */
function muin_preprocess_services_view_page(array &$variables, ViewExecutable $view): void {
  $renderer = \Drupal::service('renderer');

  if (empty($variables['rows'])) {
    $has_empty_behavior = FALSE;
    if (array_key_exists('empty', $variables)) {
      $empty_candidate = $variables['empty'];

      try {
        if ($empty_candidate instanceof RenderableInterface) {
          $empty_candidate = $empty_candidate->toRenderable();
        }

        if ($empty_candidate instanceof MarkupInterface) {
          $rendered = $empty_candidate->__toString();
        }
        elseif (is_array($empty_candidate)) {
          $render_array = $empty_candidate;
          $render_result = $renderer->renderPlain($render_array);
          if ($render_result instanceof MarkupInterface) {
            $rendered = $render_result->__toString();
          }
          else {
            $rendered = (string) $render_result;
          }
        }
        else {
          $rendered = (string) $empty_candidate;
        }

        if (trim($rendered) !== '') {
          $has_empty_behavior = TRUE;
        }
      }
      catch (\Throwable $throwable) {
        $has_empty_behavior = TRUE;
      }
    }

    if (!$has_empty_behavior) {
      $variables['empty'] = [
        '#type' => 'status_messages',
      ];
    }
  }

  $title_markup = $view->getTitle();
  $title = muin_renderable_to_text($title_markup, $renderer ?? NULL);
  if ($title === '' && $view->storage) {
    $title = muin_renderable_to_text($view->storage->label(), $renderer ?? NULL);
  }

  $default_title = (string) t('Services');
  if ($title === '') {
    $title = $default_title;
  }
  elseif (strcasecmp($title, 'services') === 0 || strcasecmp($title, $default_title) === 0) {
    $title = $default_title;
  }

  $subtitle = NULL;
  if (!empty($variables['header'])) {
    try {
      $subtitle_markup = $renderer->render($variables['header']);
      if ($subtitle_markup instanceof MarkupInterface) {
        $subtitle_string = trim($subtitle_markup->__toString());
        if ($subtitle_string !== '') {
          $subtitle = Markup::create($subtitle_string);
        }
      }
      else {
        $subtitle_string = trim((string) $subtitle_markup);
        if ($subtitle_string !== '') {
          $subtitle = Markup::create($subtitle_string);
        }
      }
    }
    catch (\Throwable $throwable) {
      $subtitle = NULL;
    }
  }

  $breadcrumb_items = muin_build_breadcrumb_items($title);
  $home_label = (string) t('Home');
  $home_url = NULL;
  try {
    $home_url = Url::fromRoute('<front>')->toString();
  }
  catch (\Throwable $throwable) {
    $home_url = NULL;
  }

  $normalized_items = [];
  $has_home = FALSE;
  foreach ($breadcrumb_items as $item) {
    $text = isset($item['text']) ? trim((string) $item['text']) : '';
    $url = $item['url'] ?? NULL;
    if ($text === '') {
      continue;
    }

    if (strcasecmp($text, 'home') === 0 || strcasecmp($text, $home_label) === 0) {
      $text = $home_label;
      if ($url === NULL && $home_url !== NULL) {
        $url = $home_url;
      }
      $has_home = TRUE;
    }

    if (strcasecmp($text, 'services') === 0 || strcasecmp($text, $default_title) === 0) {
      $text = $title;
      $url = NULL;
    }

    $normalized_items[] = [
      'text' => $text,
      'url' => $url,
    ];
  }

  if (!$has_home) {
    $normalized_items = array_merge([
      [
        'text' => $home_label,
        'url' => $home_url,
      ],
    ], $normalized_items);
  }

  if ($title !== '') {
    $last_index = array_key_last($normalized_items);
    if ($last_index === NULL || strcasecmp($normalized_items[$last_index]['text'], $title) !== 0) {
      $normalized_items[] = [
        'text' => $title,
        'url' => NULL,
      ];
    }
    else {
      $normalized_items[$last_index]['text'] = $title;
      $normalized_items[$last_index]['url'] = NULL;
    }
  }

  $total_results = NULL;
  try {
    if (isset($view->total_rows)) {
      $total_results = (int) $view->total_rows;
    }
  }
  catch (\Throwable $throwable) {
    $total_results = NULL;
  }

  if ($total_results === NULL) {
    $result = $view->result ?? NULL;
    if (is_array($result)) {
      $total_results = count($result);
    }
  }

  $variables['muin_services'] = [
    'title' => $title,
    'subtitle' => $subtitle,
    'breadcrumb' => $normalized_items,
    'total_results' => $total_results,
  ];
}

/**
 * Implements hook_preprocess_node().
 */
function muin_preprocess_node(array &$variables): void {
  if (empty($variables['node']) || !$variables['node'] instanceof NodeInterface) {
    return;
  }

  $view_mode = $variables['view_mode'] ?? NULL;
  $node = $variables['node'];
  $content = &$variables['content'];
  if (!is_array($content)) {
    $content = [];
  }

  if ($node->bundle() === 'service' && $view_mode === 'teaser') {
    $service = [];

    $service['icon'] = muin_extract_render_array($content, [
      'field_service_icon',
      'field_icon',
      'field_icon_media',
      'field_icon_image',
      'field_service_logo',
      'field_media_icon',
    ]);

    $service['tags'] = muin_extract_label_items($node, $content, [
      'field_service_tags',
      'field_tags',
      'field_category',
    ]);

    $service['description'] = muin_extract_render_array($content, [
      'field_summary',
      'field_description',
      'field_intro',
      'body',
    ]);
    if (!isset($service['description'])) {
      $description_text = muin_extract_text_field($node, [
        'field_summary',
        'field_description',
        'field_intro',
        'body',
      ], $content);
      if ($description_text !== NULL && $description_text !== '') {
        $service['description_text'] = $description_text;
      }
    }

    $service['primary_cta'] = muin_extract_link_field($node, $content, [
      'field_primary_cta',
      'field_cta_link',
      'field_contact_cta',
      'field_contact_link',
      'field_primary_call_to_action',
      'field_learn_more_link',
    ]);

    $service['secondary_cta'] = muin_extract_link_field($node, $content, [
      'field_secondary_cta',
      'field_secondary_call_to_action',
      'field_start_now',
      'field_start_now_link',
      'field_apply_now',
      'field_apply_now_link',
    ]);

    $service = array_filter($service, static function ($value) {
      if (is_array($value)) {
        if (isset($value['render'])) {
          return !empty($value['render']);
        }
        return !empty(array_filter($value));
      }
      return $value !== NULL && $value !== '';
    });

    if (!empty($service)) {
      $variables['muin_service_teaser'] = $service;
    }

    return;
  }

  if ($view_mode !== 'full') {
    return;
  }

  switch ($node->bundle()) {
    case 'page':
      $basic = [];
      $basic['breadcrumb'] = muin_build_basic_page_breadcrumb($variables);
      $basic['lead'] = muin_extract_render_array($content, [
        'field_lead',
        'field_intro',
        'field_summary',
        'field_lead_text',
        'field_subtitle',
      ]);
      $basic['description'] = muin_extract_render_array($content, [
        'field_description',
        'field_intro_long',
        'field_summary_long',
      ]);
      $basic['quick_links'] = muin_extract_render_array($content, [
        'field_quick_links',
        'field_quick_link',
        'field_reference_links',
      ]);
      $basic['sections'] = muin_extract_render_array($content, [
        'field_sections',
        'field_content_sections',
        'field_components',
      ]);
      $basic['body'] = muin_extract_render_array($content, [
        'body',
      ]);
      $basic['resources'] = muin_extract_render_array($content, [
        'field_resources',
        'field_related_links',
      ]);
      $basic['cta'] = muin_extract_render_array($content, [
        'field_cta',
        'field_call_to_action',
        'field_next_steps',
      ]);
      $basic['back_to_top'] = muin_extract_text_field($node, [
        'field_back_to_top_label',
        'field_back_to_top',
      ]);

      $basic_filtered = array_filter($basic, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });

      if (!empty($basic_filtered)) {
        $variables['muin_basic_page'] = $basic_filtered;
      }

      if (muin_is_about_kingdom_page($node)) {
        $variables['theme_hook_suggestions'][] = 'node__page__about_kingdom';
        $about = muin_build_about_kingdom_page($node, $content, $variables, $basic_filtered ?? []);
        if (!empty($about)) {
          $variables['muin_about_kingdom_page'] = $about;
        }
      }
      break;

    case 'article':
      $article = [];
      $article['breadcrumb'] = muin_build_article_page_breadcrumb($variables);
      $article['lead'] = muin_extract_render_array($content, [
        'field_lead',
        'field_intro',
        'field_summary',
        'field_lead_text',
      ]);
      $article['description'] = muin_extract_render_array($content, [
        'field_description',
        'field_intro_long',
        'field_summary_long',
      ]);
      $article['sections'] = muin_extract_render_array($content, [
        'field_sections',
        'field_content_sections',
        'field_components',
      ]);
      $article['body'] = muin_extract_render_array($content, [
        'body',
      ]);

      $meta = [];
      $meta['date'] = muin_extract_render_array($content, [
        'field_publication_date',
        'field_date',
        'field_published_on',
      ]);
      $meta['author'] = muin_extract_render_array($content, [
        'field_author',
        'field_authors',
        'uid',
      ]);
      $meta['tags'] = muin_extract_render_array($content, [
        'field_category',
        'field_categories',
        'field_tags',
      ]);
      $meta = array_filter($meta, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($meta)) {
        $article['meta'] = $meta;
      }

      $article['toc_label'] = muin_extract_text_field($node, [
        'field_toc_label',
        'field_on_this_page_label',
      ]);
      $article['toc_title'] = muin_extract_text_field($node, [
        'field_toc_title',
        'field_toc_heading',
      ]);

      $toc = muin_build_article_toc($node, $article['body'] ?? NULL);
      if (!empty($toc)) {
        $article['toc'] = $toc;
      }

      $variables['muin_article_page'] = array_filter($article, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      break;

    case 'service':
      $service = [];
      $service['breadcrumb'] = muin_build_service_page_breadcrumb($variables);

      $service['cta'] = muin_extract_link_field($node, $content, [
        'field_primary_cta',
        'field_cta_link',
        'field_contact_cta',
        'field_contact_link',
        'field_primary_call_to_action',
      ]);

      $service['tags'] = muin_extract_label_items($node, $content, [
        'field_service_tags',
        'field_tags',
        'field_category',
      ]);

      $service['description'] = muin_extract_render_array($content, [
        'field_description',
        'field_summary',
        'field_intro',
        'body',
      ]);
      if (!isset($service['description'])) {
        $description_text = muin_extract_text_field($node, [
          'field_description',
          'field_summary',
          'field_intro',
          'body',
        ], $content);
        if ($description_text !== NULL && $description_text !== '') {
          $service['description_text'] = $description_text;
        }
      }

      $service['sla'] = muin_extract_link_field($node, $content, [
        'field_sla_link',
        'field_service_level_agreement',
        'field_sla',
      ]);

      $service['steps_heading'] = muin_extract_text_field($node, [
        'field_steps_heading',
        'field_process_heading',
        'field_how_it_works_heading',
      ], $content);

      $service_steps = muin_extract_text_items($node, $content, [
        'field_service_steps',
        'field_steps',
        'field_process_steps',
      ]);
      if (!empty($service_steps)) {
        $service['steps'] = $service_steps;
      }
      else {
        $service_steps_render = muin_extract_render_array($content, [
          'field_service_steps',
          'field_steps',
          'field_process_steps',
        ]);
        if ($service_steps_render !== NULL) {
          $service['steps_render'] = $service_steps_render;
        }
      }

      $info_blocks = [];

      $audience = [];
      $audience['title'] = muin_extract_text_field($node, [
        'field_target_audience_title',
        'field_audience_title',
      ], $content);
      $audience_body = muin_extract_render_array($content, [
        'field_target_audience',
        'field_service_audience',
        'field_audience',
      ]);
      if ($audience_body !== NULL) {
        $audience['body'] = $audience_body;
      }
      else {
        $audience_text = muin_extract_text_field($node, [
          'field_target_audience',
          'field_service_audience',
          'field_audience',
        ], $content);
        if ($audience_text !== NULL && $audience_text !== '') {
          $audience['body_text'] = $audience_text;
        }
      }
      $audience = array_filter($audience, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($audience)) {
        $info_blocks['audience'] = $audience;
      }

      $duration = [];
      $duration['title'] = muin_extract_text_field($node, [
        'field_service_duration_title',
        'field_duration_title',
      ], $content);
      $duration_body = muin_extract_render_array($content, [
        'field_service_duration',
        'field_duration',
        'field_timeframe',
      ]);
      if ($duration_body !== NULL) {
        $duration['body'] = $duration_body;
      }
      else {
        $duration_text = muin_extract_text_field($node, [
          'field_service_duration',
          'field_duration',
          'field_timeframe',
        ], $content);
        if ($duration_text !== NULL && $duration_text !== '') {
          $duration['body_text'] = $duration_text;
        }
      }
      $duration = array_filter($duration, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($duration)) {
        $info_blocks['duration'] = $duration;
      }

      $channels = [];
      $channels['title'] = muin_extract_text_field($node, [
        'field_service_channels_title',
        'field_channels_title',
      ], $content);
      $channels_body = muin_extract_render_array($content, [
        'field_service_channels',
        'field_channels',
        'field_contact_channels',
      ]);
      if ($channels_body !== NULL) {
        $channels['body'] = $channels_body;
      }
      else {
        $channels_text = muin_extract_text_field($node, [
          'field_service_channels',
          'field_channels',
          'field_contact_channels',
        ], $content);
        if ($channels_text !== NULL && $channels_text !== '') {
          $channels['body_text'] = $channels_text;
        }
      }
      $channels = array_filter($channels, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($channels)) {
        $info_blocks['channels'] = $channels;
      }

      $cost = [];
      $cost['title'] = muin_extract_text_field($node, [
        'field_service_cost_title',
        'field_cost_title',
      ], $content);
      $cost_body = muin_extract_render_array($content, [
        'field_service_cost',
        'field_cost',
        'field_pricing',
      ]);
      if ($cost_body !== NULL) {
        $cost['body'] = $cost_body;
      }
      else {
        $cost_text = muin_extract_text_field($node, [
          'field_service_cost',
          'field_cost',
          'field_pricing',
        ], $content);
        if ($cost_text !== NULL && $cost_text !== '') {
          $cost['body_text'] = $cost_text;
        }
      }
      $cost = array_filter($cost, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($cost)) {
        $info_blocks['cost'] = $cost;
      }

      if (!empty($info_blocks)) {
        $service['info'] = $info_blocks;
      }

      $payment = [];
      $payment['title'] = muin_extract_text_field($node, [
        'field_payment_methods_title',
        'field_payment_title',
      ], $content);
      $payment_methods = muin_extract_render_array($content, [
        'field_payment_methods',
        'field_payment_options',
        'field_payment_icons',
      ]);
      if ($payment_methods !== NULL) {
        $payment['methods'] = $payment_methods;
      }
      else {
        $payment_text = muin_extract_text_field($node, [
          'field_payment_methods',
          'field_payment_options',
        ], $content);
        if ($payment_text !== NULL && $payment_text !== '') {
          $payment['methods_text'] = $payment_text;
        }
      }
      $payment = array_filter($payment, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($payment)) {
        $service['payment'] = $payment;
      }

      $contact = [];
      $contact['faq_title'] = muin_extract_text_field($node, [
        'field_faq_title',
        'field_faq_heading',
      ], $content);
      $contact['faq_link'] = muin_extract_link_field($node, $content, [
        'field_faq_link',
        'field_faq',
        'field_faq_url',
      ]);

      $contact['phone_title'] = muin_extract_text_field($node, [
        'field_phone_title',
        'field_contact_phone_title',
      ], $content);
      $contact['phone_link'] = muin_extract_link_field($node, $content, [
        'field_phone_link',
        'field_phone',
        'field_contact_phone',
      ]);

      $contact['email_title'] = muin_extract_text_field($node, [
        'field_email_title',
        'field_contact_email_title',
      ], $content);
      $contact['email_link'] = muin_extract_link_field($node, $content, [
        'field_email_link',
        'field_email',
        'field_contact_email',
      ]);

      $contact['manual'] = muin_extract_link_field($node, $content, [
        'field_manual_link',
        'field_manual',
        'field_download_manual',
        'field_manual_button',
      ]);

      $contact = array_filter($contact, static function ($value) {
        if (is_array($value)) {
          if (isset($value['render'])) {
            return !empty($value['render']);
          }
          return !empty(array_filter($value));
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($contact)) {
        $service['contact'] = $contact;
      }

      $mobile = [];
      $mobile['title'] = muin_extract_text_field($node, [
        'field_mobile_app_title',
        'field_mobile_apps_title',
        'field_mobile_apps_heading',
      ], $content);
      $mobile_items = muin_extract_render_array($content, [
        'field_mobile_apps',
        'field_app_links',
        'field_application_links',
      ]);
      if ($mobile_items !== NULL) {
        $mobile['items'] = $mobile_items;
      }
      else {
        $mobile_text = muin_extract_text_field($node, [
          'field_mobile_apps',
          'field_app_links',
          'field_application_links',
        ], $content);
        if ($mobile_text !== NULL && $mobile_text !== '') {
          $mobile['items_text'] = $mobile_text;
        }
      }
      $mobile = array_filter($mobile, static function ($value) {
        if (is_array($value)) {
          return !empty($value);
        }
        return $value !== NULL && $value !== '';
      });
      if (!empty($mobile)) {
        $service['mobile'] = $mobile;
      }

      $filtered_service = [];
      foreach ($service as $key => $value) {
        if (is_array($value)) {
          $filtered_value = [];
          foreach ($value as $sub_key => $sub_value) {
            if (is_array($sub_value)) {
              $sub_filtered = array_filter($sub_value, static function ($item) {
                if (is_array($item)) {
                  return !empty(array_filter($item));
                }
                return $item !== NULL && $item !== '';
              });
              if (!empty($sub_filtered)) {
                $filtered_value[$sub_key] = $sub_filtered;
              }
            }
            elseif ($sub_value !== NULL && $sub_value !== '') {
              $filtered_value[$sub_key] = $sub_value;
            }
          }
          if (!empty($filtered_value)) {
            $filtered_service[$key] = $filtered_value;
          }
        }
        elseif ($value !== NULL && $value !== '') {
          $filtered_service[$key] = $value;
        }
      }

      if (!empty($filtered_service)) {
        $variables['muin_service_page'] = $filtered_service;
      }
      break;
  }
}

/**
 * Builds breadcrumb items for the basic page layout.
 */
function muin_build_basic_page_breadcrumb(array $variables): array {
  $renderer = \Drupal::service('renderer');
  $label = '';
  if (isset($variables['label'])) {
    $label = muin_renderable_to_text($variables['label'], $renderer);
  }
  elseif (!empty($variables['node']) && $variables['node'] instanceof NodeInterface) {
    $label = muin_renderable_to_text($variables['node']->label(), $renderer);
  }

  return muin_build_breadcrumb_items($label);
}

/**
 * Builds breadcrumb items for the article layout.
 */
function muin_build_article_page_breadcrumb(array $variables): array {
  $renderer = \Drupal::service('renderer');
  $label = '';
  if (isset($variables['label'])) {
    $label = muin_renderable_to_text($variables['label'], $renderer);
  }
  elseif (!empty($variables['node']) && $variables['node'] instanceof NodeInterface) {
    $label = muin_renderable_to_text($variables['node']->label(), $renderer);
  }

  $items = muin_build_breadcrumb_items($label);

  $articles_label = (string) t('Articles');
  $articles_url = NULL;
  try {
    $articles_url = Url::fromRoute('view.articles.page')->toString();
  }
  catch (\Throwable $throwable) {
    $articles_url = NULL;
  }

  $has_articles = FALSE;
  foreach ($items as $index => $item) {
    $text = isset($item['text']) ? trim((string) $item['text']) : '';
    if ($text === '') {
      continue;
    }

    if (strcasecmp($text, $articles_label) === 0) {
      $has_articles = TRUE;
      if ($articles_url !== NULL && (empty($item['url']) || !is_string($item['url']))) {
        $items[$index]['url'] = $articles_url;
      }
      break;
    }
  }

  if (!$has_articles) {
    $article_item = [
      'text' => $articles_label,
      'url' => $articles_url,
    ];

    $last_index = array_key_last($items);
    if ($last_index === NULL) {
      $items[] = $article_item;
    }
    else {
      array_splice($items, $last_index, 0, [$article_item]);
    }
  }

  $home_label = (string) t('Home');
  $has_home = FALSE;
  foreach ($items as $item) {
    $text = isset($item['text']) ? trim((string) $item['text']) : '';
    if ($text === '') {
      continue;
    }

    if (strcasecmp($text, $home_label) === 0) {
      $has_home = TRUE;
      break;
    }
  }

  if (!$has_home) {
    $home_url = NULL;
    try {
      $home_url = Url::fromRoute('<front>')->toString();
    }
    catch (\Throwable $throwable) {
      $home_url = NULL;
    }

    array_unshift($items, [
      'text' => $home_label,
      'url' => $home_url,
    ]);
  }

  return $items;
}

/**
 * Builds breadcrumb items for the service layout.
 */
function muin_build_service_page_breadcrumb(array $variables): array {
  $renderer = \Drupal::service('renderer');
  $label = '';
  if (isset($variables['label'])) {
    $label = muin_renderable_to_text($variables['label'], $renderer);
  }
  elseif (!empty($variables['node']) && $variables['node'] instanceof NodeInterface) {
