/**
 * Extracts a formatted markup value from a node field.
 */
function muin_extract_markup_field(NodeInterface $node, array &$content, array $candidates): ?MarkupInterface {
  $render_array = muin_extract_render_array($content, $candidates);
  if ($render_array !== NULL) {
    try {
      $renderer = \Drupal::service('renderer');
      $rendered = $renderer->render($render_array);
      if ($rendered instanceof MarkupInterface) {
        return $rendered;
      }

      return Markup::create((string) $rendered);
    }
    catch (\Throwable $throwable) {
      // Ignore rendering issues and fallback to field inspection.
    }
  }

  foreach ($candidates as $field_name) {
    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $node->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    if (!$item) {
      continue;
    }

    if (isset($item->processed) && $item->processed !== '') {
      return Markup::create($item->processed);
    }

    if (isset($item->value) && $item->value !== '') {
      return Markup::create((string) $item->value);
    }
  }

  return NULL;
}

/**
 * Extracts multiple link items from a field.
 */
function muin_extract_link_items(NodeInterface $node, array &$content, array $candidates): array {
  $items = [];

  foreach ($candidates as $field_name) {
    if (isset($content[$field_name])) {
      unset($content[$field_name]);
    }

    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    foreach ($node->get($field_name) as $item) {
      $link = muin_normalize_link_item($item);
      if ($link !== NULL) {
        $items[] = $link;
      }
    }

    if (!empty($items)) {
      break;
    }
  }

  return $items;
}

/**
 * Normalizes a link item from a field or paragraph.
 */
function muin_normalize_link_item($item): ?array {
  if (!$item) {
    return NULL;
  }

  $title = NULL;
  if (isset($item->title) && $item->title !== '') {
    $title = (string) $item->title;
  }
  elseif (isset($item->value) && $item->value !== '') {
    $title = (string) $item->value;
  }

  $url_string = NULL;
  $options = [];

  try {
    if (method_exists($item, 'getUrl')) {
      $url_object = $item->getUrl();
      if ($url_object instanceof Url) {
        $url_string = $url_object->toString();
        $options = $url_object->getOptions();
      }
      elseif ($url_object) {
        $url_string = $url_object->toString();
        if (method_exists($url_object, 'getOptions')) {
          $options = $url_object->getOptions();
        }
      }
    }
  }
  catch (\Throwable $throwable) {
    // Ignore URL extraction issues.
  }

  if ($url_string === NULL && isset($item->uri) && $item->uri !== '') {
    try {
      $url_object = Url::fromUri($item->uri, $item->options ?? []);
      $url_string = $url_object->toString();
      $options = $url_object->getOptions();
    }
    catch (\Throwable $throwable) {
      $url_string = (string) $item->uri;
      $options = is_array($item->options ?? NULL) ? $item->options : [];
    }
  }

  if ($url_string === NULL) {
    return NULL;
  }

  if ($title === NULL || $title === '') {
    $title = $url_string;
  }

  return [
    'title' => (string) $title,
    'url' => $url_string,
    'options' => is_array($options) ? $options : [],
  ];
}

/**
 * Extracts an image field value from a node.
 */
function muin_extract_image_field(NodeInterface $node, array &$content, array $candidates): ?array {
  foreach ($candidates as $field_name) {
    if (isset($content[$field_name])) {
      unset($content[$field_name]);
    }

    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $node->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    $image = muin_normalize_image_item($item);
    if ($image !== NULL) {
      return $image;
    }
  }

  return NULL;
}

/**
 * Normalizes an image item from a field or paragraph.
 */
function muin_normalize_image_item($item): ?array {
  if (!$item) {
    return NULL;
  }

  $file = NULL;
  if (isset($item->entity) && $item->entity instanceof FileInterface) {
    $file = $item->entity;
  }
  elseif (method_exists($item, 'entity') && $item->entity() instanceof FileInterface) {
    $file = $item->entity();
  }
  elseif (method_exists($item, 'getEntity')) {
    try {
      $entity = $item->getEntity();
      if ($entity instanceof FileInterface) {
        $file = $entity;
      }
    }
    catch (\Throwable $throwable) {
      $file = NULL;
    }
  }

  if (!$file instanceof FileInterface) {
    return NULL;
  }

  try {
    $file_url_generator = \Drupal::service('file_url_generator');
    $url = $file_url_generator->generateString($file->getFileUri());
  }
  catch (\Throwable $throwable) {
    $url = NULL;
  }

  if ($url === NULL) {
    return NULL;
  }

  $alt = NULL;
  if (isset($item->alt) && $item->alt !== '') {
    $alt = (string) $item->alt;
  }
  elseif (method_exists($item, 'getValue')) {
    try {
      $value = $item->getValue();
      if (is_array($value) && !empty($value['alt'])) {
        $alt = (string) $value['alt'];
      }
    }
    catch (\Throwable $throwable) {
      $alt = NULL;
    }
  }

  if ($alt === NULL || $alt === '') {
    $alt = $file->getFilename();
  }

  return [
    'url' => $url,
    'alt' => $alt,
  ];
}

/**
 * Extracts paragraph-based cards for structured sections.
 */
function muin_extract_paragraph_cards(NodeInterface $node, array &$content, array $candidates): array {
  $paragraphs = muin_extract_paragraph_entities($node, $content, $candidates);
  $items = [];

  foreach ($paragraphs as $paragraph) {
    $title = muin_paragraph_text($paragraph, [
      'field_title',
      'field_heading',
      'field_label',
      'field_question',
    ]);
    $body = muin_paragraph_markup($paragraph, [
      'field_body',
      'field_text',
      'field_description',
      'field_summary',
      'field_answer',
    ]);
    $list = muin_paragraph_list($paragraph, [
      'field_items',
      'field_list',
      'field_points',
      'field_steps',
      'field_bullets',
    ]);
    $cta = muin_paragraph_link($paragraph, [
      'field_link',
      'field_cta',
      'field_call_to_action',
      'field_primary_cta',
      'field_button_link',
    ]);
    $image = muin_paragraph_image($paragraph, [
      'field_image',
      'field_media',
      'field_graphic',
      'field_photo',
      'field_illustration',
    ]);

    $item = array_filter([
      'title' => $title,
      'body' => $body,
      'list' => $list,
      'cta' => $cta,
      'image' => $image,
    ], static function ($value) {
      if (is_array($value)) {
        return !empty($value);
      }

      if ($value instanceof MarkupInterface) {
        return trim($value->__toString()) !== '';
      }

      return $value !== NULL && $value !== '';
    });

    if (!empty($item)) {
      $items[] = $item;
    }
  }

  return $items;
}

/**
 * Extracts FAQ paragraph data.
 */
function muin_extract_about_faq(NodeInterface $node, array &$content, array $candidates): array {
  $paragraphs = muin_extract_paragraph_entities($node, $content, $candidates);
  $items = [];

  foreach ($paragraphs as $paragraph) {
    $question = muin_paragraph_text($paragraph, [
      'field_question',
      'field_title',
      'field_heading',
      'field_label',
    ]);
    $answer = muin_paragraph_markup($paragraph, [
      'field_answer',
      'field_body',
      'field_text',
      'field_description',
    ]);

    if ($question === NULL && $answer === NULL) {
      continue;
    }

    $items[] = array_filter([
      'question' => $question,
      'answer' => $answer,
    ], static function ($value) {
      if ($value instanceof MarkupInterface) {
        return trim($value->__toString()) !== '';
      }
      return $value !== NULL && $value !== '';
    });
  }

  return $items;
}

/**
 * Extracts referenced paragraph entities from a node field.
 */
function muin_extract_paragraph_entities(NodeInterface $node, array &$content, array $candidates): array {
  foreach ($candidates as $field_name) {
    if (isset($content[$field_name])) {
      unset($content[$field_name]);
    }

    if (!$node->hasField($field_name) || $node->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $entities = $node->get($field_name)->referencedEntities();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    $paragraphs = [];
    foreach ($entities as $entity) {
      if ($entity instanceof ParagraphInterface) {
        $paragraphs[] = $entity;
      }
    }

    if (!empty($paragraphs)) {
      return $paragraphs;
    }
  }

  return [];
}

/**
 * Extracts a plain text value from a paragraph.
 */
function muin_paragraph_text(ParagraphInterface $paragraph, array $candidates): ?string {
  foreach ($candidates as $field_name) {
    if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $paragraph->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    if (!$item) {
      continue;
    }

    if (isset($item->value) && $item->value !== '') {
      return trim((string) $item->value);
    }

    if (isset($item->title) && $item->title !== '') {
      return trim((string) $item->title);
    }

    if (method_exists($item, 'getString')) {
      try {
        $value = $item->getString();
        if ($value !== '') {
          return trim($value);
        }
      }
      catch (\Throwable $throwable) {
        continue;
      }
    }
  }

  return NULL;
}

/**
 * Extracts markup content from a paragraph field.
 */
function muin_paragraph_markup(ParagraphInterface $paragraph, array $candidates): ?MarkupInterface {
  foreach ($candidates as $field_name) {
    if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $paragraph->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    if (!$item) {
      continue;
    }

    if (isset($item->processed) && $item->processed !== '') {
      return Markup::create($item->processed);
    }

    if (isset($item->value) && $item->value !== '') {
      return Markup::create((string) $item->value);
    }
  }

  return NULL;
}

/**
 * Extracts a list of text items from a paragraph field.
 */
function muin_paragraph_list(ParagraphInterface $paragraph, array $candidates): array {
  foreach ($candidates as $field_name) {
    if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }

    $items = [];
    foreach ($paragraph->get($field_name) as $item) {
      if (isset($item->value) && $item->value !== '') {
        $items[] = trim((string) $item->value);
      }
    }

    if (!empty($items)) {
      return $items;
    }
  }

  return [];
}

/**
 * Extracts a link from a paragraph field.
 */
function muin_paragraph_link(ParagraphInterface $paragraph, array $candidates): ?array {
  foreach ($candidates as $field_name) {
    if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $paragraph->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    $link = muin_normalize_link_item($item);
    if ($link !== NULL) {
      return $link;
    }
  }

  return NULL;
}

/**
 * Extracts an image from a paragraph field.
 */
function muin_paragraph_image(ParagraphInterface $paragraph, array $candidates): ?array {
  foreach ($candidates as $field_name) {
    if (!$paragraph->hasField($field_name) || $paragraph->get($field_name)->isEmpty()) {
      continue;
    }

    try {
      $item = $paragraph->get($field_name)->first();
    }
    catch (\Throwable $throwable) {
      continue;
    }

    $image = muin_normalize_image_item($item);
    if ($image !== NULL) {
      return $image;
    }
  }

  return NULL;
}
