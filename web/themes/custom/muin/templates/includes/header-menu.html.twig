{% macro render_fields(content, classes) %}
  {% set fields = content|without('#sorted', '#type', '#theme', '#wrapper_attributes') %}
  {% if fields %}
    {% set rendered = fields|render %}
    {% if rendered|trim %}
      <div class="{{ classes|default('mt-2 text-sm text-slate-600') }}">{{ rendered }}</div>
    {% endif %}
  {% endif %}
{% endmacro %}

{% macro desktop_items(items, prefix, level) %}
  {% import _self as menus %}
  {% for item in items %}
    {% set has_children = item.below is not empty %}
    {% set item_key = prefix ~ '-' ~ level ~ '-' ~ loop.index %}
    {% set item_attributes = item.attributes.addClass('h-full', 'flex', 'items-center') %}
    <li{{ item_attributes }}
      @click.outside="openMenu==='{{ item_key }}' && (openMenu=null)"
      @keydown.escape.window="openMenu=null"
    >
      {% if has_children %}
        <button
          type="button"
          class="flex items-center gap-0 px-4 py-4 w-fit rounded-md relative text-sm font-semibold transition h-[71px] focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800 text-nowrap text-gray-900"
          @click="openMenu = openMenu === '{{ item_key }}' ? null : '{{ item_key }}'"
          aria-haspopup="true"
          :aria-expanded="openMenu === '{{ item_key }}'"
          :class="openMenu === '{{ item_key }}' && `bg-primary-600 text-white after:content-[''] after:absolute after:bottom-0 after:w-[80%] after:h-[4px] after:left-1/2 after:-translate-x-1/2 after:bg-primary-200 after:rounded-full`"
        >
          <span class="flex gap-2 px-1 items-center">
            <span>{{ item.title }}</span>
            <span class="w-3">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="size-3 transition-transform" :class="openMenu === '{{ item_key }}' ? 'rotate-180' : ''">
                <path fill="currentColor" d="M6.3 8.3a1 1 0 0 1 1.4 0L12 12.6l4.3-4.3a1 1 0 1 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 0 1 0-1.4Z" />
              </svg>
            </span>
          </span>
        </button>
        {{ menus.render_fields(item.content, 'px-4 pb-2 text-sm text-slate-600') }}
        {{ menus.desktop_panel(item.below, prefix, item_key, level + 1) }}
      {% else %}
        {% if item.url %}
          {{ link(item.title, item.url, {'class': ['flex', 'items-center', 'gap-0', 'px-4', 'py-4', 'w-fit', 'm-0.5', 'rounded-md', 'text-sm', 'leading-[1.2]', 'font-medium', 'transition', 'h-full', 'relative', 'focus-visible:outline', 'focus-visible:outline-2', 'focus-visible:outline-gray-800',  'text-gray-900']}) }}
        {% else %}
          <span class="flex items-center gap-0 px-4 py-4 w-fit m-0.5 rounded-md text-sm leading-[1.2] font-medium text-gray-900">{{ item.title }}</span>
        {% endif %}
        {{ menus.render_fields(item.content, 'px-4 pb-2 text-sm text-slate-600') }}
      {% endif %}
    </li>
  {% endfor %}
{% endmacro %}

{% macro desktop_panel(items, prefix, parent_key, level) %}
  {% import _self as menus %}
  <div
    x-cloak
    x-show="openMenu === '{{ parent_key }}'"
    x-transition.opacity
    class="absolute right-0 top-[83px] mt-2 bg-white border w-full shadow-none z-50"
  >
    <div class="container-page">
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 lg:gap-6 py-10">
        {% for item in items %}
          <li class="flex flex-col gap-1">
            {% if item.url %}
              {{ link(item.title, item.url, {'class': ['hover:underline', 'block', 'text-sm', 'font-medium', 'leading-[1.6]']}) }}
            {% else %}
              <span class="block text-md font-medium leading-[1.6]">{{ item.title }}</span>
            {% endif %}
            {{ menus.render_fields(item.content, 'text-sm text-slate-600') }}
            {% if item.below %}
              <ul class="grid grid-cols-1 gap-2 pt-2">
                {% for child in item.below %}
                  <li>
                    {% if child.url %}
                      {{ link(child.title, child.url, {'class': ['hover:underline', 'block', 'text-sm']}) }}
                    {% else %}
                      <span class="block text-sm">{{ child.title }}</span>
                    {% endif %}
                    {{ menus.render_fields(child.content, 'text-xs text-slate-500') }}
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>
{% endmacro %}

{% macro mobile_items(items, prefix, level) %}
  {% import _self as menus %}
  {% for item in items %}
    {% set has_children = item.below is not empty %}
    {% set item_key = prefix ~ '-' ~ level ~ '-' ~ loop.index %}
    {% set wrapper_classes = [] %}
    {% if level == 1 %}
      {% set wrapper_classes = wrapper_classes|merge(['border-b', 'border-gray-200']) %}
    {% endif %}
    <li class="{{ wrapper_classes|join(' ') }}">
      {% if has_children %}
        <button
          class="w-full flex items-center justify-between px-3 py-3 text-sm font-semibold"
          @click="mobileSection === '{{ item_key }}' ? mobileSection = null : mobileSection = '{{ item_key }}'"
          :aria-expanded="mobileSection === '{{ item_key }}'"
        >
          <span>{{ item.title }}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 transition-transform" :class="mobileSection === '{{ item_key }}' ? 'rotate-180' : ''">
            <path fill="currentColor" d="M6.3 8.3a1 1 0 0 1 1.4 0L12 12.6l4.3-4.3a1 1 0 1 1 1.4 1.4l-5 5a1 1 0 0 1-1.4 0l-5-5a1 1 0 0 1 0-1.4Z" />
          </svg>
        </button>
        {{ menus.render_fields(item.content, 'px-3 pb-2 text-sm text-slate-600') }}
        <div
          x-cloak
          x-show="mobileSection === '{{ item_key }}'"
          x-transition
          class="pb-3 px-3"
        >
          <ul class="grid grid-cols-1 gap-2">
            {{ menus.mobile_items(item.below, prefix, level + 1) }}
          </ul>
        </div>
      {% else %}
        {% if item.url %}
          {{ link(item.title, item.url, {'class': ['flex', 'items-center', 'gap-0', 'px-4', 'py-3', 'w-full', 'rounded-sm', 'text-md', 'leading-[1.2]', 'font-medium', 'transition',  'text-gray-900']}) }}
        {% else %}
          <span class="flex items-center gap-0 px-4 py-3 w-full rounded-md text-sm leading-[1.2] font-medium text-gray-900">{{ item.title }}</span>
        {% endif %}
        {{ menus.render_fields(item.content, 'px-4 pb-2 text-sm text-slate-600') }}
      {% endif %}
    </li>
  {% endfor %}
{% endmacro %}
