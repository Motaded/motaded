{#
  Template for the Basic page ("page" content type) full view.
  Inspired by reference/html-src/content-single.html layout.
#}
{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  'content-basic-page'
] %}

<article{{ attributes.addClass(classes).setAttribute('id', 'basic-page-top') }}>
  {% set basic = muin_basic_page|default({}) %}
  {% set breadcrumb_items = basic.breadcrumb|default([]) %}
  {% set lead = basic.lead ?? null %}
  {% set description = basic.description ?? null %}
  {% set quick_links = basic.quick_links ?? null %}
  {% set sections = basic.sections ?? null %}
  {% set body = basic.body ?? null %}
  {% set resources = basic.resources ?? null %}
  {% set cta = basic.cta ?? null %}
  {% set back_to_top = basic.back_to_top ?? 'Back to top'|t %}
  {% set additional_content = content|without('links') %}

  <main class="content-basic-page__main" role="presentation">
    {% if breadcrumb_items %}
      <div class="py-6 bg-gray-50">
        <nav class="text-sm text-gray-600 container-page" aria-label="{{ 'Breadcrumb'|t }}">
          <ol class="flex flex-wrap items-center gap-1">
            {% for item in breadcrumb_items %}
              <li>
                {% if item.url and not loop.last %}
                  <a href="{{ item.url }}" class="hover:underline">{{ item.text }}</a>
                {% else %}
                  <span class="{{ loop.last ? 'text-gray-900 font-medium' : '' }}">{{ item.text }}</span>
                {% endif %}
              </li>
              {% if not loop.last %}
                <li aria-hidden="true">/</li>
              {% endif %}
            {% endfor %}
          </ol>
        </nav>
      </div>
    {% endif %}

    <section class="mt-6 pb-8 bg-white">
      <div class="container-page">
        {{ title_prefix }}
        <h1 class="pt-8 font-bold content-main-title max-sm:text-3xl max-sm:leading-9">{{ label }}</h1>
        {{ title_suffix }}

        {% if lead %}
          <div class="mt-6 content-lead leading-7 font-semibold">{{ lead }}</div>
        {% endif %}

        {% if description %}
          <div class="mt-2 content-description leading-6">{{ description }}</div>
        {% endif %}

        {% if quick_links %}
          <div class="mt-4 flex flex-wrap gap-2 border-b border-gray-300 pb-2">
            {{ quick_links }}
          </div>
        {% endif %}
      </div>
    </section>

    <section class="py-8 prose prose-neutral max-w-none bg-white">
      <div class="container-page flex flex-col gap-8">
        {% if sections %}
          <div class="content-sections not-prose flex flex-col gap-8">
            {{ sections }}
          </div>
        {% elseif body %}
          <div class="content-body leading-6">
            {{ body }}
          </div>
        {% endif %}

        {% if resources %}
          <div class="content-resources not-prose">
            {{ resources }}
          </div>
        {% endif %}

        {% if cta %}
          <div class="content-cta not-prose">
            {{ cta }}
          </div>
        {% endif %}

        {% if additional_content %}
          <div class="content-additional not-prose">
            {{ additional_content }}
          </div>
        {% endif %}

        <div class="mt-10">
          <a
            href="#basic-page-top"
            class="inline-flex items-center gap-2 text-sm underline underline-offset-2 text-gray-700 hover:text-gray-900"
          >
            <span>{{ back_to_top }}</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  {% if content.links %}
    <div class="node__links">{{ content.links }}</div>
  {% endif %}
</article>
