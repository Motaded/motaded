{#
  Article teaser card used on the articles listing page.
#}
{% set classes = [
  'node',
  'node--type-' ~ node.bundle|clean_class,
  'node--view-mode-' ~ view_mode|clean_class,
  'articles-card',
  'group',
  'block',
  'h-full'
] %}

{% set image = null %}
{% for candidate in [
  'field_media_image',
  'field_image',
  'field_hero_image',
  'field_thumbnail',
  'field_featured_image'
] %}
  {% if image is null and attribute(content, candidate) is defined %}
    {% set image = attribute(content, candidate) %}
  {% endif %}
{% endfor %}

{% if image is iterable %}
  {% if image['#items'] is defined and image[0] is defined %}
    {% set image = image[0] %}
  {% endif %}
{% endif %}

{% if image is iterable %}
  {% set image_attributes = image['#attributes']|default({}) %}
  {% set image_classes = image_attributes.class|default([])|merge(['w-full', 'h-full', 'object-cover', 'articles-card-img']) %}
  {% set image_attributes = image_attributes|merge({'class': image_classes}) %}
  {% set image = image|merge({'#attributes': image_attributes}) %}
{% endif %}

{% set summary = null %}
{% for candidate in [
  'field_summary',
  'field_intro',
  'body'
] %}
  {% if summary is null and attribute(content, candidate) is defined %}
    {% set summary = attribute(content, candidate) %}
  {% endif %}
{% endfor %}

{% set date_field = null %}
{% for candidate in [
  'field_publication_date',
  'field_date',
  'field_published_on'
] %}
  {% if date_field is null and attribute(content, candidate) is defined %}
    {% set date_field = attribute(content, candidate) %}
  {% endif %}
{% endfor %}

{% set tag_labels = [] %}
{% if node.hasField('field_category') and not node.field_category.isEmpty() %}
  {% for item in node.field_category %}
    {% set tag_labels = tag_labels|merge([item.entity ? item.entity.label : item.value]) %}
  {% endfor %}
{% endif %}
{% if node.hasField('field_categories') and not node.field_categories.isEmpty() %}
  {% for item in node.field_categories %}
    {% set tag_labels = tag_labels|merge([item.entity ? item.entity.label : item.value]) %}
  {% endfor %}
{% endif %}
{% if node.hasField('field_tags') and not node.field_tags.isEmpty() %}
  {% for item in node.field_tags %}
    {% set tag_labels = tag_labels|merge([item.entity ? item.entity.label : item.value]) %}
  {% endfor %}
{% endif %}

{% set extra_content = content|without(
  'links',
  'field_media_image',
  'field_image',
  'field_hero_image',
  'field_thumbnail',
  'field_featured_image',
  'field_summary',
  'field_intro',
  'body',
  'field_publication_date',
  'field_date',
  'field_published_on',
  'field_category',
  'field_categories',
  'field_tags'
) %}

<article{{ attributes.addClass(classes) }}>
  <div class="bg-white rounded-xl border border-transparent hover:border-primary-600 shadow-sm transition h-full flex flex-col overflow-hidden">
    {% if image %}
      <div class="relative w-full articles-card-media overflow-hidden">
        {{ image }}
      </div>
    {% endif %}

    <div class="p-4 flex flex-col gap-3 flex-1">
      {% if tag_labels %}
        <div class="flex flex-wrap gap-2">
          {% for tag in tag_labels %}
            <span class="border px-2 py-0.5 rounded text-xs font-medium bg-gray-50 text-gray-700 border-gray-200">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}

      {{ title_prefix }}
      <h3 class="text-md font-semibold articles-card-title line-clamp-2">
        <a href="{{ url }}" rel="bookmark" class="text-gray-900 transition group-hover:text-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">{{ label }}</a>
      </h3>
      {{ title_suffix }}

      {% if summary %}
        <div class="text-sm text-gray-600 articles-card-excerpt line-clamp-3">{{ summary }}</div>
      {% endif %}

      {% if extra_content %}
        <div class="sr-only">{{ extra_content }}</div>
      {% endif %}

      <div class="mt-auto flex items-center justify-between pt-2">
        {% if date_field %}
          <div class="text-xs text-gray-500">{{ date_field }}</div>
        {% elseif date %}
          <div class="text-xs text-gray-500">{{ date }}</div>
        {% endif %}
        <a href="{{ url }}" rel="bookmark" class="text-sm font-medium text-primary-700 group-hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">{{ 'Read more'|t }}</a>
      </div>
    </div>
  </div>

  {% if content.links %}
    <div class="sr-only">{{ content.links }}</div>
  {% endif %}
</article>
