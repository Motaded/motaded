<footer class="site-footer" role="contentinfo">
  {{ attach_library("muin/footer") }}
  <div class="container-page">
    {% if promo_content %}
    <div class="site-footer__promo">
      {{ promo_content }}
    </div>
    {% endif %} {% if menu_columns %}
    <div class="site-footer__grid">
      {% for menu in menu_columns %}
      <div class="site-footer__column site-footer__column--{{ menu.modifier }}">
        {{ menu.content }}
      </div>
      {% endfor %}
    </div>
    {% endif %} {% if has_bottom %}
    <div class="site-footer__bottom">
      {% if legal_content %}
      <div class="site-footer__legal">
        {{ legal_content }}
      </div>
      {% endif %} {% if action_items %}
      <div class="site-footer__actions">
        {% for item in action_items %}
        <div class="site-footer__{{ item.modifier }}">
          {{ item.content }}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %} {% if default_content %}
    <div class="site-footer__additional">
      {{ default_content }}
    </div>
    {% endif %}
  </div>
</footer>
{% endif %}
