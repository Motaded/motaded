{#
  @file
  Theme override for the footer menu block in the Muin theme.
#}
{% set heading_id = attributes.id ~ '-menu'|clean_id %}
<nav role="navigation" aria-labelledby="{{ heading_id }}"{{ attributes|without('role', 'aria-labelledby') }}>
  <div class="text-white">
    {% set label_classes = ['text-md', 'font-semibold', 'block', 'mb-3', 'leading-[1.6]'] %}
    {% if not configuration.label_display %}
      {% set title_attributes = title_attributes.addClass('visually-hidden') %}
      {% set label_classes = [] %}
    {% endif %}
    {% set title_attributes = title_attributes.addClass(label_classes) %}

    {{ title_prefix }}
    {% if configuration.label %}
      <p{{ title_attributes.setAttribute('id', heading_id) }}>{{ configuration.label }}</p>
    {% endif %}
    {{ title_suffix }}

    <div class="w-full bg-white/30 my-3 h-px" aria-hidden="true"></div>

    <div class="flex flex-col">
      {{ content }}
    </div>
  </div>
</nav>
