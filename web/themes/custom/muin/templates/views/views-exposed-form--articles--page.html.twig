{#
  Custom exposed filters for the articles view page display.
  Provides a layout that mirrors reference/html-src/articles-page.html.
#}
{% set attributes = attributes.addClass('articles-filter-form', 'flex', 'flex-col', 'gap-4') %}
{% set hidden_keys = ['form_build_id', 'form_token', 'form_id'] %}
{% set search_rendered = false %}
{% set align_shift_applied = false %}

<form{{ attributes }}>
  {% if q is not empty %}
    {{ q }}
  {% endif %}

  <div class="flex flex-wrap items-center gap-3">
    {% for key, element in form %}
      {% if key starts with '#' %}
        {# Skip metadata. #}
      {% elseif key in hidden_keys %}
        {# Hidden elements are rendered after the visible controls. #}
      {% elseif key == 'actions' %}
        {# Render actions after the loop to keep them aligned to the end. #}
      {% else %}
        {% set element_type = attribute(element, '#type')|default('') %}
        {% set wrapper_classes = ['articles-filter-item'] %}
        {% set element_attributes = element['#attributes']|default({}) %}
        {% set element_classes = element_attributes.class|default([]) %}
        {% set title_attributes = element['#title_attributes']|default({}) %}
        {% set title_classes = title_attributes.class|default([]) %}

        {% if not search_rendered and element_type in ['search', 'textfield'] %}
          {% set wrapper_classes = wrapper_classes|merge([
            'relative',
            'w-full',
            'min-w-[240px]',
            'md:max-w-[420px]',
            'lg:max-w-[480px]',
            'articles-search-field'
          ]) %}
          {% set element_classes = element_classes|merge(['w-full', 'rounded-md', 'border', 'border-gray-300', 'bg-white', 'px-4', 'py-2', 'text-sm', 'focus:outline-none', 'focus:border-gray-900']) %}
          {% set title_classes = title_classes|merge(['text-sm', 'font-medium', 'text-gray-700']) %}
          {% set search_rendered = true %}
        {% else %}
          {% set wrapper_classes = wrapper_classes|merge(['flex', 'items-center', 'gap-2', 'text-sm']) %}
          {% set element_classes = element_classes|merge(['rounded-md', 'border', 'border-gray-300', 'bg-white', 'px-2.5', 'py-1.5', 'text-sm', 'focus:outline-none', 'focus:border-gray-900']) %}
          {% set title_classes = title_classes|merge(['text-sm', 'font-medium', 'text-gray-700']) %}
          {% if not align_shift_applied and key in ['sort_by', 'sort_order'] %}
            {% set wrapper_classes = wrapper_classes|merge(['md:ml-auto']) %}
            {% set align_shift_applied = true %}
          {% endif %}
        {% endif %}

        {% set element_attributes = element_attributes|merge({'class': element_classes}) %}
        {% set title_attributes = title_attributes|merge({'class': title_classes}) %}
        {% set element = element|merge({
          '#attributes': element_attributes,
          '#title_attributes': title_attributes,
        }) %}
        <div class="{{ wrapper_classes|join(' ') }}">{{ element }}</div>
      {% endif %}
    {% endfor %}

    {% if form.actions is defined %}
      {% set actions = form.actions %}
      {% set actions_attributes = actions['#attributes']|default({}) %}
      {% set actions_classes = actions_attributes.class|default([])|merge(['flex', 'items-center', 'gap-3']) %}
      {% set actions_attributes = actions_attributes|merge({'class': actions_classes}) %}

      {% if actions.submit is defined %}
        {% set submit = actions.submit %}
        {% set submit_attributes = submit['#attributes']|default({}) %}
        {% set submit_classes = submit_attributes.class|default([])|merge([
          'inline-flex',
          'items-center',
          'justify-center',
          'rounded-md',
          'bg-primary-600',
          'px-4',
          'py-2',
          'text-sm',
          'font-semibold',
          'text-white',
          'shadow-sm',
          'transition',
          'hover:bg-primary-700',
          'focus-visible:outline',
          'focus-visible:outline-2',
          'focus-visible:outline-offset-2',
          'focus-visible:outline-primary-600'
        ]) %}
        {% set submit_attributes = submit_attributes|merge({'class': submit_classes}) %}
        {% set submit = submit|merge({'#attributes': submit_attributes}) %}
        {% set actions = actions|merge({'submit': submit}) %}
      {% endif %}

      {% set actions = actions|merge({'#attributes': actions_attributes}) %}
      {% set clear_label = 'Clear'|t %}
      <div class="articles-filter-actions ml-auto flex items-center gap-3">
        <button
          type="button"
          class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm text-gray-700 transition hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-300"
          data-articles-filter-clear
        >
          {{ clear_label }}
        </button>
        {{ actions }}
      </div>
    {% endif %}
  </div>

  {% for key in hidden_keys %}
    {% if attribute(form, key) is defined %}
      {{ attribute(form, key) }}
    {% endif %}
  {% endfor %}
</form>
