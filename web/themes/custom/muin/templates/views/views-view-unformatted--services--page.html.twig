{#
  Grid layout for the services view page display.
#}
{% if title %}
  <h2 class="sr-only">{{ title }}</h2>
{% endif %}
<div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3 lg:gap-6" role="list">
  {% for row in rows %}
    {% set row_classes = [
      default_row_class ? 'views-row',
      'h-full'
    ] %}
    <div{{ row.attributes.addClass(row_classes) }} role="listitem">
      {{- row.content -}}
    </div>
  {% endfor %}
</div>
