{# Muin: page template #}
{% import '@muin/includes/header-menu.html.twig' as header_menu %}
{% set topbar = topbar_settings|default({}) %}

<div
  x-data="topbar()"
  x-init="loadData()"
  class="bg-gray-100 py-2 w-full border-b border-blueGray-200 transition-all duration-300"
>
  {{ attach_library('muin/topbar') }}
  <div class="container-page">
    <div class="flex justify-between items-center gap-3 flex-wrap">
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <img
            src="{{ base_path ~ directory }}/img/icon-calender.svg"
            alt="{{ topbar.calendarAlt|default('Calendar icon'|t) }}"
            x-bind:alt="calendarAlt"
            class="h-5 w-5"
          />
          <p
            class="text-sm font-normal text-gray-900 max-sm:!text-xs leading-[1.6]"
            x-text="date"
          >
            {{ topbar.date|default('') }}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3 flex-wrap">
        <div
          class="tooltip"
          data-tip="{{ topbar.increaseFontTip|default('Increase font size'|t) }}"
          x-bind:data-tip="increaseFontTip"
        >
          <button
            type="button"
            class="btn btn-ghost btn-xs rounded-full text-primary"
            aria-label="{{ topbar.increaseFontLabel|default('Increase font size'|t) }}"
            x-bind:aria-label="increaseFontLabel"
            @click="increaseFont()"
          >
            <img
              src="{{ base_path ~ directory }}/img/icon-increase.svg"
              alt="{{ topbar.increaseFontLabel|default('Increase font size'|t) }}"
              x-bind:alt="increaseFontLabel"
            />
          </button>
        </div>

        <div
          class="tooltip"
          data-tip="{{ topbar.decreaseFontTip|default('Decrease font size'|t) }}"
          x-bind:data-tip="decreaseFontTip"
        >
          <button
            type="button"
            class="btn btn-ghost btn-xs rounded-full text-primary"
            aria-label="{{ topbar.decreaseFontLabel|default('Decrease font size'|t) }}"
            x-bind:aria-label="decreaseFontLabel"
            @click="decreaseFont()"
          >
            <img
              src="{{ base_path ~ directory }}/img/icon-decrease.svg"
              alt="{{ topbar.decreaseFontLabel|default('Decrease font size'|t) }}"
              x-bind:alt="decreaseFontLabel"
            />
          </button>
        </div>

        <div
          class="tooltip"
          data-tip="{{ topbar.invertColorsTip|default('Invert colors'|t) }}"
          x-bind:data-tip="invertColorsTip"
        >
          <button
            type="button"
            class="btn btn-ghost btn-xs rounded-full text-primary"
            aria-label="{{ topbar.invertColorsLabel|default('Invert colors'|t) }}"
            x-bind:aria-label="invertColorsLabel"
            @click="toggleInvert()"
          >
            <img
              src="{{ base_path ~ directory }}/img/icon-dark-mode.svg"
              alt="{{ topbar.invertColorsLabel|default('Invert colors'|t) }}"
              x-bind:alt="invertColorsLabel"
            />
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<header
  x-data="{ openMenu: null, mobileOpen: false, mobileSection: null }"
  class="sticky top-0 z-[201] h-[91px] bg-white border-b border-gray-200"
  role="banner"
  @keydown.escape.window="openMenu=null; mobileOpen=false; mobileSection=null"
>
  {{ attach_library('muin/header') }}

  {% set header_branding = null %}
  {% set header_utilities = [] %}
  {% set header_prefix = page.header['#prefix']|default('') %}
  {% set header_suffix = page.header['#suffix']|default('') %}

  {% set search_prefix = path('<front>') %}
  {% set search_url = search_prefix ~ (search_prefix ends with '/' ? '' : '/') ~ 'search' %}

  {% if page.header %}
    {% for key, item in page.header %}
      {% if key|first != '#' %}
        {% if header_branding is null %}
          {% set header_branding = item %}
        {% else %}
          {% set header_utilities = header_utilities|merge([item]) %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {% set primary_menu_items = page.primary_menu['#items']|default([]) %}
  {% set primary_menu_attributes = page.primary_menu['#attributes']|default(create_attribute()) %}
  {% set has_primary_menu = primary_menu_items|length > 0 %}

  {% if page.primary_menu %}{% set _ = page.primary_menu|render %}{% endif %}

  {% if header_prefix %}{{ header_prefix }}{% endif %}

  <div class="container-page hidden md:block h-full">
    <div class="flex items-center h-full py-1 gap-3">
      {% if header_branding %}
        <div class="flex items-center h-full">
          {{ header_branding }}
        </div>
      {% endif %}

      {% if has_primary_menu %}
        {% set desktop_attributes = primary_menu_attributes.addClass('flex', 'items-center', 'justify-center', 'gap-2', 'pt-2', 'pb-2', 'h-full', 'list-none', 'm-0', 'p-0') %}
        <nav class="hidden lg:block h-full" aria-label="{{ 'Main navigation'|t }}">
          <ul{{ desktop_attributes }}>
            {{ header_menu.desktop_items(primary_menu_items, 'desktop', 1) }}
          </ul>
        </nav>
      {% endif %}

      <div class="block w-full items-center gap-2">
        <div class="header-utilities flex items-center gap-2 lg:gap-4 max-xl:text-sm">
          {% set has_header_utilities = header_utilities|length > 0 %}
          {% if has_header_utilities %}
            {% for utility in header_utilities %}
              {% if loop.first %}
              <div class="header-utilities__item flex items-center mr-auto">{{ utility }}</div>
              {% endif %}

                {% if not loop.first %}
                  <div class="header-utilities__item flex items-center">{{ utility }}</div>
                  {% endif %}
            {% endfor %}
          {% endif %}

          {% set search_item_classes = ['header-utilities__item', 'flex', 'items-center', 'search-block-btn'] %}
          {% if not has_header_utilities %}
            {% set search_item_classes = search_item_classes|merge(['ml-auto']) %}
          {% endif %}
          <div class="{{ search_item_classes|join(' ') }}">
            <a
              href="{{ search_url }}"
              class="inline-flex items-center justify-center font-medium transition rounded-md text-gray-900 text-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800"
              aria-label="{{ 'Search'|t }}"
            >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M11 1.25C5.61522 1.25 1.25 5.61522 1.25 11C1.25 16.3848 5.61522 20.75 11 20.75C13.4224 20.75 15.6385 19.8666 17.3437 18.4043L21.4697 22.5303C21.7626 22.8232 22.2374 22.8232 22.5303 22.5303C22.8232 22.2374 22.8232 21.7626 22.5303 21.4697L18.4043 17.3437C19.8666 15.6385 20.75 13.4224 20.75 11C20.75 5.61522 16.3848 1.25 11 1.25ZM2.75 11C2.75 6.44365 6.44365 2.75 11 2.75C15.5563 2.75 19.25 6.44365 19.25 11C19.25 15.5563 15.5563 19.25 11 19.25C6.44365 19.25 2.75 15.5563 2.75 11Z" fill="#161616"/>
              </svg>
              
              <span class="text-md font-medium leading-[1.6] hidden xl:block mx-2">{{ 'Search'|t }}</span>
            </a>
          </div>
        </div>

        <div class="lg:hidden">
          <button
            type="button"
            class="w-12 h-12 grid place-items-center rounded-md hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800"
            aria-label="{{ 'Open menu'|t }}"
            @click="mobileOpen = true; mobileSection = null"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 text-gray-900">
              <path fill="currentColor" d="M4 7a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H5A1 1 0 0 1 4 7Zm0 5a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1Zm1 4a1 1 0 1 0 0 2h14a1 1 0 1 0 0-2H5Z" />
            </svg>
            <span class="sr-only">{{ 'Open menu'|t }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="block py-5 md:py-0">
    <div class="container-page relative flex items-center justify-between py-2 md:hidden">
      <div class="flex items-center gap-2">
        {% for utility in header_utilities %}
          <div class="header-utilities__item flex items-center">{{ utility }}</div>
        {% endfor %}

        <a
          href="{{ search_url }}"
          class="w-12 h-12 grid place-items-center rounded-md hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800"
          aria-label="{{ 'Search'|t }}"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 text-gray-900">
            <path
              d="M21 21l-4.35-4.35"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            />
            <path
              d="M10.5 18a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15Z"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
            />
          </svg>
          <span class="sr-only">{{ 'Search'|t }}</span>
        </a>
      </div>

      {% if header_branding %}
        <div class="absolute left-1/2 -translate-x-1/2">
          {{ header_branding }}
        </div>
      {% endif %}

      <div class="flex items-center gap-2">
        <button
          type="button"
          class="w-12 h-12 grid place-items-center rounded-md hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800"
          aria-label="{{ 'Open menu'|t }}"
          @click="mobileOpen = true; mobileSection = null"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6 text-gray-900">
            <path fill="currentColor" d="M4 7a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H5A1 1 0 0 1 4 7Zm0 5a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H5a1 1 0 0 1-1-1Zm1 4a1 1 0 1 0 0 2h14a1 1 0 1 0 0-2H5Z" />
          </svg>
          <span class="sr-only">{{ 'Open menu'|t }}</span>
        </button>
      </div>
    </div>

    <div
      x-cloak
      x-show="mobileOpen"
      x-transition.opacity
      class="fixed inset-0 z-[202] bg-black/40 md:hidden"
      @click="mobileOpen=false"
    ></div>

    <aside
      x-cloak
      x-show="mobileOpen"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="-translate-x-full opacity-0"
      x-transition:enter-end="translate-x-0 opacity-100"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="translate-x-0 opacity-100"
      x-transition:leave-end="-translate-x-full opacity-0"
      class="fixed inset-y-0 left-0 z-[203] w-[88%] max-w-[360px] bg-white shadow-xl flex flex-col md:hidden"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'Mobile menu'|t }}"
      @click.stop
    >
      <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200">
        {% if header_branding %}
          <div class="inline-flex items-center gap-2">
            {{ header_branding }}
          </div>
        {% endif %}
        <button
          type="button"
          class="size-10 grid place-items-center rounded-md hover:bg-gray-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800"
          aria-label="{{ 'Close menu'|t }}"
          @click="mobileOpen=false; mobileSection=null"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 text-gray-900">
            <path fill="currentColor" d="m12 10.586 4.95-4.95a1 1 0 1 1 1.414 1.414L13.414 12l4.95 4.95a1 1 0 0 1-1.414 1.414L12 13.414l-4.95 4.95a1 1 0 1 1-1.414-1.414L10.586 12 5.636 7.05A1 1 0 0 1 7.05 5.636L12 10.586Z" />
          </svg>
          <span class="sr-only">{{ 'Close menu'|t }}</span>
        </button>
      </div>

      <div class="px-2 py-2 overflow-y-auto flex-1">
        {% if has_primary_menu %}
          <nav class="flex flex-col">
            <ul class="grid grid-cols-1 gap-2 list-none m-0 p-0" role="list">
              {{ header_menu.mobile_items(primary_menu_items, 'mobile', 1) }}
            </ul>
          </nav>
        {% endif %}
      </div>

      <div class="mt-auto px-4 py-3 border-t border-gray-200">
        <div class="flex flex-col gap-2">
          {% for utility in header_utilities %}
            <div class="header-utilities__item flex items-center gap-2 justify-between">{{ utility }}</div>
          {% endfor %}

          <a
            href="{{ search_url }}"
            class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-md border border-gray-200 text-sm font-semibold text-gray-900 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-800"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 text-gray-900">
              <path
                d="M21 21l-4.35-4.35"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              />
              <path
                d="M10.5 18a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15Z"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
              />
            </svg>
            <span>{{ 'Search'|t }}</span>
          </a>
        </div>
      </div>
    </aside>
  </div>

  {% if header_suffix %}{{ header_suffix }}{% endif %}
</header>

{% if page.hero %}
  <section class="hero">
    {{ page.hero }}
  </section>
{% endif %}

<main role="main" class="layout">
  <div class="content">
    {{ page.content }}
  </div>

  {% if page.sidebar %}
    <aside class="sidebar">
      {{ page.sidebar }}
    </aside>
  {% endif %}
</main>

{% include '@muin/footer/footer.html.twig' with {
  footer_promo: page.footer_promo|default([]),
  footer_branding: page.footer_branding|default([]),
  footer_primary: page.footer_primary|default([]),
  footer_secondary: page.footer_secondary|default([]),
  footer_tertiary: page.footer_tertiary|default([]),
  footer_quaternary: page.footer_quaternary|default([]),
  footer_social: page.footer_social|default([]),
  footer_legal: page.footer_legal|default([]),
  footer_default: page.footer|default([])
} only %}
