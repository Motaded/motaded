<?php

use Drupal\block\Entity\Block;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Cache\Cache;
use Drupal\Core\Entity\ContentEntityInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\TranslatableInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\node\NodeInterface;
use Drupal\webform\Entity\WebformOptions;

/**
 * Webform wizard page key: nationality + appointment + first consent.
 */
const MOTADED_CUSTOM_TASHEER_WIZARD_APPLICATION_PAGE = 'application';

/**
 * Webform wizard page key: visa chain (after Terms) + application type + email.
 */
const MOTADED_CUSTOM_TASHEER_WIZARD_VISA_CHAIN_PAGE = 'visa_followup';

/**
 * Implements hook_theme().
 */
function motaded_custom_theme() {
  return [
    'banner_block' => [
      'variables' => [
        'content' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_module_implements_alter().
 *
 * Ensure our page_attachments_alter runs last (after schema_metatag).
 */
function motaded_custom_module_implements_alter(array &$implementations, $hook) {
  if ($hook === 'page_attachments_alter' && isset($implementations['motaded_custom'])) {
    $group = $implementations['motaded_custom'];
    unset($implementations['motaded_custom']);
    $implementations['motaded_custom'] = $group;
  }
}

/**
 * Implements hook_page_attachments()
 */
function motaded_custom_page_attachments(array &$attachments) {
  // Check if we are on node edit form.
  if (in_array(\Drupal::routeMatch()->getRouteName(), ['entity.node.edit_form', 'node.add'])) {
    $attachments['#attached']['library'][] = 'motaded_custom/gin-custom';
  }

  // Frontend + Toolbar + Gin Toolbar: secondary meta row must clear the fixed toolbar.
  if (!\Drupal::service('router.admin_context')->isAdminRoute()
    && \Drupal::moduleHandler()->moduleExists('toolbar')
    && \Drupal::currentUser()->hasPermission('access toolbar')) {
    $attachments['#attached']['library'][] = 'motaded_custom/toolbar_frontend_stack_fix';
  }
}

/**
 * Whether the current page needs CKEditor accordion frontend (dl.ckeditor-accordion markup).
 */
function _motaded_custom_page_needs_ckeditor_accordion_frontend(): bool {
  $node = \Drupal::routeMatch()->getParameter('node');
  if (!$node instanceof NodeInterface) {
    return FALSE;
  }
  return _motaded_custom_entity_contains_ckeditor_accordion_markup($node);
}

/**
 * Recursively scans text fields and paragraph references for accordion HTML.
 */
function _motaded_custom_entity_contains_ckeditor_accordion_markup(ContentEntityInterface $entity, array &$visited = [], int $depth = 0): bool {
  if ($depth > 12) {
    return FALSE;
  }
  $vid = $entity->getEntityTypeId() . ':' . ($entity->id() ?? 'new');
  if (isset($visited[$vid])) {
    return FALSE;
  }
  $visited[$vid] = TRUE;

  foreach ($entity->getFields() as $field) {
    if ($field->isEmpty()) {
      continue;
    }
    $definition = $field->getFieldDefinition();
    $type = $definition->getType();

    if (in_array($type, ['text_long', 'text_with_summary', 'string_long', 'string', 'text'], TRUE)) {
      foreach ($field as $item) {
        $value = $item->value ?? '';
        if (is_string($value) && strpos($value, 'ckeditor-accordion') !== FALSE) {
          return TRUE;
        }
        if (!empty($item->processed) && is_string($item->processed) && strpos($item->processed, 'ckeditor-accordion') !== FALSE) {
          return TRUE;
        }
      }
    }
    elseif (in_array($type, ['entity_reference_revisions', 'entity_reference'], TRUE)) {
      foreach ($field->referencedEntities() as $ref) {
        if ($ref instanceof ContentEntityInterface) {
          if (_motaded_custom_entity_contains_ckeditor_accordion_markup($ref, $visited, $depth + 1)) {
            return TRUE;
          }
        }
      }
    }
  }

  return FALSE;
}

/**
 * Implements hook_page_attachments_alter().
 *
 * - Ensures FAQ Answer text is always a string (schema_metatag may explode on comma).
 * - Adds BreadcrumbList schema site-wide (except admin).
 * Runs after schema_metatag to fix/extend the final JSON-LD output.
 */
function motaded_custom_page_attachments_alter(array &$attachments) {
  // Skip admin pages.
  if (\Drupal::service('router.admin_context')->isAdminRoute()) {
    return;
  }

  // CKEditor accordion: attach frontend only when content contains accordion markup.
  $libs = &$attachments['#attached']['library'];
  if (is_array($libs)) {
    $libs = array_values(array_filter($libs, function ($lib) {
      return $lib !== 'ckeditor_accordion/accordion.frontend';
    }));
  }
  if (_motaded_custom_page_needs_ckeditor_accordion_frontend()) {
    $attachments['#attached']['library'][] = 'ckeditor_accordion/accordion.frontend';
  }
  else {
    unset($attachments['#attached']['drupalSettings']['ckeditorAccordion']);
  }

  $breadcrumb_list = _motaded_custom_build_breadcrumb_list_schema();
  $html_head = &$attachments['#attached']['html_head'] ?? NULL;

  // Ensure html_head exists for BreadcrumbList when no schema yet.
  if ($html_head === NULL) {
    $attachments['#attached']['html_head'] = [];
    $html_head = &$attachments['#attached']['html_head'];
  }

  $breadcrumb_added = FALSE;
  foreach ($html_head as $id => &$attachment) {
    $element = is_array($attachment) && isset($attachment[0]) ? $attachment[0] : $attachment;
    $value = $element['#value'] ?? NULL;
    if (empty($value) || !is_string($value)) {
      continue;
    }
    $data = json_decode($value, TRUE);
    if (!$data || empty($data['@graph'])) {
      continue;
    }
    $changed = FALSE;

    // Fix FAQ Answer text (array -> string).
    foreach ($data['@graph'] as &$item) {
      if (($item['@type'] ?? '') === 'FAQPage' && !empty($item['mainEntity'])) {
        foreach ($item['mainEntity'] as &$question) {
          if (!empty($question['acceptedAnswer']['text']) && is_array($question['acceptedAnswer']['text'])) {
            $question['acceptedAnswer']['text'] = implode(', ', $question['acceptedAnswer']['text']);
            $changed = TRUE;
          }
        }
      }
    }

    // Add BreadcrumbList to existing @graph.
    if (!empty($breadcrumb_list)) {
      $data['@graph'][] = $breadcrumb_list;
      $breadcrumb_added = TRUE;
      $changed = TRUE;
    }

    if ($changed) {
      $encoded = json_encode($data, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
      if (isset($attachment[0])) {
        $attachment[0]['#value'] = $encoded;
      }
      else {
        $attachment['#value'] = $encoded;
      }
    }
  }

  // If no @graph script exists (e.g. taxonomy, search), add standalone BreadcrumbList.
  if (!empty($breadcrumb_list) && !$breadcrumb_added) {
    $data = [
      '@context' => 'https://schema.org',
      '@graph' => [$breadcrumb_list],
    ];
    $attachments['#attached']['html_head'][] = [
      [
        '#type' => 'html_tag',
        '#tag' => 'script',
        '#value' => json_encode($data, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR),
        '#attributes' => ['type' => 'application/ld+json'],
      ],
      'motaded_custom_breadcrumb_list',
    ];
  }

  // Append current query string to canonical and hreflang links when URL has params
  // (e.g. /fr/blog?page=0, /ar/contact-us?package=basic&plan=annual).
  _motaded_custom_ensure_x_default_hreflang($html_head);
  _motaded_custom_fix_canonical_and_hreflang_query_string($html_head);
}

/**
 * Ensures x-default hreflang exists and points to English alternate URL.
 */
function _motaded_custom_ensure_x_default_hreflang(array &$html_head): void {
  $x_default_attachment_index = NULL;
  $english_href = '';
  $fallback_href = '';
  $canonical_href = '';

  foreach ($html_head as $id => $attachment) {
    $element = is_array($attachment) && isset($attachment[0]) ? $attachment[0] : $attachment;
    if (!is_array($element) || ($element['#tag'] ?? '') !== 'link') {
      continue;
    }

    $attrs = $element['#attributes'] ?? [];
    $rel = strtolower((string) ($attrs['rel'] ?? ''));
    $hreflang = strtolower((string) ($attrs['hreflang'] ?? ''));
    $href = (string) ($attrs['href'] ?? '');
    if ($rel !== 'alternate' || $hreflang === '' || $href === '') {
      if ($rel === 'canonical' && $href !== '') {
        $canonical_href = $href;
      }
      continue;
    }

    if ($hreflang === 'x-default') {
      $x_default_attachment_index = $id;
      continue;
    }

    if ($fallback_href === '') {
      $fallback_href = $href;
    }
    if ($english_href === '' && in_array($hreflang, ['en', 'en-us', 'en-gb'], TRUE)) {
      $english_href = $href;
    }
  }

  if ($english_href === '') {
    $request = \Drupal::request();
    $internal_path = \Drupal::service('path.current')->getPath();
    // Front page may resolve as /front internally; keep canonical homepage URL.
    if ($internal_path === '/front') {
      $english_alias = '/';
    }
    else {
      $english_alias = \Drupal::service('path_alias.manager')->getAliasByPath($internal_path, 'en');
    }
    $english_href = $request->getSchemeAndHttpHost() . $english_alias;
  }

  $href = $english_href !== '' ? $english_href : ($fallback_href !== '' ? $fallback_href : $canonical_href);
  if ($href === '') {
    $request = \Drupal::request();
    $href = $request->getSchemeAndHttpHost() . $request->getPathInfo();
  }
  $href = _motaded_custom_normalize_front_href($href);
  if ($href === '') {
    return;
  }

  if ($x_default_attachment_index !== NULL) {
    if (isset($html_head[$x_default_attachment_index][0]['#attributes'])) {
      $html_head[$x_default_attachment_index][0]['#attributes']['href'] = $href;
    }
    elseif (isset($html_head[$x_default_attachment_index]['#attributes'])) {
      $html_head[$x_default_attachment_index]['#attributes']['href'] = $href;
    }
    return;
  }

  $html_head[] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'link',
      '#attributes' => [
        'rel' => 'alternate',
        'hreflang' => 'x-default',
        'href' => $href,
      ],
    ],
    'motaded_custom_hreflang_x_default',
  ];
}

/**
 * Normalizes front-page alias in absolute URLs from /front to /.
 */
function _motaded_custom_normalize_front_href(string $href): string {
  if ($href === '' || !str_contains($href, '/front')) {
    return $href;
  }

  $parts = parse_url($href);
  if ($parts === FALSE || empty($parts['scheme']) || empty($parts['host'])) {
    return $href;
  }

  $path = $parts['path'] ?? '';
  if ($path !== '/front') {
    return $href;
  }

  $normalized = $parts['scheme'] . '://' . $parts['host'];
  if (isset($parts['port'])) {
    $normalized .= ':' . $parts['port'];
  }
  $normalized .= '/';
  if (!empty($parts['query'])) {
    $normalized .= '?' . $parts['query'];
  }
  if (!empty($parts['fragment'])) {
    $normalized .= '#' . $parts['fragment'];
  }

  return $normalized;
}

/**
 * Appends the current request's query string to canonical and hreflang links.
 *
 * When a page has query params (e.g. ?page=0, ?package=basic&plan=annual), both
 * canonical and each hreflang href must include them for correct SEO signals.
 */
function _motaded_custom_fix_canonical_and_hreflang_query_string(array &$html_head): void {
  $query_string = \Drupal::request()->getQueryString();
  if ($query_string === NULL || $query_string === '') {
    return;
  }
  $suffix = '?' . $query_string;

  foreach ($html_head as $id => &$attachment) {
    $element = is_array($attachment) && isset($attachment[0]) ? $attachment[0] : $attachment;
    if (!is_array($element) || ($element['#tag'] ?? '') !== 'link') {
      continue;
    }
    $attrs = $element['#attributes'] ?? [];
    $rel = $attrs['rel'] ?? '';
    $is_canonical = $rel === 'canonical';
    $is_hreflang = $rel === 'alternate' && !empty($attrs['hreflang']);
    if (!$is_canonical && !$is_hreflang) {
      continue;
    }
    $href = $attrs['href'] ?? '';
    if ($href === '') {
      continue;
    }
    if (str_contains($href, '?')) {
      $href = strstr($href, '?', TRUE) . $suffix;
    }
    else {
      $href .= $suffix;
    }
    if (isset($attachment[0])) {
      $attachment[0]['#attributes']['href'] = $href;
    }
    else {
      $attachment['#attributes']['href'] = $href;
    }
  }
}

/**
 * Builds BreadcrumbList schema from Drupal breadcrumb.
 *
 * @return array|null
 *   BreadcrumbList structure for @graph, or NULL if empty.
 */
function _motaded_custom_build_breadcrumb_list_schema() {
  try {
    $breadcrumb = \Drupal::service('breadcrumb')->build(\Drupal::routeMatch());
    $links = $breadcrumb->getLinks();
  }
  catch (\Throwable $e) {
    return NULL;
  }
  if (empty($links)) {
    return NULL;
  }
  $item_list = [];
  $position = 1;
  foreach ($links as $link) {
    $url = $link->getUrl();
    $url->setAbsolute(TRUE);
    $url_string = $url->toString();
    $text = $link->getText();
    if (is_object($text) && method_exists($text, '__toString')) {
      $text = (string) $text;
    }
    $item_list[] = [
      '@type' => 'ListItem',
      'position' => $position,
      'name' => $text,
      'item' => $url_string,
    ];
    $position++;
  }
  if (empty($item_list)) {
    return NULL;
  }
  return [
    '@type' => 'BreadcrumbList',
    'itemListElement' => $item_list,
  ];
}

/**
 * Extracts FAQ items (Question/Answer) from field_keywords (CKEditor accordion).
 *
 * @param \Drupal\node\NodeInterface $node
 *   The node to extract from.
 *
 * @return array
 *   Array of Question schema items for FAQPage mainEntity.
 */
function _motaded_custom_extract_faq_from_node(NodeInterface $node) {
  if (!$node->hasField('field_keywords') || $node->get('field_keywords')->isEmpty()) {
    return [];
  }
  return _motaded_custom_extract_faq_from_ckeditor_accordion($node->get('field_keywords')->value);
}

/**
 * Extracts FAQ from CKEditor accordion HTML (dl.dt.dd structure).
 *
 * @param string $html
 *   HTML containing <dl class="ckeditor-accordion"><dt>Q</dt><dd>A</dd></dl>.
 *
 * @return array
 *   Array of Question schema items.
 */
function _motaded_custom_extract_faq_from_ckeditor_accordion($html) {
  $items = [];
  if (empty($html) || (strpos($html, 'ckeditor-accordion') === FALSE && strpos($html, '<dt>') === FALSE)) {
    return $items;
  }
  $dom = new \DOMDocument();
  @$dom->loadHTML('<?xml encoding="UTF-8">' . $html);
  $dts = $dom->getElementsByTagName('dt');
  foreach ($dts as $dt) {
    $question = trim(strip_tags($dt->textContent ?? ''));
    $answer = '';
    if ($dt instanceof \DOMElement && $dt->nextElementSibling !== NULL && $dt->nextElementSibling->nodeName === 'dd') {
      $answer = trim(strip_tags($dt->nextElementSibling->textContent ?? ''));
    }
    if ($question !== '' && $answer !== '') {
      $items[] = [
        '@type' => 'Question',
        'name' => $question,
        'acceptedAnswer' => [
          '@type' => 'Answer',
          'text' => $answer,
        ],
      ];
    }
  }
  return $items;
}

/**
 * Implements hook_block_access().
 */
function motaded_custom_block_access(Block $block, $operation, AccountInterface $account) {
  if ($operation === 'view' && $block->getPluginId() === 'page_title_block') {
    $route_name = \Drupal::routeMatch()->getRouteName();
    $node = \Drupal::routeMatch()->getParameter('node');

    if ($route_name === 'entity.node.canonical' && $node instanceof NodeInterface) {
      // Article and news full pages render their own <h1> inside the node template.
      if (in_array($node->bundle(), ['article', 'news'], TRUE)) {
        return AccessResult::forbidden()
          ->addCacheableDependency($block)
          ->addCacheableDependency($node);
      }

      // Basic pages: <h1> is rendered in node--page--full (service hero or centered basic layout).
      if ($node->bundle() === 'page') {
        return AccessResult::forbidden()
          ->addCacheableDependency($block)
          ->addCacheableDependency($node);
      }
    }
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_entity_access().
 */
function motaded_custom_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($entity->getEntityTypeId() == 'paragraph') {
    if ($operation == 'view') {
      // Get the current language.
      $current_language = \Drupal::languageManager()->getCurrentLanguage()->getId();

      // Check if the paragraph has a translation in the current language.
      if ($entity->hasTranslation($current_language)) {
        // Get the translation.
        $translation = $entity->getTranslation($current_language);

        // Check if the translation is not published.
        if (!$translation->isPublished()) {
          return AccessResult::forbidden();
        }
      }
    }
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_preprocess_menu().
 *
 * Replaces menu links to nodes that lack translation in the current language
 * with the default-language URL. Prevents crawlers (e.g. Screaming Frog) from
 * seeing /lang/node/ID internal paths for untranslated content.
 */
function motaded_custom_preprocess_menu(array &$variables): void {
  if (empty($variables['items'])) {
    return;
  }
  try {
    _motaded_custom_menu_items_fallback_to_default_language($variables['items']);
  }
  catch (\Throwable $e) {
    // On any error, skip modification to avoid breaking the menu display.
    \Drupal::logger('motaded_custom')->warning('Menu URL fallback failed: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Recursively replaces node URLs with default-language alias when no translation.
 *
 * @param array $items
 *   Menu items (reference); each has 'url', 'below' keys.
 */
function _motaded_custom_menu_items_fallback_to_default_language(array &$items): void {
  $current_langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $default_langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();

  if ($current_langcode === $default_langcode) {
    return;
  }

  foreach ($items as $key => $item) {
    if (!empty($item['below'])) {
      _motaded_custom_menu_items_fallback_to_default_language($items[$key]['below']);
    }

    if (empty($item['url']) || !($item['url'] instanceof Url)) {
      continue;
    }

    $url = $item['url'];
    $route_name = $url->getRouteName();
    if ($route_name === NULL || $route_name !== 'entity.node.canonical') {
      continue;
    }

    $params = $url->getRouteParameters();
    $node_param = $params['node'] ?? NULL;
    if ($node_param === NULL) {
      continue;
    }

    $node = $node_param instanceof NodeInterface
      ? $node_param
      : \Drupal::entityTypeManager()->getStorage('node')->load($node_param);
    if (!$node instanceof NodeInterface) {
      continue;
    }

    if ($node->hasTranslation($current_langcode)) {
      continue;
    }

    if (!$node->hasTranslation($default_langcode)) {
      continue;
    }

    $fallback_url = $node->getTranslation($default_langcode)->toUrl();
    $fallback_url->setOption('language', \Drupal::languageManager()->getLanguage($default_langcode));
    $items[$key]['url'] = $fallback_url;
  }
}

/**
 * Implements hook_preprocess_links__language_block().
 *
 * Filters the language switcher to show only languages that have a translation
 * for the current entity (node, taxonomy term, etc.). On entity pages without
 * translation, the language is hidden instead of linking to homepage.
 */
function motaded_custom_preprocess_links__language_block(array &$variables): void {
  $allowed_langcodes = _motaded_custom_get_accessible_translation_langcodes();
  if ($allowed_langcodes === NULL) {
    // No translatable entity on the page — show all languages.
    return;
  }

  foreach (array_keys($variables['links']) as $langcode) {
    if (!in_array($langcode, $allowed_langcodes, TRUE)) {
      unset($variables['links'][$langcode]);
    }
  }
}

/**
 * Returns langcodes that have an accessible translation for current route entity.
 *
 * @return array<string>|null
 *   Array of langcodes, or NULL if no translatable entity (show all languages).
 */
function _motaded_custom_get_accessible_translation_langcodes(): ?array {
  $route_match = \Drupal::routeMatch();
  $allowed = NULL;

  foreach ($route_match->getParameters() as $param) {
    if (!$param instanceof TranslatableInterface) {
      continue;
    }
    /** @var \Drupal\Core\Entity\TranslatableInterface $entity */
    $entity = $param;
    $translations = array_filter(
      array_keys($entity->getTranslationLanguages()),
      function ($langcode) use ($entity) {
        if (!$entity->hasTranslation($langcode)) {
          return FALSE;
        }
        $translation = $entity->getTranslation($langcode);
        return method_exists($translation, 'access') && $translation->access('view');
      }
    );
    if ($allowed === NULL) {
      $allowed = array_values($translations);
    }
    else {
      $allowed = array_values(array_intersect($allowed, $translations));
    }
  }

  return $allowed;
}

/**
 * Implements hook_metatags_alter().
 *
 * Inject FAQ schema (from accordions) for page nodes via schema_qa_page.
 */
function motaded_custom_metatags_alter(array &$metatags, array &$context) {
  $entity = $context['entity'] ?? NULL;
  if (!$entity || !$entity instanceof NodeInterface) {
    return;
  }
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'page') {
    return;
  }

  $faq = _motaded_custom_extract_faq_from_node($entity);
  if (!empty($faq)) {
    $metatags['schema_qa_page_main_entity'] = \Drupal\schema_metatag\SchemaMetatagManager::serialize($faq);
  }
  else {
    unset($metatags['schema_qa_page_type'], $metatags['schema_qa_page_main_entity'], $metatags['schema_qa_page_id']);
  }
}

/**
 * Implements hook_form_alter().
 */
function motaded_custom_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $settings = \Drupal::config('motaded_custom.tasheer_visa');
  $targetWebform = (string) ($settings->get('webform_id') ?: 'tasheer_visa_appointment');
  if (($form['#webform_id'] ?? '') !== $targetWebform) {
    return;
  }
  if (empty($form['elements']) || !is_array($form['elements'])) {
    return;
  }
  $app_key = MOTADED_CUSTOM_TASHEER_WIZARD_APPLICATION_PAGE;
  $chain_key = MOTADED_CUSTOM_TASHEER_WIZARD_VISA_CHAIN_PAGE;
  if (!isset($form['elements'][$app_key]['select_nationality'])) {
    return;
  }
  if (empty($form['elements'][$chain_key]) || !is_array($form['elements'][$chain_key])) {
    return;
  }
  $app = &$form['elements'][$app_key];
  $chain = &$form['elements'][$chain_key];
  foreach (['visa_type', 'number_of_entries', 'visa_validity'] as $key) {
    if (!isset($chain[$key])) {
      return;
    }
  }

  // Wrap only dependent fields — do NOT wrap select_nationality, or AJAX replaces
  // the whole region and the native <select> loses focus / closes the dropdown.
  $wrap_open = '<div id="tasheer-dependent-wrapper">';
  $wrap_close = '</div>';
  $chain['visa_type']['#prefix'] = $wrap_open . ($chain['visa_type']['#prefix'] ?? '');
  $chain['visa_validity']['#suffix'] = ($chain['visa_validity']['#suffix'] ?? '') . $wrap_close;

  $ajax = [
    'callback' => 'motaded_custom_tasheer_ajax_refresh',
    'event' => 'change',
    'wrapper' => 'tasheer-dependent-wrapper',
    'progress' => ['type' => 'throbber'],
  ];
  $app['select_nationality']['#ajax'] = $ajax;
  $chain['visa_type']['#ajax'] = $ajax;
  $chain['number_of_entries']['#ajax'] = $ajax;

  motaded_custom_tasheer_apply_dependent_options($form, $form_state);
  $form['#validate'][] = 'motaded_custom_tasheer_validate';

  // Styling for markup defined in the webform (Structure → Webforms → Tasheer visa).
  $form['#attached']['library'][] = 'motaded_custom/tasheer_visa_appointment';
}

/**
 * AJAX callback: rerender dependent elements.
 */
function motaded_custom_tasheer_ajax_refresh(array &$form, FormStateInterface $form_state): array {
  $chain_key = MOTADED_CUSTOM_TASHEER_WIZARD_VISA_CHAIN_PAGE;
  $chain = $form['elements'][$chain_key] ?? [];
  return [
    '#type' => 'container',
    '#attributes' => [
      'id' => 'tasheer-dependent-wrapper',
    ],
    'visa_type' => $chain['visa_type'] ?? [],
    'number_of_entries' => $chain['number_of_entries'] ?? [],
    'visa_validity' => $chain['visa_validity'] ?? [],
  ];
}

/**
 * Populates dynamic options for tasheer chain.
 */
function motaded_custom_tasheer_apply_dependent_options(array &$form, FormStateInterface $form_state): void {
  $settings = \Drupal::config('motaded_custom.tasheer_visa');
  $app_key = MOTADED_CUSTOM_TASHEER_WIZARD_APPLICATION_PAGE;
  $chain_key = MOTADED_CUSTOM_TASHEER_WIZARD_VISA_CHAIN_PAGE;
  if (!isset($form['elements'][$app_key], $form['elements'][$chain_key]) || !is_array($form['elements'][$chain_key])) {
    return;
  }
  $app = &$form['elements'][$app_key];
  $chain = &$form['elements'][$chain_key];
  $labels = [
    'nationality' => motaded_custom_tasheer_get_options((string) $settings->get('options.nationality')),
    'visa_type' => motaded_custom_tasheer_get_options((string) $settings->get('options.visa_type')),
    'number_of_entries' => motaded_custom_tasheer_get_options((string) $settings->get('options.number_of_entries')),
    'visa_validity' => motaded_custom_tasheer_get_options((string) $settings->get('options.visa_validity')),
  ];

  $trigger_name = (string) ($form_state->getTriggeringElement()['#name'] ?? '');
  $ep_chain = ['elements', $chain_key];
  if (motaded_custom_tasheer_triggered_by($trigger_name, 'select_nationality')) {
    $form_state->setValue(array_merge($ep_chain, ['visa_type']), '');
    $form_state->setValue(array_merge($ep_chain, ['number_of_entries']), '');
    $form_state->setValue(array_merge($ep_chain, ['visa_validity']), '');
  }
  elseif (motaded_custom_tasheer_triggered_by($trigger_name, 'visa_type')) {
    $form_state->setValue(array_merge($ep_chain, ['number_of_entries']), '');
    $form_state->setValue(array_merge($ep_chain, ['visa_validity']), '');
  }
  elseif (motaded_custom_tasheer_triggered_by($trigger_name, 'number_of_entries')) {
    $form_state->setValue(array_merge($ep_chain, ['visa_validity']), '');
  }

  $nat = motaded_custom_tasheer_get_nationality($form_state);
  $visa = motaded_custom_tasheer_get_chain_value($form_state, 'visa_type');
  $entries = motaded_custom_tasheer_get_chain_value($form_state, 'number_of_entries');

  $empty = (string) ($settings->get('messages.no_options') ?: 'No options available');
  $fallback = ['' => $empty];

  $conditions = motaded_custom_tasheer_get_conditions($settings);
  $visaTypeByNat = $conditions['visa_type_by_nationality'];
  $entriesByNatVisa = $conditions['entries_by_nat_visa_type'];
  $validityByTriple = $conditions['validity_by_nat_visa_type_entry'];

  $app['select_nationality']['#options'] = $labels['nationality'];

  $hasVisaCondition = array_key_exists($nat, $visaTypeByNat);
  $visaAllowed = is_array($visaTypeByNat[$nat] ?? NULL) ? $visaTypeByNat[$nat] : [];
  $chain['visa_type']['#options'] = $hasVisaCondition
    ? (motaded_custom_tasheer_filter_options($labels['visa_type'], $visaAllowed) ?: $fallback)
    : $labels['visa_type'];
  if ($hasVisaCondition && !in_array($visa, $visaAllowed, TRUE)) {
    $visa = '';
    $entries = '';
  }

  $entriesKey = $nat . '|' . $visa;
  $hasEntriesCondition = array_key_exists($entriesKey, $entriesByNatVisa);
  $entriesAllowed = is_array($entriesByNatVisa[$entriesKey] ?? NULL) ? $entriesByNatVisa[$entriesKey] : [];
  $chain['number_of_entries']['#options'] = $hasEntriesCondition
    ? (motaded_custom_tasheer_filter_options($labels['number_of_entries'], $entriesAllowed) ?: $fallback)
    : $labels['number_of_entries'];
  if ($hasEntriesCondition && !in_array($entries, $entriesAllowed, TRUE)) {
    $entries = '';
  }

  $validityKey = $nat . '|' . $visa . '|' . $entries;
  $hasValidityCondition = array_key_exists($validityKey, $validityByTriple);
  $validityAllowed = is_array($validityByTriple[$validityKey] ?? NULL) ? $validityByTriple[$validityKey] : [];
  $chain['visa_validity']['#options'] = $hasValidityCondition
    ? (motaded_custom_tasheer_filter_options($labels['visa_validity'], $validityAllowed) ?: $fallback)
    : $labels['visa_validity'];
}

/**
 * Final submit validation of selected combination.
 */
function motaded_custom_tasheer_validate(array &$form, FormStateInterface $form_state): void {
  $settings = \Drupal::config('motaded_custom.tasheer_visa');
  $targetWebform = (string) ($settings->get('webform_id') ?: 'tasheer_visa_appointment');
  if (($form['#webform_id'] ?? '') !== $targetWebform) {
    return;
  }
  $values = (array) $form_state->getValue('elements');
  $app_key = MOTADED_CUSTOM_TASHEER_WIZARD_APPLICATION_PAGE;
  $chain_key = MOTADED_CUSTOM_TASHEER_WIZARD_VISA_CHAIN_PAGE;
  $app = isset($values[$app_key]) && is_array($values[$app_key]) ? $values[$app_key] : [];
  $chain = isset($values[$chain_key]) && is_array($values[$chain_key]) ? $values[$chain_key] : [];

  $app_form = $form['elements'][$app_key] ?? [];
  if (empty($app['tasheer_consent']) && isset($app_form['tasheer_consent'])) {
    $form_state->setError(
      $app_form['tasheer_consent'],
      t('You must consent to Tasheer processing your personal data to continue.')
    );
  }

  $nat = (string) ($app['select_nationality'] ?? '');
  $visa = (string) ($chain['visa_type'] ?? '');
  $entries = (string) ($chain['number_of_entries'] ?? '');
  $validity = (string) ($chain['visa_validity'] ?? '');
  if ($nat === '' || $visa === '' || $entries === '' || $validity === '') {
    return;
  }

  $conditions = motaded_custom_tasheer_get_conditions($settings);
  $c1 = $conditions['visa_type_by_nationality'];
  $c2 = $conditions['entries_by_nat_visa_type'];
  $c3 = $conditions['validity_by_nat_visa_type_entry'];

  $chain_form = $form['elements'][$chain_key] ?? [];
  if (array_key_exists($nat, $c1) && !in_array($visa, (array) ($c1[$nat] ?? []), TRUE)) {
    if (isset($chain_form['visa_type'])) {
      $form_state->setError($chain_form['visa_type'], t('Invalid visa type for selected nationality.'));
    }
    return;
  }
  if (array_key_exists($nat . '|' . $visa, $c2) && !in_array($entries, (array) ($c2[$nat . '|' . $visa] ?? []), TRUE)) {
    if (isset($chain_form['number_of_entries'])) {
      $form_state->setError($chain_form['number_of_entries'], t('Invalid number of entries for selected nationality and visa type.'));
    }
    return;
  }
  if (array_key_exists($nat . '|' . $visa . '|' . $entries, $c3) && !in_array($validity, (array) ($c3[$nat . '|' . $visa . '|' . $entries] ?? []), TRUE)) {
    if (isset($chain_form['visa_validity'])) {
      $form_state->setError($chain_form['visa_validity'], t('Invalid visa validity for selected combination.'));
    }
  }
}

/**
 * Gets options from webform options config entity.
 *
 * @return array<string, string>
 */
function motaded_custom_tasheer_get_options(string $options_id): array {
  if ($options_id === '') {
    return [];
  }
  $entity = WebformOptions::load($options_id);
  return $entity ? (array) $entity->getOptions() : [];
}

/**
 * @param array<string, string> $all
 * @param array<int, string> $allowed
 *
 * @return array<string, string>
 */
function motaded_custom_tasheer_filter_options(array $all, array $allowed): array {
  $out = [];
  foreach ($allowed as $id) {
    $key = (string) $id;
    if (isset($all[$key])) {
      $out[$key] = $all[$key];
    }
  }
  return $out;
}

/**
 * Detects triggering element by key for both Webform naming styles.
 */
function motaded_custom_tasheer_triggered_by(string $trigger_name, string $key): bool {
  return $trigger_name === $key || str_ends_with($trigger_name, '[' . $key . ']');
}

/**
 * Reads nationality from the application wizard page.
 */
function motaded_custom_tasheer_get_nationality(FormStateInterface $form_state): string {
  $input = $form_state->getUserInput();
  $page_key = MOTADED_CUSTOM_TASHEER_WIZARD_APPLICATION_PAGE;
  $page_input = $input['elements'][$page_key] ?? [];
  $page_input = is_array($page_input) ? $page_input : [];
  $raw = $page_input['select_nationality']
    ?? $form_state->getValue(['elements', $page_key, 'select_nationality'])
    ?? $form_state->getValue(['elements', 'select_nationality']) ?? '';
  return is_scalar($raw) ? (string) $raw : '';
}

/**
 * Reads a dependent-select value from the visa_followup wizard page.
 */
function motaded_custom_tasheer_get_chain_value(FormStateInterface $form_state, string $key): string {
  $input = $form_state->getUserInput();
  $page_key = MOTADED_CUSTOM_TASHEER_WIZARD_VISA_CHAIN_PAGE;
  $page_input = $input['elements'][$page_key] ?? [];
  $page_input = is_array($page_input) ? $page_input : [];
  $raw = $page_input[$key]
    ?? $form_state->getValue(['elements', $page_key, $key])
    ?? $form_state->getValue(['elements', $key]) ?? '';
  return is_scalar($raw) ? (string) $raw : '';
}

/**
 * Gets conditions from config, with optional JSON fallback.
 *
 * @return array{
 *   visa_type_by_nationality: array<string, array<int, string>>,
 *   entries_by_nat_visa_type: array<string, array<int, string>>,
 *   validity_by_nat_visa_type_entry: array<string, array<int, string>>
 * }
 */
function motaded_custom_tasheer_get_conditions($settings): array {
  $out = [
    'visa_type_by_nationality' => (array) $settings->get('conditions.visa_type_by_nationality'),
    'entries_by_nat_visa_type' => (array) $settings->get('conditions.entries_by_nat_visa_type'),
    'validity_by_nat_visa_type_entry' => (array) $settings->get('conditions.validity_by_nat_visa_type_entry'),
  ];
  if (!empty($out['visa_type_by_nationality'])) {
    return $out;
  }

  $jsonPath = trim((string) $settings->get('json_path'));
  if ($jsonPath === '') {
    return $out;
  }
  $resolved = DRUPAL_ROOT . '/' . ltrim($jsonPath, '/');
  if (!is_readable($resolved)) {
    return $out;
  }
  $raw = file_get_contents($resolved);
  if ($raw === FALSE) {
    return $out;
  }
  try {
    $data = json_decode($raw, TRUE, 512, JSON_THROW_ON_ERROR);
  }
  catch (\JsonException) {
    return $out;
  }
  $out['visa_type_by_nationality'] = (array) ($data['conditions']['visaTypeByNationality'] ?? []);
  $out['entries_by_nat_visa_type'] = (array) ($data['conditions']['entriesByNatVisaType'] ?? []);
  $out['validity_by_nat_visa_type_entry'] = (array) ($data['conditions']['validityByNatVisaTypeEntry'] ?? []);
  return $out;
}

/**
 * Implements hook_link_alter().
 *
 * Adds rel="nofollow" to social network outbound links site-wide.
 */
function motaded_custom_link_alter(array &$variables): void {
  if (empty($variables['url']) || !$variables['url'] instanceof Url) {
    return;
  }

  $url = $variables['url'];
  if (!$url->isExternal()) {
    return;
  }

  $uri = (string) $url->getUri();
  if (!preg_match('#^https?://#i', $uri)) {
    return;
  }

  $host = (string) parse_url($uri, PHP_URL_HOST);
  $host = strtolower($host);
  if ($host === '' || !_motaded_custom_is_social_host($host)) {
    return;
  }

  $variables['options'] = $variables['options'] ?? [];
  $attributes = $variables['options']['attributes'] ?? [];

  $existing = trim((string) ($attributes['rel'] ?? ''));
  $rels = $existing === '' ? [] : (preg_split('/\s+/', $existing) ?: []);
  $rels_map = array_fill_keys(array_map('strtolower', $rels), TRUE);

  foreach (['nofollow', 'noopener', 'noreferrer'] as $rel) {
    if (!isset($rels_map[$rel])) {
      $rels[] = $rel;
      $rels_map[$rel] = TRUE;
    }
  }

  $attributes['rel'] = trim(implode(' ', $rels));
  $variables['options']['attributes'] = $attributes;
}

/**
 * Checks whether host belongs to a known social platform.
 */
function _motaded_custom_is_social_host(string $host): bool {
  $domains = [
    'facebook.com',
    'fb.com',
    'instagram.com',
    'linkedin.com',
    'lnkd.in',
    'twitter.com',
    'x.com',
    't.me',
    'telegram.me',
    'youtube.com',
    'youtu.be',
    'tiktok.com',
    'wa.me',
    'whatsapp.com',
    'snapchat.com',
    'pinterest.com',
  ];

  foreach ($domains as $domain) {
    if ($host === $domain || str_ends_with($host, '.' . $domain)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_ajax_render_alter().
 *
 * Views AJAX adds ScrollTop whenever pager_element is present (often 0), which
 * jumps the viewport on exposed-filter updates. Strip it for homepage events blocks.
 *
 * @see \Drupal\views\Controller\ViewAjaxController::ajaxView()
 */
function motaded_custom_ajax_render_alter(array &$commands): void {
  if (\Drupal::routeMatch()->getRouteName() !== 'views.ajax') {
    return;
  }
  $request = \Drupal::request();
  $view_name = (string) ($request->get('view_name') ?? '');
  $display_id = (string) ($request->get('view_display_id') ?? '');

  $should_strip_scroll = FALSE;

  // Events: homepage blocks + directory/calendar.
  if ($view_name === 'events' && in_array($display_id, [
    'block_home',
    'block_calendar',
    'page_1',
    'attachment_page_calendar',
  ], TRUE)) {
    $should_strip_scroll = TRUE;
  }

  // Library: homepage Library block exposed filters should not jump the viewport.
  if ($view_name === 'library' && $display_id === 'block_1') {
    $should_strip_scroll = TRUE;
  }

  if (!$should_strip_scroll) {
    return;
  }

  foreach ($commands as $index => $command) {
    if (!is_array($command)) {
      continue;
    }
    $cmd = $command['command'] ?? '';
    if ($cmd === 'scrollTop' || $cmd === 'viewsScrollTop') {
      unset($commands[$index]);
    }
  }
}

/**
 * Implements hook_entity_presave().
 *
 * Auto-compute Event status (upcoming/ongoing/past) from start/end datetimes.
 */
function motaded_custom_entity_presave(\Drupal\Core\Entity\EntityInterface $entity): void {
  if (!$entity instanceof \Drupal\node\NodeInterface) {
    return;
  }
  if ($entity->bundle() !== 'event') {
    return;
  }
  if (!$entity->hasField('field_event_status') || !$entity->hasField('field_event_start') || !$entity->hasField('field_event_end')) {
    return;
  }
  if ($entity->get('field_event_start')->isEmpty() || $entity->get('field_event_end')->isEmpty()) {
    return;
  }

  $start_raw = (string) ($entity->get('field_event_start')->value ?? '');
  $end_raw = (string) ($entity->get('field_event_end')->value ?? '');
  if ($start_raw === '' || $end_raw === '') {
    return;
  }

  try {
    $start = new DrupalDateTime($start_raw, new \DateTimeZone('UTC'));
    $end = new DrupalDateTime($end_raw, new \DateTimeZone('UTC'));
    $now = new \DateTimeImmutable('now', new \DateTimeZone('UTC'));
    $start_ts = $start->getTimestamp();
    $end_ts = $end->getTimestamp();
    $now_ts = $now->getTimestamp();

    $status = 'upcoming';
    if ($now_ts < $start_ts) {
      $status = 'upcoming';
    }
    elseif ($now_ts > $end_ts) {
      $status = 'past';
    }
    else {
      $status = 'ongoing';
    }
    $entity->set('field_event_status', $status);
  }
  catch (\Throwable $e) {
    // Keep editor-provided value if parsing fails.
  }
}

/**
 * Implements hook_views_query_alter().
 *
 * Events directory (/events): optional motaded_event_date_from / motaded_event_date_to (Y-m-d).
 *
 * Library view: section filter is an exposed Views filter on library_section terms.
 */
function motaded_custom_views_query_alter(\Drupal\views\ViewExecutable $view, \Drupal\views\Plugin\views\query\QueryPluginBase $query): void {
  $view_id = $view->id() ?? '';

  if ($view_id === 'events') {
    $display_id = $view->current_display ?? '';
    if (!in_array($display_id, ['page_1', 'attachment_page_calendar'], TRUE)) {
      return;
    }
    if (!$query instanceof \Drupal\views\Plugin\views\query\Sql) {
      return;
    }
    $req = \Drupal::request();
    $from = $req->query->get('motaded_event_date_from');
    $to = $req->query->get('motaded_event_date_to');
    if (!is_string($from) && !is_string($to)) {
      return;
    }
    $info = $query->getTableInfo('node__field_event_start');
    if (empty($info['alias'])) {
      return;
    }
    $alias = $info['alias'];
    $col = $alias . '.field_event_start_value';
    if (is_string($from) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $from)) {
      $query->addWhere(0, $col, $from . 'T00:00:00', '>=');
    }
    if (is_string($to) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $to)) {
      $query->addWhere(0, $col, $to . 'T23:59:59', '<=');
    }
    return;
  }
}

/**
 * Returns taxonomy term ID in vocabulary library_section by exact name.
 */
function motaded_custom_library_section_group_tid_by_name(string $name): ?int {
  $name = trim($name);
  if ($name === '') {
    return NULL;
  }
  $ids = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'library_section')
    ->condition('name', $name)
    ->range(0, 1)
    ->execute();
  if (!$ids) {
    return NULL;
  }
  return (int) reset($ids);
}

/**
 * Document type term IDs assigned to a library section group term.
 *
 * @return int[]
 */
function motaded_custom_document_type_tids_for_library_section_tid(int $section_tid): array {
  if ($section_tid < 1) {
    return [];
  }
  $ids = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'document_type')
    ->condition('field_library_section', $section_tid)
    ->execute();
  if (!is_array($ids) || $ids === []) {
    return [];
  }
  return array_values(array_map('intval', $ids));
}

/**
 * Legacy slug → group term ID (for old bookmarks).
 */
function motaded_custom_library_section_tid_from_slug(string $slug, int $templates_tid, int $regulations_tid): int {
  return $slug === 'regulations' ? $regulations_tid : $templates_tid;
}

/**
 * Normalizes exposed library_section (tid or legacy slug) to a valid group tid.
 */
function motaded_custom_library_section_normalize_input(mixed $raw, int $templates_tid, int $regulations_tid): int {
  if (is_string($raw)) {
    $raw = trim($raw);
    if ($raw === 'templates' || $raw === 'regulations') {
      return motaded_custom_library_section_tid_from_slug($raw, $templates_tid, $regulations_tid);
    }
    if ($raw !== '' && ctype_digit($raw)) {
      $tid = (int) $raw;
      if ($tid === $templates_tid || $tid === $regulations_tid) {
        return $tid;
      }
    }
  }
  elseif (is_int($raw) || is_float($raw)) {
    $tid = (int) $raw;
    if ($tid === $templates_tid || $tid === $regulations_tid) {
      return $tid;
    }
  }
  elseif (is_array($raw)) {
    $first = reset($raw);
    return motaded_custom_library_section_normalize_input($first, $templates_tid, $regulations_tid);
  }
  return $templates_tid;
}

/**
 * Document type term IDs for a library section tab (legacy slug API for theme).
 *
 * @return int[]
 */
function motaded_custom_library_section_document_type_tids(string $section): array {
  $templates_tid = motaded_custom_library_section_group_tid_by_name('Templates');
  $regulations_tid = motaded_custom_library_section_group_tid_by_name('Regulations');
  if ($templates_tid === NULL || $regulations_tid === NULL) {
    return motaded_custom_taxonomy_tids_by_exact_names('document_type', $section === 'regulations'
      ? ['Regulation', 'Law', 'Policy']
      : ['Template', 'Form', 'Guide']);
  }
  $group_tid = $section === 'regulations' ? $regulations_tid : $templates_tid;
  return motaded_custom_document_type_tids_for_library_section_tid($group_tid);
}

/**
 * Taxonomy term IDs by vocabulary and exact default labels.
 *
 * @return int[]
 */
function motaded_custom_taxonomy_tids_by_exact_names(string $vid, array $names): array {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = [];
  foreach ($names as $name) {
    $name = trim((string) $name);
    if ($name === '') {
      continue;
    }
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->condition('name', $name)
      ->range(0, 1)
      ->execute();
    if ($ids) {
      $tids[] = (int) reset($ids);
    }
  }
  return array_values(array_unique($tids));
}

/**
 * Implements hook_views_pre_build().
 *
 * Ensures Library block/page always get Views AJAX settings even if active
 * config drifted from exported defaults (use_ajax).
 */
function motaded_custom_views_pre_build(\Drupal\views\ViewExecutable $view): void {
  if (($view->id() ?? '') !== 'library') {
    return;
  }
  if (!in_array($view->current_display ?? '', ['page_1', 'block_1'], TRUE)) {
    return;
  }
  if (empty($view->is_attachment) && empty($view->live_preview)) {
    $view->setAjaxEnabled(TRUE);
  }

  $templates_tid = motaded_custom_library_section_group_tid_by_name('Templates');
  $regulations_tid = motaded_custom_library_section_group_tid_by_name('Regulations');
  if ($templates_tid === NULL || $regulations_tid === NULL) {
    return;
  }

  $req = \Drupal::request();
  $input = $view->getExposedInput();
  $raw = $input['library_section'] ?? NULL;
  if ($raw === NULL || $raw === '') {
    $raw = $req->query->get('library_section');
  }
  if ($raw === NULL || $raw === '') {
    $raw = $req->request->get('library_section');
  }
  $tid = motaded_custom_library_section_normalize_input($raw, $templates_tid, $regulations_tid);
  $input['library_section'] = (string) $tid;
  $view->setExposedInput($input);
}

/**
 * Implements hook_views_pre_render().
 */
function motaded_custom_views_pre_render(\Drupal\views\ViewExecutable $view): void {
  if (($view->id() ?? '') !== 'library') {
    return;
  }
  if (!in_array($view->current_display ?? '', ['page_1', 'block_1'], TRUE)) {
    return;
  }
  $view->element['#cache']['contexts'][] = 'url.query_args:library_section';
}

/**
 * Implements hook_cron().
 *
 * Queues a daily World Bank import (processed by queue worker; see
 * MarketIndicatorsImportQueueWorker).
 */
function motaded_custom_cron(): void {
  $day = gmdate('Y-m-d', \Drupal::time()->getRequestTime());
  $state = \Drupal::state();
  if ($state->get('motaded_custom.market_indicators_queue_day') !== $day) {
    $queue = \Drupal::queue('market_indicators_import');
    if ($queue->numberOfItems() === 0) {
      $queue->createItem([]);
      $state->set('motaded_custom.market_indicators_queue_day', $day);
    }
  }
  if ($state->get('motaded_custom.sector_indicators_queue_day') !== $day) {
    $queue_sector = \Drupal::queue('sector_indicators_import');
    if ($queue_sector->numberOfItems() === 0) {
      $queue_sector->createItem([]);
      $state->set('motaded_custom.sector_indicators_queue_day', $day);
    }
  }
}

/**
 * Returns market indicator rows for the v1 homepage table order.
 *
 * @return list<array<string, mixed>>
 *   Rows from {market_indicators}, keys ordered for display.
 */
function motaded_custom_market_indicators_table_rows(): array {
  $keys = [
    'gdp_growth',
    'population',
    'fdi_inflow',
    'non_oil_gdp_growth',
    'inflation',
    'unemployment',
  ];
  return \Drupal::service('motaded_custom.market_indicator_repository')->loadLatestRowsOrdered($keys);
}

/**
 * GDP growth series for chart (last 6 calendar years, local DB only).
 *
 * @return list<array{year: int, value: float}>
 */
function motaded_custom_market_indicators_gdp_growth_series(): array {
  $current_year = (int) gmdate('Y', \Drupal::time()->getRequestTime());
  $year_min = $current_year - 5;
  return \Drupal::service('motaded_custom.market_indicator_repository')->loadSeries('gdp_growth', $year_min, $current_year);
}

/**
 * Homepage sector cards from {sector_indicator_points} (headline KPI + sparkline data).
 *
 * @return list<array<string, mixed>>
 *   Each card: sector_key, sector_title, kpi_label, value_display, year,
 *   explore_url, explore_label, icon_key, sparkline_points (list of year/value).
 */
function motaded_custom_sector_homepage_cards(): array {
  if (!\Drupal::hasService('motaded_custom.sector_indicator_repository')) {
    return [];
  }
  /** @var \Drupal\motaded_custom\SectorIndicators\SectorIndicatorRepository $repo */
  $repo = \Drupal::service('motaded_custom.sector_indicator_repository');
  $calendar_year = (int) gmdate('Y', \Drupal::time()->getRequestTime());

  $cards = [];
  foreach (\Drupal\motaded_custom\SectorIndicators\SectorIndicatorDefinitions::headlineRows() as $def) {
    $latest = $repo->loadLatest($def['sector_key'], $def['indicator_key']);
    if ($latest === NULL) {
      continue;
    }
    $value_display = isset($latest['value_display']) ? trim((string) $latest['value_display']) : '';
    if ($value_display === '') {
      continue;
    }
    [$year_min, $year_max] = _motaded_custom_sector_sparkline_year_bounds((int) ($latest['year'] ?? 0), $calendar_year);
    $series = $repo->loadSeries($def['sector_key'], $def['indicator_key'], $year_min, $year_max);
    $kpi_card = trim((string) ($def['card_kpi_label'] ?? ''));
    if ($kpi_card === '') {
      $kpi_card = trim((string) ($def['kpi_label'] ?? ''));
    }
    $cards[] = [
      'sector_key' => $def['sector_key'],
      'sector_title' => $def['sector_label'],
      'kpi_label' => $kpi_card,
      'value_display' => $value_display,
      'year' => (int) ($latest['year'] ?? 0),
      'explore_url' => Url::fromUri('internal:/sectors')->toString(),
      'explore_label' => (string) t('Explore sector'),
      'icon_key' => (string) ($def['icon_key'] ?? $def['sector_key']),
      'sparkline_points' => $series,
    ];
  }
  return $cards;
}

/**
 * Maps a sector_page node title / sector term to a canonical sector_key (WB definitions).
 */
function _motaded_custom_sector_key_from_sector_page(NodeInterface $node): ?string {
  if ($node->bundle() !== 'sector_page') {
    return NULL;
  }
  $candidates = [trim($node->getTitle())];
  if ($node->hasField('field_sector') && !$node->get('field_sector')->isEmpty()) {
    $term = $node->get('field_sector')->entity;
    if ($term instanceof \Drupal\taxonomy\TermInterface) {
      $candidates[] = trim($term->label());
    }
  }
  static $map = [
    'Tourism' => 'tourism',
    'Energy' => 'energy',
    'Manufacturing' => 'manufacturing',
    'Technology' => 'technology',
    'Finance & Fintech' => 'finance',
    'Finance and Fintech' => 'finance',
    'Logistics & Transport' => 'logistics',
    'Logistics Transport' => 'logistics',
    'Healthcare' => 'healthcare',
    'Construction & Infrastructure' => 'construction',
    'Construction and Infrastructure' => 'construction',
  ];
  foreach ($candidates as $c) {
    if ($c !== '' && isset($map[$c])) {
      return $map[$c];
    }
  }
  return NULL;
}

/**
 * Sparkline loads up to 6 years ending at the headline year (not “calendar last 6 years”).
 *
 * @return array{0: int, 1: int}
 *   Tuple year_min, year_max for DB BETWEEN.
 */
function _motaded_custom_sector_sparkline_year_bounds(int $latest_row_year, int $calendar_year): array {
  if ($latest_row_year < 1960) {
    $latest_row_year = $calendar_year;
  }
  $year_max = min($calendar_year, $latest_row_year);
  $year_min = max(1960, $year_max - 5);
  return [$year_min, $year_max];
}

/**
 * World Bank headline KPI + series for homepage sector cards (when DB has data).
 *
 * @return array<string, mixed>|null
 *   Keys: sector_key, value_display, year, kpi_label, icon_key, sparkline_points.
 */
function motaded_custom_sector_wb_overlay_for_node(NodeInterface $node): ?array {
  $sector_key = _motaded_custom_sector_key_from_sector_page($node);
  if ($sector_key === NULL || !\Drupal::hasService('motaded_custom.sector_indicator_repository')) {
    return NULL;
  }
  $def = \Drupal\motaded_custom\SectorIndicators\SectorIndicatorDefinitions::headlineForSectorKey($sector_key);
  if ($def === NULL) {
    return NULL;
  }
  /** @var \Drupal\motaded_custom\SectorIndicators\SectorIndicatorRepository $repo */
  $repo = \Drupal::service('motaded_custom.sector_indicator_repository');
  $latest = $repo->loadLatest($sector_key, $def['indicator_key']);
  if ($latest === NULL) {
    return NULL;
  }
  $value_display = isset($latest['value_display']) ? trim((string) $latest['value_display']) : '';
  if ($value_display === '') {
    return NULL;
  }
  $calendar_year = (int) gmdate('Y', \Drupal::time()->getRequestTime());
  [$year_min, $year_max] = _motaded_custom_sector_sparkline_year_bounds((int) ($latest['year'] ?? 0), $calendar_year);
  $series = $repo->loadSeries($sector_key, $def['indicator_key'], $year_min, $year_max);
  $kpi_card = trim((string) ($def['card_kpi_label'] ?? ''));
  if ($kpi_card === '') {
    $kpi_card = trim((string) ($def['kpi_label'] ?? ''));
  }
  return [
    'sector_key' => $sector_key,
    'value_display' => $value_display,
    'year' => (int) ($latest['year'] ?? 0),
    'kpi_label' => $kpi_card,
    'icon_key' => (string) ($def['icon_key'] ?? $sector_key),
    'sparkline_points' => $series,
  ];
}

/**
 * Implements hook_preprocess_HOOK() for node templates.
 *
 * sector_page (full): Key stats (WB + GASTAT), trade volume chart, GASTAT activity growth chart.
 */
function motaded_custom_preprocess_node(array &$variables): void {
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface) {
    return;
  }
  if ($node->bundle() !== 'sector_page' || ($variables['view_mode'] ?? '') !== 'full' || empty($variables['page'])) {
    return;
  }
  $sector_key = _motaded_custom_sector_key_from_sector_page($node);
  if ($sector_key === NULL) {
    return;
  }
  $allowed = \Drupal\motaded_custom\SectorIndicators\SectorIndicatorDefinitions::sectorPageKeys();
  if (!in_array($sector_key, $allowed, TRUE)) {
    return;
  }
  $variables['#cache']['tags'][] = 'node:' . $node->id();
  $api_max_age = 43200;
  $has_api_layer = FALSE;

  if (\Drupal::hasService('motaded_custom.sector_page_key_stats_builder')) {
    /** @var \Drupal\motaded_custom\SectorKeyStats\SectorPageKeyStatsBuilder $builder */
    $builder = \Drupal::service('motaded_custom.sector_page_key_stats_builder');
    $rows = $builder->build($sector_key);
    if ($rows !== []) {
      $years = array_filter(array_map(
        static fn(array $r): int => (int) ($r['year'] ?? 0),
        $rows
      ));
      $title_year = $years !== [] ? max($years) : (int) gmdate('Y', \Drupal::time()->getRequestTime());
      $variables['sector_api_key_stats'] = $rows;
      $variables['sector_api_key_stats_year'] = $title_year;
      $variables['sector_api_key_stats_more_url'] = 'https://data.worldbank.org/country/saudi-arabia';
      $has_api_layer = TRUE;
    }
  }

  if (\Drupal::hasService('motaded_custom.logistics_trade_volume_chart_builder')) {
    /** @var \Drupal\motaded_custom\SectorKeyStats\TradeVolumeChartBuilder $chartBuilder */
    $chartBuilder = \Drupal::service('motaded_custom.logistics_trade_volume_chart_builder');
    $chart = $chartBuilder->build($sector_key, 'trade_volume_chart');
    if ($chart !== NULL) {
      $chart['gradient_id'] = 'stc-fill-' . $node->id();
      $variables['sector_trade_volume_chart'] = $chart;
      $has_api_layer = TRUE;
      $api_max_age = min($api_max_age, (int) ($chart['cache_max_age'] ?? $api_max_age));
      $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $chart['cache_tags'] ?? []);
    }
  }

  if (\Drupal::hasService('motaded_custom.sector_gastat_activity_chart_builder')) {
    /** @var \Drupal\motaded_custom\SectorKeyStats\SectorGastatActivityGrowthChartBuilder $gdpChart */
    $gdpChart = \Drupal::service('motaded_custom.sector_gastat_activity_chart_builder');
    $gdp = $gdpChart->build($sector_key);
    if ($gdp !== NULL) {
      $gdp['chart_uid'] = 'sgastat-' . $node->id();
      $variables['sector_logistics_gdp_chart'] = $gdp;
      $has_api_layer = TRUE;
      $api_max_age = min($api_max_age, (int) ($gdp['cache_max_age'] ?? $api_max_age));
      $variables['#cache']['tags'] = Cache::mergeTags($variables['#cache']['tags'] ?? [], $gdp['cache_tags'] ?? []);
    }
  }

  if ($has_api_layer) {
    $prev_max = $variables['#cache']['max-age'] ?? NULL;
    if ($prev_max === NULL || $prev_max === Cache::PERMANENT) {
      $variables['#cache']['max-age'] = $api_max_age;
    }
    else {
      $variables['#cache']['max-age'] = min((int) $prev_max, $api_max_age);
    }
  }
}
