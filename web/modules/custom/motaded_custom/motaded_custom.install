/**
 * Defines tables for normalized market indicators (World Bank + manual).
 */
function motaded_custom_schema(): array {
  $schema['market_indicators'] = [
    'description' => 'Latest normalized values per indicator and year.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'indicator_key' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'label' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'value_raw' => [
        'type' => 'numeric',
        'precision' => 24,
        'scale' => 8,
        'not null' => FALSE,
      ],
      'value_display' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'year' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'size' => 'normal',
      ],
      'period' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => FALSE,
      ],
      'period_type' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'annual',
      ],
      'source_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'source_url' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'provider' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'fetched_at' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'indicator_year' => ['indicator_key', 'year'],
    ],
    'indexes' => [
      'indicator_key' => ['indicator_key'],
    ],
  ];

  $schema['market_indicator_series'] = [
    'description' => 'Time series points for charts (e.g. GDP growth).',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'indicator_key' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'year' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'size' => 'normal',
      ],
      'value' => [
        'type' => 'numeric',
        'precision' => 24,
        'scale' => 8,
        'not null' => TRUE,
      ],
      'source_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'indicator_series_year' => ['indicator_key', 'year'],
    ],
    'indexes' => [
      'indicator_key' => ['indicator_key'],
    ],
  ];

  $schema['sector_indicator_points'] = [
    'description' => 'World Bank (and future manual) time series per sector and indicator.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'sector_key' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'indicator_key' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'wb_code' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'year' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'size' => 'normal',
      ],
      'value_raw' => [
        'type' => 'numeric',
        'precision' => 24,
        'scale' => 8,
        'not null' => FALSE,
      ],
      'value_display' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ],
      'source_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'source_url' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'provider' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'fetched_at' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'sector_indicator_year' => ['sector_key', 'indicator_key', 'year'],
    ],
    'indexes' => [
      'sector_indicator' => ['sector_key', 'indicator_key'],
      'sector_key' => ['sector_key'],
    ],
  ];

  return $schema;
}

/**
 * Adds Arabic translations for taxonomy terms in the "beneficiaries" vocabulary.
 *
 * Terms are content (not config-exportable by default). Keeping translations in
 * code via an update hook makes deployments deterministic across environments.
 */
function motaded_custom_update_10002(): void {
  if (!\Drupal::moduleHandler()->moduleExists('taxonomy')) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'beneficiaries')
    ->sort('tid')
    ->execute();

  if (!$tids) {
    return;
  }

  /** @var array<int, string> $by_tid */
  $by_tid = [
    165 => 'مالكو الشركات',
    166 => 'المستوردون والمصدرون',
    167 => 'فرق العلاقات الحكومية ومكاتب PRO',
    168 => 'فرق الامتثال والشؤون القانونية',
    169 => 'فرق الموارد البشرية وإدارة القوى العاملة',
    170 => 'فرق المالية والرواتب',
    171 => 'الشركات المحلية والدولية',
  ];

  /** @var array<string, string> $by_en_label */
  $by_en_label = [
    'Company Owners' => 'مالكو الشركات',
    'Importers and Exporters' => 'المستوردون والمصدرون',
    'PRO and Government Relations Teams' => 'فرق العلاقات الحكومية ومكاتب PRO',
    'Compliance and Legal Teams' => 'فرق الامتثال والشؤون القانونية',
    'HR and Workforce Teams' => 'فرق الموارد البشرية وإدارة القوى العاملة',
    'Finance and Payroll Teams' => 'فرق المالية والرواتب',
    'Local and International Businesses' => 'الشركات المحلية والدولية',
  ];

  foreach ($tids as $tid) {
    $tid = (int) $tid;
    $term = $storage->load($tid);
    if (!$term instanceof \Drupal\taxonomy\TermInterface) {
      continue;
    }

    $default = $term->getUntranslated()->language()->getId();
    $source = $term->hasTranslation($default) ? $term->getTranslation($default) : $term;
    $en_label = trim((string) $source->label());

    $name_ar = $by_tid[$tid] ?? ($by_en_label[$en_label] ?? '');
    if ($name_ar === '') {
      continue;
    }

    if ($term->hasTranslation('ar')) {
      $ar = $term->getTranslation('ar');
    }
    else {
      $ar = $term->addTranslation('ar');
    }

    $ar->setName($name_ar);
    if ($ar->hasField('status')) {
      $ar->set('status', TRUE);
    }
    $term->save();
  }
}

/**
 * Adds missing Arabic translation for a specific service tag term.
 */
function motaded_custom_update_10003(): void {
  if (!\Drupal::moduleHandler()->moduleExists('taxonomy')) {
    return;
  }

  $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load(82);
  if (!$term instanceof \Drupal\taxonomy\TermInterface) {
    return;
  }

  if ($term->hasTranslation('ar')) {
    return;
  }

  $name_ar = 'العلاقات الحكومية في المملكة العربية السعودية';
  $ar = $term->addTranslation('ar');
  $ar->setName($name_ar);
  if ($ar->hasField('status')) {
    $ar->set('status', TRUE);
  }
  $term->save();
}

/**
 * Copies reference field values from default translation to AR when missing.
 *
 * Some Arabic translations of service pages were created without copying taxonomy
 * references from English, which makes chips/filters fall back to English labels.
 */
function motaded_custom_update_10004(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('node');
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'page')
    ->condition('field_display_on_services', 1)
    ->execute();

  if (!$nids) {
    return;
  }

  foreach ($nids as $nid) {
    $node = $storage->load($nid);
    if (!$node instanceof \Drupal\node\NodeInterface) {
      continue;
    }
    if (!$node->hasTranslation('ar')) {
      continue;
    }

    $default_langcode = $node->getUntranslated()->language()->getId();
    $src = $node->getTranslation($default_langcode);
    $ar = $node->getTranslation('ar');

    $changed = FALSE;
    foreach (['field_beneficiaries', 'field_tags', 'field_taxonomy'] as $field_name) {
      if (!$node->hasField($field_name)) {
        continue;
      }
      if (!$ar->get($field_name)->isEmpty()) {
        continue;
      }
      if ($src->get($field_name)->isEmpty()) {
        continue;
      }
      $ar->set($field_name, $src->get($field_name)->getValue());
      $changed = TRUE;
    }

    if ($changed) {
      // Avoid creating noisy revisions for a data hygiene fix.
      $ar->setNewRevision(FALSE);
      $node->save();
    }
  }
}

/**
 * Seeds default terms for Document type and Document category vocabularies.
 */
function motaded_custom_update_10005(): void {
  if (!\Drupal::moduleHandler()->moduleExists('taxonomy')) {
    return;
  }

  $voc_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  if ($voc_storage->load('document_type')) {
    _motaded_custom_install_ensure_taxonomy_terms('document_type', [
      'Template',
      'Form',
      'Guide',
      'Regulation',
      'Law',
      'Policy',
    ]);
  }

  if ($voc_storage->load('document_category')) {
    _motaded_custom_install_ensure_taxonomy_terms('document_category', [
      'Business Setup',
      'HR',
      'Tax',
      'Compliance',
      'Licensing',
    ]);
  }
}

/**
 * Seeds default terms for City and Country vocabularies (events UX filters).
 */
function motaded_custom_update_10006(): void {
  if (!\Drupal::moduleHandler()->moduleExists('taxonomy')) {
    return;
  }
  $voc_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  if ($voc_storage->load('city')) {
    _motaded_custom_install_ensure_taxonomy_terms('city', [
      'Riyadh',
      'Jeddah',
      'Dammam',
      'Dubai',
    ]);
  }
  if ($voc_storage->load('country')) {
    _motaded_custom_install_ensure_taxonomy_terms('country', [
      'Saudi Arabia',
      'United Arab Emirates',
    ]);
  }
}

/**
 * Creates taxonomy terms when missing (matches by exact default label).
 *
 * @param string $vid
 *   Vocabulary ID.
 * @param array<int, string> $names
 *   Term names in display order (weight).
 */
function _motaded_custom_install_ensure_taxonomy_terms(string $vid, array $names): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $weight = 0;
  foreach ($names as $name) {
    $name = trim($name);
    if ($name === '') {
      continue;
    }
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->condition('name', $name)
      ->range(0, 1)
      ->execute();
    if ($ids) {
      $weight++;
      continue;
    }

    $term = \Drupal\taxonomy\Entity\Term::create([
      'vid' => $vid,
      'name' => $name,
      'weight' => $weight,
      'langcode' => 'en',
    ]);
    $term->save();
    $weight++;
  }
}

/**
 * Creates market indicator tables and default config for World Bank import (v1).
 */
function motaded_custom_update_10007(): void {
  $db_schema = \Drupal::database()->schema();
  \Drupal::moduleHandler()->loadInclude('motaded_custom', 'install');
  if (!function_exists('motaded_custom_schema')) {
    return;
  }
  $schema = motaded_custom_schema();
  foreach (['market_indicators', 'market_indicator_series'] as $table) {
    if (!$db_schema->tableExists($table)) {
      $db_schema->createTable($table, $schema[$table]);
    }
  }

  $config = \Drupal::configFactory()->get('motaded_custom.market_indicators');
  if ($config->isNew()) {
    $module_path = \Drupal::service('extension.list.module')->getPath('motaded_custom');
    $path = $module_path . '/config/install/motaded_custom.market_indicators.yml';
    if (is_readable($path)) {
      $raw = file_get_contents($path);
      if ($raw !== FALSE) {
        $data = \Drupal\Component\Serialization\Yaml::decode($raw);
        if (is_array($data)) {
          \Drupal::configFactory()->getEditable('motaded_custom.market_indicators')->setData($data)->save();
        }
      }
    }
  }
}

/**
 * Creates sector_indicator_points table for World Bank sector card import (v1).
 */
function motaded_custom_update_10008(): void {
  $db_schema = \Drupal::database()->schema();
  \Drupal::moduleHandler()->loadInclude('motaded_custom', 'install');
  if (!function_exists('motaded_custom_schema')) {
    return;
  }
  $schema = motaded_custom_schema();
  $table = 'sector_indicator_points';
  if (!$db_schema->tableExists($table) && isset($schema[$table])) {
    $db_schema->createTable($table, $schema[$table]);
  }
}

/**
 * Seeds library_section terms and field_library_section on document_type terms.
 *
 * Nodes do not store this value: they reference document_type, which now points
 * to a library_section term (Templates vs Regulations).
 */
function motaded_custom_update_10009(): void {
  if (!\Drupal::moduleHandler()->moduleExists('taxonomy')) {
    return;
  }
  $voc_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  if (!$voc_storage->load('library_section') || !$voc_storage->load('document_type')) {
    return;
  }

  _motaded_custom_install_ensure_taxonomy_terms('library_section', [
    'Templates',
    'Regulations',
  ]);

  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $tid_by_name = static function (string $vid, string $name) use ($term_storage): ?int {
    $name = trim($name);
    if ($name === '') {
      return NULL;
    }
    $ids = $term_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('vid', $vid)
      ->condition('name', $name)
      ->range(0, 1)
      ->execute();
    if (!$ids) {
      return NULL;
    }
    return (int) reset($ids);
  };

  $templates_section_tid = $tid_by_name('library_section', 'Templates');
  $regulations_section_tid = $tid_by_name('library_section', 'Regulations');
  if ($templates_section_tid === NULL || $regulations_section_tid === NULL) {
    return;
  }

  $map_templates = ['Template', 'Form', 'Guide'];
  $map_regulations = ['Regulation', 'Law', 'Policy'];

  foreach ($map_templates as $type_name) {
    $tid = $tid_by_name('document_type', $type_name);
    if ($tid === NULL) {
      continue;
    }
    $term = $term_storage->load($tid);
    if (!$term instanceof \Drupal\taxonomy\TermInterface || !$term->hasField('field_library_section')) {
      continue;
    }
    $term->set('field_library_section', $templates_section_tid);
    $term->setNewRevision(FALSE);
    $term->save();
  }

  foreach ($map_regulations as $type_name) {
    $tid = $tid_by_name('document_type', $type_name);
    if ($tid === NULL) {
      continue;
    }
    $term = $term_storage->load($tid);
    if (!$term instanceof \Drupal\taxonomy\TermInterface || !$term->hasField('field_library_section')) {
      continue;
    }
    $term->set('field_library_section', $regulations_section_tid);
    $term->setNewRevision(FALSE);
    $term->save();
  }

  $all_doc_type_ids = $term_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', 'document_type')
    ->execute();
  if (is_array($all_doc_type_ids)) {
    foreach ($term_storage->loadMultiple($all_doc_type_ids) as $term) {
      if (!$term instanceof \Drupal\taxonomy\TermInterface || !$term->hasField('field_library_section')) {
        continue;
      }
      if (!$term->get('field_library_section')->isEmpty()) {
        continue;
      }
      $term->set('field_library_section', $templates_section_tid);
      $term->setNewRevision(FALSE);
      $term->save();
    }
  }
}

/**
 * Imports /translations/motaded-service-ui.ar.po into the locale DB.
 *
 * Shared helper used by individual `_update_NNNN` hooks below. Drupal does not
 * pick up changes to PO files automatically — Gettext::fileToDatabase() writes
 * msgid/msgstr pairs into locales_source/locales_target. We only overwrite
 * non-customized translations to preserve any manual edits made via
 * Configuration → Translate interface.
 */
function _motaded_custom_import_ar_locale_po(): void {
  if (!\Drupal::moduleHandler()->moduleExists('locale')) {
    return;
  }
  $absolute_path = \Drupal::root() . '/../translations/motaded-service-ui.ar.po';
  if (!is_file($absolute_path) || !is_readable($absolute_path)) {
    \Drupal::logger('motaded_custom')->warning('Skipping locale import: @path not readable.', ['@path' => $absolute_path]);
    return;
  }
  $languages = \Drupal::languageManager()->getLanguages();
  if (!isset($languages['ar'])) {
    \Drupal::logger('motaded_custom')->notice('Skipping locale import: Arabic language is not enabled.');
    return;
  }

  $file = (object) [
    'filename' => basename($absolute_path),
    'uri' => $absolute_path,
    'langcode' => 'ar',
    'timestamp' => filemtime($absolute_path) ?: \Drupal::time()->getRequestTime(),
  ];

  $options = [
    'customized' => 0,
    'overwrite_options' => [
      'not_customized' => TRUE,
      'customized' => FALSE,
    ],
  ];

  try {
    \Drupal\locale\Gettext::fileToDatabase($file, $options);
    \Drupal::logger('motaded_custom')->info('Imported Arabic locale file @file.', ['@file' => $file->filename]);
  }
  catch (\Throwable $e) {
    \Drupal::logger('motaded_custom')->error('Failed to import @file: @msg', [
      '@file' => $file->filename,
      '@msg' => $e->getMessage(),
    ]);
  }
}

/**
 * Initial Arabic UI strings import (hero copy, quick links, aria labels).
 *
 * Re-run manually: drush ev '\Drupal::moduleHandler()->loadInclude("motaded_custom", "install"); _motaded_custom_import_ar_locale_po();' && drush cr
 */
function motaded_custom_update_10012(): void {
  _motaded_custom_import_ar_locale_po();
}

