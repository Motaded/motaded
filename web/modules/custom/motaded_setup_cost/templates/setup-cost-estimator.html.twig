{#
  Business setup cost estimator — step wizard + sticky results + optional webform.
#}
{% set ui = profile.ui|default({}) %}
{% set _tag = 'di' ~ 'v' %}
<{{ _tag }}
  class="setup-cost setup-cost__shell mx-auto w-full max-w-[1320px] px-4 sm:px-6"
  id="setup-cost-estimator"
  data-setup-cost-estimator
  x-data="setupCostEstimator"
>
  <{{ _tag }} class="setup-cost__panel setup-cost__wizard">
    <{{ _tag }} class="setup-cost__layout">
      <{{ _tag }} class="setup-cost__main">
        <{{ _tag }} class="setup-cost__progress" role="status" aria-live="polite">
          <{{ _tag }} class="setup-cost__progress-bar" aria-hidden="true">
            <span class="setup-cost__progress-fill" :style="'width:' + progressPct + '%'"></span>
          </{{ _tag }}>
          <p class="setup-cost__progress-label" x-text="progressLabel"></p>
        </{{ _tag }}>

        <template x-for="(step, index) in steps" :key="step.id">
          <section
            class="setup-cost__step"
            x-show="currentStep === index"
            x-transition.opacity.duration.200ms
            :aria-hidden="currentStep !== index"
          >
            <h2 class="setup-cost__step-title" x-text="step.label"></h2>

            <{{ _tag }} class="setup-cost__cards" x-show="step.type === 'cards'">
              <template x-for="opt in step.options" :key="opt.id">
                <button
                  type="button"
                  class="setup-cost__card"
                  :class="{ 'is-selected': answers[step.id] === opt.id }"
                  @click="selectOption(step.id, opt.id)"
                  :aria-pressed="answers[step.id] === opt.id ? 'true' : 'false'"
                >
                  <span class="setup-cost__card-label" x-text="opt.label"></span>
                </button>
              </template>
            </{{ _tag }}>

            <{{ _tag }} class="setup-cost__slider" x-show="step.type === 'slider'">
              <label class="setup-cost__slider-label" :for="'setup-cost-' + step.id">
                <span x-text="employeesLabel(step)"></span>
              </label>
              <input
                type="range"
                class="setup-cost__range"
                :id="'setup-cost-' + step.id"
                :min="step.slider_min"
                :max="step.slider_max"
                :step="step.slider_step || 1"
                x-model.number="answers[step.id]"
                @input="recalculate()"
              />
              <{{ _tag }} class="setup-cost__slider-ticks">
                <span x-text="step.slider_min"></span>
                <span x-text="step.slider_max + '+'"></span>
              </{{ _tag }}>
            </{{ _tag }}>

            <template x-if="step.type === 'checkboxes'">
              <{{ _tag }}>
                <p class="setup-cost__step-hint">{{ 'Select all services you need — optional.'|t }}</p>
                <{{ _tag }} class="setup-cost__services" role="group" :aria-label="step.label">
                  <template x-for="opt in step.options" :key="opt.id">
                    <label
                      class="setup-cost__service"
                      :class="{ 'is-selected': isServiceChecked(step.id, opt.id) }"
                      :data-service="opt.id"
                    >
                      <input
                        type="checkbox"
                        class="setup-cost__service-input"
                        :value="opt.id"
                        @change="toggleService(step.id, opt.id, $event.target.checked)"
                        :checked="isServiceChecked(step.id, opt.id)"
                      />
                      <span class="setup-cost__service-mark" aria-hidden="true">
                        <svg class="setup-cost__service-check" width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M2.5 7.2L5.8 10.5L11.5 3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                      <span class="setup-cost__service-label" x-text="opt.label"></span>
                    </label>
                  </template>
                </{{ _tag }}>
              </{{ _tag }}>
            </template>

            <{{ _tag }} class="setup-cost__nav">
              <button
                type="button"
                class="setup-cost__btn setup-cost__btn--ghost"
                x-show="index > 0"
                @click="prevStep()"
              >
                {{ 'Back'|t }}
              </button>
              <button
                type="button"
                class="setup-cost__btn setup-cost__btn--primary"
                x-show="index < steps.length - 1"
                :disabled="!canAdvance(step)"
                @click="nextStep()"
              >
                {{ 'Continue'|t }}
              </button>
              <button
                type="button"
                class="setup-cost__btn setup-cost__btn--primary"
                x-show="index === steps.length - 1"
                :disabled="!canAdvance(step)"
                @click="scrollToLead()"
              >
                {{ ui.lead_cta_label|default('Get detailed estimate'|t) }}
              </button>
            </{{ _tag }}>
          </section>
        </template>

        {% if show_packages %}
          <template x-if="result && result.package">
            <section class="setup-cost__packages">
              <h3 class="setup-cost__packages-title" x-text="ui.packages_title || '{{ 'Recommended package'|t }}'"></h3>
              <article class="setup-cost__package-card">
                <h4 class="setup-cost__package-name" x-text="result.package.label"></h4>
                <p class="setup-cost__package-desc" x-text="result.package.description"></p>
              </article>
            </section>
          </template>
        {% endif %}

        {% if profile.disclaimer %}
          <p class="setup-cost__disclaimer">{{ profile.disclaimer }}</p>
        {% endif %}
        {% if profile.last_updated or profile.methodology_source %}
          <p class="setup-cost__meta">
            {% if profile.last_updated %}<span>{{ 'Updated'|t }}: {{ profile.last_updated }}</span>{% endif %}
            {% if profile.methodology_source %}<span>{{ profile.methodology_source }}</span>{% endif %}
          </p>
        {% endif %}
      </{{ _tag }}>

      <aside class="setup-cost__aside" aria-live="polite" aria-atomic="true">
        <{{ _tag }} class="setup-cost__result-card">
          <p
            class="setup-cost__empty"
            x-show="!hasEstimate"
            x-cloak
            x-text="ui.empty_selection_hint || '{{ 'Complete the steps to see your estimate.'|t }}'"
          ></p>
          <template x-if="hasEstimate && result">
            <{{ _tag }}>
              <p class="setup-cost__result-kicker" x-text="ui.result_setup_label"></p>
              <p class="setup-cost__result-value">
                <span class="setup-cost__currency" x-text="currency"></span>
                <span x-text="formatRange(result.setup_min, result.setup_max)"></span>
              </p>
              <p class="setup-cost__result-kicker" x-text="ui.result_monthly_label"></p>
              <p class="setup-cost__result-value setup-cost__result-value--sm">
                <span class="setup-cost__currency" x-text="currency"></span>
                <span x-text="formatRange(result.monthly_min, result.monthly_max)"></span>
              </p>
              <p class="setup-cost__result-kicker" x-text="ui.result_timeline_label"></p>
              <p class="setup-cost__result-timeline" x-text="formatTimeline()"></p>
              <template x-if="result.breakdown && result.breakdown.length">
                <{{ _tag }} class="setup-cost__breakdown">
                  <h3 class="setup-cost__breakdown-title" x-text="ui.result_breakdown_title"></h3>
                  <table class="setup-cost__table">
                    <thead>
                      <tr>
                        <th scope="col">{{ 'Item'|t }}</th>
                        <th scope="col">{{ 'Estimated'|t }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="row in result.breakdown" :key="row.id">
                        <tr>
                          <td x-text="row.label"></td>
                          <td x-text="currency + ' ' + formatRange(row.min, row.max)"></td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </{{ _tag }}>
              </template>
              {% if ui.cta_advisor_url %}
                <a class="setup-cost__advisor" href="{{ ui.cta_advisor_url }}">{{ ui.cta_advisor_label|default('Talk to an advisor'|t) }}</a>
              {% endif %}
            </{{ _tag }}>
          </template>
        </{{ _tag }}>
      </aside>
    </{{ _tag }}>
  </{{ _tag }}>

  {% if webform %}
    <section
      class="setup-cost__lead"
      id="setup-cost-lead"
      x-show="showLead"
      x-cloak
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-3"
      x-transition:enter-end="opacity-100 translate-y-0"
      :aria-hidden="showLead ? 'false' : 'true'"
    >
      <{{ _tag }} class="setup-cost__panel setup-cost__lead-panel">
        {% if ui.lead_title %}
          <h2 class="setup-cost__lead-title">{{ ui.lead_title }}</h2>
        {% endif %}
        {% if ui.lead_description %}
          <p class="setup-cost__lead-desc">{{ ui.lead_description }}</p>
        {% endif %}
        <{{ _tag }} class="setup-cost__lead-form-wrap">
          {{ webform }}
        </{{ _tag }}>
      </{{ _tag }}>
    </section>
  {% endif %}
</{{ _tag }}>
