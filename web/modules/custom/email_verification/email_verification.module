<?php

/**
 * @file
 * Email OTP gate before webform submission (modal + private tempstore).
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_form_alter().
 */
function email_verification_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $webform_id = $form['#webform_id'] ?? NULL;
  if (!$webform_id) {
    return;
  }
  /** @var \Drupal\email_verification\EmailVerificationOtpManager $otp_manager */
  $otp_manager = \Drupal::service('email_verification.otp_manager');
  $protected = $otp_manager->getAllowedWebforms();
  if (!isset($protected[$webform_id])) {
    return;
  }
  $config = $protected[$webform_id];

  $form['#attached']['library'][] = 'email_verification/modal';
  // CSRF for POST is fetched in JS via GET /session/token (avoids stale tokens
  // when the page HTML is served from cache for anonymous users).
  $form['#attached']['drupalSettings']['emailVerification'] = [
    'webformId' => $webform_id,
    'emailElementName' => $config['email_element'],
  ];
  $form['#attributes']['data-email-verification'] = $webform_id;

  $form['#validate'][] = 'email_verification_validate_submission';
}

/**
 * Finds a scalar value by key in a nested webform elements array.
 */
function email_verification_find_value_in_elements(?array $branch, string $key): ?string {
  if ($branch === NULL) {
    return NULL;
  }
  foreach ($branch as $k => $v) {
    if ((string) $k === $key) {
      return is_scalar($v) ? (string) $v : NULL;
    }
    if (is_array($v)) {
      $found = email_verification_find_value_in_elements($v, $key);
      if ($found !== NULL) {
        return $found;
      }
    }
  }
  return NULL;
}

/**
 * Locates the email form element for setError() when nested under wizard pages.
 */
function email_verification_find_email_element(array $form, string $key): ?array {
  $elements = $form['elements'] ?? [];
  if (!is_array($elements)) {
    return NULL;
  }
  if (isset($elements[$key]['#type'])) {
    return $elements[$key];
  }
  foreach ($elements as $page) {
    if (!is_array($page) || empty($page[$key]['#type'] ?? NULL)) {
      continue;
    }
    return $page[$key];
  }
  return NULL;
}

/**
 * Validates that the email was verified via OTP in this session.
 */
function email_verification_validate_submission(array &$form, FormStateInterface $form_state) {
  $webform_id = $form['#webform_id'] ?? NULL;
  if (!$webform_id) {
    return;
  }
  /** @var \Drupal\email_verification\EmailVerificationOtpManager $otp_manager */
  $otp_manager = \Drupal::service('email_verification.otp_manager');
  if (!$otp_manager->isWebformAllowed($webform_id)) {
    return;
  }
  $email_key = $otp_manager->getEmailElementKey($webform_id);
  if (!$email_key) {
    return;
  }
  $elements_values = $form_state->getValue('elements');
  $email = is_array($elements_values)
    ? email_verification_find_value_in_elements($elements_values, $email_key)
    : NULL;
  if ($email === NULL || $email === '') {
    $email = $form_state->getValue($email_key);
  }
  if ($email === NULL || $email === '') {
    return;
  }
  if (!$otp_manager->isVerified($webform_id, (string) $email)) {
    $message = t('Please confirm your email with the verification code before submitting.');
    $email_el = email_verification_find_email_element($form, $email_key);
    if ($email_el !== NULL) {
      $form_state->setError($email_el, $message);
    }
    else {
      $form_state->setErrorByName('elements', $message);
    }
  }
}

/**
 * Implements hook_webform_submission_insert().
 */
function email_verification_webform_submission_insert(WebformSubmissionInterface $webform_submission) {
  $webform_id = $webform_submission->getWebform()->id();
  /** @var \Drupal\email_verification\EmailVerificationOtpManager $otp_manager */
  $otp_manager = \Drupal::service('email_verification.otp_manager');
  if ($otp_manager->isWebformAllowed($webform_id)) {
    $email_key = $otp_manager->getEmailElementKey($webform_id);
    if ($email_key) {
      $data = $webform_submission->getData();
      $email = $data[$email_key] ?? '';
      if ($email !== '') {
        $otp_manager->clearVerification($webform_id, (string) $email);
      }
    }
  }

  if ($webform_id === 'event_updates') {
    \Drupal::service('email_verification.branded_email')
      ->sendUpdatesSubscriptionConfirmation($webform_submission);
  }
}

/**
 * Implements hook_theme().
 */
function email_verification_theme($existing, $type, $theme, $path) {
  return [
    'motaded_branded_email' => [
      'variables' => [
        'langcode' => 'en',
        'text_direction' => 'ltr',
        'site_url' => '',
        'year' => '',
        'preheader' => '',
        'headline' => '',
        'intro' => '',
        'highlight_label' => NULL,
        'highlight_value' => NULL,
        'highlight_monospace' => FALSE,
        'notes' => [],
      ],
      'template' => 'motaded-branded-email',
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function email_verification_mail($key, &$message, $params) {
  switch ($key) {
    case 'email_verification_otp':
    case 'setup_cost_lead_confirmation':
    case 'updates_subscription_confirmation':
      $message['subject'] = trim((string) ($params['subject'] ?? ''));
      $html = (string) ($params['html_body'] ?? '');
      $message['body'][] = \Drupal\Core\Render\Markup::create($html);
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      break;
  }
}
