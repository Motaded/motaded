<?php

/**
 * @file
 * Install and update hooks for Email verification.
 */

/**
 * Adds default config if the module was enabled before settings existed.
 */
function email_verification_update_9001() {
  $config = \Drupal::configFactory()->getEditable('email_verification.settings');
  if ($config->isNew()) {
    $config->setData([
      'webforms' => [
        'book_a_free_consultation' => [
          'email_element' => 'email',
        ],
      ],
    ])->save();
  }
}

/**
 * Extend OTP verification to all email webforms except career.
 */
function email_verification_update_9002(): void {
  $webforms = [
    'book_a_free_consultation' => ['email_element' => 'email'],
    'contact' => ['email_element' => 'email'],
    'event_registration_help' => ['email_element' => 'email'],
    'event_updates' => ['email_element' => 'email'],
    'setup_cost_estimate_lead' => ['email_element' => 'email'],
    'set_up_company' => ['email_element' => 'email'],
    'coworking_space_requirements' => ['email_element' => 'email_address'],
    'translation_services_requirement' => ['email_element' => 'email'],
    'clints_form' => ['email_element' => 'email'],
    'tasheer_visa_appointment' => ['email_element' => 'email'],
    'request_a_consultation' => ['email_element' => 'work_email'],
    'career' => ['email_element' => 'email'],
  ];
  \Drupal::configFactory()->getEditable('email_verification.settings')
    ->set('webforms', $webforms)
    ->save();
}

/**
 * Enable OTP verification on the career webform.
 */
function email_verification_update_9003(): void {
  $config = \Drupal::configFactory()->getEditable('email_verification.settings');
  $webforms = $config->get('webforms') ?: [];
  $webforms['career'] = ['email_element' => 'email'];
  $config->set('webforms', $webforms)->save();
}
