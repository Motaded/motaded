			<rms:rms_skill_0_category>Skills 2</rms:rms_skill_0_category>
			<rms:rms_skill_0_keywords>Competency in accounting standards and principles (i.e., IFRS, IFRS SMEs, IPSAS, ASPE, GAAP, &amp; etc.).</rms:rms_skill_0_keywords>
			<rms:rms_skill_1_category>Skills 3</rms:rms_skill_1_category>
			<rms:rms_skill_1_keywords>Proficient in MS Office and ERP systems.</rms:rms_skill_1_keywords>
			<rms:rms_skill_2_category>Skills 0</rms:rms_skill_2_category>
			<rms:rms_skill_2_keywords>Strong communication and organizational skills.</rms:rms_skill_2_keywords>
			<rms:rms_skill_3_category>Skills 1</rms:rms_skill_3_category>
			<rms:rms_skill_3_keywords>Quick learner and adept at multitasking under pressure.</rms:rms_skill_3_keywords>
			<rms:rms_skill_count>4</rms:rms_skill_count>
			<rms:rms_summary>A detail-oriented accounting and audit professional with experience in financial operations, auditing, and administrative support. Recognized for strong analytical skills, accurate documentation, and effective communication. Proficient in MS Office and ERP systems. Adept at supporting financial reporting, reconciliation, and process improvements, with a commitment to learning and contributing in collaborative environments as an independent professional.</rms:rms_summary>
			<xmp:CreateDate>2025-06-14T10:30:56+03:00</xmp:CreateDate>
