{
    "name": "drupal/legacy-project",
    "description": "Project template for Drupal projects with composer following drupal/drupal layout",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "noli42/chosen",
                "version": "3.0.0",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/noli42/chosen/releases/download/3.0.0/chosen-assets-v3.0.0.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/address": "^2.0",
        "drupal/addtoany": "^2.0",
        "drupal/admin_toolbar": "^3.6",
        "drupal/backup_migrate": "^5.1",
        "drupal/better_exposed_filters": "^7.0",
        "drupal/bootstrap5": "^4.0",
        "drupal/chosen": "^5.0",
        "drupal/ckeditor5_font": "^1.1@beta",
        "drupal/ckeditor5_paste_filter": "^1.1",
        "drupal/ckeditor5_template": "^1.0",
        "drupal/ckeditor_accordion": "^2.3",
        "drupal/ckeditor_responsive_table": "^1.0",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_ignore": "^3.3",
        "drupal/content_export_csv": "^4.9",
        "drupal/content_translation_redirect": "^2.0",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/core-vendor-hardening": "^10.3",
        "drupal/devel": "^5.4",
        "drupal/devel_debug_log": "^2.0",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/entity_export_csv": "^2.1",
        "drupal/estimated_read_time": "^1.2",
        "drupal/eu_cookie_compliance": "^1.29",
        "drupal/faqfield": "^8.0",
        "drupal/field_group": "^4.0",
        "drupal/flood_control": "^3.0",
        "drupal/formdazzle": "^4.0",
        "drupal/fullcalendar_view": "^5.2",
        "drupal/gin": "^5.0",
        "drupal/honeypot": "^2.2",
        "drupal/http_status_code": "^2.0@dev",
        "drupal/imageapi_optimize": "^4.1",
        "drupal/imageapi_optimize_webp": "^2.1",
        "drupal/inline_responsive_images": "^4.0",
        "drupal/lang_dropdown": "^2.4",
        "drupal/like_dislike": "^2.4",
        "drupal/media_gallery": "^3.2",
        "drupal/metatag": "^2.2",
        "drupal/metatag_webform": "^1.0",
        "drupal/node_view_redirect": "^1.2",
        "drupal/page_specific_class": "^2.0",
        "drupal/paragraphs": "^1.19",
        "drupal/pathauto": "^1.14",
        "drupal/recaptcha": "^3.4",
        "drupal/recreate_block_content": "^3.0",
        "drupal/redirect": "^1.12",
        "drupal/redirect_410": "dev-1.0.x",
        "drupal/redirect_regex": "^1.0@alpha",
        "drupal/responsive_favicons": "^4.0",
        "drupal/robotstxt": "^1.6",
        "drupal/schema_metatag": "^3.0",
        "drupal/search_api": "^1.40",
        "drupal/seckit": "^2.0",
        "drupal/security_review": "^3.1",
        "drupal/simple_sitemap": "^4.2",
        "drupal/smtp": "^1.4",
        "drupal/social_link_field": "^2.1",
        "drupal/svg_image": "^3.2",
        "drupal/svg_image_field": "^2.3",
        "drupal/symfony_mailer": "^1.6",
        "drupal/token_filter": "^2.2",
        "drupal/tus": "^2.1",
        "drupal/twig_tweak": "^3.4",
        "drupal/views_fieldsets": "^4.0",
        "drupal/viewsreference": "^2.0@beta",
        "drupal/webform": "^6.3@beta",
        "drupal/yoast_seo": "^2.2",
        "drush/drush": "^13.6",
        "mglaman/composer-drupal-lenient": "^1.0",
        "noli42/chosen": "3.0.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-vendor-hardening": true,
            "mglaman/composer-drupal-lenient": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "web/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "composer-exit-on-patch-failure": false,
        "patchLevel": {
            "drupal/core": "-p2",
            "drupal/contrib-module1": "-p1",
            "drupal/contrib-module2": "-p1"
        },
        "patches": {
            "drupal/core": {
                "2916377: Allow colon in classes": "https://www.drupal.org/files/issues/2025-06-20/2916377.patch",
                "2802371: active language CSS class": "https://git.drupalcode.org/project/drupal/-/merge_requests/12862.diff"
            },
            "drupal/like_dislike": {
                "3431667: Drupal 11 compatability": "https://git.drupalcode.org/project/like_dislike/-/merge_requests/10.diff"
            },
            "drupal/tus": {
                "3448866: Drupal 11 compatability": "https://git.drupalcode.org/project/tus/-/merge_requests/12.diff"
            },
            "drupal/ckeditor5_font": {
                "3429155: Drupal 11 compatibility": "https://git.drupalcode.org/project/ckeditor5_font/-/merge_requests/10.diff",
                "3541766: JS error": "https://www.drupal.org/files/issues/2025-08-18/can-not-read-properties-undefined-3541766-3.patch",
                "3541766: Fatal error": "https://www.drupal.org/files/issues/2024-10-23/error-after-drupal-10.1.0-3368736-60.patch"
            },
            "drupal/content_export_csv": {
                "Avoid undefined langcode key warning in export": "patches/content_export_csv-undefined-array-key-langcode.patch"
            },
            "drupal/redirect": {
                "2831605: support wildcards": "https://git.drupalcode.org/project/redirect/-/merge_requests/97.diff",
                "redirect_404: safe logger.factory->get() when channel omitted": "patches/redirect_404-logger-factory-get-default.patch"
            },
            "drupal/redirect_410": {
                "Drupal 11 compatibility and status code hardening": "patches/redirect_410-drupal-11-compat-and-hardening.patch"
            },
            "drupal/imageapi_optimize_webp": {
                "Drupal 11: use GDToolkit::getImage() (getResource removed)": "patches/imageapi_optimize_webp-drupal-11-gd-getimage.patch",
                "Native .webp only: do not rewrite file query to extensionless URI": "patches/imageapi_optimize_webp-native-webp-source.patch"
            }
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/.htaccess": false,
                "[web-root]/robots.txt": false,
                "[web-root]/INSTALL.txt": false,
                "[web-root]/README.md": false,
                "[web-root]/sites/development.services.yml": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/legacy-project template!               </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "drupal-lenient": {
            "allowed-list": ["drupal/tus", "drupal/like_dislike", "drupal/ckeditor5_font", "drupal/ckeditor_templates_ui", "drupal/redirect_410"]
        }
    }
}
