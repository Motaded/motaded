 html {
   scroll-behavior: smooth;
 }
 
 /* =========================
    Theme Colors (Tailwind v4, OKLCH)
    ========================= */
 @theme {
   /* Primary — DGA Green */
   --color-primary-50: oklch(0.97 0.02 175);
   --color-primary-100: oklch(0.93 0.03 175);
   --color-primary-200: oklch(0.87 0.05 175);
   --color-primary-300: oklch(0.81 0.08 175);
   --color-primary-400: oklch(0.72 0.11 175);
   --color-primary-500: oklch(0.55 0.13 158.44);
   /* Main DGA Green */
   --color-primary-600: oklab(0.54 -0.09 -0.01); /* oklch(0.51 0.12 159.07); */
   --color-primary-700: oklab(0.41 -0.05 -0.02); /* oklch(0.47 0.11 159.67); */
   --color-primary-800: oklch(0.48 0.11 175);
   --color-primary-900: oklch(0.42 0.1 175);
 
